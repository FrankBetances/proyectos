---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const targetUrl = `${baseUrl}/construye-con-lua`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
    <title>Redirigiendo a Lúa Construye...</title>
    <script define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body style="background: #07090e; color: #F8FAFC; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
    <p>Redirigiendo a <a href={targetUrl} style="color: #FB923C;">Lúa Construye</a>...</p>
  </body>
</html>
