---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import ConstruyeHero from '../components/construye-con-lua/ConstruyeHero.astro';
import ConstruyeHowItWorks from '../components/construye-con-lua/ConstruyeHowItWorks.astro';
import ConstruyeDualLine from '../components/construye-con-lua/ConstruyeDualLine.astro';
import ConstruyeExperiences from '../components/construye-con-lua/ConstruyeExperiences.astro';
import ConstruyeInstitutionalValue from '../components/construye-con-lua/ConstruyeInstitutionalValue.astro';
import ConstruyeLicensingFAQ from '../components/construye-con-lua/ConstruyeLicensingFAQ.astro';

const pageTitle = "Lúa Construye · Juego Manipulativo y Estimulación Infantil Sin Pantallas";
const pageDescription = "Sistema de juego tangible, pensamiento espacial y estimulación neurofuncional para primera infancia (0 a 6 años). Cero pantallas para el menor, conectado con Descubre con Lúa y Valeria+.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://FrankBetances.github.io/proyectos/construye-con-lua#product",
      "name": "Lúa Construye · Aprendizaje Manipulativo y Estimulación Sensorial (0-6 años)",
      "description": pageDescription,
      "brand": {
        "@type": "Organization",
        "name": "Earlify Health S.L."
      },
      "category": "Educational & Pediatric Neurodevelopment System",
      "manufacturer": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "ORL & Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "sponsor": [
        {
          "@type": "Organization",
          "name": "Consorcio de la Zona Franca de Vigo"
        },
        {
          "@type": "Organization",
          "name": "Incubadora de Alta Tecnología startTIC"
        }
      ],
      "audience": {
        "@type": "Audience",
        "audienceType": "Escuelas Infantiles, Colegios, Logopedas, Terapeutas Ocupacionales y Familias"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/construye-con-lua#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Para qué edades está recomendado Lúa Construye?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El sistema abarca toda la etapa de primera infancia, de 0 a 6 años, cumpliendo con la normativa europea de seguridad infantil EN 71-1 tanto para aulas de 0-3 años como para 3-6 años y gabinetes clínicos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué las niñas y niños no interactúan con ninguna pantalla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Siguiendo las directrices de la OMS y la Asociación Española de Pediatría, la aplicación sirve exclusivamente como guión para la persona adulta. Los menores aprenden manipulando piezas reales y dialogando cara a cara."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo solicitar una demostración o proyecto piloto para una escuela o clínica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A través del formulario de contacto profesional de la página o escribiendo directamente al equipo del Dr. Frank Betances para acordar una demostración o convenio institucional."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image="/assets/lua-mascota-valeria.png"
  keywords="Lúa Construye, Juego Manipulativo Infantil, Educación Sin Pantallas, Atención Temprana, Estimulación Sensorial, Descubre con Lúa, Valeria+, Earlify Health, Dr. Frank Betances, startTIC, Zona Franca de Vigo"
  jsonLd={jsonLd}
>
  <Header activeTab="construye-con-lua" />

  <main id="main-content">
    <ConstruyeHero />
    <ConstruyeHowItWorks />
    <ConstruyeDualLine />
    <ConstruyeExperiences />
    <ConstruyeInstitutionalValue />
    <ConstruyeLicensingFAQ />
  </main>

  <Footer />
  <ContactModal />
</Layout>
