---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import ConstruyeHero from '../components/construye-con-lua/ConstruyeHero.astro';
import ConstruyeHowItWorks from '../components/construye-con-lua/ConstruyeHowItWorks.astro';
import ConstruyeDualLine from '../components/construye-con-lua/ConstruyeDualLine.astro';
import ConstruyeExperiences from '../components/construye-con-lua/ConstruyeExperiences.astro';
import ConstruyeInstitutionalValue from '../components/construye-con-lua/ConstruyeInstitutionalValue.astro';
import ConstruyeLicensingFAQ from '../components/construye-con-lua/ConstruyeLicensingFAQ.astro';

const pageTitle = "Lúa Construye · Bloques Pedagógicos STEAM para Primera Infancia (0 a 6 años)";
const pageDescription = "Sistema de bloques manipulativos STEAM y estimulación neurofuncional sin pantallas. Conecta la manipulación tangible con visión artificial local y la mascota Lúa. Especificación V5 Octubre 2026.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://FrankBetances.github.io/proyectos/construye-con-lua#product",
      "name": "Lúa Construye · Bloques Pedagógicos STEAM y Juego Manipulativo (0-6 años)",
      "description": pageDescription,
      "brand": {
        "@type": "Organization",
        "name": "Earlify Health S.L."
      },
      "category": "Educational & Pediatric STEAM System",
      "manufacturer": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "ORL & Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "sponsor": [
        {
          "@type": "Organization",
          "name": "Consorcio de la Zona Franca de Vigo"
        },
        {
          "@type": "Organization",
          "name": "Incubadora de Alta Tecnología startTIC"
        }
      ],
      "audience": {
        "@type": "Audience",
        "audienceType": "Escuelas Infantiles (0-3 y 3-6 años), Logopedas, Terapeutas Ocupacionales, Audiólogos Pediátricos y Familias"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/construye-con-lua#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el axioma fundamental de Lúa Construye?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La app decide. Lúa reacciona. Los bloques los mueve el niño. El adulto media siempre. El principio pedagógico rector es: «El fenómeno manda y el lenguaje lo nombra»."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué Lúa no tiene altavoz ni micrófono en su cabeza física?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por prescripción médica del Dr. Frank Alberto Betances Reinoso: los altavoces de juguete provocan distorsión que perjudica a menores con implantes o audífonos, y prescindir de micrófono blinda por hardware el Muro Regulatorio Zero-PHI. La voz pertenece exclusivamente a la persona adulta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo conviven las Escalas G (0-3 años) y E (3-6 años) sin adaptadores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mediante una proporción geométrica 2:1 nativa con paso paramétrico 2P (Escala G, piezas > 31,75 mm y paredes >= 3,2 mm bajo norma EN 71-1) y paso P (Escala E), permitiendo encaje directo sin adaptadores."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo funciona la visión artificial sin conexión a internet ni riesgo para la privacidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cámara de la tableta opera como sensor ciego en memoria RAM local mediante algoritmos deterministas (ARCore/MediaPipe). Ninguna imagen o dato biométrico se almacena ni se transmite a servidores."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image="/assets/lua-mascota-valeria.png"
  keywords="Lúa Construye, Bloques STEAM, Juego Manipulativo Infantil, Educación Sin Pantallas, Atención Temprana, Estimulación Sensorial, Descubre con Lúa, Valeria+, Earlify Health, Dr. Frank Betances, startTIC, Zona Franca de Vigo, EN 71-1"
  jsonLd={jsonLd}
>
  <Header activeTab="construye-con-lua" />

  <main id="main-content">
    <ConstruyeHero />
    <ConstruyeHowItWorks />
    <ConstruyeDualLine />
    <ConstruyeExperiences />
    <ConstruyeInstitutionalValue />
    <ConstruyeLicensingFAQ />
  </main>

  <Footer />
  <ContactModal />
</Layout>