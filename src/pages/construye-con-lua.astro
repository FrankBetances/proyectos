---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import ConstruyeHero from '../components/construye-con-lua/ConstruyeHero.astro';
import ConstruyeEcosystemBridge from '../components/construye-con-lua/ConstruyeEcosystemBridge.astro';
import ConstruyeMechanicalSpecs from '../components/construye-con-lua/ConstruyeMechanicalSpecs.astro';
import ConstruyeBlenderPipeline from '../components/construye-con-lua/ConstruyeBlenderPipeline.astro';
import ConstruyeMatrixCatalog from '../components/construye-con-lua/ConstruyeMatrixCatalog.astro';
import ConstruyeSoftwareArchitecture from '../components/construye-con-lua/ConstruyeSoftwareArchitecture.astro';
import ConstruyeRoadmapViability from '../components/construye-con-lua/ConstruyeRoadmapViability.astro';
import ConstruyeNormativeFAQ from '../components/construye-con-lua/ConstruyeNormativeFAQ.astro';
import ConstruyeCTA from '../components/construye-con-lua/ConstruyeCTA.astro';

const pageTitle = "Lúa Construye · Robótica Manipulativa 3D y Estándar Duplo (31,80 mm)";
const pageDescription = "Sistema modular tangible de robótica manipulativa y construcción educativa-clínica (0-6 años). Modelado procedural en Blender (Python bpy) para impresión 3D y sincronizado con Descubre con Lúa y Valeria+.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://FrankBetances.github.io/proyectos/construye-con-lua#product",
      "name": "Lúa Construye (Sistema Modular Tangible Duplo 31,80 mm)",
      "description": pageDescription,
      "brand": {
        "@type": "Organization",
        "name": "Earlify Health S.L."
      },
      "category": "Educational Toy & Tangible Computing Robotics Hardware",
      "manufacturer": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "ORL & Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "sponsor": [
        {
          "@type": "Organization",
          "name": "Consorcio de la Zona Franca de Vigo"
        },
        {
          "@type": "Organization",
          "name": "Incubadora de Alta Tecnología startTIC"
        }
      ],
      "audience": {
        "@type": "Audience",
        "audienceType": "Educadores de Infantil (0 a 6 años), Terapeutas Ocupacionales, Logopedas y Familias"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "MechanicalStandard",
          "value": "Duplo Compatible (Stud Pitch 31.80 mm, Stud Diameter 9.40 mm, Height 19.20 mm)"
        },
        {
          "@type": "PropertyValue",
          "name": "ChildSafetyStandard",
          "value": "EN 71-1 (> 31.75 mm anti-choking test cylinder compliant for < 36 months)"
        },
        {
          "@type": "PropertyValue",
          "name": "ModelingPipeline",
          "value": "Blender 4.x Headless (Python bpy) with Manifold 2-manifold exact kernel"
        },
        {
          "@type": "PropertyValue",
          "name": "SoftwareIntegration",
          "value": "Flutter CustomPainter (Zero-Network, Zero external UI packages, Zero-PHI)"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/construye-con-lua#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué se eligió el estándar Duplo (31,80 mm) en lugar de LEGO clásico (8 mm)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por estricto cumplimiento de la normativa europea EN 71-1. Las piezas con cota menor a 31,75 mm presentan riesgo de asfixia en menores de 36 meses. El paso modular Duplo de 31,80 mm asegura seguridad total y adaptación a la motricidad bimanual temprana."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué se rechazó un visor 3D interactivo dentro de la aplicación móvil?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En asambleas de aula de 5 a 8 minutos, un visor 3D embebido infla el bundle del APK con librerías pesadas WebGL y distrae a la docente. El trazado procedural 2D con CustomPainter es instantáneo y pedagógicamente idóneo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre la Gama Lúa y la Gama Valeria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ambas comparten el acople de 31,80 mm. La Gama Lúa está dirigida a pensamiento computacional y algoritmos en el aula LOMLOE; la Gama Valeria incorpora caras superiores funcionalizadas para terapia somatosensorial palmar, cilindros de prensión gradual y resonadores acústicos."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image="/assets/lua-mascota-valeria.png"
  keywords="Lúa Construye, Robótica Manipulativa, Estándar Duplo 31.8 mm, Blender bpy, Impresión 3D FDM, EN 71-1, Pensamiento Computacional Infantil, Descubre con Lúa, Valeria+, Earlify Health, Dr. Frank Betances, startTIC, Zona Franca de Vigo"
  jsonLd={jsonLd}
>
  <Header activeTab="construye-con-lua" />

  <main id="main-content">
    <ConstruyeHero />
    <ConstruyeEcosystemBridge />
    <ConstruyeMechanicalSpecs />
    <ConstruyeBlenderPipeline />
    <ConstruyeMatrixCatalog />
    <ConstruyeSoftwareArchitecture />
    <ConstruyeRoadmapViability />
    <ConstruyeNormativeFAQ />
    <ConstruyeCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
