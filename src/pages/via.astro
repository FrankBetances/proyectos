---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ViaHero from '../components/via/ViaHero.astro';
import ViaOverview from '../components/via/ViaOverview.astro';
import ViaRegulatory from '../components/via/ViaRegulatory.astro';
import ViaWorkflow from '../components/via/ViaWorkflow.astro';
import ViaModules from '../components/via/ViaModules.astro';
import ViaTelemetryPrivacy from '../components/via/ViaTelemetryPrivacy.astro';
import ViaTechStack from '../components/via/ViaTechStack.astro';
import ViaEcosystem from '../components/via/ViaEcosystem.astro';
import Footer from '../components/Footer.astro';

const viaJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "VIA+ (Valoración Interactiva de Audición y Lenguaje)",
  "applicationCategory": "MedicalApplication",
  "operatingSystem": "iOS, Android",
  "description": "Software como Dispositivo Médico (SaMD) de Clase IIa (MDR 2017/745) para apoyo a la decisión clínica en audiología y lenguaje pediátrico.",
  "author": {
    "@type": "Person",
    "name": "Dr. Frank Alberto Betances Reinoso",
    "url": "https://FrankBetances.github.io/valeria-web/cv"
  },
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": ["Physician", "Audiologist", "Speech Language Pathologist"]
  }
};
---

<Layout 
	title="VIA+ · Valoración Interactiva de Audición y Lenguaje (SaMD Clase IIa)"
	description="Software como Dispositivo Médico (SaMD) de Clase IIa (MDR 2017/745, Regla 11) para apoyo a la decisión clínica en audiología pediátrica, logoaudiometría y voz."
	keywords="VIA+, SaMD, Dispositivo Médico Clase IIa, MDR 2017/745, Audiología Pediátrica, Logoaudiometría, Análisis Acústico de Voz, Dr. Frank Betances"
	jsonLd={viaJsonLd}
>
	<Header activeTab="via" />
	<main>
		<ViaHero />
		<ViaOverview />
		<ViaRegulatory />
		<ViaWorkflow />
		<ViaModules />
		<ViaTelemetryPrivacy />
		<ViaTechStack />
		<ViaEcosystem />
	</main>
	<Footer />
</Layout>
