---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ViaHero from '../components/via/ViaHero.astro';
import ViaOverview from '../components/via/ViaOverview.astro';
import ViaRegulatory from '../components/via/ViaRegulatory.astro';
import ViaCollaborators from '../components/via/ViaCollaborators.astro';
import ViaWorkflow from '../components/via/ViaWorkflow.astro';
import ViaModules from '../components/via/ViaModules.astro';
import ViaLanguages from '../components/via/ViaLanguages.astro';
import ViaTelemetryPrivacy from '../components/via/ViaTelemetryPrivacy.astro';
import ViaTechStack from '../components/via/ViaTechStack.astro';
import ViaEcosystem from '../components/via/ViaEcosystem.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "VIA+ · Software Médico SaMD Clase IIa Llave en Mano (13 Módulos & 7 Lenguas)";
const pageDescription = "Software como Dispositivo Médico (SaMD Clase IIa, MDR 2017/745) entregado llave en mano en tableta clínica homologada en modo kiosco con calibración acústica de fábrica y motor NLG determinista.";

const viaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://FrankBetances.github.io/proyectos/via#software",
      "name": "VIA+ (Valoración Interactiva de Audición y Lenguaje)",
      "softwareVersion": "3.0",
      "applicationCategory": "MedicalApplication",
      "operatingSystem": "Estación Clínica Homologada en Modo Kiosco",
      "description": pageDescription,
      "author": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Especialista en Otorrinolaringología & Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "provider": {
        "@type": "Organization",
        "name": "Earlify Health S.L.",
        "url": "https://FrankBetances.github.io/proyectos/earlify"
      },
      "medicalAudience": {
        "@type": "MedicalAudience",
        "audienceType": ["Physician", "Otorhinolaryngologist", "Audiologist", "Speech Language Pathologist", "Pediatrician"]
      },
      "featureList": [
        "SaMD Clase IIa entregado llave en mano sobre tableta clínica homologada en modo kiosco bloqueado",
        "Calibración electroacústica sellada de fábrica en cámara anecoica frente a sonómetro Clase 1",
        "Motor NLG determinista para informes clínicos sin alucinaciones con borrador supervisado y firma colegiada",
        "13 módulos de evaluación clínica y neurodesarrollo adaptados a la infancia",
        "Pre-screening clínico CAP con otoscopia por oído y veredicto graduado (Completo, Parcial o Bloqueado)",
        "Sonómetro Ambiental en dB(A) con ponderación A (IEC 61672), LAeq y percentiles",
        "Audiometría Tonal liminar (Hughson-Westlake) y Condicionada (El Tren del Sonido) con cálculo de PTA",
        "Análisis Acústico de Voz (F0, jitter, shimmer ciclo a ciclo y HNR) validado frente a estándares de fonética clínica",
        "Test de Disfagia MECV-V con pulsioximetría BLE para detección de desaturación SpO₂",
        "Cribado de Autismo M-CHAT-R/F y SAHS Infantil (PSQ de Chervin + Brodsky)",
        "Articulación fonética T.A.R. (registro SODA) con 86 ítems propios por variedad",
        "Logoaudiometría Verbal en campo libre con 7 variedades lingüísticas",
        "Funciones Ejecutivas con 5 mini-juegos estructurados por franjas de edad",
        "Análisis Prosódico descriptivo sobre habla conectada",
        "Cribado normativo de Hitos del Lenguaje ASHA (0 a 5 años) con 8 banderas rojas",
        "Principio de Cero IA en el dispositivo y almacenamiento local cifrado por hardware",
        "Telemetría de usabilidad Zero-PHI con código QR anónimo (IEC 62366-1)"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/via#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es VIA+ y para qué sirve en consulta médica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "VIA+ es un Software como Dispositivo Médico (SaMD Clase IIa) diseñado para tablets que asiste a médicos otorrinolaringólogos, audiólogos y logopedas en la valoración integral de la audición, la voz, la articulación, la deglución y el neurodesarrollo infantil de forma interactiva y gamificada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué significa que VIA+ aplica el principio de 'Cero IA en el dispositivo'?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Significa que la aplicación no utiliza modelos de inteligencia artificial de 'caja negra' en tiempo real. Todas las mediciones acústicas y algoritmos de evaluación son matemáticamente deterministas, auditables y validados frente a estándares de fonética clínica, lo que garantiza máxima fiabilidad y cumplimiento con el Reglamento de IA de la UE."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué VIA+ no emite diagnósticos automáticos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por mandato de seguridad y regulación sanitaria (MDR 2017/745 Clase IIa y IEC 62304 Clase B). VIA+ es un sistema de apoyo a la decisión clínica (CDSS): proporciona datos precisos, pero el diagnóstico y la decisión médica siempre corresponden en exclusiva al facultativo especialista."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo protege la privacidad de los niños y sus datos de salud?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Todos los datos clínicos y grabaciones de audio se guardan exclusivamente en la memoria local cifrada de la estación clínica y nunca se suben a la nube. La telemetría de usabilidad es anónima (Zero-PHI) y se exporta mediante un código QR sin internet."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué idiomas y lenguas se puede realizar la evaluación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuenta con 7 lenguas de sesión: Castellano, Galego (Proxecto Nós), Euskara (HiTZ/Aholab), Dominicano (Quisqueya Habla), Català (projecte AINA), Español Latinoamericano y US English, con bancos de voz neuronal y adaptaciones fonéticas validadas."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	keywords="VIA+, SaMD, Dispositivo Médico Clase IIa, MDR 2017/745, Audiología Pediátrica, Logoaudiometría, Análisis Acústico de Voz, Disfagia MECV-V, M-CHAT-R, Hitos ASHA, Telemetría Zero-PHI, Dr. Frank Betances, Earlify Health"
	jsonLd={viaJsonLd}
>
	<Header activeTab="via" />
	<main id="main-content">
		<ViaHero />
		<ViaOverview />
		<ViaRegulatory />
		<ViaCollaborators />
		<ViaWorkflow />
		<ViaModules />
		<ViaLanguages />
		<ViaTelemetryPrivacy />
		<ViaTechStack />
		<ViaEcosystem />
	</main>
	<Footer />
	<ContactModal />
</Layout>
