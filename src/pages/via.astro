---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ViaHero from '../components/via/ViaHero.astro';
import ViaOverview from '../components/via/ViaOverview.astro';
import ViaRegulatory from '../components/via/ViaRegulatory.astro';
import ViaWorkflow from '../components/via/ViaWorkflow.astro';
import ViaModules from '../components/via/ViaModules.astro';
import ViaTelemetryPrivacy from '../components/via/ViaTelemetryPrivacy.astro';
import ViaTechStack from '../components/via/ViaTechStack.astro';
import ViaEcosystem from '../components/via/ViaEcosystem.astro';
import Footer from '../components/Footer.astro';

const viaJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "VIA+ (Valoración Interactiva de Audición y Lenguaje)",
  "applicationCategory": "MedicalApplication",
  "operatingSystem": "iOS, Android",
  "description": "Software como Dispositivo Médico (SaMD) de Clase IIa (MDR 2017/745, Regla 11) para apoyo a la decisión clínica en audiología, logoaudiometría, voz y neurodesarrollo pediátrico con 12 módulos de evaluación.",
  "author": {
    "@type": "Person",
    "name": "Dr. Frank Alberto Betances Reinoso",
    "url": "https://FrankBetances.github.io/proyectos/cv"
  },
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": ["Physician", "Audiologist", "Speech Language Pathologist"]
  },
  "featureList": [
    "12 módulos de evaluación clínicamente validados",
    "Análisis Prosódico (Móvil 12) sobre habla conectada",
    "Sonómetro Ambiental en dB(A) con ponderación A (IEC 61672)",
    "Análisis Acústico de Voz (F0, jitter, shimmer, HNR) validado contra Praat",
    "Certificado de Aptitud para la Prueba (CAP) bloqueante",
    "Cero IA en el dispositivo (ADR firmado)",
    "Telemetría de usabilidad Zero-PHI con QR (IEC 62366-1)",
    "Operación 100% offline y datos clínicos locales"
  ]
};
---

<Layout 
	title="VIA+ · Dispositivo Médico SaMD Clase IIa (12 Módulos)"
	description="Software como Dispositivo Médico (SaMD) de Clase IIa (MDR 2017/745, Regla 11) para apoyo a la decisión clínica en audiología pediátrica, logoaudiometría, voz y prosodia."
	keywords="VIA+, SaMD, Dispositivo Médico Clase IIa, MDR 2017/745, Audiología Pediátrica, Logoaudiometría, Análisis Acústico de Voz, Análisis Prosódico, Dr. Frank Betances"
	jsonLd={viaJsonLd}
>
	<Header activeTab="via" />
	<main>
		<ViaHero />
		<ViaOverview />
		<ViaRegulatory />
		<ViaWorkflow />
		<ViaModules />
		<ViaTelemetryPrivacy />
		<ViaTechStack />
		<ViaEcosystem />
	</main>
	<Footer />
</Layout>
