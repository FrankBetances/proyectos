---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import EarlifyHero from '../components/earlify/EarlifyHero.astro';
import EarlifyBrands from '../components/earlify/EarlifyBrands.astro';
import EarlifyWorkflow from '../components/earlify/EarlifyWorkflow.astro';
import EarlifyB2B from '../components/earlify/EarlifyB2B.astro';
import EarlifyFounder from '../components/earlify/EarlifyFounder.astro';
import ProblemSection from '../components/earlify/ProblemSection.astro';
import SolutionSection from '../components/earlify/SolutionSection.astro';
import EarlifyValidation from '../components/earlify/EarlifyValidation.astro';
import EarlifyDifferentiators from '../components/earlify/EarlifyDifferentiators.astro';
import EarlifyCTA from '../components/earlify/EarlifyCTA.astro';

const pageTitle = "Earlify Health · Ecosistema Pediátrico: Consulta, Hogar y Lúa";
const pageDescription = "Conectamos la consulta médica con el hogar para el desarrollo infantil: VIA+ (apoyo diagnóstico), Valeria+ (terapia y formación familiar) y Lúa (mascota AIoT).";

const earlifyJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalOrganization",
      "@id": "https://FrankBetances.github.io/proyectos/earlify#organization",
      "name": "Earlify Health S.L.",
      "legalName": "Earlify Health S.L.",
      "url": "https://FrankBetances.github.io/proyectos/earlify",
      "logo": "https://FrankBetances.github.io/proyectos/assets/earlify-logo.png",
      "slogan": "Uniendo la precisión médica con la calidez del hogar para el desarrollo infantil.",
      "founder": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Médico Otorrinolaringólogo y Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv",
        "sameAs": "https://orcid.org/0000-0002-6349-9537"
      },
      "description": pageDescription,
      "memberOf": {
        "@type": "ProgramMembership",
        "programName": "startTIC - Incubadora de Alta Tecnología",
        "hostingOrganization": {
          "@type": "GovernmentOrganization",
          "name": "Consorcio de la Zona Franca de Vigo"
        }
      },
      "funder": {
        "@type": "Organization",
        "name": "Fondo Europeo de Desarrollo Regional (FEDER) - Fundación INCYDE"
      },
      "sponsor": [
        {
          "@type": "Organization",
          "name": "Fundación Centro Tecnológico de Telecomunicación de Galicia (GRADIANT)"
        },
        {
          "@type": "Organization",
          "name": "Cámara Oficial de Comercio, Industria, Servicios y Navegación de Pontevedra, Vigo y Vilagarcía de Arousa"
        }
      ],
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "VIA+",
            "applicationCategory": "MedicalApplication",
            "description": "Software como Dispositivo Médico (SaMD Clase IIa) con 13 módulos de evaluación clínica de audición, voz (validada con Praat), deglución y neurodesarrollo."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "Valeria+",
            "applicationCategory": "HealthApplication",
            "description": "Plataforma de apoyo al lenguaje infantil con formación para familias (Academy) y 9 bloques de ejercicios 100% offline."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Product",
            "name": "Lúa",
            "category": "Pediatric Health Companion & AIoT Hardware",
            "description": "Mascota física en ESP32-C3 y digital en pixel art que ofrece refuerzo lúdico y acompaña en estricto silencio clínico durante las pruebas médicas."
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/earlify#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es Earlify Health y cuál es su misión?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Earlify Health es una empresa de salud digital pediátrica incubada en startTIC (Zona Franca de Vigo / Gradiant / FEDER). Su misión es eliminar la soledad y la incertidumbre que sufren las familias tras un diagnóstico de audición o lenguaje, uniendo la precisión de la consulta médica con la terapia diaria en casa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se integran VIA+, Valeria+ y Lúa en un solo ecosistema?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "VIA+ realiza la evaluación clínica en consulta con 13 módulos objetivos; Valeria+ traslada las pautas al hogar con formación para padres (Academy) y 9 bloques de juego; y Lúa es la mascota física y digital que motiva al niño y respeta el silencio clínico en consulta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué las soluciones de Earlify funcionan 100% offline y con Cero IA en el dispositivo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para garantizar la máxima protección de la privacidad de los menores (Zero-PHI) y cumplir estrictamente con el marco regulatorio europeo (MDR 2017/745 y Reglamento de IA). Los datos quedan en el dispositivo y los cálculos acústicos son transparentes y deterministas."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords="Earlify Health, VIA+ SaMD, Valeria+, Mascota Lúa, startTIC, Incubadora Alta Tecnología, Zona Franca de Vigo, Gradiant, Neurodesarrollo Infantil, Logopedia en Casa, Salud Digital, Dr. Frank Betances"
  jsonLd={earlifyJsonLd}
>
  <Header activeTab="earlify" />

  <main id="main-content">
    <EarlifyHero />
    <ProblemSection />
    <SolutionSection />
    <EarlifyDifferentiators />
    <EarlifyValidation />
    <EarlifyWorkflow />
    <EarlifyB2B />
    <EarlifyBrands />
    <EarlifyFounder />
    <EarlifyCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
