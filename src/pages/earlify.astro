  image="https://FrankBetances.github.io/proyectos/assets/earlify-logo.png"
  keywords="Earlify Health, VIA+ SaMD, Descubre con Lúa, Valeria+, Mascota Lúa, startTIC, Incubadora Alta Tecnología, Zona Franca de Vigo, Gradiant, Neurodesarrollo Infantil, Metrónomo Visual, Logopedia en Casa, Salud Digital, Dr. Frank Betances"
  jsonLd={earlifyJsonLd}
>
  <Header activeTab="earlify" />

  <main id="main-content">
    <EarlifyHero />
    <ProblemSection />
    <EarlifyInteractiveEcosystem />
    <EarlifyWorkflow />
    <EarlifyDifferentiators />
    <EarlifyValidation />
    <EarlifyB2B />
    <EarlifyFounder />
    <EarlifyCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
