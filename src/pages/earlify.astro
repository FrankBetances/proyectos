---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import EarlifyHero from '../components/earlify/EarlifyHero.astro';
import EarlifyBrands from '../components/earlify/EarlifyBrands.astro';
import EarlifyWorkflow from '../components/earlify/EarlifyWorkflow.astro';
import EarlifyB2B from '../components/earlify/EarlifyB2B.astro';
import EarlifyFounder from '../components/earlify/EarlifyFounder.astro';
import ProblemSection from '../components/earlify/ProblemSection.astro';
import SolutionSection from '../components/earlify/SolutionSection.astro';
import EvidenceSection from '../components/earlify/EvidenceSection.astro';
import EarlifyDifferentiators from '../components/earlify/EarlifyDifferentiators.astro';
import EarlifyCTA from '../components/earlify/EarlifyCTA.astro';

const pageTitle = "Earlify Health S.L. · Evaluación clínica estructurada. Continuidad en el hogar.";
const pageDescription = "Earlify Health desarrolla productos digitales para mejorar el recorrido asistencial en neurodesarrollo: VIA+ para el apoyo a la evaluación clínica y Valeria+ para la continuidad de la intervención en el hogar en español e inglés.";

const earlifyJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://FrankBetances.github.io/proyectos/earlify#organization",
      "name": "Earlify Health S.L.",
      "legalName": "Earlify Health S.L.",
      "url": "https://FrankBetances.github.io/proyectos/earlify",
      "slogan": "Evaluación clínica estructurada. Continuidad en el hogar.",
      "founder": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Fundador y CEO",
        "sameAs": "https://orcid.org/0000-0002-6349-9537"
      },
      "description": pageDescription,
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "VIA+",
            "applicationCategory": "HealthApplication",
            "description": "Herramienta de apoyo a la decisión clínica para profesionales sanitarios en audición, lenguaje y neurodesarrollo."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "Valeria+",
            "applicationCategory": "HealthApplication",
            "description": "Aplicación de rehabilitación auditivo-verbal y del lenguaje para niños, acompañados por padres y cuidadores."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords="Earlify Health, VIA+ SaMD, Valeria+, Evaluar mejor Dar continuidad antes, Neurodesarrollo, Salud Digital, Dr. Frank Betances"
  jsonLd={earlifyJsonLd}
>
  <Header activeTab="earlify" />

  <main id="main-content">
    <EarlifyHero />
    <ProblemSection />
    <SolutionSection />
    <EarlifyDifferentiators />
    <EvidenceSection />
    <EarlifyWorkflow />
    <EarlifyB2B />
    <EarlifyBrands />
    <EarlifyFounder />
    <EarlifyCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
