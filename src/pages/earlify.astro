---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import EarlifyHero from '../components/earlify/EarlifyHero.astro';
import EarlifyBrands from '../components/earlify/EarlifyBrands.astro';
import EarlifyWorkflow from '../components/earlify/EarlifyWorkflow.astro';
import EarlifyB2B from '../components/earlify/EarlifyB2B.astro';
import EarlifyFounder from '../components/earlify/EarlifyFounder.astro';
import ProblemSection from '../components/earlify/ProblemSection.astro';
import SolutionSection from '../components/earlify/SolutionSection.astro';
import EarlifyValidation from '../components/earlify/EarlifyValidation.astro';
import EarlifyDifferentiators from '../components/earlify/EarlifyDifferentiators.astro';
import EarlifyCTA from '../components/earlify/EarlifyCTA.astro';

const pageTitle = "Earlify Health · Terapia Digital & Neurodesarrollo Infantil";
const pageDescription = "Earlify Health conecta la consulta médica con el hogar mediante terapia digital y hardware AIoT. Proyecto incubado en startTIC (Zona Franca / Gradiant).";

const earlifyJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://FrankBetances.github.io/proyectos/earlify#organization",
      "name": "Earlify Health S.L.",
      "legalName": "Earlify Health S.L.",
      "url": "https://FrankBetances.github.io/proyectos/earlify",
      "slogan": "Conectando la consulta médica con el hogar mediante terapia digital.",
      "founder": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Fundador y CEO",
        "sameAs": "https://orcid.org/0000-0002-6349-9537"
      },
      "description": pageDescription,
      "memberOf": {
        "@type": "ProgramMembership",
        "programName": "startTIC - Incubadora de Alta Tecnología",
        "hostingOrganization": {
          "@type": "GovernmentOrganization",
          "name": "Consorcio de la Zona Franca de Vigo"
        }
      },
      "funder": {
        "@type": "Organization",
        "name": "Fondo Europeo de Desarrollo Regional (FEDER) - Fundación INCYDE"
      },
      "sponsor": [
        {
          "@type": "Organization",
          "name": "Fundación Centro Tecnológico de Telecomunicación de Galicia (GRADIANT)"
        },
        {
          "@type": "Organization",
          "name": "Cámara Oficial de Comercio, Industria, Servicios y Navegación de Pontevedra, Vigo y Vilagarcía de Arousa"
        }
      ],
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "VIA+",
            "applicationCategory": "HealthApplication",
            "description": "Herramienta de apoyo a la decisión clínica para profesionales sanitarios en audición, lenguaje y neurodesarrollo (SaMD Clase IIa)."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "Valeria+",
            "applicationCategory": "HealthApplication",
            "description": "Aplicación de rehabilitación auditivo-verbal y del lenguaje para niños, acompañados por padres y cuidadores 100% offline."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Product",
            "name": "Lúa (Mascota AIoT)",
            "category": "Medical Device Accessory & Pediatric Neurodevelopment Hardware",
            "description": "Compañera física interactiva ESP32-C3 con pantalla IPS circular 240x240 para espejo visual y asistencia en silencio clínico."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords="Earlify Health, VIA+ SaMD, Valeria+, Mascota Lúa, startTIC, Incubadora Alta Tecnología, Zona Franca de Vigo, Gradiant, Neurodesarrollo, Salud Digital, Dr. Frank Betances"
  jsonLd={earlifyJsonLd}
>
  <Header activeTab="earlify" />

  <main id="main-content">
    <EarlifyHero />
    <ProblemSection />
    <SolutionSection />
    <EarlifyDifferentiators />
    <EarlifyValidation />
    <EarlifyWorkflow />
    <EarlifyB2B />
    <EarlifyBrands />
    <EarlifyFounder />
    <EarlifyCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
