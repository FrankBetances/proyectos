---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import DescubreHero from '../components/descubre-con-lua/DescubreHero.astro';
import DescubreEcosystem from '../components/descubre-con-lua/DescubreEcosystem.astro';
import DescubrePedagogyVoice from '../components/descubre-con-lua/DescubrePedagogyVoice.astro';
import DescubrePrivacyGates from '../components/descubre-con-lua/DescubrePrivacyGates.astro';
import DescubreLicensingFAQ from '../components/descubre-con-lua/DescubreLicensingFAQ.astro';

const pageTitle = "Descubre con Lúa · Edición Escolar | App Educativa 0-3 Años";
const pageDescription = "Aplicación Android educativa 100% sin conexión para escuelas infantiles y familias (0-3 años). Desarrollada por el Dr. Frank Betances en startTIC.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://FrankBetances.github.io/proyectos/descubre-con-lua#software",
      "name": "Descubre con Lúa · Edición Escolar",
      "operatingSystem": "Android 7.0+ (minSdk 24, targetSdk 36)",
      "applicationCategory": "EducationalApplication",
      "description": pageDescription,
      "inLanguage": ["es-ES", "gl-ES"],
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR",
        "category": "Gratis para familias"
      },
      "author": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "ORL Infantil & Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "sponsor": [
        {
          "@type": "Organization",
          "name": "Consorcio de la Zona Franca de Vigo"
        },
        {
          "@type": "Organization",
          "name": "Incubadora de Alta Tecnología startTIC"
        }
      ],
      "featureList": [
        "10 unidades de aula (una por mes de curso escolar)",
        "11 cápsulas formativas (5 de Academy + 6 de formación docente)",
        "1.020 locuciones neuronales grabadas offline (Celtia / Proxecto Nós, Sharvard, LJSpeech)",
        "80 láminas vectoriales dibujadas como datos (50 vocabulario + 30 escenas)",
        "Pulso rítmico visual para menores con audífono o implante coclear",
        "Premios y gamificación ética dirigida exclusivamente a la persona adulta",
        "Cero permisos de red y total protección de la privacidad infantil",
        "El menor de 0 a 3 años no interactúa con la pantalla",
        "Pipeline de calidad estricto con 16 gates automáticos de compilación"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/descubre-con-lua#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué el menor no debe mirar ni tocar la pantalla a esta edad (0-3 años)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las directrices de la OMS y de la Asociación Española de Pediatría desaconsejan la exposición a pantallas en menores de 2 años. La app es un guión instrumental para la persona adulta; el niño interactúa cara a cara con la persona que le habla."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo funciona el inglés en la aplicación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El inglés es contenido que se escucha antes de hablar. El adulto pulsa la pastilla con voz neuronal nativa, escucha la modulación correcta y luego la pronuncia con seguridad delante del menor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre Descubre con Lúa y Valeria+ o VIA+?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Descubre con Lúa tiene finalidad exclusivamente educativa y comunitaria (0-3 años). No es un producto sanitario. Valeria+ es apoyo familiar en casa para el desarrollo del lenguaje y VIA+ es un SaMD Clase IIa de apoyo al diagnóstico médico en consulta."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image="/assets/descubre-con-lua/bienvenida-gl.png"
  keywords="Descubre con Lúa, Escuelas Infantiles, startTIC, Zona Franca de Vigo, Educación Infantil 0-3 años, Estimulación del Lenguaje, Dr. Frank Betances, Aprendizaje sin conexión, Cero pantallas"
  jsonLd={jsonLd}
>
  <Header activeTab="descubre-con-lua" />

  <main id="main-content">
    <DescubreHero />
    <DescubreEcosystem />
    <DescubrePedagogyVoice />
    <DescubrePrivacyGates />
    <DescubreLicensingFAQ />
  </main>

  <Footer />
  <ContactModal />
</Layout>
