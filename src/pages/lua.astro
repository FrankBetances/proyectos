---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import LuaHero from '../components/lua/LuaHero.astro';
import LuaClinicalObjectives from '../components/lua/LuaClinicalObjectives.astro';
import LuaProtocolTable from '../components/lua/LuaProtocolTable.astro';
import LuaExpressionsGallery from '../components/lua/LuaExpressionsGallery.astro';
import LuaEcosystemIntegration from '../components/lua/LuaEcosystemIntegration.astro';
import LuaArchitecture from '../components/lua/LuaArchitecture.astro';
import LuaCTA from '../components/lua/LuaCTA.astro';

const pageTitle = "Lúa · Compañera Física Interactiva, Juego STEAM y Realidad Aumentada";
const pageDescription = "Mascota física con visor circular integrado, sets de bloques manipulativos (EN 71-1) y Realidad Aumentada Zero-PHI para Valeria+, Descubre con Lúa y VIA+. Incubada en startTIC.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://FrankBetances.github.io/proyectos/lua#product",
      "name": "Lúa (Compañera Física Interactiva, Juego STEAM y Realidad Aumentada)",
      "description": pageDescription,
      "brand": {
        "@type": "Organization",
        "name": "Earlify Health S.L."
      },
      "category": "Pediatric Neurodevelopment Companion & STEAM Manipulative System",
      "manufacturer": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "ORL Infantil & Especialista en Salud Digital"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Familias, Escuelas Infantiles (0-6 años) y Consultas de Otorrinolaringología y Logopedia Pediátrica"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "PhysicalFormat",
          "value": "Figura de cuerpo entero sin motores ni piezas móviles con visor circular integrado (240x240 px)"
        },
        {
          "@type": "PropertyValue",
          "name": "ManipulativeSystem",
          "value": "Sets de bloques de gran formato (> 31,75 mm, norma europea EN 71-1) y Realidad Aumentada Zero-PHI"
        },
        {
          "@type": "PropertyValue",
          "name": "VisualCatalogue",
          "value": "25 expresiones faciales, 8 emociones puras, 120 pictogramas voxel y 45 insignias"
        },
        {
          "@type": "PropertyValue",
          "name": "Microphone",
          "value": "None (Cero micrófonos por diseño físico · Privacidad Zero-PHI)"
        },
        {
          "@type": "PropertyValue",
          "name": "IncubatorProgram",
          "value": "startTIC - Incubadora de Alta Tecnología (Zona Franca de Vigo / Gradiant / FEDER)"
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords="Mascota Lúa, Compañera Física Pediátrica, Juguete STEAM Infantil, Bloques Manipulativos EN 71-1, Realidad Aumentada Pediátrica, startTIC, Gradiant, Zona Franca de Vigo, Valeria+, Descubre con Lúa, Lúa Construye, VIA+ SaMD, Silencio Clínico, Zero-PHI, Dr. Frank Betances"
  jsonLd={jsonLd}
>
  <Header activeTab="lua" />

  <main id="main-content">
    <LuaHero />
    <LuaClinicalObjectives />
    <LuaProtocolTable />
    <LuaExpressionsGallery />
    <LuaEcosystemIntegration />
    <LuaArchitecture />
    <LuaCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
