---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import LuaHero from '../components/lua/LuaHero.astro';
import LuaClinicalObjectives from '../components/lua/LuaClinicalObjectives.astro';
import LuaEcosystemIntegration from '../components/lua/LuaEcosystemIntegration.astro';
import LuaArchitecture from '../components/lua/LuaArchitecture.astro';

const pageTitle = "Lúa: Mascota Inteligente para Rehabilitación y Consulta Clínica";
const pageDescription = "Lúa es una mascota robótica AIoT que facilita la rehabilitación del neurodesarrollo en casa (Valeria+) y asiste en silencio durante las pruebas audiológicas en consulta (VIA+).";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Lúa (Mascota AIoT)",
  "description": pageDescription,
  "brand": {
    "@type": "Organization",
    "name": "Earlify Health"
  },
  "category": "Medical Device Accessory",
  "audience": {
    "@type": "Patient",
    "healthCondition": "Trastornos del Neurodesarrollo y Hipoacusia"
  }
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords="Mascota Lúa, Mascota robótica, Rehabilitación en casa, Consulta clínica, Hardware AIoT, Valeria+, VIA+, Refuerzo Conductual pediátrico"
>
  <!-- JSON-LD Schema for rich results -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
  <Header activeTab="lua" />

  <main id="main-content">
    <LuaHero />
    <LuaClinicalObjectives />
    <LuaEcosystemIntegration />
    <LuaArchitecture />
  </main>

  <Footer />
  <ContactModal />
</Layout>
