---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/cv/ContactModal.astro';

import LuaHero from '../components/lua/LuaHero.astro';
import LuaClinicalObjectives from '../components/lua/LuaClinicalObjectives.astro';
import LuaProtocolTable from '../components/lua/LuaProtocolTable.astro';
import LuaExpressionsGallery from '../components/lua/LuaExpressionsGallery.astro';
import LuaEcosystemIntegration from '../components/lua/LuaEcosystemIntegration.astro';
import LuaArchitecture from '../components/lua/LuaArchitecture.astro';
import LuaDecisionsAndStatus from '../components/lua/LuaDecisionsAndStatus.astro';
import LuaCTA from '../components/lua/LuaCTA.astro';

const pageTitle = "Lúa · Mascota Interactiva STEAM de Bloques | Earlify Health";
const pageDescription = "La compañera pedagógica infantil que une el mundo tangible con la interacción digital: el niño construye el cuerpo con bloques pasivos y Lúa reacciona con miradas expresivas en riguroso silencio clínico.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://FrankBetances.github.io/proyectos/lua#product",
      "name": "Lúa · Mascota STEAM de Bloques con Cabeza Electrónica Sellada",
      "description": pageDescription,
      "brand": {
        "@type": "Organization",
        "name": "Earlify Health S.L."
      },
      "category": "Pediatric STEAM Toy & Neurodevelopmental Tangible System",
      "manufacturer": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "ORL Infantil & Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Familias, Escuelas Infantiles (0-6 años), Logopedas y Consultas de Otorrinolaringología Pediátrica"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "ElectronicHead",
          "value": "Cabeza expresiva sellada con pantalla circular de 240x240 px, batería integrada y 4 luces direccionales suaves"
        },
        {
          "@type": "PropertyValue",
          "name": "BlockBody",
          "value": "Cuerpo de bloques pasivos ensamblado por el niño sin cables, tornillos, pegamento ni pilas expuestas"
        },
        {
          "@type": "PropertyValue",
          "name": "STEAMSystem",
          "value": "6 Mundos de juego manipulativo de Construye con Lúa (norma europea EN 71-1 anti-asfixia)"
        },
        {
          "@type": "PropertyValue",
          "name": "HapticBlock",
          "value": "Bloque háptico opcional Ronroneo (≥ 3 años, estimulación táctil suave regulable por el adulto)"
        },
        {
          "@type": "PropertyValue",
          "name": "AcousticDesign",
          "value": "Sin altavoz y sin micrófono por diseño físico estructural (Silencio Clínico físico garantizado · Zero-PHI)"
        },
        {
          "@type": "PropertyValue",
          "name": "IncubatorProgram",
          "value": "startTIC - Incubadora de Alta Tecnología (Zona Franca de Vigo / Gradiant / FEDER 60%)"
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image="/assets/valeria_lua.png"
  keywords="Mascota Lúa, Mascota STEAM de Bloques, Juguete STEAM Infantil, Cabeza Sellada V1 circular, Bloques Manipulativos EN 71-1, Bloque Háptico Ronroneo, Anillo de Luces Direccionales, startTIC, Gradiant, Zona Franca de Vigo, masque3d, Valeria+, Descubre con Lúa, Lúa Construye, VIA+ SaMD, Silencio Clínico, Zero-PHI, Dr. Frank Betances"
  jsonLd={jsonLd}
>
  <Header activeTab="lua" />

  <main id="main-content">
    <LuaHero />
    <LuaClinicalObjectives />
    <LuaProtocolTable />
    <LuaArchitecture />
    <LuaExpressionsGallery />
    <LuaEcosystemIntegration />
    <LuaDecisionsAndStatus />
    <LuaCTA />
  </main>

  <Footer />
  <ContactModal />
</Layout>
