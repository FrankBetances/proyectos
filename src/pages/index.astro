---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatIsValeria from '../components/WhatIsValeria.astro';
import TherapyBlocks from '../components/TherapyBlocks.astro';
import AcademySection from '../components/AcademySection.astro';
import AdultPanel from '../components/AdultPanel.astro';
import LuaMascotSection from '../components/LuaMascotSection.astro';
import LocalesLanguages from '../components/LocalesLanguages.astro';
import Collaborators from '../components/Collaborators.astro';
import ClinicalTelemetry from '../components/ClinicalTelemetry.astro';
import DownloadCta from '../components/DownloadCta.astro';
import ValeriaFaq from '../components/ValeriaFaq.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import Footer from '../components/Footer.astro';

const valeriaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://FrankBetances.github.io/proyectos/#software",
      "name": "Valeria+",
      "softwareVersion": "16.0",
      "applicationCategory": "EducationalApplication",
      "applicationSubCategory": "Speech & Language Family Support",
      "operatingSystem": "Android 8.0+",
      "downloadUrl": "https://play.google.com/store/apps/details?id=eu.futureforkids.valeria",
      "installUrl": "https://play.google.com/store/apps/details?id=eu.futureforkids.valeria",
      "description": "Aplicación educativa para acompañar el lenguaje infantil en casa. Abre en Academy con guías de 2 minutos para la familia y ofrece 10 bloques de juego con la gata Lúa, rutinas secuenciales de 4 pasos, más de 160 pictogramas en píxel art y 4.711 locuciones 100% offline sin servidor.",
      "author": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Otorrinolaringólogo y Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "provider": {
        "@type": "Organization",
        "name": "Earlify Health S.L.",
        "url": "https://FrankBetances.github.io/proyectos/earlify",
        "memberOf": {
          "@type": "ProgramMembership",
          "programName": "startTIC - Incubadora de Alta Tecnología",
          "hostingOrganization": {
            "@type": "GovernmentOrganization",
            "name": "Consorcio de la Zona Franca de Vigo"
          }
        }
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Formación familiar en Academy: cápsulas de 2 minutos, La Brújula ASHA (0-5 años) y 27 signos LSE validados por ACOPROS",
        "Integración Sensorial Auditiva con 11 estímulos cotidianos y ambientales, pre-escucha para el adulto y pausa que suma puntos",
        "Aventuras con Lúa: 105 actividades en 6 franjas de edad con canciones habladas a pulso y metrónomo visual en castellano y galego",
        "Pares Mínimos en 6 variedades con comparación de ambas palabras del par, misión física y sello Manos juntas",
        "Expansión Semántica y Rutinas diarias en 4 pasos para ordenar y nombrar en doble vuelta con más de 160 pictogramas en píxel art",
        "Audición (18 ejercicios) según protocolo ACOPROS con escucha en ruido babble graduable",
        "Lenguaje (7 ejercicios) con 5 variantes de atención conjunta y aviso previo de materiales cotidianos",
        "TEA (6 ejercicios) con sello Punto de mirada y retos regulados a mano por el adulto",
        "Dislexia (6 ejercicios) con intruso fonológico numerado, criba de pseudopalabras y mapa de rotaciones b/d y p/q",
        "La Pizarra Mágica de Lúa con 18 trazos guiados, 6 contrastes de letras confundibles y voz neuronal en 5 idiomas",
        "Realidad Aumentada 3D como sensor de movimiento orofacial y espacial sin grabar imágenes ni sonido",
        "Comprobación previa de los 6 sonidos de Ling para audífonos e implantes cocleares",
        "Mascota Lúa acariciable en píxel art con 12 niveles, 18 insignias, descanso visual 20-20-20 y conexión con dispositivo físico Lúa",
        "6 variedades lingüísticas: Castellano, Galego, Dominicano, Euskara, US English y Català (4.711 locuciones offline)",
        "Funcionamiento 100% offline, sin cuentas ni servidor, bajo control exclusivo del adulto"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es Valeria+ y cómo apoya a las familias en casa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Valeria+ es una aplicación educativa de apoyo al lenguaje infantil pensada para madres, padres y cuidadores entre sesión y sesión con el logopeda. Abre directamente en Academy con cápsulas de 2 minutos y ofrece 10 bloques de juego guiados por la gata Lúa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué funciona 100% offline y sin servidor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para proteger de forma estricta la privacidad infantil. Valeria+ no pide cuentas de usuario ni se conecta a servidores externos: las 4.711 locuciones y el reconocimiento operan dentro del móvil o tablet sin guardar ni enviar grabaciones."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es un dispositivo médico o sustituye al logopeda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Valeria+ es una aplicación educativa y de apoyo familiar, no un dispositivo médico ni sustituye al especialista en audición y lenguaje. La aplicación orienta en casa, pero quien acompaña y valida cada paso con un toque es siempre el adulto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluyen los 10 bloques de ejercicios?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Abarcan Integración Sensorial Auditiva (con pre-escucha para el adulto), Aventuras con Lúa (105 actividades), Pares Mínimos, Expansión Semántica y Rutinas de 4 pasos, Audición (protocolo ACOPROS), Lenguaje temprano, TEA, Dislexia, La Pizarra Mágica (18 trazos) y Realidad Aumentada 3D, además de la comprobación previa de los 6 sonidos de Ling."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué idiomas y variedades lingüísticas está disponible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dispone de 6 variedades de voz con 4.711 locuciones neuronales offline: Castellano, Galego (Proxecto Nós / ACOPROS), Dominicano (Quisqueya Habla), Euskara (HiTZ), US English (validado en Howard University) y Català (Projecte AINA), con interfaz disponible en 4 idiomas (Castellano, Galego, Català e Inglés)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Valeria+ · Apoyo al Lenguaje y Audición Infantil en Casa"
	description="Aplicación educativa para acompañar el habla e hipoacusia en familia. Cápsulas Academy de 2 minutos, 10 bloques de juego con Lúa, rutinas y privacidad 100% offline sin servidor."
	image="https://FrankBetances.github.io/proyectos/assets/valeria-lua-hero-bg.jpg"
	keywords="Valeria+, apoyo al lenguaje en casa, logopedia infantil, hipoacusia, implante coclear, dislalia, dislexia infantil, TEA autismo, integracion sensorial auditiva, Lua mascota, Dr. Frank Betances, Earlify Health, startTIC"
	jsonLd={valeriaJsonLd}
>
	<Header activeTab="home" />
	<main id="main-content">
		<Hero />
		<WhatIsValeria />
		<TherapyBlocks />
		<AcademySection />
		<AdultPanel />
		<LuaMascotSection />
		<LocalesLanguages />
		<Collaborators />
		<ClinicalTelemetry />
		<DownloadCta />
		<ValeriaFaq />
	</main>
	<Footer />
	<ContactModal />
</Layout>
