---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatIsValeria from '../components/WhatIsValeria.astro';
import TherapyBlocks from '../components/TherapyBlocks.astro';
import AcademySection from '../components/AcademySection.astro';
import AdultPanel from '../components/AdultPanel.astro';
import LuaMascotSection from '../components/LuaMascotSection.astro';
import LocalesLanguages from '../components/LocalesLanguages.astro';
import Collaborators from '../components/Collaborators.astro';
import ClinicalTelemetry from '../components/ClinicalTelemetry.astro';
import Footer from '../components/Footer.astro';

const valeriaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://FrankBetances.github.io/proyectos/#software",
      "name": "Valeria+",
      "softwareVersion": "14.2",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Android, iOS",
      "description": "Plataforma móvil de formación para familias y ejercicios de lenguaje para niñas y niños con hipoacusia, implante coclear, dislalias, TEA, dislexia o dificultades del habla. 9 bloques de ejercicios, Realidad Aumentada 3D, mascota Lúa, 6 variedades de voz neuronal y funcionamiento 100% offline.",
      "author": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Otorrinolaringólogo y Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "provider": {
        "@type": "Organization",
        "name": "Earlify Health S.L.",
        "url": "https://FrankBetances.github.io/proyectos/earlify",
        "memberOf": {
          "@type": "ProgramMembership",
          "programName": "startTIC - Incubadora de Alta Tecnología",
          "hostingOrganization": {
            "@type": "GovernmentOrganization",
            "name": "Consorcio de la Zona Franca de Vigo"
          }
        }
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Formación para familias con Academy: cápsulas de 2 minutos (incluye La Brújula de las Palabras con hitos ASHA 0-5 años)",
        "Integración Sensorial Auditiva (SOR) con 11 sonidos sintetizados propios y control adulto",
        "Pares Mínimos D7 (vecino más cercano O2 con 35/35 contrastes detectados)",
        "Expansión Semántica con 66 pictogramas propios en píxel art y doble vuelta (comprensión + producción)",
        "Audición (18 ejercicios) según protocolo ACOPROS con escucha en ruido",
        "Lenguaje (7 ejercicios) para estimulación temprana e interacción en el hogar",
        "TEA (6 ejercicios) con estresores 100% manuales",
        "Dislexia (6 ejercicios) con conciencia fonológica y mapa de rotaciones",
        "Grafomotricidad y Escritura (La Pizarra Mágica de Lúa con pauta Montessori y puntos numerados)",
        "Realidad Aumentada 3D con ARCore + MediaPipe (sensor de conducta motora sin micrófono)",
        "Test de Ling previo de 6 sonidos para audífonos e implantes",
        "Mascota Lúa en píxel art con 12 niveles, 18 insignias, armario de complementos y regla 20-20-20",
        "6 variedades idiomáticas: Castellano (Sharvard), Galego (Celtia), Dominicano (es-DO), Euskara (HiTZ-TTS), US English (LJSpeech) y Català (Matxa-TTS)",
        "4.110 locuciones neuronales empaquetadas offline",
        "Funcionamiento 100% offline, privacidad Zero-PHI y control del adulto (MDR)"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es Valeria+ y cómo ayuda a mi hijo/a?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Valeria+ es una plataforma de apoyo para el desarrollo del lenguaje infantil. Primero capacita a madres, padres y cuidadores en cápsulas de 2 minutos (Academy) para entender cada trastorno, y luego ofrece 9 bloques de ejercicios prácticos para jugar en casa junto a la gata Lúa, reforzando la terapia logopédica."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué funciona 100% offline y sin conexión a internet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para proteger al máximo la privacidad de los menores (Zero-PHI) y garantizar que las familias puedan practicar en cualquier lugar. Todos los audios, voces neuronales y datos de progreso quedan cifrados dentro del propio dispositivo, sin enviar grabaciones a servidores externos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué significa que el adulto es el juez clínico (Principio MDR)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Significa que la aplicación nunca toma decisiones automáticas ni diagnostica por su cuenta. El reconocimiento de voz asiste, pero el padre, madre o logopeda siempre tiene la última palabra para validar o corregir el resultado de cada ejercicio con un toque."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué dificultades o trastornos del lenguaje cubre Valeria+?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cubre hipoacusia e implante coclear (audición y Test de Ling), sobre-responsividad auditiva (integración sensorial), dislalias y pronunciación (pares mínimos), retraso del lenguaje (expansión semántica), autismo (TEA), dificultades de lectura y escritura (dislexia y grafomotricidad) y motricidad orofacial (realidad aumentada)."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué idiomas y variedades lingüísticas está disponible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dispone de 6 variedades con voces neuronales propias: Castellano, Galego (Proxecto Nós), Dominicano (Quisqueya Habla), Euskara (HiTZ), US English e Català (projecte AINA), con más de 4.110 locuciones grabadas y adaptadas a la realidad de cada lengua."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Valeria+ · Rehabilitación del Lenguaje Guiada en Casa (100% Offline)"
	description="App de apoyo al lenguaje infantil para familias y logopedas. 9 bloques de ejercicios, formación Academy, mascota Lúa y Realidad Aumentada. 100% offline."
	keywords="Valeria+, terapia del lenguaje en casa, logopedia infantil, hipoacusia, implante coclear, dislalia, dislexia infantil, TEA autismo, integración sensorial auditiva, Lúa mascota, Dr. Frank Betances, Earlify Health, startTIC"
	jsonLd={valeriaJsonLd}
>
	<Header activeTab="home" />
	<main id="main-content">
		<Hero />
		<WhatIsValeria />
		<TherapyBlocks />
		<AcademySection />
		<AdultPanel />
		<LuaMascotSection />
		<LocalesLanguages />
		<Collaborators />
		<ClinicalTelemetry />
	</main>
	<Footer />
</Layout>
