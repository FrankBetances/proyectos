---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatIsValeria from '../components/WhatIsValeria.astro';
import TherapyBlocks from '../components/TherapyBlocks.astro';
import AcademySection from '../components/AcademySection.astro';
import AdultPanel from '../components/AdultPanel.astro';
import LuaMascotSection from '../components/LuaMascotSection.astro';
import LocalesLanguages from '../components/LocalesLanguages.astro';
import Collaborators from '../components/Collaborators.astro';
import ClinicalTelemetry from '../components/ClinicalTelemetry.astro';
import DownloadCta from '../components/DownloadCta.astro';
import ValeriaFaq from '../components/ValeriaFaq.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import Footer from '../components/Footer.astro';

const valeriaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://FrankBetances.github.io/proyectos/#software",
      "name": "Valeria+",
      "softwareVersion": "14.2",
      "applicationCategory": "HealthApplication",
      "applicationSubCategory": "Speech Therapy",
      "operatingSystem": "Android 8.0+",
      "downloadUrl": "https://play.google.com/store/apps/details?id=health.earlify.valeria",
      "installUrl": "https://play.google.com/store/apps/details?id=health.earlify.valeria",
      "description": "Plataforma de apoyo al lenguaje infantil en casa. 10 bloques clínicos de ejercicios, formación Academy en 2 minutos, mascota Lúa en píxel art, 4.711 locuciones offline y privacidad Zero-PHI bajo control del adulto (marco MDR).",
      "author": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Otorrinolaringólogo y Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "provider": {
        "@type": "Organization",
        "name": "Earlify Health S.L.",
        "url": "https://FrankBetances.github.io/proyectos/earlify",
        "memberOf": {
          "@type": "ProgramMembership",
          "programName": "startTIC - Incubadora de Alta Tecnología",
          "hostingOrganization": {
            "@type": "GovernmentOrganization",
            "name": "Consorcio de la Zona Franca de Vigo"
          }
        }
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Formación parental con Academy: micro-cápsulas de 2 minutos y La Brújula ASHA (hitos 0-5 años)",
        "Integración Sensorial Auditiva (SOR) con 11 sonidos sintetizados propios y control adulto",
        "Aventuras con Lúa: 105 actividades en 6 franjas de edad con canciones habladas a pulso",
        "Pares Mínimos D7 (algoritmo O2 con 35/35 contrastes detectados sin falsos positivos)",
        "Expansión Semántica con 66 pictogramas propios en píxel art y práctica en doble vuelta",
        "Audición (18 ejercicios) según protocolo ACOPROS con escucha en ruido babble graduable",
        "Lenguaje (7 ejercicios) para estimulación temprana e interacción en el hogar",
        "TEA (6 ejercicios) con estresores 100% manuales y atención conjunta triangulada",
        "Dislexia (6 ejercicios) con criba de pseudopalabras y mapa de rotaciones b/d y p/q",
        "Grafomotricidad y Escritura (La Pizarra Mágica de Lúa con 18 trazos y puntos numerados)",
        "Realidad Aumentada 3D con ARCore + MediaPipe (sensor de conducta motora sin micrófono)",
        "Test de Ling previo de 6 sonidos para audífonos e implantes cocleares",
        "Mascota Lúa en píxel art con 12 niveles, 18 insignias, descanso visual 20-20-20 y réplica BLE",
        "6 variedades idiomáticas: Castellano, Galego, Dominicano, Euskara, US English y Català",
        "4.711 locuciones neuronales empaquetadas offline",
        "Funcionamiento 100% offline, privacidad Zero-PHI y control del adulto (marco MDR)"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es Valeria+ y cómo ayuda en el hogar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Valeria+ es una plataforma de apoyo al lenguaje infantil en casa. Primero capacita a madres, padres y cuidadores en cápsulas de 2 minutos (Academy) y luego ofrece 10 bloques prácticos de ejercicios guiados por la gata Lúa, reforzando la terapia logopédica."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué funciona 100% offline y sin conexión a internet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para garantizar la privacidad absoluta de los menores (Zero-PHI) y posibilitar la práctica en cualquier lugar. Todos los modelos y las 4.711 locuciones neuronales operan dentro del dispositivo sin guardar grabaciones ni enviar datos a la nube."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué significa que el adulto es el juez clínico (Marco MDR)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Significa que la aplicación nunca toma decisiones automáticas ni diagnostica por su cuenta (MDR SaMD Clase I). El reconocimiento de voz asiste en local, pero el adulto siempre tiene la última palabra para validar o matizar cada respuesta con un toque."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuáles son los 10 bloques clínicos de ejercicios de Valeria+?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los 10 bloques cubren: Integración Sensorial (SOR), Aventuras con Lúa, Pares Mínimos D7, Expansión Semántica, Audición (ACOPROS), Lenguaje temprano, TEA, Dislexia, Grafomotricidad (La Pizarra Mágica) y Realidad Aumentada 3D; además de la comprobación previa del Test de Ling."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué idiomas y variedades lingüísticas está disponible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dispone de 6 variedades de voz con 4.711 locuciones neuronales offline: Castellano, Galego (Proxecto Nós), Dominicano (Quisqueya Habla), Euskara (HiTZ), US English y Català (Projecte AINA), con interfaz disponible en 4 idiomas (Castellano, Galego, Català e Inglés)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Valeria+ · Terapia del Lenguaje en Casa 100% Offline"
	description="App clínica de terapia del lenguaje infantil en casa. 10 bloques prácticos, formación Academy, gata Lúa y 4.711 locuciones offline con control adulto."
	image="https://FrankBetances.github.io/proyectos/assets/valeria-lua-hero-bg.jpg"
	keywords="Valeria+, terapia del lenguaje en casa, logopedia infantil, hipoacusia, implante coclear, dislalia, dislexia infantil, TEA autismo, integracion sensorial auditiva, Lua mascota, Dr. Frank Betances, Earlify Health, startTIC, MDR SaMD"
	jsonLd={valeriaJsonLd}
>
	<Header activeTab="home" />
	<main id="main-content">
		<Hero />
		<WhatIsValeria />
		<TherapyBlocks />
		<AcademySection />
		<AdultPanel />
		<LuaMascotSection />
		<LocalesLanguages />
		<Collaborators />
		<ClinicalTelemetry />
		<DownloadCta />
		<ValeriaFaq />
	</main>
	<Footer />
	<ContactModal />
</Layout>
