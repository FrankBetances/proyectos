---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatIsValeria from '../components/WhatIsValeria.astro';
import ValeriaSTEAMAndAR from '../components/ValeriaSTEAMAndAR.astro';
import TherapyBlocks from '../components/TherapyBlocks.astro';
import AcademySection from '../components/AcademySection.astro';
import AdultPanel from '../components/AdultPanel.astro';
import LuaMascotSection from '../components/LuaMascotSection.astro';
import LocalesLanguages from '../components/LocalesLanguages.astro';
import Collaborators from '../components/Collaborators.astro';
import ClinicalTelemetry from '../components/ClinicalTelemetry.astro';
import DownloadCta from '../components/DownloadCta.astro';
import ValeriaFaq from '../components/ValeriaFaq.astro';
import ContactModal from '../components/cv/ContactModal.astro';
import Footer from '../components/Footer.astro';

const valeriaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://FrankBetances.github.io/proyectos/#software",
      "name": "Valeria+",
      "softwareVersion": "17.0",
      "applicationCategory": "EducationalApplication",
      "applicationSubCategory": "Speech & Language Family Support",
      "operatingSystem": "Android 8.0+",
      "downloadUrl": "https://play.google.com/store/apps/details?id=eu.futureforkids.valeria",
      "installUrl": "https://play.google.com/store/apps/details?id=eu.futureforkids.valeria",
      "description": "Aplicación educativa de formación para madres, padres y cuidadores sobre el desarrollo del lenguaje y la comunicación en la infancia, con juegos y ejercicios para practicar en casa. Desde octubre de 2026 la práctica se ordena alrededor de STEAM: el niño provoca un fenómeno con las manos en los mundos de Construye con Lúa, y el lenguaje lo nombra. Pensada también para familias de niñas y niños con hipoacusia, implante coclear, dislalias, dislexia o TEA. Offline y en el bolsillo.",
      "author": {
        "@type": "Person",
        "name": "Dr. Frank Alberto Betances Reinoso",
        "jobTitle": "Otorrinolaringólogo y Especialista en Salud Digital",
        "url": "https://FrankBetances.github.io/proyectos/cv"
      },
      "provider": {
        "@type": "Organization",
        "name": "Earlify Health S.L.",
        "url": "https://FrankBetances.github.io/proyectos/earlify",
        "memberOf": {
          "@type": "ProgramMembership",
          "programName": "startTIC - Incubadora de Alta Tecnología",
          "hostingOrganization": {
            "@type": "GovernmentOrganization",
            "name": "Consorcio de la Zona Franca de Vigo"
          }
        }
      },
      "award": "Mejor Iniciativa Innovadora en Maker Faire Galicia 2026",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Eje vertebrador STEAM: el fenómeno físico manda y el lenguaje lo nombra (basado en BrickSmart CHI 2025)",
        "6 Mundos de Construye con Lúa adaptados a la práctica del hogar (norma europea EN 71-1, piezas > 31,75 mm)",
        "Contrato de interacción de Realidad Aumentada de 5 eslabones con sensor ciego local (Google Filament, mallas < 100 KB)",
        "Cuentos pedagógicos dialógicos de 3-4 láminas con sugerencias de recast y expansión para el adulto",
        "Perfiles de adaptación configurables con PIN profesional (Hipoacusia e implantes, TEA, Dislexia, Dislalias)",
        "Formación familiar en Academy: cápsulas de 2 minutos, La Brújula ASHA (0-5 años) y 27 signos LSE validados por ACOPROS",
        "Integración Sensorial Auditiva con 11 estímulos cotidianos y ambientales, pre-escucha para el adulto y pausa que suma puntos",
        "Aventuras con Lúa: 105 actividades en 6 franjas de edad con canciones habladas a pulso y metrónomo visual en castellano y galego",
        "Pares Mínimos en 6 variedades con comparación de ambas palabras del par, misión física y sello Manos juntas",
        "Expansión Semántica y Rutinas diarias en 4 pasos para ordenar y nombrar en doble vuelta con más de 160 pictogramas en píxel art",
        "Audición (18 ejercicios) según protocolo ACOPROS con escucha en ruido babble graduable",
        "Lenguaje (7 ejercicios) con 5 variantes de atención conjunta y aviso previo de materiales cotidianos",
        "TEA (6 ejercicios) con sello Punto de mirada y retos regulados a mano por el adulto",
        "Dislexia (6 ejercicios) con intruso fonológico numerado, criba de pseudopalabras y mapa de rotaciones b/d y p/q",
        "La Pizarra Mágica de Lúa con 18 trazos guiados, 6 contrastes de letras confundibles y voz neuronal en 5 idiomas",
        "Mascota Lúa en píxel art con 12 niveles, 18 insignias, descanso visual 20-20-20 y enlace BLE con la cabeza oficial circular V1",
        "6 variedades lingüísticas: Castellano, Galego, Dominicano, Euskara, US English y Català (4.711 locuciones offline)",
        "Funcionamiento 100% offline, sin cuentas, sin servidor ni backend, bajo control exclusivo del adulto"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://FrankBetances.github.io/proyectos/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es Valeria+ y cómo apoya a las familias en casa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Valeria+ es una aplicación educativa de apoyo al lenguaje infantil pensada para madres, padres y cuidadores entre sesión y sesión con el logopeda. Abre directamente en Academy con cápsulas de 2 minutos y ofrece 10 bloques de juego guiados por la gata Lúa y los mundos STEAM."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué funciona 100% offline y sin backend?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para proteger de forma estricta la privacidad infantil bajo el principio Zero-PHI. Valeria+ no pide cuentas de usuario ni se conecta a servidores externos: las 4.711 locuciones y la Realidad Aumentada operan localmente dentro del dispositivo sin guardar ni enviar datos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es un dispositivo médico o sustituye al logopeda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Valeria+ es una aplicación educativa y de apoyo familiar, no un dispositivo médico ni sustituye al especialista en audición y lenguaje. La aplicación orienta en casa, pero quien acompaña y valida cada paso con un toque es siempre el adulto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué desde octubre de 2026 la práctica se ordena alrededor de STEAM y los bloques?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Porque en el desarrollo infantil el orden importa: el fenómeno manda y el lenguaje lo nombra. Al provocar un fenómeno físico tangible con las manos (una esfera que baja por una rampa, un resonador acústico o el equilibrio de una balanza en Construye con Lúa), la app sugiere al adulto palabras espaciales y de proceso adecuadas, fundamentado en investigaciones como BrickSmart (CHI 2025)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo funciona el contrato de interacción de Realidad Aumentada sin comprometer la privacidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La tableta opera como un sensor ciego local (ARCore + MediaPipe + Google Filament, mallas < 100 KB) procesando únicamente magnitudes físicas en memoria volátil. Ningún evento depende exclusivamente de la cámara (el adulto siempre puede validarlo con un toque) y jamás se graban, guardan ni transmiten vídeos o audios fuera del dispositivo."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Valeria+ · Entiende su lenguaje, practica en casa. Lúa os acompaña"
	description="Aplicación educativa sobre el desarrollo del lenguaje en la infancia. Práctica guiada con STEAM y los mundos de Construye con Lúa, cápsulas Academy de 2 min y privacidad 100% offline sin backend."
	image="https://FrankBetances.github.io/proyectos/assets/valeria-lua-hero-bg.jpg"
	keywords="Valeria+, apoyo al lenguaje en casa, STEAM infantil, Construye con Lúa, logopedia infantil, hipoacusia, implante coclear, dislalia, dislexia infantil, TEA autismo, integracion sensorial auditiva, Lua mascota, Maker Faire Galicia 2026, Dr. Frank Betances, Earlify Health, startTIC"
	jsonLd={valeriaJsonLd}
>
	<Header activeTab="home" />
	<main id="main-content">
		<Hero />
		<WhatIsValeria />
		<ValeriaSTEAMAndAR />
		<TherapyBlocks />
		<AcademySection />
		<AdultPanel />
		<LuaMascotSection />
		<LocalesLanguages />
		<Collaborators />
		<ClinicalTelemetry />
		<DownloadCta />
		<ValeriaFaq />
	</main>
	<Footer />
	<ContactModal />
</Layout>
