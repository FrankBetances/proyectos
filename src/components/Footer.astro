---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer print-hide">
  <div class="container footer-content">
    <div class="footer-brand">
      <a href={`${baseUrl}/`} class="footer-logo">
        <img src={`${baseUrl}/assets/dr-betances-logo.jpg`} alt="Logo Dr. Frank Betances" class="footer-logo-img" />
        <span class="logo-name">Dr. Frank Betances</span>
      </a>
      <p class="footer-desc">
        Otorrinolaringólogo y Cirujano de Cabeza y Cuello. Especialista en Audiología Infantil, Docencia e Investigación en Salud Digital y Rehabilitación del Lenguaje. Co-PI en el Proyecto FONDOCYT <strong>Quisqueya Habla</strong>.
      </p>
      <div class="footer-badges">
        <span class="badge badge-cyan">Hospital Ribera Polusa</span>
        <span class="badge badge-purple">UFHEC / MESCYT</span>
        <span class="badge badge-emerald">Earlify Health S.L.</span>
      </div>
    </div>

    <div class="footer-column">
      <h4>Navegación</h4>
      <ul>
        <li><a href={`${baseUrl}/quisqueya-habla`}>Proyecto Quisqueya Habla</a></li>
        <li><a href={`${baseUrl}/earlify`}>Earlify Health S.L.</a></li>
        <li><a href={`${baseUrl}/via`}>Dispositivo Médico VIA+ (SaMD)</a></li>
        <li><a href={`${baseUrl}/`}>Plataforma Valeria+</a></li>
        <li><a href={`${baseUrl}/cv`}>Currículum Vítae (CV)</a></li>
        <li><a href={`${baseUrl}/cv#seccion-proyectos`}>Proyectos & FONDOCYT</a></li>
        <li><a href={`${baseUrl}/cv#seccion-publicaciones`}>Publicaciones Científicas</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h4>Perfiles Académicos</h4>
      <ul>
        <li><a href="https://www.researchgate.net/profile/Frank-Reinoso" target="_blank" rel="noopener noreferrer">ResearchGate</a></li>
        <li><a href="https://orcid.org/0000-0002-6349-9537" target="_blank" rel="noopener noreferrer">ORCID (0000-0002-6349-9537)</a></li>
        <li><a href="https://github.com/FrankBetances" target="_blank" rel="noopener noreferrer">GitHub Repositories</a></li>
        <li><button id="open-contact-modal-footer" class="footer-contact-btn">Contacto Profesional</button></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-content">
      <p>&copy; {currentYear} Dr. Frank Alberto Betances Reinoso · Quisqueya Habla (UFHEC / MESCYT). Todos los derechos reservados.</p>
      <p class="privacy-note">🔒 Perfil profesional sin exposición de datos personales privados (LOPDGDD / GDPR compliant).</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #030508;
    border-top: 1px solid var(--border-light);
    padding-top: 4rem;
    margin-top: 4rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo .footer-logo-img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-logo .logo-name {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 480px;
  }

  .footer-badges {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footer-column h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .footer-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-column a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    color: var(--accent-cyan);
  }

  .footer-contact-btn {
    background: none;
    border: none;
    color: var(--accent-cyan);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    text-align: left;
  }

  .footer-contact-btn:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.5rem 0;
    background: rgba(0, 0, 0, 0.4);
  }

  .bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-dim);
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .privacy-note {
    color: var(--accent-emerald);
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .bottom-content {
      flex-direction: column;
      text-align: center;
    }
  }

  @media print {
    .site-footer {
      display: none !important;
    }
  }
</style>
