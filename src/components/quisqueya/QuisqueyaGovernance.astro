---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section id="gobernanza" class="quisqueya-gov section-padding">
  <div class="container">
    <div class="section-header">
      <div class="gov-header-brand">
        <img 
          src={`${baseUrl}/assets/quisqueya-logo-clean.png?v=2`} 
          alt="Isotipo Quisqueya Habla" 
          class="gov-brand-icon" 
          width="40" 
          height="64" 
          loading="lazy" 
          decoding="async" 
        />
        <span class="section-badge">Gobernanza Institucional & Marco Ético</span>
      </div>
      <h2 class="section-title">
        Equipo Investigador & <span class="gradient-text">Alianzas UFHEC</span>
      </h2>
      <p class="section-description">
        Investigación pública subvencionada por FONDOCYT (MESCYT) bajo la supervisión ética del Comité Nacional de Bioética en Salud (CONABIOS) de la República Dominicana.
      </p>
    </div>

    <div class="team-grid">
      <!-- IP -->
      <div class="team-card glass-card">
        <div class="role-badge badge-amber">INVESTIGADORA PRINCIPAL (IP)</div>
        <h3 class="member-name">Dra. Luz Verys Ramón Javier</h3>
        <p class="member-affiliation">Universidad Federico Henríquez y Carvajal (UFHEC)</p>
        <p class="member-desc">
          Dirección ejecutiva, coordinación institucional con MESCYT/FONDOCYT y firma de supervisión científica del proyecto.
        </p>
      </div>

      <!-- Co-PI -->
      <div class="team-card glass-card">
        <div class="role-badge badge-cyan">CO-INVESTIGADOR PRINCIPAL (Co-PI)</div>
        <h3 class="member-name">Dr. Frank Betances Reinoso</h3>
        <p class="member-affiliation">Otorrinolaringólogo · Salud Digital · Doctorando USC</p>
        <p class="member-desc">
          Liderazgo de salud digital, arquitectura de evaluación (VIA+) y rehabilitación domiciliaria offline (Valeria+).
        </p>
      </div>

      <!-- Psicología / Familia -->
      <div class="team-card glass-card">
        <div class="role-badge badge-purple">PSICOLOGÍA & FAMILIA</div>
        <h3 class="member-name">Mtra. Carmen Valdez Luciano</h3>
        <p class="member-affiliation">Investigadora Adjunta (UFHEC)</p>
        <p class="member-desc">
          Adaptación de cuestionarios, guías psicoeducativas para cuidadores y validación de contenidos de M-CHAT-R/F-RD.
        </p>
      </div>

      <!-- Estadística / Diseño -->
      <div class="team-card glass-card">
        <div class="role-badge badge-emerald">ESTADÍSTICA & DISEÑO</div>
        <h3 class="member-name">John Henry Antonio</h3>
        <p class="member-affiliation">Investigador Metodológico (UFHEC)</p>
        <p class="member-desc">
          Diseño experimental del ensayo clínico piloto, muestreo, análisis psicométrico (S-CVI) y soporte de datos.
        </p>
      </div>

      <!-- Encuestas & Aceptabilidad -->
      <div class="team-card glass-card">
        <div class="role-badge badge-blue">ENCUESTAS & ACEPTABILIDAD</div>
        <h3 class="member-name">John Morales</h3>
        <p class="member-affiliation">Investigador de Campo (UFHEC)</p>
        <p class="member-desc">
          Administración de encuestas de aceptabilidad técnica/clínica (QuestionPro) a familias y profesionales.
        </p>
      </div>

      <!-- Gestión Presupuestaria -->
      <div class="team-card glass-card">
        <div class="role-badge badge-amber">GESTIÓN & COMPRAS FONDOCYT</div>
        <h3 class="member-name">Adalgisa Adams</h3>
        <p class="member-affiliation">Gestión Administrativa y Financiera (UFHEC)</p>
        <p class="member-desc">
          Supervisión presupuestaria, cotizaciones de licencias/servicios técnicos de terceros y auditoría de MESCYT.
        </p>
      </div>
    </div>

    <!-- Governance Details Grid -->
    <div class="gov-details-grid margin-top-lg">
      <div class="gov-detail-card glass-card">
        <div class="card-icon">📜</div>
        <h4>Convenio Marco UFHEC</h4>
        <p>
          Convenio de subvención para la ejecución del proyecto **FONDOCYT 2024-3-4A2-0922**. La UFHEC actúa como institución gestora y garante académica ante el MESCYT.
        </p>
      </div>

      <div class="gov-detail-card glass-card">
        <div class="card-icon">🔒</div>
        <h4>Comité de Bioética CONABIOS</h4>
        <p>
          Protocolo clínico revisado y autorizado por el **Comité Nacional de Bioética en Salud (CONABIOS)** para la protección de datos pediátricos y consentimiento informado.
        </p>
      </div>

      <div class="gov-detail-card glass-card">
        <div class="card-icon">🏛️</div>
        <h4>Centros Piloto Participantes</h4>
        <p>
          Despliegue de ensayos de campo en el **CIADIF** (Centro de Desarrollo Pediátrico) y la **Escuela de Educación Especial Padre Cavalotto** (San Pedro de Macorís).
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .quisqueya-gov {
    background: rgba(255, 255, 255, 0.015);
    border-top: 1px solid var(--border-glow);
    border-bottom: 1px solid var(--border-glow);
  }

  .gov-header-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .gov-brand-icon {
    height: 48px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(0, 242, 254, 0.4));
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .team-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .role-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
  }

  .member-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text-main);
  }

  .member-affiliation {
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .member-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-top: auto;
  }

  .margin-top-lg {
    margin-top: 3rem;
  }

  .gov-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .gov-detail-card {
    padding: 1.5rem;
  }

  .gov-detail-card .card-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .gov-detail-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .gov-detail-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
