---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section id="gobernanza" class="quisqueya-gov section-padding">
  <div class="container">
    <div class="section-header">
      <div class="gov-header-brand">
        <img 
          src={`${baseUrl}/assets/quisqueya-logo-clean.png`} 
          alt="Isotipo Quisqueya Habla" 
          class="gov-brand-icon" 
          width="40" 
          height="64" 
          loading="lazy" 
          decoding="async" 
        />
        <span class="section-badge">Gobernanza Institucional & Marco Ético</span>
      </div>
      <h2 class="section-title">
        Equipo Investigador & <span class="gradient-text">Alianzas UFHEC</span>
      </h2>
      <p class="section-description">
        Investigación pública subvencionada por FONDOCYT (MESCYT) bajo la supervisión ética del Comité Nacional de Bioética en Salud (CONABIOS) de la República Dominicana.
      </p>
    </div>

    <div class="team-grid">
      <!-- IP -->
      <div class="team-card glass-card">
        <div class="role-badge badge-amber">INVESTIGADORA PRINCIPAL (IP)</div>
        <h3 class="member-name">Dra. Luz Verys Ramón Javier</h3>
        <p class="member-affiliation">Universidad Federico Henríquez y Carvajal (UFHEC)</p>
        <p class="member-desc">
          Dirección ejecutiva, coordinación institucional con MESCYT/FONDOCYT y firma de supervisión científica del proyecto.
        </p>
      </div>

      <!-- Co-PI -->
      <div class="team-card glass-card">
        <div class="role-badge badge-cyan">CO-INVESTIGADOR PRINCIPAL (Co-PI)</div>
        <h3 class="member-name">Dr. Frank Betances Reinoso</h3>
        <p class="member-affiliation">Otorrinolaringólogo · Salud Digital · Doctorando USC</p>
        <p class="member-desc">
          Liderazgo de salud digital, arquitectura de evaluación (VIA+) y rehabilitación domiciliaria offline (Valeria+).
        </p>
      </div>

      <!-- Carmen Valdez -->
      <div class="team-card glass-card">
        <div class="role-badge badge-purple">CO-INVESTIGADORA / PSICOLOGÍA</div>
        <h3 class="member-name">Mtra. Carmen Valdez Luciano</h3>
        <p class="member-affiliation">Psicología & Desarrollo Infantil</p>
        <p class="member-desc">
          Adaptación de materiales familiares, psicometría pediátrica y apoyo psicoeducativo a cuidadores.
        </p>
      </div>

      <!-- John Henry Antonio -->
      <div class="team-card glass-card">
        <div class="role-badge badge-emerald">ESTADÍSTICA & METODOLOGÍA</div>
        <h3 class="member-name">John Henry Antonio</h3>
        <p class="member-affiliation">Análisis Estadístico & Metodología de la Investigación</p>
        <p class="member-desc">
          Diseño metodológico del ensayo cuasi-experimental pre-post test y procesamiento de datos psicométricos.
        </p>
      </div>

      <!-- John Morales -->
      <div class="team-card glass-card">
        <div class="role-badge badge-cyan">ACEPTABILIDAD & CUESTIONARIOS</div>
        <h3 class="member-name">John Morales</h3>
        <p class="member-affiliation">Medición de Usabilidad & QuestionPro</p>
        <p class="member-desc">
          Administración de encuestas de aceptabilidad, usabilidad y satisfacción con la plataforma QuestionPro.
        </p>
      </div>

      <!-- Adalgisa Adams -->
      <div class="team-card glass-card">
        <div class="role-badge badge-amber">GESTIÓN PRESUPUESTARIA</div>
        <h3 class="member-name">Adalgisa Adams</h3>
        <p class="member-affiliation">Custodio de Compras & Presupuesto FONDOCYT</p>
        <p class="member-desc">
          Gestión transparente de compras, auditoría presupuestaria e inventario oficial para el MESCYT.
        </p>
      </div>
    </div>

    <!-- Institutional Framework Grid -->
    <div class="inst-framework-grid">
      <div class="inst-card glass-card">
        <div class="inst-icon">🏛️</div>
        <div>
          <h4>UFHEC & FONDOCYT</h4>
          <p>Proyecto subvencionado formalmente bajo el código <strong>FONDOCYT 2024-3-4A2-0922</strong> (18 meses de ejecución activa).</p>
        </div>
      </div>

      <div class="inst-card glass-card">
        <div class="inst-icon">🔒</div>
        <div>
          <h4>Égida CONABIOS</h4>
          <p>Aprobación del Comité Nacional de Bioética en Salud con estricto cumplimiento del consentimiento informado parental.</p>
        </div>
      </div>

      <div class="inst-card glass-card">
        <div class="inst-icon">🏥</div>
        <div>
          <h4>CIADIF & Padre Cavalotto</h4>
          <p>Alianza con centros piloto para la aplicación del M-CHAT-R/F-RD y prueba de aceptabilidad en intervención escolar.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .quisqueya-gov {
    background: rgba(15, 23, 42, 0.4);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
  }

  .gov-header-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .gov-brand-icon {
    width: 30px;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(0, 242, 254, 0.5)) drop-shadow(0 0 2px rgba(255, 255, 255, 0.8)) brightness(1.15);
  }

  .section-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: var(--accent-amber);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .section-description {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .team-card {
    padding: 1.75rem;
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
  }

  .role-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 0.85rem;
    align-self: flex-start;
  }

  .member-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .member-affiliation {
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .member-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .inst-framework-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .inst-card {
    padding: 1.5rem;
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .inst-icon {
    font-size: 2rem;
    background: rgba(255, 255, 255, 0.05);
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .inst-card h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.3rem;
  }

  .inst-card p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }
  }
</style>
