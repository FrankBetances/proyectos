---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="quisqueya-hero">
  <div class="container">
    <div class="hero-top-badges">
      <span class="badge badge-amber">🇩🇴 FONDOCYT 2024-3-4A2-0922</span>
      <span class="badge badge-purple">🏛️ MESCYT / UFHEC</span>
      <span class="badge badge-emerald">🔒 Égida CONABIOS</span>
      <span class="badge badge-cyan">🔬 S-CVI 0.879</span>
    </div>

    <!-- Official Quisqueya Habla Logo -->
    <div class="logo-wrapper">
      <img 
        src={`${baseUrl}/assets/quisqueya-logo.png`} 
        alt="Logo Oficial del Proyecto Quisqueya Habla" 
        class="quisqueya-logo-img" 
        width="420"
        height="236"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <h1 class="hero-title">
      Proyecto <span class="gradient-text">Quisqueya Habla</span>
    </h1>

    <p class="hero-subtitle">
      Detección temprana y rehabilitación domiciliaria de trastornos del lenguaje y TEA en niños de 2 a 6 años en la República Dominicana.
    </p>

    <!-- Pilot Showcase Banner -->
    <div class="pilot-banner glass-card">
      <div class="banner-badge">
        <span class="pulse-dot"></span>
        <span>Piloto Clínico Activo en Rep. Dominicana</span>
      </div>
      <div class="banner-grid">
        <div class="banner-item">
          <strong>CIADIF</strong>
          <span>Centro de Desarrollo Pediátrico</span>
        </div>
        <div class="banner-item">
          <strong>Padre Cavalotto</strong>
          <span>Escuela de Educación Especial</span>
        </div>
        <div class="banner-item">
          <strong>Léxico es-DO</strong>
          <span>Adaptación dialectal dominicana</span>
        </div>
      </div>
    </div>

    <div class="hero-actions">
      <a href="#gobernanza" class="btn-primary">
        <span>Gobernanza UFHEC</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <a href="#ensayo-clinico" class="btn-secondary">
        <span>Ensayo Piloto</span>
      </a>
      <a href={`${baseUrl}/cv`} class="btn-secondary">
        <span>Co-PI Dr. Frank Betances</span>
      </a>
    </div>
  </div>
</section>

<style>
  .quisqueya-hero {
    padding-top: 130px;
    padding-bottom: 60px;
    text-align: center;
  }

  .hero-top-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.5rem auto 1.75rem auto;
  }

  .quisqueya-logo-img {
    max-width: 90%;
    width: 360px;
    height: auto;
    border-radius: 20px;
    background: #FFFFFF;
    padding: 14px 22px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 242, 254, 0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .quisqueya-logo-img:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 242, 254, 0.3);
  }

  .hero-title {
    font-size: 3.2rem;
    font-weight: 800;
    max-width: 900px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 800px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .pilot-banner {
    padding: 1.5rem 1.75rem;
    max-width: 850px;
    margin: 0 auto 2.25rem auto;
    text-align: left;
    border: 1px solid var(--border-glow);
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
  }

  .banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-amber);
    margin-bottom: 0.85rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-amber);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-amber);
    animation: pulse 2s infinite;
  }

  .banner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .banner-item strong {
    font-size: 1.05rem;
    color: var(--text-main);
    display: block;
    margin-bottom: 0.2rem;
  }

  .banner-item span {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
    display: block;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.1rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
