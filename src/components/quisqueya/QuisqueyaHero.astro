---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section for Quisqueya Habla inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="quisqueya-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Research Backdrop Graphic with Parallax -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div id="quisqueya-hero-bg-stage" class="hero-quisqueya-bg-stage">
        <img 
          src={`${baseUrl}/assets/quisqueya-hero-bg.jpg?v=1`} 
          alt="Consulta de investigación pediátrica en Santo Domingo con especialista, familia y tablet mostrando evaluación de lenguaje" 
          class="quisqueya-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="quisqueya-overlay-gradient"></div>
      </div>
      <div class="glow-orb orb-amber"></div>
      <div class="glow-orb orb-blue"></div>
      <div class="glow-orb orb-emerald"></div>
      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line, invisible at 0 scroll) -->
    <div class="hero-editorial-tracker" id="quisqueya-tracker" aria-hidden="true">
      <div class="tracker-segment" id="qh-track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="qh-fill-0"></div></div><span>Investigación FONDOCYT</span></div>
      <div class="tracker-segment" id="qh-track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="qh-fill-1"></div></div><span>Validación & Piloto RD</span></div>
      <div class="tracker-segment" id="qh-track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="qh-fill-2"></div></div><span>Bioética & Alianzas</span></div>
    </div>

    <!-- Sutil indicador de ratón inicial abajo (desaparece al hacer scroll) -->
    <div id="quisqueya-scroll-starter" class="hero-scroll-starter" aria-hidden="true">
      <span class="starter-text">Scroll para conocer el proyecto</span>
      <div class="hint-mouse">
        <div class="mouse-wheel"></div>
      </div>
    </div>

    <!-- PHASE 0: Identidad de Investigación & Marco FONDOCYT (Aparece al hacer scroll: 2% - 36%) -->
    <div id="quisqueya-phase-0" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <!-- Official Quisqueya Habla Logo -->
        <div class="quisqueya-logo-wrapper">
          <img 
            src={`${baseUrl}/assets/quisqueya-logo.png?v=4`} 
            alt="Logo Oficial del Proyecto Quisqueya Habla - FONDOCYT MESCYT UFHEC" 
            class="quisqueya-brand-logo" 
            width="140"
            height="180"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="editorial-eyebrow eyebrow-amber">
          <span>Proyecto de Investigación Clínica (UFHEC / MESCYT)</span>
        </div>

        <h1 class="hero-headline">
          Detección Temprana y Rehabilitación Pediátrica <span class="gradient-text-amber">en la República Dominicana</span>
        </h1>

        <p class="hero-narrative-lead">
          Proyecto de investigación clínica financiado por el <strong>FONDOCYT 2024-3-4A2-0922</strong> (MESCYT / UFHEC) para el cribado temprano y estimulación domiciliaria de trastornos del lenguaje y TEA en niñas y niños de 2 a 6 años.
        </p>

        <div class="hero-badge-pill-row">
          <span class="badge-pill pill-amber">🇩🇴 FONDOCYT 2024-3-4A2-0922</span>
          <span class="badge-pill pill-purple">🏛️ MESCYT / UFHEC</span>
          <span class="badge-pill pill-emerald">🔒 Aprobación CONABIOS</span>
          <span class="badge-pill pill-cyan">🔬 Validación S-CVI 0.879</span>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Validación Científica & Ensayo Piloto (38% - 70% Scroll) -->
    <div id="quisqueya-phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Validación Científica & Centros Piloto</span>
        </div>
        <h2 class="hero-headline gradient-text-amber">
          Adaptación Cultural al Español Dominicano (es-DO) & Centros Piloto.
        </h2>

        <div class="quisqueya-showcase-grid">
          <!-- Left: Clinical & Methodological Cards -->
          <div class="showcase-cards-col">
            <div class="quisqueya-feature-card">
              <div class="feature-icon-badge icon-amber">📋</div>
              <div class="feature-text">
                <strong>Validación M-CHAT-R/F-RD</strong>
                <p>Adaptación cultural y validación de contenido con 28 expertos nacionales (Índice de Validez de Contenido <strong>S-CVI 0.879</strong>).</p>
              </div>
            </div>

            <div class="quisqueya-feature-card">
              <div class="feature-icon-badge icon-emerald">🏥</div>
              <div class="feature-text">
                <strong>Centros Piloto (CIADIF & Padre Cavalotto)</strong>
                <p>Ensayo clínico en el Centro Integral de Desarrollo Infantil (<strong>CIADIF</strong>) y la Escuela de Educación Especial <strong>Padre Cavalotto</strong>.</p>
              </div>
            </div>

            <div class="quisqueya-feature-card">
              <div class="feature-icon-badge icon-cyan">🎙️</div>
              <div class="feature-text">
                <strong>Léxico y Fonología es-DO</strong>
                <p>Modelos de voz y bancos de estímulos calibrados para el habla dominicana, sin penalización dialectal y con operación 100% offline.</p>
              </div>
            </div>
          </div>

          <!-- Right: Research Metrics Card -->
          <div class="showcase-metrics-col">
            <div class="research-metric-card">
              <div class="metric-card-header">
                <span class="pulse-dot"></span>
                <strong>Ensayo Clínico Piloto en Marcha</strong>
              </div>
              <div class="metrics-subgrid">
                <div class="metric-box">
                  <span class="m-val">18</span>
                  <span class="m-lbl">Meses de Investigación</span>
                </div>
                <div class="metric-box">
                  <span class="m-val">86</span>
                  <span class="m-lbl">Locuciones es-DO Nativas</span>
                </div>
                <div class="metric-box">
                  <span class="m-val">100%</span>
                  <span class="m-lbl">Offline · Cero PHI en Nube</span>
                </div>
                <div class="metric-box">
                  <span class="m-val">2</span>
                  <span class="m-lbl">Centros de Atención Especial</span>
                </div>
              </div>
              <div class="metric-card-footer">
                <span>Égida Bioética Nacional: <strong>CONABIOS</strong></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: Rigor Bioético, Alianzas & CTAs (72% - 100% Scroll) -->
    <div id="quisqueya-phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Rigor Bioético & Impacto en Salud Pública</span>
        </div>
        <h2 class="hero-headline">
          <span class="quote-tagline-amber">“Evidencia científica. Salud digital para la niñez dominicana.”</span>
        </h2>
        <p class="hero-narrative-lead">
          Investigación liderada por la <strong>Dra. Luz Verys Ramón Javier</strong> (IP) y el <strong>Dr. Frank Betances Reinoso</strong> (Co-PI / Líder de Salud Digital), con estricta gobernanza bioética avalada por <strong>CONABIOS</strong> y privacidad de datos clínicos en el dispositivo local.
        </p>

        <div class="hero-cta-group">
          <a href="#gobernanza" class="btn-qh-primary">
            <span>Gobernanza UFHEC</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#ensayo-clinico" class="btn-qh-secondary">
            <span>Ensayo Piloto</span>
          </a>
          <a href="#publicaciones" class="btn-qh-secondary">
            <span>Publicaciones</span>
          </a>
          <a href={`${baseUrl}/cv`} class="btn-qh-ghost">
            <span>Co-PI Dr. Frank Betances</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initQuisqueyaHero() {
    const heroSection = document.getElementById('quisqueya-hero-scrub');
    const scrollStarter = document.getElementById('quisqueya-scroll-starter');
    const tracker = document.getElementById('quisqueya-tracker');
    const phase0 = document.getElementById('quisqueya-phase-0');
    const phase1 = document.getElementById('quisqueya-phase-1');
    const phase2 = document.getElementById('quisqueya-phase-2');

    const fill0 = document.getElementById('qh-fill-0');
    const fill1 = document.getElementById('qh-fill-1');
    const fill2 = document.getElementById('qh-fill-2');
    const bgStage = document.getElementById('quisqueya-hero-bg-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    function calcOpacity(progress: number, enterStart: number, enterEnd: number, exitStart: number, exitEnd: number): number {
      if (progress < enterStart || progress > exitEnd) return 0;
      if (progress < enterEnd) return (progress - enterStart) / (enterEnd - enterStart);
      if (progress > exitStart) return Math.max(0, 1 - (progress - exitStart) / (exitEnd - exitStart));
      return 1.0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      } else {
        targetProgress = 0;
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      currentProgress += (targetProgress - currentProgress) * 0.18;

      // Starter hint fades out immediately when scroll starts (> 0.005)
      const opStarter = calcOpacity(targetProgress, 0.0, 0.002, 0.01, 0.025);
      if (scrollStarter) {
        scrollStarter.style.opacity = opStarter.toFixed(3);
        scrollStarter.style.pointerEvents = opStarter > 0.4 ? 'auto' : 'none';
      }

      // Phase 0: Enters rapidly and stays 100% solid (0.015 -> 0.04 reaches 1.0 -> stays until 0.32 -> exits at 0.38)
      const op0 = calcOpacity(targetProgress, 0.015, 0.04, 0.32, 0.38);
      // Phase 1: Validación & Centros Piloto (0.37 -> reaches 1.0 at 0.42 -> stays until 0.68 -> exits at 0.73)
      const op1 = calcOpacity(targetProgress, 0.37, 0.42, 0.68, 0.73);
      // Phase 2: Bioética & Alianzas (0.72 -> reaches 1.0 at 0.76 -> stays until 1.00)
      const op2 = calcOpacity(targetProgress, 0.72, 0.76, 0.98, 1.00);

      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${(0.15 - targetProgress) * 40}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.52 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.86 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      // Lifestyle Background Dynamic Parallax
      if (bgStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const bgOpacity = Math.max(0.35, 0.68 - currentProgress * 0.25);
        bgStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        bgStage.style.opacity = bgOpacity.toFixed(3);
      }

      // Tracker visibility
      if (tracker) {
        tracker.style.opacity = targetProgress > 0.015 ? '1' : '0';
      }

      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.015) / 0.345) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.36) / 0.36) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.72) / 0.28) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initQuisqueyaHero);
  } else {
    initQuisqueyaHero();
  }
  document.addEventListener('astro:page-load', initQuisqueyaHero);
</script>

<style>
  /* 320vh Hero Container */
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    width: 100%;
    background-color: var(--bg-dark);
  }

  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Ambient Backdrop Canvas */
  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  /* Research Artwork Background Parallax Stage */
  .hero-quisqueya-bg-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100vh;
    max-width: 1920px;
    max-height: 1080px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    will-change: transform, opacity;
    opacity: 0.68;
    pointer-events: none;
  }

  .quisqueya-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    mask-image: radial-gradient(ellipse at 50% 50%, black 45%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 45%, transparent 90%);
    filter: brightness(0.65) contrast(1.15);
  }

  .quisqueya-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.45) 0%, rgba(7, 9, 14, 0.85) 75%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(95px);
    opacity: 0.28;
    pointer-events: none;
  }

  .orb-amber {
    top: 20%;
    left: 18%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, var(--accent-amber) 0%, rgba(245, 158, 11, 0) 70%);
  }

  .orb-blue {
    bottom: 20%;
    right: 15%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--accent-blue) 0%, rgba(79, 172, 254, 0) 70%);
  }

  .orb-emerald {
    top: 60%;
    left: 45%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, var(--accent-emerald) 0%, rgba(16, 185, 129, 0) 70%);
    opacity: 0.18;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
  }

  /* Official Brand Logo */
  .quisqueya-logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.25rem auto;
  }

  .quisqueya-brand-logo {
    width: clamp(110px, 14vw, 145px);
    height: auto;
    filter: drop-shadow(0 0 35px rgba(245, 158, 11, 0.45)) drop-shadow(0 10px 25px rgba(0, 0, 0, 0.6));
    transition: transform 0.3s ease;
    animation: subtleFloat 4s ease-in-out infinite alternate;
  }

  @keyframes subtleFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  /* Sutil indicador de inicio abajo (desaparece con el scroll) */
  .hero-scroll-starter {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 8;
    will-change: opacity;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .starter-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* Editorial Tracker */
  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-amber);
    transition: width 0.1s linear;
  }

  /* Phase Panels */
  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 960px;
    margin: 0 auto;
  }

  .max-w-showcase {
    max-width: 1100px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .eyebrow-amber {
    color: var(--accent-amber);
  }

  .eyebrow-cyan {
    color: var(--accent-cyan);
  }

  .eyebrow-emerald {
    color: var(--accent-emerald);
  }

  .hero-headline {
    font-size: clamp(2.1rem, 4.2vw, 3.6rem);
    font-weight: 900;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
  }

  .gradient-text-amber {
    color: var(--accent-amber);
    font-weight: 900;
    text-shadow: 0 0 25px rgba(245, 158, 11, 0.6);
  }

  .quote-tagline-amber {
    color: var(--accent-amber);
    font-weight: 900;
    text-shadow: 0 0 25px rgba(245, 158, 11, 0.6);
    display: inline-block;
  }

  .hero-narrative-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: #FFFFFF;
    line-height: 1.75;
    max-width: 860px;
    margin: 0 auto 2.25rem auto;
    font-weight: 600;
    padding: 1.35rem 1.85rem;
    background: #070B14;
    border: 2px solid var(--accent-amber);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.95), 0 0 30px rgba(245, 158, 11, 0.25);
  }

  .hero-narrative-lead strong {
    color: var(--accent-amber);
    font-weight: 900;
  }

  /* Badge Pill Row */
  .hero-badge-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge-pill {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-amber {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--accent-amber);
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #D8B4FE;
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  /* Showcase Grid */
  .quisqueya-showcase-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 1.5rem;
    text-align: left;
  }

  .showcase-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quisqueya-feature-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s ease;
  }

  .quisqueya-feature-card:hover {
    transform: translateX(4px);
    border-color: rgba(245, 158, 11, 0.4);
  }

  .feature-icon-badge {
    font-size: 1.75rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .icon-amber {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .icon-emerald {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

