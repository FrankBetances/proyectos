---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<section class="descubre-hero">
  <div class="hero-bg-gradient" aria-hidden="true"></div>
  <div class="hero-glow orb-1" aria-hidden="true"></div>
  <div class="hero-glow orb-2" aria-hidden="true"></div>

  <div class="container hero-container">
    <!-- Institutional Origin Banner -->
    <div class="origin-banner">
      <div class="origin-logos">
        <img 
          src={`${baseUrl}/assets/descubre-con-lua/dr-betances-crest.png`} 
          alt="Escudo del Dr. Frank Alberto Betances Reinoso" 
          class="crest-logo" 
          width="40" 
          height="40" 
        />
        <div class="origin-separator"></div>
        <img 
          src={`${baseUrl}/assets/descubre-con-lua/startic.png`} 
          alt="Incubadora de Alta Tecnoloxía startTIC" 
          class="partner-logo" 
          height="28" 
        />
        <div class="origin-separator"></div>
        <img 
          src={`${baseUrl}/assets/descubre-con-lua/zona-franca-vigo.png`} 
          alt="Consorcio da Zona Franca de Vigo" 
          class="partner-logo" 
          height="32" 
        />
        <div class="origin-separator"></div>
        <img 
          src={`${baseUrl}/assets/descubre-con-lua/concello-vigo.png`} 
          alt="Escolas infantís municipais do Concello de Vigo" 
          class="partner-logo" 
          height="26" 
        />
      </div>
      <span class="origin-text">
        Proxecto xurdido na <strong>Incubadora de Alta Tecnoloxía startTIC</strong> · <strong>Consorcio da Zona Franca de Vigo</strong>
      </span>
    </div>

    <!-- Editorial Badge -->
    <div class="hero-badge-pill">
      <span class="pill-dot"></span>
      <span>Educación Infantil 0-3 Anos · 100% Sen Conexión · Bilingüe Galego / Castelán</span>
    </div>

    <!-- Main Title -->
    <h1 class="hero-title">
      Descubre con Lúa <br />
      <span class="gradient-text-teal">Edición Escolas de Vigo</span>
    </h1>

    <!-- Lead narrative -->
    <p class="hero-lead">
      Aplicación Android educativa, <strong>estritamente sen conexión</strong>, deseñada para as escolas infantís municipais de Vigo e as súas familias. Conecta a <strong>asamblea diaria de 8 minutos</strong> na aula co estímulo no fogar, con audio neuronal gravado, pulso visual adaptado e <strong>cero exposición de pantallas ás crianzas</strong>.
    </p>

    <!-- CTAs -->
    <div class="hero-cta-group">
      <a href="#pilares" class="btn-primary-hero">
        <span>Explorar Arquitectura e Aula</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>

      <button 
        id="open-contact-modal-hero" 
        class="btn-secondary-hero"
        onclick="document.getElementById('contact-modal')?.classList.add('open'); document.getElementById('contact-modal')?.setAttribute('aria-hidden', 'false');"
      >
        <span>Solicitar Convenio ou Licenza</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Dual Device Showcase (Galego / Castellano View) -->
    <div class="hero-visual-showcase">
      <div class="showcase-card">
        <div class="showcase-header">
          <div class="tab-indicator active">
            <span class="lang-badge">GL</span>
            <span>Versión en Galego</span>
          </div>
          <div class="tab-indicator">
            <span class="lang-badge">ES</span>
            <span>Versión en Castelán</span>
          </div>
        </div>

        <div class="device-pair">
          <!-- Device 1: Galego -->
          <div class="device-wrapper main-device">
            <div class="device-label">Benvida e Entrada · Modo Galego</div>
            <div class="device-mockup">
              <div class="device-notch"></div>
              <div class="device-screen">
                <img 
                  src={`${baseUrl}/assets/descubre-con-lua/bienvenida-gl.png`} 
                  alt="Pantalla de benvida de Descubre con Lúa en galego para escolas de Vigo" 
                  class="screen-img" 
                  loading="eager" 
                  decoding="async"
                />
              </div>
            </div>
          </div>

          <!-- Device 2: Unidades Aula -->
          <div class="device-wrapper secondary-device">
            <div class="device-label">10 Unidades de Aula · Asamblea</div>
            <div class="device-mockup">
              <div class="device-notch"></div>
              <div class="device-screen">
                <img 
                  src={`${baseUrl}/assets/descubre-con-lua/aula-unidades-gl.png`} 
                  alt="Unidades mensuais de asamblea de Descubre con Lúa" 
                  class="screen-img" 
                  loading="lazy" 
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Metrics Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-number">10</div>
        <div class="metric-title">Unidades de Aula</div>
        <div class="metric-desc">Unha unidade por mes de curso escolar (Setembro a Xuño) estruturada para asamblea de 8 minutos.</div>
      </div>

      <div class="metric-card">
        <div class="metric-number">1.020</div>
        <div class="metric-title">Locucións Neuronais</div>
        <div class="metric-desc">443 en galego (Celtia / Proxecto Nós), 443 en castelán e 134 en inglés gravadas no paquete.</div>
      </div>

      <div class="metric-card">
        <div class="metric-number">80</div>
        <div class="metric-title">Láminas Propias</div>
        <div class="metric-desc">50 láminas de vocabulario e 30 escenas do conto debuxadas directamente como datos vectoriais.</div>
      </div>

      <div class="metric-card">
        <div class="metric-number">0</div>
        <div class="metric-title">Permisos de Rede</div>
        <div class="metric-desc">Cero conexión, cero analítica e total privacidade. A criatura non emprega a pantalla.</div>
      </div>
    </div>
  </div>
</section>

<style>
  .descubre-hero {
    position: relative;
    padding: 7.5rem 0 4.5rem 0;
    overflow: hidden;
  }

  .hero-bg-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 10%, rgba(14, 165, 233, 0.12) 0%, rgba(7, 9, 14, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }

  .orb-1 {
    top: 5%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(20, 184, 166, 0.15), transparent 70%);
  }

  .orb-2 {
    top: 25%;
    right: -10%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.12), transparent 70%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Institutional Origin Banner */
  .origin-banner {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: 0.85rem 1.75rem;
    margin-bottom: 2rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .origin-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .crest-logo {
    background: #0B1220;
    border-radius: 8px;
    padding: 4px;
    object-fit: contain;
  }

  .partner-logo {
    object-fit: contain;
    filter: brightness(1.05);
  }

  .origin-separator {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.15);
  }

  .origin-text {
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .origin-text strong {
    color: var(--text-main);
  }

  /* Editorial Pill */
  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    background: rgba(20, 184, 166, 0.12);
    border: 1px solid rgba(20, 184, 166, 0.3);
    border-radius: var(--radius-full);
    color: #2DD4BF;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2DD4BF;
    box-shadow: 0 0 8px #2DD4BF;
  }

  /* Headings */
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 5.2vw, 3.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.5rem;
    max-width: 960px;
  }

  .gradient-text-teal {
    background: linear-gradient(135deg, #2DD4BF 0%, #06B6D4 50%, #38BDF8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 820px;
    margin-bottom: 2.25rem;
  }

  .hero-lead strong {
    color: var(--text-main);
  }

  /* CTA Buttons */
  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .btn-primary-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.85rem;
    background: linear-gradient(135deg, #0D9488 0%, #0284C7 100%);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 25px rgba(13, 148, 136, 0.35);
    transition: all 0.25s ease;
  }

  .btn-primary-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(13, 148, 136, 0.5);
  }

  .btn-secondary-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.85rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-secondary-hero:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  /* Dual Device Showcase */
  .hero-visual-showcase {
    width: 100%;
    max-width: 900px;
    margin-bottom: 4rem;
  }

  .showcase-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.7), 0 0 35px rgba(20, 184, 166, 0.1);
    backdrop-filter: blur(16px);
  }

  .showcase-header {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .tab-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .tab-indicator.active {
    background: rgba(20, 184, 166, 0.15);
    color: #2DD4BF;
    border: 1px solid rgba(20, 184, 166, 0.3);
  }

  .lang-badge {
    font-weight: 800;
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .tab-indicator.active .lang-badge {
    background: #0D9488;
    color: #FFFFFF;
  }

  .device-pair {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 2rem;
  }

  .device-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .device-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .device-mockup {
    position: relative;
    width: 220px;
    padding: 7px;
    border-radius: 28px;
    background: #0D131F;
    border: 2.5px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.7), 0 0 30px rgba(13, 148, 136, 0.2);
  }

  .secondary-device .device-mockup {
    width: 200px;
    opacity: 0.85;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .device-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 9px;
    border-radius: var(--radius-full);
    background: #05080E;
    z-index: 2;
  }

  .device-screen {
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    background: #07090E;
    aspect-ratio: 9 / 19.5;
  }

  .screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 1100px;
  }

  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.25rem;
    text-align: left;
    transition: all 0.25s ease;
  }

  .metric-card:hover {
    border-color: rgba(20, 184, 166, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .metric-number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: #2DD4BF;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .metric-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .metric-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Responsive Adjustments */
  @media (max-width: 980px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .origin-banner {
      padding: 0.85rem 1.25rem;
    }
  }

  @media (max-width: 680px) {
    .descubre-hero {
      padding: 6rem 0 3.5rem 0;
    }

    .origin-logos {
      gap: 0.75rem;
    }

    .origin-separator {
      display: none;
    }

    .device-pair {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .secondary-device {
      display: none;
    }

    .device-mockup {
      width: min(220px, 68vw);
    }

    .metrics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
