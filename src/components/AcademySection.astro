---
const academyDomains = [
  { icon: "🧭", title: "Lenguaje & 'La Brújula'", desc: "Hitos normativos ASHA 0-5 años (receptivo vs. expresivo) y modelado positivo (recast)." },
  { icon: "👂", title: "Hipoacusia & Implantes", desc: "Pérdida auditiva, pautas familiares y manejo práctico de audífonos e implantes cocleares." },
  { icon: "🗣️", title: "Dislalias & Articulación", desc: "Puntos de articulación de la boca y praxias para fonemas difíciles (/r/, /s/, /l/)." },
  { icon: "🔤", title: "Dislexia & Fonología", desc: "Conciencia fonológica, ritmo auditivo y trucos para apoyar la lectura emergente en casa." },
  { icon: "🧩", title: "TEA (Espectro Autista)", desc: "Comunicación funcional, anticipación estructurada y regulación respetuosa en el hogar." },
  { icon: "🤟", title: "Lengua de Signos (LSE)", desc: "Abecedario dactilológico con 27 configuraciones de mano dibujadas y validadas por ACOPROS." },
  { icon: "🎧", title: "Integración Sensorial", desc: "Estrategias para sobre-responsividad auditiva (SOR) ante electrodomésticos y ruidos fuertes." }
];
---

<section id="academy" class="academy-section section-padding">
  <div class="container">
    <div class="academy-box glass-card">
      <div class="academy-header-content">
        <div class="academy-title-wrap">
          <span class="badge badge-purple">Pestaña Inicial por Defecto</span>
          <h2>Academy · <span class="gradient-text">Formación Parental en 2 Minutos</span></h2>
          <p>
            Comprender el desarrollo del lenguaje es imprescindible antes de ejercitarlo. 
            Valeria+ abre en Academy para formar a madres y padres mediante <strong>cápsulas breves de 2 minutos</strong> con micro-preguntas que suman puntos XP.
          </p>
        </div>
        <div class="academy-badge-large">
          <span class="academy-xp">⚡ XP por Dominio</span>
          <span class="academy-status">7 Silos Formativos · Cero Jerga</span>
        </div>
      </div>

      <!-- 7 Domains Grid -->
      <div class="domains-grid">
        {academyDomains.map((d) => (
          <div class="domain-card">
            <span class="domain-icon">{d.icon}</span>
            <div class="domain-body">
              <h4>{d.title}</h4>
              <p>{d.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Spotlight dual: La Brújula de las Palabras + Lengua de Signos -->
      <div class="academy-spotlight-row">
        <div class="lse-spotlight">
          <div class="lse-tag">🧭 Hitos Normativos ASHA (0 a 5 años)</div>
          <h3>La Brújula de las Palabras</h3>
          <p>
            Guía clínica por edades que deslinda <strong>lo que el niño comprende</strong> (lenguaje receptivo) de <strong>lo que expresa</strong> (lenguaje expresivo), orientando a la familia sobre cuándo consultar al logopeda.
          </p>
        </div>

        <div class="lse-spotlight lse-alt">
          <div class="lse-tag text-purple">🤟 Validación Oficial ACOPROS</div>
          <h3>Lengua de Signos Española (LSE)</h3>
          <p>
            Las <strong>27 configuraciones del abecedario dactilológico</strong> han sido revisadas y validadas directamente por 
            <strong>la logopeda y personas sordas de ACOPROS</strong>, disponibles en un panel de consulta rápida.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .academy-section {
    padding: 85px 0;
    position: relative;
    border-top: 1px solid var(--border-light);
  }

  .academy-box {
    padding: 3rem 2.5rem;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 27, 75, 0.4) 100%);
    border: 1px solid rgba(138, 43, 226, 0.3);
    box-shadow: var(--shadow-purple);
  }

  .academy-header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .academy-title-wrap h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.3rem);
    font-weight: 800;
    margin: 0.6rem 0 0.8rem 0;
  }

  .academy-title-wrap p {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .academy-title-wrap strong {
    color: var(--text-main);
  }

  .academy-badge-large {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .academy-xp {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--accent-purple);
    background: rgba(168, 85, 247, 0.1);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .academy-status {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .domain-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: transform var(--transition-fast);
  }

  .domain-card:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  .domain-icon {
    font-size: 1.6rem;
    background: rgba(255, 255, 255, 0.05);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .domain-body h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--text-main);
  }

  .domain-body p {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  .academy-spotlight-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .lse-spotlight {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(0, 242, 254, 0.2);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .lse-spotlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--accent-cyan);
  }

  .lse-spotlight.lse-alt {
    border-color: rgba(168, 85, 247, 0.25);
  }

  .lse-spotlight.lse-alt::before {
    background: var(--accent-purple);
  }

  .lse-tag {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .lse-tag.text-purple {
    color: #C084FC;
  }

  .lse-spotlight h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .lse-spotlight p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .lse-spotlight strong {
    color: var(--text-main);
  }

  @media (max-width: 768px) {
    .academy-box {
      padding: 2rem 1.25rem;
    }
    .academy-header-content {
      flex-direction: column;
      gap: 1.25rem;
    }
    .academy-badge-large {
      align-items: flex-start;
    }
  }
</style>
