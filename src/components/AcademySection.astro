---
const academyDomains = [
  { icon: "🧭", title: "Lenguaje & Hitos ASHA", desc: "Hitos normativos de 0 a 5 años (receptivo vs. expresivo) y técnicas de modelado positivo (recast)." },
  { icon: "👂", title: "Hipoacusia & Implantes", desc: "Pautas familiares prácticas para el cuidado y aprovechamiento de audífonos e implantes cocleares." },
  { icon: "🗣️", title: "Dislalias & Articulación", desc: "Puntos de articulación orofacial y praxias lúdicas para fonemas complejos (/r/, /s/, /l/)." },
  { icon: "🔤", title: "Dislexia & Fonología", desc: "Conciencia fonológica, ritmo auditivo y claves para consolidar la lectura emergente en el hogar." },
  { icon: "🧩", title: "TEA (Espectro Autista)", desc: "Estrategias de comunicación funcional, turnos compartidos y rutinas de anticipación visual." },
  { icon: "🎧", title: "Integración Sensorial", desc: "Regulación progresiva ante la sobre-responsividad acústica (SOR) frente a electrodomésticos." }
];
---

<section id="academy" class="academy-section">
  <div class="container">
    <div class="academy-box glass-card">
      <div class="section-header academy-header">
        <span class="tag">Formación Parental Previa</span>
        <h2>Academy · <span class="gradient-text">Micro-cápsulas en 2 Minutos</span></h2>
        <p>
          Comprender el desarrollo del lenguaje antes de ejercitarlo. Valeria+ capacita a las familias mediante <strong>pautas clínicas directas de 2 minutos</strong> con preguntas que refuerzan el aprendizaje.
        </p>
      </div>

      <!-- 6 Key Domains Grid - Symmetrical & Centered -->
      <div class="domains-grid">
        {academyDomains.map((d) => (
          <div class="domain-card">
            <span class="domain-icon">{d.icon}</span>
            <div class="domain-body">
              <h4>{d.title}</h4>
              <p>{d.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Spotlight dual: La Brújula + Lengua de Signos (LSE) - Symmetrical & Centered -->
      <div class="academy-spotlight-row">
        <div class="lse-spotlight">
          <div class="lse-tag">🧭 Hitos Normativos ASHA (0 a 5 años)</div>
          <h3>La Brújula de las Palabras</h3>
          <p>
            Guía clínica que diferencia <strong>comprensión</strong> de <strong>expresión</strong>, orientando a la familia sobre cuándo consultar con el especialista.
          </p>
        </div>

        <div class="lse-spotlight lse-alt">
          <div class="lse-tag text-purple">🤟 Validación Oficial ACOPROS</div>
          <h3>Lengua de Signos Española (LSE)</h3>
          <p>
            Las <strong>27 configuraciones dactilológicas</strong> han sido revisadas y validadas directamente por la logopeda y personas sordas de <strong>ACOPROS</strong>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .academy-section {
    padding: 85px 0;
    position: relative;
    border-top: 1px solid var(--border-light);
  }

  .academy-box {
    padding: 3rem 2.5rem;
    max-width: 1060px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 27, 75, 0.4) 100%);
    border: 1px solid rgba(138, 43, 226, 0.3);
    box-shadow: var(--shadow-purple);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .academy-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .academy-header p {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
    width: 100%;
  }

  .domain-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .domain-card:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  .domain-icon {
    font-size: 1.75rem;
    background: rgba(255, 255, 255, 0.05);
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    margin: 0 auto 0.85rem auto;
    flex-shrink: 0;
  }

  .domain-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .domain-body h4 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text-main);
    text-align: center;
  }

  .domain-body p {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    text-align: center;
  }

  .academy-spotlight-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .lse-spotlight {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .lse-spotlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-cyan);
  }

  .lse-spotlight.lse-alt {
    border-color: rgba(168, 85, 247, 0.3);
  }

  .lse-spotlight.lse-alt::before {
    background: var(--accent-purple);
  }

  .lse-tag {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .lse-tag.text-purple {
    color: #C084FC;
  }

  .lse-spotlight h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    text-align: center;
    color: var(--text-main);
  }

  .lse-spotlight p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    text-align: center;
    max-width: 440px;
  }

  .lse-spotlight strong {
    color: var(--text-main);
  }

  @media (max-width: 768px) {
    .academy-section {
      padding: 50px 0;
    }

    .academy-box {
      padding: 1.5rem 1rem;
      border-radius: var(--radius-md);
    }

    .domains-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .domain-card {
      padding: 1.15rem 1rem;
    }

    .domain-icon {
      width: 40px;
      height: 40px;
      font-size: 1.4rem;
      margin-bottom: 0.55rem;
    }

    .domain-body h4 {
      font-size: 1rem;
    }

    .domain-body p {
      font-size: 0.84rem;
    }

    .academy-spotlight-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .lse-spotlight {
      padding: 1.35rem 1.15rem;
    }

    .lse-spotlight h3 {
      font-size: 1.1rem;
    }

    .lse-spotlight p {
      font-size: 0.88rem;
    }
  }
</style>
