---
---

<section id="especificaciones" class="specs-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Ingeniería & Tolerancias FDM</span>
      <h2 class="section-title">
        Especificación Mecánica en Blender: <span class="gradient-text-orange">Métrica Real</span>
      </h2>
      <p class="section-subtitle">
        Toda la matriz física se diseña en milímetros reales. Configuración métrica estricta en Blender (<code>scale_length = 0.001</code>) para garantizar compatibilidad con piezas comerciales y seguridad infantil EN 71-1.
      </p>
    </div>

    <div class="specs-grid">
      <!-- Interactive SVG Blueprint Card -->
      <div class="blueprint-card">
        <div class="blueprint-header">
          <div class="blueprint-tag">Plano Técnico de Corte Modular 2×2</div>
          <span class="blueprint-scale">Escala 1:1 · Cotas Nominales</span>
        </div>

        <div class="svg-blueprint-wrapper">
          <svg viewBox="0 0 540 340" fill="none" class="blueprint-svg" aria-label="Plano acotado de un bloque Duplo modular">
            <!-- Background grid -->
            <defs>
              <pattern id="bp-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0, 242, 254, 0.08)" stroke-width="0.8"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="#070c18"/>
            <rect width="100%" height="100%" fill="url(#bp-grid)"/>

            <!-- Main Block Body (63.6mm wide representation, 19.2mm high) -->
            <!-- Base block: x: 80 to 460 (width 380), y: 150 to 280 (height 130) -->
            <rect x="90" y="150" width="360" height="130" rx="4" fill="rgba(249, 115, 22, 0.12)" stroke="#FB923C" stroke-width="2.5"/>

            <!-- Inner Wall / Shell indication -->
            <rect x="105" y="165" width="330" height="115" rx="2" fill="none" stroke="#FB923C" stroke-width="1.2" stroke-dasharray="4 3"/>

            <!-- Stud 1: x: 135 to 225 (width 90), y: 110 to 150 (height 40) -->
            <rect x="135" y="115" width="90" height="35" rx="3" fill="rgba(249, 115, 22, 0.25)" stroke="#FB923C" stroke-width="2.2"/>

            <!-- Stud 2: x: 315 to 405 (width 90), y: 110 to 150 (height 40) -->
            <rect x="315" y="115" width="90" height="35" rx="3" fill="rgba(249, 115, 22, 0.25)" stroke="#FB923C" stroke-width="2.2"/>

            <!-- Central Clutch Cylinder (Tubo interior Ø 13.20 mm) -->
            <rect x="215" y="165" width="110" height="115" fill="rgba(0, 242, 254, 0.08)" stroke="#00F2FE" stroke-width="1.8" stroke-dasharray="3 3"/>
            <line x1="270" y1="165" x2="270" y2="280" stroke="#00F2FE" stroke-width="1" stroke-dasharray="2 2"/>

            <!-- Dimension: Stud Pitch 31.80 mm (Between Centers) -->
            <line x1="180" y1="85" x2="360" y2="85" stroke="#00F2FE" stroke-width="1.5"/>
            <line x1="180" y1="75" x2="180" y2="115" stroke="#00F2FE" stroke-width="1" stroke-dasharray="2 2"/>
            <line x1="360" y1="75" x2="360" y2="115" stroke="#00F2FE" stroke-width="1" stroke-dasharray="2 2"/>
            <polygon points="180,85 188,82 188,88" fill="#00F2FE"/>
            <polygon points="360,85 352,82 352,88" fill="#00F2FE"/>
            <text x="270" y="78" fill="#00F2FE" font-size="12" font-family="'JetBrains Mono', monospace" font-weight="700" text-anchor="middle">PASO MODULAR: 31,80 mm</text>

            <!-- Dimension: Stud Diameter 9.40 mm -->
            <line x1="135" y1="105" x2="225" y2="105" stroke="#FDBA74" stroke-width="1.2"/>
            <polygon points="135,105 141,102 141,108" fill="#FDBA74"/>
            <polygon points="225,105 219,102 219,108" fill="#FDBA74"/>
            <text x="180" y="98" fill="#FDBA74" font-size="10.5" font-family="'JetBrains Mono', monospace" text-anchor="middle">Ø 9,40 mm</text>

            <!-- Dimension: Stud Height 4.50 mm -->
            <line x1="420" y1="115" x2="420" y2="150" stroke="#FDBA74" stroke-width="1.2"/>
            <polygon points="420,115 417,121 423,121" fill="#FDBA74"/>
            <polygon points="420,150 417,144 423,144" fill="#FDBA74"/>
            <text x="430" y="136" fill="#FDBA74" font-size="10.5" font-family="'JetBrains Mono', monospace" text-anchor="start">4,50 mm</text>

            <!-- Dimension: Block Base Height 19.20 mm -->
            <line x1="55" y1="150" x2="55" y2="280" stroke="#34D399" stroke-width="1.5"/>
            <line x1="45" y1="150" x2="90" y2="150" stroke="#34D399" stroke-width="1" stroke-dasharray="2 2"/>
            <line x1="45" y1="280" x2="90" y2="280" stroke="#34D399" stroke-width="1" stroke-dasharray="2 2"/>
            <polygon points="55,150 52,158 58,158" fill="#34D399"/>
            <polygon points="55,280 52,272 58,272" fill="#34D399"/>
            <text x="42" y="220" fill="#34D399" font-size="11" font-family="'JetBrains Mono', monospace" font-weight="700" text-anchor="end">ALTURA BASE: 19,20 mm</text>

            <!-- Dimension: Inner Clutch Tube Diameter Øext 13.20 mm -->
            <text x="270" y="235" fill="#00F2FE" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">TUBO RETENCIÓN</text>
            <text x="270" y="250" fill="#67E8F9" font-size="11" font-family="'JetBrains Mono', monospace" font-weight="700" text-anchor="middle">Øext 13,20 mm</text>

            <!-- Dimension: Wall Thickness 1.50 - 1.60 mm -->
            <text x="270" y="315" fill="#94A3B8" font-size="10.5" font-family="'JetBrains Mono', monospace" text-anchor="middle">GROSOR PARED EXTERIOR: 1,50 - 1,60 mm · SEGURIDAD EN 71-1 (> 31,75 mm)</text>
          </svg>
        </div>

        <div class="blueprint-footer">
          <div class="bp-tip">
            <span class="bp-tip-icon">💡</span>
            <span><strong>Ajuste por Fricción (*Clutch Power*):</strong> El tubo central interactúa tangencialmente con los 4 tetones del bloque inferior proporcionando sujeción mecánica firme y separable por manos infantiles.</span>
          </div>
        </div>
      </div>

      <!-- Specs Table & Settings -->
      <div class="specs-content">
        <div class="blender-snippet-card">
          <div class="card-head">
            <span class="code-title">Configuración Escena Blender (bpy)</span>
            <span class="lang-tag">Python</span>
          </div>
          <pre class="code-box"><code><span class="kw">import</span> bpy

scene = bpy.context.scene
scene.unit_settings.system = <span class="str">'METRIC'</span>
scene.unit_settings.length_unit = <span class="str">'MILLIMETERS'</span>
scene.unit_settings.scale_length = <span class="num">0.001</span>  <span class="comm"># 1 unidad Blender = 1 metro</span></code></pre>
        </div>

        <!-- Parameters Table -->
        <div class="params-table-wrapper">
          <table class="params-table">
            <thead>
              <tr>
                <th>Parámetro Mecánico</th>
                <th>Cota Nominal</th>
                <th>Tolerancia / Función Crítica</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Paso modular (*stud pitch*)</strong></td>
                <td><code class="val-code">31,80 mm</code></td>
                <td>Distancia interaxial entre centros de tetones contiguos (X/Y).</td>
              </tr>
              <tr>
                <td><strong>Diámetro del tetón (*stud*)</strong></td>
                <td><code class="val-code">9,40 mm</code></td>
                <td>Cilindro superior de inserción por fricción estandarizada.</td>
              </tr>
              <tr>
                <td><strong>Altura del tetón (*stud height*)</strong></td>
                <td><code class="val-code">4,50 mm</code></td>
                <td>Altura libre vertical del conector superior.</td>
              </tr>
              <tr>
                <td><strong>Altura base del bloque</strong></td>
                <td><code class="val-code">19,20 mm</code></td>
                <td>Altura modular de bloque (sin incluir tetón superior).</td>
              </tr>
              <tr>
                <td><strong>Grosor pared exterior</strong></td>
                <td><code class="val-code">1,50 - 1,60 mm</code></td>
                <td>Rigidez estructural e indeformabilidad ante mordiscos.</td>
              </tr>
              <tr>
                <td><strong>Tubo interior (*clutch tube*)</strong></td>
                <td><code class="val-code">Øext 13,20 mm</code></td>
                <td>Cilindro hueco interno de anclaje para bloques 2×2 y 2×4.</td>
              </tr>
              <tr>
                <td><strong>Offset de encaje (FDM)</strong></td>
                <td><code class="val-code">Δ = 0,15 - 0,20 mm</code></td>
                <td>Compensación radial según contracción de PLA/PETG.</td>
              </tr>
              <tr>
                <td><strong>Norma EN 71-1 (Juguetes)</strong></td>
                <td><code class="val-code">> 31,75 mm</code></td>
                <td>Supera el cilindro de partes pequeñas para &lt; 36 meses.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .specs-section {
    padding: 5rem 0;
    position: relative;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #FB923C 0%, #F97316 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .section-subtitle code {
    color: #67E8F9;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
  }

  /* Specs Grid */
  .specs-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Blueprint Card */
  .blueprint-card {
    background: #060913;
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
  }

  .blueprint-header {
    background: rgba(0, 242, 254, 0.06);
    border-bottom: 1px solid rgba(0, 242, 254, 0.15);
    padding: 0.9rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blueprint-tag {
    font-size: 0.82rem;
    font-weight: 700;
    color: #67E8F9;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .blueprint-scale {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: 'JetBrains Mono', monospace;
  }

  .svg-blueprint-wrapper {
    padding: 1.5rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .blueprint-svg {
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: 6px;
    border: 1px solid rgba(0, 242, 254, 0.12);
  }

  .blueprint-footer {
    padding: 1.2rem 1.4rem;
    background: rgba(15, 23, 42, 0.4);
    border-top: 1px solid var(--border-light);
  }

  .bp-tip {
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .bp-tip-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .bp-tip strong {
    color: #FDBA74;
  }

  /* Code snippet */
  .blender-snippet-card {
    background: rgba(10, 15, 29, 0.8);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.75rem;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-light);
  }

  .code-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .lang-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
  }

  .code-box {
    margin: 0;
    padding: 1.1rem 1.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #E2E8F0;
    overflow-x: auto;
  }

  .kw { color: #F43F5E; }
  .str { color: #34D399; }
  .num { color: #F59E0B; }
  .comm { color: #64748B; font-style: italic; }

  /* Parameters Table */
  .params-table-wrapper {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .params-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    text-align: left;
  }

  .params-table th {
    background: rgba(255, 255, 255, 0.04);
    padding: 0.85rem 1rem;
    font-weight: 700;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-light);
  }

  .params-table td {
    padding: 0.8rem 1rem;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    line-height: 1.45;
  }

  .params-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .val-code {
    font-family: 'JetBrains Mono', monospace;
    color: #FDBA74;
    background: rgba(249, 115, 22, 0.1);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.88em;
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
