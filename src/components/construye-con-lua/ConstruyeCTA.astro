---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<section class="construye-cta-section">
  <div class="cta-glow orb-1" aria-hidden="true"></div>
  <div class="cta-glow orb-2" aria-hidden="true"></div>

  <div class="container">
    <div class="cta-card">
      <div class="cta-badge">Transferencia Tecnológica & Aula</div>
      
      <h2 class="cta-title">
        Construye el Futuro Tangible de la <br />
        <span class="gradient-text-orange">Educación y Salud Infantil</span>
      </h2>

      <p class="cta-description">
        Lúa Construye está disponible para colegios, escuelas municipales infantiles, clínicas de neurodesarrollo y gabinetes de logopedia. Modelos 3D abiertos, software offline estricto y rigor clínico bajo supervisión del Dr. Frank Betances.
      </p>

      <div class="cta-buttons">
        <button 
          id="open-contact-modal-cta" 
          class="btn-primary-cta"
          onclick="document.getElementById('contact-modal')?.classList.add('open'); document.getElementById('contact-modal')?.setAttribute('aria-hidden', 'false');"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>Solicitar Modelos 3D o Convenio</span>
        </button>

        <a href={`${baseUrl}/descubre-con-lua`} class="btn-secondary-cta">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span>Ver Descubre con Lúa (Vigo)</span>
        </a>

        <a href="https://github.com/FrankBetances" target="_blank" rel="noopener noreferrer" class="btn-secondary-cta">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span>Repositorio en GitHub</span>
        </a>
      </div>

      <!-- Institutional Footer Note -->
      <div class="cta-trust-note">
        <span>Diseñado y validado en <strong>Vigo, Galicia</strong> en el marco de la incubadora <strong>startTIC</strong> (Consorcio Zona Franca de Vigo / Gradiant / FEDER)</span>
      </div>
    </div>
  </div>
</section>

<style>
  .construye-cta-section {
    position: relative;
    padding: 6rem 0;
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: -1;
  }

  .orb-1 {
    top: 20%;
    left: 20%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.18) 0%, rgba(249, 115, 22, 0) 70%);
  }

  .orb-2 {
    bottom: 10%;
    right: 20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.12) 0%, rgba(0, 242, 254, 0) 70%);
  }

  .cta-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(10, 15, 29, 0.95) 100%);
    border: 1px solid rgba(249, 115, 22, 0.35);
    border-radius: var(--radius-lg);
    padding: 4rem 2.5rem;
    text-align: center;
    position: relative;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.6);
  }

  .cta-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #FDBA74;
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.35);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }

  .cta-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-main);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #FB923C 0%, #F97316 60%, #00F2FE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cta-description {
    max-width: 740px;
    margin: 0 auto 2.8rem;
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    justify-content: center;
    margin-bottom: 2.8rem;
  }

  .btn-primary-cta,
  .btn-secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    font-size: 0.98rem;
    padding: 0.9rem 1.8rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-primary-cta {
    background: linear-gradient(135deg, #F97316 0%, #EA580C 100%);
    color: #FFFFFF;
    border: none;
    box-shadow: 0 4px 20px rgba(249, 115, 22, 0.4);
  }

  .btn-primary-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(249, 115, 22, 0.6);
  }

  .btn-secondary-cta {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    border: 1px solid var(--border-light);
  }

  .btn-secondary-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .cta-trust-note {
    font-size: 0.85rem;
    color: var(--text-dim);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.5rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .cta-trust-note strong {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .cta-card {
      padding: 3rem 1.5rem;
    }
    .cta-buttons {
      flex-direction: column;
    }
    .btn-primary-cta,
    .btn-secondary-cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
