---
---

<section id="arquitectura" class="ecosystem-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Arquitectura del Ecosistema</span>
      <h2 class="section-title">
        El Puente Mecánico: <span class="gradient-text-orange">Estándar Duplo 31,80 mm</span>
      </h2>
      <p class="section-subtitle">
        Una sola matriz física interoperable que se bifurca en dos universos de software rigurosamente delimitados: la escuela infantil comunitaria (LOMLOE) y la terapia clínica de neurodesarrollo.
      </p>
    </div>

    <!-- Interactive Diagram Card -->
    <div class="diagram-wrapper">
      <div class="diagram-core">
        <div class="core-badge">ESTÁNDAR MECÁNICO CENTRAL</div>
        <div class="core-title">Matriz Modular Duplo (31,80 mm Stud Pitch)</div>
        <p class="core-desc">
          Piezas Núcleo (Core): Placas 8×8, bloques base 2×2 y 2×4, rampas continuas 15°/30° y ejes de giro modular. Tolerancias milimétricas en Blender 4.x headless vía Python <code>bpy</code>.
        </p>
        <div class="core-specs-row">
          <span class="spec-pill">Paso: 31,80 mm</span>
          <span class="spec-pill">Tetón: Ø 9,40 mm × 4,50 mm</span>
          <span class="spec-pill">Tubo Clutch: Øext 13,20 mm</span>
          <span class="spec-pill">Seguridad: EN 71-1 (> 31,75 mm)</span>
        </div>
      </div>

      <!-- Connector Lines in SVG -->
      <div class="connector-svg-container" aria-hidden="true">
        <svg viewBox="0 0 1000 70" preserveAspectRatio="none" class="connector-svg">
          <path d="M 500 0 L 500 35 L 250 35 L 250 70" stroke="#00F2FE" stroke-width="2.5" fill="none" stroke-dasharray="6 4"/>
          <path d="M 500 0 L 500 35 L 750 35 L 750 70" stroke="#C084FC" stroke-width="2.5" fill="none" stroke-dasharray="6 4"/>
          <circle cx="500" cy="0" r="5" fill="#FB923C"/>
          <circle cx="250" cy="70" r="5" fill="#00F2FE"/>
          <circle cx="750" cy="70" r="5" fill="#C084FC"/>
        </svg>
      </div>

      <!-- Bifurcation Columns -->
      <div class="bifurcation-grid">
        <!-- Gama Descubre con Lúa -->
        <div class="branch-card branch-lua">
          <div class="branch-header">
            <div class="branch-icon-pill icon-teal">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>
            <div>
              <span class="branch-tag tag-teal">Escuela / LOMLOE / STEAM</span>
              <h3 class="branch-title">Gama «Descubre con Lúa»</h3>
            </div>
          </div>

          <div class="branch-block">
            <h4 class="block-subtitle">Piezas Físicas de Manipulación</h4>
            <ul class="feature-list">
              <li>
                <span class="bullet bullet-teal"></span>
                <strong>Baldosas de dirección plana:</strong> guiado lineal y cambios de sentido para la gata Lúa.
              </li>
              <li>
                <span class="bullet bullet-teal"></span>
                <strong>Ranuras continuas de 12 mm:</strong> conducción de esferas y marcadores tangibles.
              </li>
              <li>
                <span class="bullet bullet-teal"></span>
                <strong>Bloques huecos resonadores:</strong> percusión rítmica vinculada a consignas de aula.
              </li>
              <li>
                <span class="bullet bullet-teal"></span>
                <strong>Fichas algorítmicas de giro:</strong> introducción intuitiva al pensamiento computacional.
              </li>
            </ul>
          </div>

          <div class="branch-bridge-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
            <span>Sincronización de Software Offline</span>
          </div>

          <div class="software-layer layer-lua">
            <div class="software-header">
              <span class="software-tag">App Descubre con Lúa (Flutter)</span>
            </div>
            <ul class="software-features">
              <li><code>assets/content/steam/*.json</code> bilingüe (gl/es)</li>
              <li>Trazado vectorial en <code>CustomPainter</code> (cero emojis)</li>
              <li>Consignas TPR English pregrabadas con hash SHA-256</li>
              <li><strong>Zero-Network & Zero-PHI:</strong> Sin red ni datos infantiles</li>
            </ul>
          </div>
        </div>

        <!-- Gama Valeria -->
        <div class="branch-card branch-valeria">
          <div class="branch-header">
            <div class="branch-icon-pill icon-purple">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
              </svg>
            </div>
            <div>
              <span class="branch-tag tag-purple">Hogar / Clínica / Estimulación</span>
              <h3 class="branch-title">Gama «Valeria»</h3>
            </div>
          </div>

          <div class="branch-block">
            <h4 class="block-subtitle">Piezas Físicas Terapéuticas</h4>
            <ul class="feature-list">
              <li>
                <span class="bullet bullet-purple"></span>
                <strong>Relieves hápticos y sensoriales:</strong> estimulación táctil palmar con estrías calibradas.
              </li>
              <li>
                <span class="bullet bullet-purple"></span>
                <strong>Cilindros de prensión gradual:</strong> entrenamiento de fuerza bimanual y pinza digital.
              </li>
              <li>
                <span class="bullet bullet-purple"></span>
                <strong>Canales para praxias de soplo:</strong> control aerodinámico y modulación fonatoria.
              </li>
              <li>
                <span class="bullet bullet-purple"></span>
                <strong>Pesos propioceptivos calibrados:</strong> discriminación de masa y tono postural.
              </li>
            </ul>
          </div>

          <div class="branch-bridge-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
            <span>Sincronización Clínica & Hitos</span>
          </div>

          <div class="software-layer layer-valeria">
            <div class="software-header">
              <span class="software-tag">Ecosistema Valeria+ & VIA+</span>
            </div>
            <ul class="software-features">
              <li>Plataforma de soporte clínico y registro de sesiones</li>
              <li>Registro longitudinal de hitos de neurodesarrollo</li>
              <li>Cribado estandarizado según protocolos validados</li>
              <li><strong>Marco Regulatorio:</strong> Cumplimiento MDR (UE) 2017/745 y RGPD</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparative Table -->
    <div class="comparison-panel">
      <h3 class="comparison-title">Frontera Regulatoria y Pedagógica Innegociable</h3>
      <div class="table-responsive">
        <table class="bridge-table">
          <thead>
            <tr>
              <th>Criterio Arquitectónico</th>
              <th>Gama «Descubre con Lúa» (Escuela)</th>
              <th>Gama «Valeria» (Clínica / Hogar)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Finalidad Primaria</strong></td>
              <td>Educativa, STEAM y juego vivencial guiado en aula (LOMLOE).</td>
              <td>Estimulación neurosensorial, rehabilitación motriz y lenguaje.</td>
            </tr>
            <tr>
              <td><strong>Operador del Sistema</strong></td>
              <td>Docente o educadora en asamblea grupal de 5-8 minutos.</td>
              <td>Persona cuidadora / terapeuta en sesión individualizada.</td>
            </tr>
            <tr>
              <td><strong>Interacción Pantalla</strong></td>
              <td><strong>Cero pantallas para el menor:</strong> La app solo guía al adulto.</td>
              <td>Adulto monitoriza; actividades físicas sin anclaje visual forzado.</td>
            </tr>
            <tr>
              <td><strong>Régimen Normativo</strong></td>
              <td>Directiva 2009/48/CE (Juguetes) y EN 71-1. No es producto sanitario.</td>
              <td>Frontera regulatoria MDR 2017/745 Clase I / Zero-PHI estricto.</td>
            </tr>
            <tr>
              <td><strong>Conectividad</strong></td>
              <td>100% Offline (Zero-Network en binario APK sin permiso INTERNET).</td>
              <td>Operación local sin persistencia biométrica no autorizada.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .ecosystem-section {
    padding: 5rem 0;
    position: relative;
    background: linear-gradient(180deg, rgba(7, 9, 14, 0) 0%, rgba(15, 23, 42, 0.4) 50%, rgba(7, 9, 14, 0) 100%);
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #FB923C;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #FB923C 0%, #F97316 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Diagram Wrapper */
  .diagram-wrapper {
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    margin-bottom: 3.5rem;
  }

  .diagram-core {
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.12) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid rgba(249, 115, 22, 0.4);
    border-radius: var(--radius-md);
    padding: 2rem;
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    position: relative;
    box-shadow: 0 8px 30px rgba(249, 115, 22, 0.12);
  }

  .core-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #FDBA74;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .core-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
  }

  .core-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .core-desc code {
    color: #67E8F9;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
  }

  .core-specs-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .spec-pill {
    font-size: 0.8rem;
    font-weight: 600;
    color: #FDBA74;
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.35);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  /* SVG Connectors */
  .connector-svg-container {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    height: 60px;
  }

  .connector-svg {
    width: 100%;
    height: 100%;
  }

  /* Bifurcation Grid */
  .bifurcation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .branch-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .branch-lua:hover {
    border-color: rgba(0, 242, 254, 0.4);
    box-shadow: 0 12px 30px rgba(0, 242, 254, 0.08);
  }

  .branch-valeria:hover {
    border-color: rgba(192, 132, 252, 0.4);
    box-shadow: 0 12px 30px rgba(192, 132, 252, 0.08);
  }

  .branch-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .branch-icon-pill {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-teal {
    background: rgba(0, 242, 254, 0.15);
    color: #00F2FE;
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .icon-purple {
    background: rgba(192, 132, 252, 0.15);
    color: #C084FC;
    border: 1px solid rgba(192, 132, 252, 0.3);
  }

  .branch-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .tag-teal { color: #67E8F9; }
  .tag-purple { color: #D8B4FE; }

  .branch-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .block-subtitle {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .feature-list li {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    position: relative;
    padding-left: 1.4rem;
  }

  .bullet {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .bullet-teal { background: #00F2FE; box-shadow: 0 0 6px #00F2FE; }
  .bullet-purple { background: #C084FC; box-shadow: 0 0 6px #C084FC; }

  .feature-list strong {
    color: var(--text-main);
  }

  .branch-bridge-arrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-dim);
    margin: 0.5rem 0 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .software-layer {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 1.2rem;
  }

  .layer-lua { border-left: 3px solid #00F2FE; }
  .layer-valeria { border-left: 3px solid #C084FC; }

  .software-header {
    margin-bottom: 0.75rem;
  }

  .software-tag {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .software-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .software-features code {
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    color: #FDBA74;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
  }

  /* Comparison Panel */
  .comparison-panel {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 2.2rem;
  }

  .comparison-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .bridge-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .bridge-table th {
    background: rgba(255, 255, 255, 0.04);
    padding: 1rem 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-light);
  }

  .bridge-table td {
    padding: 1rem 1.2rem;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    vertical-align: top;
    line-height: 1.5;
  }

  .bridge-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  @media (max-width: 900px) {
    .bifurcation-grid {
      grid-template-columns: 1fr;
    }
    .connector-svg-container {
      display: none;
    }
  }
</style>
