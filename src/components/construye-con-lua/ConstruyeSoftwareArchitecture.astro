---
---

<section id="software-flutter" class="software-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Integración en Flutter</span>
      <h2 class="section-title">
        Arquitectura de Software en <span class="gradient-text-orange">Descubre con Lúa</span>
      </h2>
      <p class="section-subtitle">
        Diseño bajo principios innegociables de austeridad técnica: cero paquetes externos de renderizado, trazado vectorial directo en Canvas, corpus vocal pregrabado con hashes SHA-256 y arquitectura Zero-Network / Zero-PHI.
      </p>
    </div>

    <!-- 4 Inviolable Technical Principles -->
    <div class="principles-row">
      <div class="principle-card">
        <div class="pr-icon">🚫 📦</div>
        <h4>Cero Paquetes Externos</h4>
        <p>Trazado matemático nativo en <code>CustomPainter</code>. Ni una sola librería pesada en <code>pubspec.yaml</code>.</p>
      </div>
      <div class="principle-card">
        <div class="pr-icon">🔒 🌐</div>
        <h4>Zero-Network Estructural</h4>
        <p>Binario APK de release compilado sin permiso <code>android.permission.INTERNET</code>. 100% offline.</p>
      </div>
      <div class="principle-card">
        <div class="pr-icon">✏️ 📐</div>
        <h4>Cero Emojis o Fuentes Volátiles</h4>
        <p>Toda la iconografía se dibuja proceduralmente con primitivas geométricas de Flutter Canvas.</p>
      </div>
      <div class="principle-card">
        <div class="pr-icon">🛡️ 👶</div>
        <h4>Zero-PHI & Cero Inferencia IA</h4>
        <p>Sin cuentas, sin persistencia de biometría infantil y modelos de voz pre-compilados en build time.</p>
      </div>
    </div>

    <!-- File Tree & JSON / Dart Showcase -->
    <div class="software-grid">
      <!-- File Structure -->
      <div class="file-tree-card">
        <div class="tree-header">
          <span class="tree-title">Estructura del Proyecto en Flutter</span>
          <span class="tree-badge">Descubre con Lúa</span>
        </div>
        <div class="tree-content">
          <div class="tree-item folder">
            <span class="tree-icon">📁</span> assets/content/steam/
          </div>
          <div class="tree-item file file-sub">
            <span class="tree-icon">📄</span> <strong>sets_construccion.json</strong>
            <span class="file-desc">Retos e inventario bilingüe (gl/es) + hashes SHA</span>
          </div>
          <div class="tree-item folder">
            <span class="tree-icon">📁</span> lib/data/models/
          </div>
          <div class="tree-item file file-sub">
            <span class="tree-icon">📄</span> <strong>steam_set.dart</strong>
            <span class="file-desc">Modelo inmutable y tipado estricto con fromJson</span>
          </div>
          <div class="tree-item folder">
            <span class="tree-icon">📁</span> lib/features/juega/
          </div>
          <div class="tree-item file file-sub">
            <span class="tree-icon">📄</span> <strong>steam_silueta_painter.dart</strong>
            <span class="file-desc">Trazador vectorial autónomo en Canvas</span>
          </div>
          <div class="tree-item folder">
            <span class="tree-icon">📁</span> tools/
          </div>
          <div class="tree-item file file-sub">
            <span class="tree-icon">⚙️</span> <strong>check_steam_sets.py</strong>
            <span class="file-desc">Gate CI de integridad bilingüe y hashes SHA-256</span>
          </div>
        </div>
      </div>

      <!-- JSON Data Card -->
      <div class="code-card">
        <div class="code-header">
          <div class="code-title-group">
            <span class="code-icon">📋</span>
            <span class="code-filename">assets/content/steam/sets_construccion.json</span>
          </div>
          <span class="code-lang">JSON</span>
        </div>
        <pre class="code-display"><code><span class="punct">&#123;</span>
  <span class="key">"sets"</span><span class="punct">:</span> <span class="punct">[</span>
    <span class="punct">&#123;</span>
      <span class="key">"id"</span><span class="punct">:</span> <span class="str">"lua_caminos_algoritmos"</span><span class="punct">,</span>
      <span class="key">"curso"</span><span class="punct">:</span> <span class="str">"3-4"</span><span class="punct">,</span>
      <span class="key">"titulo"</span><span class="punct">:</span> <span class="punct">&#123;</span>
        <span class="key">"gl"</span><span class="punct">:</span> <span class="str">"Lúa Camiños: Algoritmos na alfombra"</span><span class="punct">,</span>
        <span class="key">"es"</span><span class="punct">:</span> <span class="str">"Lúa Caminos: Algoritmos en la alfombra"</span>
      <span class="punct">&#123;</span><span class="punct">,</span>
      <span class="key">"obxectivo"</span><span class="punct">:</span> <span class="punct">&#123;</span>
        <span class="key">"gl"</span><span class="punct">:</span> <span class="str">"Descubrir que as ordes van paso a paso e que un xiro cambia a dirección."</span><span class="punct">,</span>
        <span class="key">"es"</span><span class="punct">:</span> <span class="str">"Descubrir que las órdenes van paso a paso y que un giro cambia la dirección."</span>
      <span class="punct">&#125;</span><span class="punct">,</span>
      <span class="key">"aviso_seguridade"</span><span class="punct">:</span> <span class="punct">&#123;</span>
        <span class="key">"gl"</span><span class="punct">:</span> <span class="str">"Supervisión continuada da persoa adulta. Pezas maiores de 31 mm."</span><span class="punct">,</span>
        <span class="key">"es"</span><span class="punct">:</span> <span class="str">"Supervisión continuada de la persona adulta. Piezas mayores de 31 mm."</span>
      <span class="punct">&#125;</span><span class="punct">,</span>
      <span class="key">"inventario"</span><span class="punct">:</span> <span class="punct">[</span>
        <span class="punct">&#123;</span> <span class="key">"id"</span><span class="punct">:</span> <span class="str">"lua_recta"</span><span class="punct">,</span> <span class="key">"cantidade"</span><span class="punct">:</span> <span class="num">4</span><span class="punct">,</span> <span class="key">"silueta"</span><span class="punct">:</span> <span class="str">"ranura_recta"</span> <span class="punct">&#125;</span><span class="punct">,</span>
        <span class="punct">&#123;</span> <span class="key">"id"</span><span class="punct">:</span> <span class="str">"lua_curva"</span><span class="punct">,</span> <span class="key">"cantidade"</span><span class="punct">:</span> <span class="num">4</span><span class="punct">,</span> <span class="key">"silueta"</span><span class="punct">:</span> <span class="str">"ranura_curva"</span> <span class="punct">&#125;</span><span class="punct">,</span>
        <span class="punct">&#123;</span> <span class="key">"id"</span><span class="punct">:</span> <span class="str">"val_textura"</span><span class="punct">,</span> <span class="key">"cantidade"</span><span class="punct">:</span> <span class="num">2</span><span class="punct">,</span> <span class="key">"silueta"</span><span class="punct">:</span> <span class="str">"relieve_ondas"</span><span class="punct">,</span> <span class="key">"orixe"</span><span class="punct">:</span> <span class="str">"valeria"</span> <span class="punct">&#125;</span>
      <span class="punct">]</span><span class="punct">,</span>
      <span class="key">"retos"</span><span class="punct">:</span> <span class="punct">[</span>
        <span class="punct">&#123;</span>
          <span class="key">"fase"</span><span class="punct">:</span> <span class="num">1</span><span class="punct">,</span>
          <span class="key">"consigna"</span><span class="punct">:</span> <span class="punct">&#123;</span>
            <span class="key">"gl"</span><span class="punct">:</span> <span class="str">"Colocade dúas pezas rectas e pasade a gata con dous pasos."</span><span class="punct">,</span>
            <span class="key">"es"</span><span class="punct">:</span> <span class="str">"Colocad dos piezas rectas y pasad a la gata con dos pasos."</span>
          <span class="punct">&#125;</span><span class="punct">,</span>
          <span class="key">"tpr"</span><span class="punct">:</span> <span class="punct">&#123;</span>
            <span class="key">"texto"</span><span class="punct">:</span> <span class="str">"Step forward"</span><span class="punct">,</span>
            <span class="key">"audio_sha"</span><span class="punct">:</span> <span class="str">"sha256_b2938a192847cdef4829104829104829..."</span>
          <span class="punct">&#125;</span>
        <span class="punct">&#125;</span>
      <span class="punct">]</span>
    <span class="punct">&#125;</span>
  <span class="punct">]</span>
<span class="punct">&#125;</span></code></pre>
      </div>

      <!-- Dart CustomPainter Card -->
      <div class="code-card code-card-full">
        <div class="code-header">
          <div class="code-title-group">
            <span class="code-icon">🎯</span>
            <span class="code-filename">lib/features/juega/steam_silueta_painter.dart</span>
          </div>
          <span class="code-lang">Dart (Flutter Canvas)</span>
        </div>
        <pre class="code-display"><code><span class="kw">import</span> <span class="str">'package:flutter/material.dart'</span>;

<span class="doc">/// Dibuja vectorialmente las siluetas del inventario sin fuentes ni imágenes externas.</span>
<span class="kw">class</span> <span class="fn">SteamSiluetaPainter</span> <span class="kw">extends</span> <span class="builtin">CustomPainter</span> <span class="punct">&#123;</span>
  <span class="kw">final</span> <span class="builtin">String</span> silueta;
  <span class="kw">final</span> <span class="builtin">Color</span> color;

  <span class="kw">const</span> <span class="fn">SteamSiluetaPainter</span><span class="punct">(</span><span class="punct">&#123;</span>
    <span class="kw">required</span> <span class="kw">this</span>.silueta,
    <span class="kw">required</span> <span class="kw">this</span>.color,
  <span class="punct">&#125;</span><span class="punct">)</span>;

  <span class="kw">@override</span>
  <span class="builtin">void</span> <span class="fn">paint</span><span class="punct">(</span><span class="builtin">Canvas</span> canvas, <span class="builtin">Size</span> size<span class="punct">)</span> <span class="punct">&#123;</span>
    <span class="kw">final</span> paint = <span class="builtin">Paint</span><span class="punct">(</span><span class="punct">)</span>
      ..color = color
      ..style = <span class="builtin">PaintingStyle</span>.stroke
      ..strokeWidth = <span class="num">2.0</span>
      ..strokeCap = <span class="builtin">StrokeCap</span>.round;

    <span class="kw">final</span> w = size.width;
    <span class="kw">final</span> h = size.height;

    <span class="kw">switch</span> <span class="punct">(</span>silueta<span class="punct">)</span> <span class="punct">&#123;</span>
      <span class="kw">case</span> <span class="str">'ranura_recta'</span>:
        <span class="comm">// Bloque con canal central recto</span>
        canvas.drawRect<span class="punct">(</span><span class="builtin">Rect</span>.fromLTWH<span class="punct">(</span><span class="num">0</span>, <span class="num">0</span>, w, h<span class="punct">)</span>, paint<span class="punct">)</span>;
        paint.strokeWidth = <span class="num">3.0</span>;
        canvas.drawLine<span class="punct">(</span><span class="builtin">Offset</span><span class="punct">(</span>w / <span class="num">2</span>, <span class="num">0</span><span class="punct">)</span>, <span class="builtin">Offset</span><span class="punct">(</span>w / <span class="num">2</span>, h<span class="punct">)</span>, paint<span class="punct">)</span>;
        <span class="kw">break</span>;

      <span class="kw">case</span> <span class="str">'ranura_curva'</span>:
        <span class="comm">// Bloque con canal en arco cuadrante</span>
        canvas.drawRect<span class="punct">(</span><span class="builtin">Rect</span>.fromLTWH<span class="punct">(</span><span class="num">0</span>, <span class="num">0</span>, w, h<span class="punct">)</span>, paint<span class="punct">)</span>;
        <span class="kw">final</span> path = <span class="builtin">Path</span><span class="punct">(</span><span class="punct">)</span>
          ..moveTo<span class="punct">(</span><span class="num">0</span>, h / <span class="num">2</span><span class="punct">)</span>
          ..quadraticBezierTo<span class="punct">(</span>w / <span class="num">2</span>, h / <span class="num">2</span>, w / <span class="num">2</span>, h<span class="punct">)</span>;
        canvas.drawPath<span class="punct">(</span>path, paint<span class="punct">)</span>;
        <span class="kw">break</span>;

      <span class="kw">case</span> <span class="str">'relieve_ondas'</span>:
        <span class="comm">// Pieza sensorial tipo Valeria: estrías táctiles</span>
        canvas.drawRect<span class="punct">(</span><span class="builtin">Rect</span>.fromLTWH<span class="punct">(</span><span class="num">0</span>, <span class="num">0</span>, w, h<span class="punct">)</span>, paint<span class="punct">)</span>;
        <span class="kw">for</span> <span class="punct">(</span><span class="kw">var</span> i = <span class="num">1</span>; i &lt;= <span class="num">3</span>; i++<span class="punct">)</span> <span class="punct">&#123;</span>
          <span class="kw">final</span> y = h * <span class="punct">(</span>i / <span class="num">4.0</span><span class="punct">)</span>;
          canvas.drawLine<span class="punct">(</span><span class="builtin">Offset</span><span class="punct">(</span>w * <span class="num">0.2</span>, y<span class="punct">)</span>, <span class="builtin">Offset</span><span class="punct">(</span>w * <span class="num">0.8</span>, y<span class="punct">)</span>, paint<span class="punct">)</span>;
        <span class="punct">&#125;</span>
        <span class="kw">break</span>;

      <span class="kw">default</span>:
        <span class="comm">// Contenedor modular neutro</span>
        canvas.drawRect<span class="punct">(</span><span class="builtin">Rect</span>.fromLTWH<span class="punct">(</span><span class="num">0</span>, <span class="num">0</span>, w, h<span class="punct">)</span>, paint<span class="punct">)</span>;
    <span class="punct">&#125;</span>
  <span class="punct">&#125;</span>

  <span class="kw">@override</span>
  <span class="builtin">bool</span> <span class="fn">shouldRepaint</span><span class="punct">(</span><span class="kw">covariant</span> <span class="fn">SteamSiluetaPainter</span> oldDelegate<span class="punct">)</span> <span class="punct">&#123;</span>
    <span class="kw">return</span> oldDelegate.silueta != silueta || oldDelegate.color != color;
  <span class="punct">&#125;</span>
<span class="punct">&#125;</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .software-section {
    padding: 5rem 0;
    position: relative;
    background: linear-gradient(180deg, rgba(7, 9, 14, 0) 0%, rgba(15, 23, 42, 0.5) 50%, rgba(7, 9, 14, 0) 100%);
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #00F2FE;
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.3);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #FB923C 0%, #F97316 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Principles Row */
  .principles-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .principle-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.2rem;
    text-align: left;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .principle-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .pr-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .principle-card h4 {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .principle-card p {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .principle-card code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    color: #67E8F9;
    font-family: 'JetBrains Mono', monospace;
  }

  /* Software Grid */
  .software-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 2rem;
  }

  .code-card-full {
    grid-column: 1 / -1;
  }

  /* File Tree Card */
  .file-tree-card {
    background: #060913;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .tree-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid var(--border-light);
  }

  .tree-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .tree-badge {
    font-size: 0.72rem;
    color: #00F2FE;
    background: rgba(0, 242, 254, 0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .tree-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84rem;
  }

  .tree-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tree-item.folder {
    color: #FDBA74;
    font-weight: 600;
  }

  .tree-item.file-sub {
    padding-left: 1.5rem;
    color: #E2E8F0;
  }

  .file-desc {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-body);
    margin-left: 0.25rem;
  }

  /* Code Card */
  .code-card {
    background: #060913;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid var(--border-light);
  }

  .code-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .code-filename {
    font-size: 0.82rem;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-main);
  }

  .code-lang {
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', monospace;
    color: #FDBA74;
    background: rgba(249, 115, 22, 0.12);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .code-display {
    margin: 0;
    padding: 1.25rem 1.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #E2E8F0;
    overflow-x: auto;
    background: #04060d;
    max-height: 520px;
  }

  .key { color: #67E8F9; }
  .str { color: #34D399; }
  .num { color: #F59E0B; }
  .punct { color: #94A3B8; }
  .kw { color: #F43F5E; font-weight: 600; }
  .fn { color: #38BDF8; font-weight: 600; }
  .builtin { color: #A78BFA; }
  .doc { color: #94A3B8; font-style: italic; }
  .comm { color: #64748B; font-style: italic; }

  @media (max-width: 960px) {
    .principles-row {
      grid-template-columns: repeat(2, 1fr);
    }
    .software-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .principles-row {
      grid-template-columns: 1fr;
    }
  }
</style>
