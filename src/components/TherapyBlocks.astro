---
const lingCheck = {
  icon: "⚡",
  title: "Test de Ling (6 Sonidos)",
  category: "Comprobación Previa",
  desc: "Chequeo rápido con los 6 fonemas [a, i, u, m, s, ʃ] para verificar audífonos e implantes cocleares antes de ejercitar.",
  badge: "Pre-Sesión",
  tags: ["6 Fonemas Ling", "Frecuencias Espectrales", "Vital en Hipoacusia"]
};

const blocks = [
  {
    num: "01",
    icon: "🎧",
    title: "Integración Sensorial SOR",
    category: "Sobre-Responsividad",
    desc: "Desensibilización progresiva ante ruidos cotidianos fuertes (aspiradora, secador, aula). Muro de control adulto donde pausar siempre suma puntos.",
    badge: "SOR Acústico",
    badgeColor: "cyan"
  },
  {
    num: "02",
    icon: "🐱",
    title: "Aventuras con Lúa",
    category: "Lúa y las Palabras",
    desc: "105 actividades en 6 franjas de edad (0-2 a 7-10): juegos de selección, preguntas interactivas, cuentos ilustrados y canciones habladas a pulso.",
    badge: "105 Actividades",
    badgeColor: "purple"
  },
  {
    num: "03",
    icon: "🗣️",
    title: "Pares Mínimos D7",
    category: "Dislalias y Habla",
    desc: "15 pares contrastados en 6 grupos de articulación. Algoritmo D7 O2 que compara contra ambas palabras para eliminar falsos positivos de error.",
    badge: "Algoritmo O2",
    badgeColor: "cyan"
  },
  {
    num: "04",
    icon: "🧩",
    title: "Expansión Semántica",
    category: "Léxico y Comprensión",
    desc: "66 pictogramas propios en píxel art. Práctica en doble vuelta: el menor primero señala la imagen correcta y luego articula la palabra.",
    badge: "Doble Vuelta",
    badgeColor: "emerald"
  },
  {
    num: "05",
    icon: "👂",
    title: "Audición (ACOPROS)",
    category: "Auditivo-Verbal",
    desc: "Protocolo clínico auditivo-verbal: discriminación fonética fina y comprensión en ruido babble graduable simulando entornos escolares reales.",
    badge: "Validado ACOPROS",
    badgeColor: "purple"
  },
  {
    num: "06",
    icon: "💬",
    title: "Lenguaje Temprano",
    category: "Estimulación Familiar",
    desc: "Atención conjunta triangulada, imitación progresiva (gesto → sílaba → palabra) y rutinas comunicativas funcionales con objetos del hogar.",
    badge: "Rutina Diaria",
    badgeColor: "cyan"
  },
  {
    num: "07",
    icon: "🧠",
    title: "TEA (Espectro Autista)",
    category: "PRT + Conductual",
    desc: "Atención conjunta con Time Delay, quiebres pragmáticos y anticipación estructurada con estresores 100% regulados a mano por la familia.",
    badge: "Estresores Manuales",
    badgeColor: "amber"
  },
  {
    num: "08",
    icon: "📖",
    title: "Dislexia y Fonología",
    category: "Conciencia Fonológica",
    desc: "Intruso fonológico puramente auditivo, criba de pseudopalabras, mapa visual de rotaciones b/d · p/q y denominación rápida automatizada.",
    badge: "Criba Fonológica",
    badgeColor: "purple"
  },
  {
    num: "09",
    icon: "✏️",
    title: "La Pizarra Mágica",
    category: "Grafomotricidad",
    desc: "18 trazos guiados en SVG sobre pauta Montessori con puntos numerados (1, 2, 3) que fijan el orden motriz exacto de letras críticas.",
    badge: "18 Trazos SVG",
    badgeColor: "emerald"
  },
  {
    num: "10",
    icon: "🎯",
    title: "Realidad Aumentada 3D",
    category: "Sensor Orofacial",
    desc: "Cámara frontal como sensor cinemático orofacial sin micrófono activo (ARCore + MediaPipe + Filament 3D), garantizando privacidad absoluta.",
    badge: "ARCore + MediaPipe",
    badgeColor: "cyan"
  }
];
---

<section id="bloques-clinicos" class="therapy-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Intervención Estructurada</span>
      <h2>10 Bloques Clínicos + <span class="gradient-text">Test de Ling</span></h2>
      <p>Progresión clínica integral: desde el chequeo rápido de prótesis auditivas hasta la pronunciación, la lectura y la motricidad 3D.</p>
    </div>

    <!-- Ling Check Highlight Bar - Perfectly Centered -->
    <div class="ling-banner glass-card" id="terapias">
      <div class="ling-icon">{lingCheck.icon}</div>
      <div class="ling-text">
        <div class="ling-header-row">
          <span class="badge badge-amber">{lingCheck.badge}</span>
          <span class="ling-cat">{lingCheck.category}</span>
        </div>
        <h3>{lingCheck.title}</h3>
        <p>{lingCheck.desc}</p>
      </div>
      <div class="ling-tags">
        {lingCheck.tags.map((tag) => (
          <span class="ling-tag-item">{tag}</span>
        ))}
      </div>
    </div>

    <!-- 10 Blocks Grid - Clean, Centered & Minimalist -->
    <div class="blocks-grid">
      {blocks.map((block) => (
        <div class="glass-card block-card">
          <div class="block-top">
            <span class="block-num">BLOQUE {block.num}</span>
            <span class={`badge badge-${block.badgeColor}`}>{block.badge}</span>
          </div>

          <div class="block-icon">{block.icon}</div>
          <span class="block-category">{block.category}</span>
          <h3>{block.title}</h3>
          <p class="block-desc">{block.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .therapy-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.15);
    border-top: 1px solid var(--border-light);
  }

  /* Ling Banner - Centered */
  .ling-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 2rem 2.5rem;
    margin-bottom: 2.5rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(15, 23, 42, 0.7) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .ling-icon {
    font-size: 2rem;
    background: rgba(245, 158, 11, 0.15);
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    flex-shrink: 0;
  }

  .ling-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    max-width: 680px;
  }

  .ling-header-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .ling-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-amber);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ling-text h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
    text-align: center;
  }

  .ling-text p {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    text-align: center;
  }

  .ling-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .ling-tag-item {
    font-size: 0.78rem;
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-light);
    text-align: center;
    white-space: nowrap;
  }

  /* Blocks Grid - Centered Cards */
  .blocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .block-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .block-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .block-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .block-num {
    font-family: var(--font-heading);
    font-size: 0.725rem;
    font-weight: 800;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }

  .block-icon {
    font-size: 2.2rem;
    margin-bottom: 0.75rem;
  }

  .block-category {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
    text-align: center;
  }

  .block-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-main);
    text-align: center;
  }

  .block-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
    text-align: center;
  }

  @media (max-width: 768px) {
    .ling-banner {
      padding: 1.5rem;
    }
  }
</style>
