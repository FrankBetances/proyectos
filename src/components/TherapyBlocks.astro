---

<section id="bloques-clinicos" class="therapy-section section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Intervención Estructurada</span>
      <h2>10 Bloques Clínicos + <span class="gradient-text">Test de Ling</span></h2>
      <p>Progresión clínica integral: desde el chequeo rápido de prótesis auditivas hasta la pronunciación, la lectura y la Realidad Aumentada 3D.</p>
    </div>

    <!-- Ling Check Highlight Bar -->
    <div class="ling-banner glass-card" id="terapias">
      <div class="ling-left">
        <span class="ling-icon">{lingCheck.icon}</span>
        <div>
          <div class="ling-tag-row">
            <span class="badge badge-amber">{lingCheck.badge}</span>
            <span class="ling-cat">{lingCheck.category}</span>
          </div>
          <h3>{lingCheck.title}</h3>
          <p>{lingCheck.desc}</p>
        </div>
      </div>
      <div class="ling-bullets">
        {lingCheck.bullets.map((b) => (
          <div class="ling-bullet-item">
            <span class="check-bullet">✓</span>
            <span>{b}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 10 Blocks Grid -->
    <div class="blocks-grid">
      {blocks.map((block) => (
        <div class="glass-card block-card">
          <div class="block-top">
            <div class="block-id-group">
              <span class="block-num">{block.num}</span>
              <span class="block-icon">{block.icon}</span>
            </div>
            <span class={`badge badge-${block.badgeColor}`}>{block.badge}</span>
          </div>

          <span class="block-category">{block.category}</span>
          <h3>{block.title}</h3>
          <p class="block-desc">{block.desc}</p>

          <ul class="block-items">
            {block.bullets.map((item) => (
              <li>
                <span class="check-bullet">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .therapy-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.15);
    border-top: 1px solid var(--border-light);
  }

  /* Ling Banner */
  .ling-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 2rem;
    margin-bottom: 2.5rem;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(15, 23, 42, 0.7) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .ling-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 650px;
  }

  .ling-icon {
    font-size: 2rem;
    background: rgba(245, 158, 11, 0.15);
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ling-tag-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .ling-cat {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-amber);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ling-left h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .ling-left p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  .ling-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .ling-bullet-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-main);
  }

  /* Blocks Grid */
  .blocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.5rem;
  }

  .block-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    position: relative;
  }

  .block-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .block-id-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .block-num {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .block-icon {
    font-size: 1.5rem;
  }

  .block-category {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .block-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .block-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .block-items {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-light);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .block-items li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-main);
    line-height: 1.4;
  }

  .check-bullet {
    color: var(--accent-emerald);
    font-weight: bold;
    font-size: 0.85rem;
    line-height: 1;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .ling-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
