---
const blocks = [
  {
    id: "ling",
    icon: "👂",
    title: "Test de Ling (6 Sonidos)",
    category: "Comprobación Previa",
    desc: "Evaluación de detección auditiva básica con los 6 sonidos del Test de Ling [a, i, u, m, s, ʃ] previa a la sesión con audífono o implante coclear.",
    badge: "Protocolo Clínico",
    badgeColor: "amber",
    items: ["Detección inmediata", "Registro de audífono/implante", "Sin fatiga auditiva"]
  },
  {
    id: "pares",
    icon: "🗣️",
    title: "Pares Mínimos",
    category: "Dislalias Fonológicas",
    desc: "15 pares contrastivos (rana/lana, rata/lata) en 6 grupos de consonantes. Evaluador D7 (vecino más cercano O2 con 35/35 contrastes) y sello doble adulto-niño.",
    badge: "15 Pares · D7 (O2)",
    badgeColor: "cyan",
    items: ["Rotacismo y sigmatismo", "Evaluador O2 (35/35 contrastes)", "Sin frases portadoras redundantes"]
  },
  {
    id: "expansion",
    icon: "🧩",
    title: "Expansión Semántica",
    category: "Intervención Temprana",
    desc: "Progresión léxica estructurada: 5 escenarios diarios, 5 categorías léxicas por familiaridad, 9 progresiones de campo semántico y 8 cápsulas de doble vuelta.",
    badge: "Doble Vuelta (Comprensión + Producción)",
    badgeColor: "purple",
    items: ["66 pictogramas en píxel art 24×24", "Familiaridad adaptada por dialecto", "Antesala de material previa"]
  },
  {
    id: "audicion",
    icon: "👂",
    title: "Audición (18 Terapias)",
    category: "Protocolo ACOPROS",
    desc: "Abordaje integral de fonética-fonología, semántica, morfosintaxis, pragmática y entrenamiento de escucha en ruido competitivo (RA-1 a RA-5).",
    badge: "ACOPROS Certificado",
    badgeColor: "emerald",
    items: ["Escucha en ruido babble", "Discriminación fina", "Rotación de contenidos"]
  },
  {
    id: "lenguaje",
    icon: "💬",
    title: "Lenguaje (7 Terapias)",
    category: "Protocolo Familiar",
    desc: "Estimulación de atención conjunta (con formas alternativas), imitación vocal, comprensión instruccional, expresión libre, regulación emocional e interacción social.",
    badge: "Rutina Diaria",
    badgeColor: "cyan",
    items: ["Atención triangulada", "Comunicación funcional", "Interacción en el hogar"]
  },
  {
    id: "tea",
    icon: "🧠",
    title: "TEA (6 Terapias)",
    category: "Espectro Autista (PRT + TCC)",
    desc: "Intervención basada en tiempo de respuesta, espejo asimétrico, quiebre pragmático con consentimiento y categorización bajo múltiples señales.",
    badge: "Estresores 100% Manuales",
    badgeColor: "purple",
    items: ["Time Delay + Sello Doble", "Consentimiento informado", "Sin sobrecarga automatizada"]
  },
  {
    id: "dislexia",
    icon: "📖",
    title: "Dislexia (6 Terapias)",
    category: "Conciencia Fonológica",
    desc: "Intruso fonológico auditivo puro, síntesis rítmica fonémica, criba de pseudopalabras y rastreo visual b/d · p/q con mapa de misclicks.",
    badge: "Lectura Emergente",
    badgeColor: "amber",
    items: ["Acceso léxico rápido (RAN)", "Mapa de rotaciones visuales", "Ritmo por persecución dactilar"]
  },
  {
    id: "ar",
    icon: "🎯",
    title: "Realidad Aumentada (3 Terapias)",
    category: "Sensor Motor Pediátrico",
    desc: "La cámara frontal actúa como sensor de conducta motora con micrófono apagado: AR-1 cinemática orofacial (boquita de beso), AR-2 localización instrumentada del sonido (latencia ms) y AR-3 selección semántica por fijación de mirada.",
    badge: "Solo Android · Sensor 3D",
    badgeColor: "cyan",
    items: ["Refuerzo 3D con Filament", "Micrófono apagado", "Prueba de Aptitud del Dispositivo (A-D)"]
  }
];
---

<section id="terapias" class="therapy-section section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Módulos Especializados</span>
      <h2>7 Bloques de Terapia + <span class="gradient-text">Test de Ling</span></h2>
      <p>Diseñados para cubrir desde la criba auditiva inicial hasta intervenciones complejas en dislalias, TEA, dislexia y Realidad Aumentada.</p>
    </div>

    <div class="screenshot-wrapper">
      <img 
        src={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL}/assets/05-hub-bloques.png`} 
        alt="Hub de Bloques de Terapia" 
        class="manual-screenshot" 
        loading="lazy" 
        decoding="async"
      />
    </div>

    <div class="blocks-grid">
      {blocks.map((block) => (
        <div class="glass-card block-card">
          <div class="block-top">
            <span class="block-icon">{block.icon}</span>
            <span class={`badge badge-${block.badgeColor}`}>{block.badge}</span>
          </div>

          <span class="block-category">{block.category}</span>
          <h3>{block.title}</h3>
          <p class="block-desc">{block.desc}</p>

          <ul class="block-items">
            {block.items.map((item) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .therapy-section {
    padding: 100px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
  }

  .screenshot-wrapper {
    max-width: 320px;
    margin: 0 auto 3rem auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-light);
  }

  .manual-screenshot {
    width: 100%;
    height: auto;
    display: block;
  }

  .blocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .block-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .block-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .block-icon {
    font-size: 2rem;
  }

  .block-category {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .block-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .block-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .block-items {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-light);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .block-items li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-main);
  }

  .check-icon {
    color: var(--accent-emerald);
    font-weight: bold;
  }
</style>
