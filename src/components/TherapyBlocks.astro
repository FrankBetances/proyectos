---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const clinicalDomains = [
  { id: "all", label: "Todos los Módulos", count: "10 + Ling" },
  { id: "audicion", label: "Audición & Sensorial", count: "3 módulos" },
  { id: "habla", label: "Habla & Fonología", count: "3 módulos" },
  { id: "neuro", label: "Neurodesarrollo & Motricidad", count: "5 módulos" }
];

const lingCheck = {
  id: "ling",
  domain: "audicion",
  title: "Test de Ling (6 Sonidos)",
  category: "Comprobación Previa",
  desc: "Criba rápida de los 6 fonemas [a, i, u, m, s, ʃ] para verificar la calibración de audífonos o implantes cocleares antes de cada sesión.",
  badge: "Pre-Sesión Clave",
  badgeColor: "amber",
  img: `${baseUrl}/assets/15-ling-test.png`,
  tags: ["6 Fonemas Espectrales", "Hipoacusia & Implantes", "Validación Inmediata"]
};

const blocks = [
  {
    num: "01",
    id: "sor",
    domain: "audicion",
    title: "Integración Sensorial SOR",
    category: "Sobre-Responsividad",
    desc: "Desensibilización sonora ante ruidos fuertes cotidianos (secador, aula). Muro de control adulto donde pausar la sesión suma puntos.",
    badge: "SOR Acústico",
    badgeColor: "cyan",
    img: `${baseUrl}/assets/05-hub-bloques.png`
  },
  {
    num: "02",
    id: "aventuras",
    domain: "habla",
    title: "Aventuras con Lúa",
    category: "Lúa y las Palabras",
    desc: "105 actividades en 6 franjas de edad (0 a 10 años): preguntas interactivas, cuentos ilustrados y canciones habladas a pulso.",
    badge: "105 Actividades",
    badgeColor: "purple",
    img: `${baseUrl}/assets/08-pares-juego.png`
  },
  {
    num: "03",
    id: "pares",
    domain: "habla",
    title: "Pares Mínimos D7",
    category: "Dislalias y Habla",
    desc: "15 pares contrastados en 6 grupos articulatorios. Algoritmo O2 que coteja ambas palabras evitando falsos positivos de error.",
    badge: "Algoritmo O2",
    badgeColor: "cyan",
    img: `${baseUrl}/assets/08-pares-juego.png`
  },
  {
    num: "04",
    id: "expansion",
    domain: "habla",
    title: "Expansión Semántica",
    category: "Léxico y Comprensión",
    desc: "66 pictogramas propios en píxel art. Práctica en doble vuelta: el menor primero señala la imagen y luego articula la palabra.",
    badge: "Doble Vuelta",
    badgeColor: "emerald",
    img: `${baseUrl}/assets/12-expansion-juego.png`
  },
  {
    num: "05",
    id: "acopros",
    domain: "audicion",
    title: "Audición (ACOPROS)",
    category: "Auditivo-Verbal",
    desc: "Discriminación fonética fina y comprensión en ruido babble graduable simulando el aula real, validado por logopedas de ACOPROS.",
    badge: "Protocolo ACOPROS",
    badgeColor: "purple",
    img: `${baseUrl}/assets/15-ling-test.png`
  },
  {
    num: "06",
    id: "lenguaje",
    domain: "neuro",
    title: "Lenguaje Temprano",
    category: "Estimulación Familiar",
    desc: "Atención conjunta triangulada, imitación progresiva (gesto → sílaba → palabra) y rutinas comunicativas funcionales en el hogar.",
    badge: "Rutina Diaria",
    badgeColor: "cyan",
    img: `${baseUrl}/assets/10-expansion-escenarios.png`
  },
  {
    num: "07",
    id: "tea",
    domain: "neuro",
    title: "TEA (Espectro Autista)",
    category: "PRT + Conductual",
    desc: "Atención conjunta con Time Delay, quiebres pragmáticos y anticipación estructurada con estresores regulados a mano por el adulto.",
    badge: "Estresores Manuales",
    badgeColor: "amber",
    img: `${baseUrl}/assets/05-hub-bloques.png`
  },
  {
    num: "08",
    id: "dislexia",
    domain: "neuro",
    title: "Dislexia y Fonología",
    category: "Conciencia Fonológica",
    desc: "Intruso fonológico auditivo, criba de pseudopalabras y mapa de rotaciones críticas (b/d · p/q) con denominación rápida automatizada.",
    badge: "Criba Fonológica",
    badgeColor: "purple",
    img: `${baseUrl}/assets/08-pares-juego.png`
  },
  {
    num: "09",
    id: "pizarra",
    domain: "neuro",
    title: "La Pizarra Mágica",
    category: "Grafomotricidad",
    desc: "18 trazos guiados en SVG sobre pauta Montessori con puntos numerados (1, 2, 3) que fijan la secuencia motriz correcta de las letras.",
    badge: "18 Trazos SVG",
    badgeColor: "emerald",
    img: `${baseUrl}/assets/12-expansion-juego.png`
  },
  {
    num: "10",
    id: "ra",
    domain: "neuro",
    title: "Realidad Aumentada 3D",
    category: "Sensor Orofacial",
    desc: "Cámara frontal como sensor cinemático orofacial sin micrófono activo (ARCore + MediaPipe + Filament), garantizando privacidad estricta.",
    badge: "Cámara sin Audio",
    badgeColor: "cyan",
    img: `${baseUrl}/assets/05-hub-bloques.png`
  }
];
---

<!-- Interactive Clinical Showcase: 10 Therapy Blocks + Ling Test -->
<section id="bloques-clinicos" class="therapy-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Protocolo de Rehabilitación Pediátrica</span>
      <h2>10 Bloques Clínicos: <span class="gradient-text">Estimulación Estructurada</span></h2>
      <p>
        Diseñados bajo rigor logopédico para entrenar audición, habla, neurodesarrollo y motricidad sin frustración ni juicios automáticos.
      </p>

      <!-- Clinical Domain Tabs Filter -->
      <div class="domain-tabs-row" role="tablist" aria-label="Filtrar bloques por dominio clínico">
        {clinicalDomains.map((tab, idx) => (
          <button 
            type="button" 
            role="tab" 
            class={`domain-tab ${idx === 0 ? 'active' : ''}`} 
            data-domain={tab.id}
            aria-selected={idx === 0 ? "true" : "false"}
          >
            <span class="tab-label">{tab.label}</span>
            <span class="tab-count">{tab.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Interactive Clinical Workspace (Side-by-Side on Desktop, Responsive Carousel on Mobile) -->
    <div class="clinical-workspace-grid">
      <!-- Left Column: Interactive App Preview Stage -->
      <div class="workspace-preview-stage">
        <div class="preview-device-card glass-card">
          <div class="preview-header">
            <div class="preview-status">
              <span class="status-pulse-dot"></span>
              <span id="preview-screen-title">Hub Principal de Bloques</span>
            </div>
            <span class="badge badge-cyan" id="preview-badge-text">Captura Real en App</span>
          </div>

          <div class="preview-screen-frame">
            <img 
              id="active-clinical-img"
              src={`${baseUrl}/assets/05-hub-bloques.png`} 
              alt="Interfaz interactiva en app de Valeria+ v14" 
              class="active-screen-img"
              width="360"
              height="780"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="preview-footer-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span id="preview-caption">Selecciona un bloque clínico para previsualizar su pantalla</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Blocks Cards with Mobile Scroll-Snap Carousel -->
      <div class="workspace-cards-column">
        <!-- Pre-Session Anchor: Ling Check Card -->
        <article 
          class="glass-card clinical-card ling-anchor-card active-card" 
          data-domain="audicion"
          data-img={lingCheck.img}
          data-title={lingCheck.title}
          data-caption="Criba rápida de los 6 fonemas espectrales para calibrar audífonos e implantes"
        >
          <div class="card-top-row">
            <span class="badge badge-amber">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>{lingCheck.badge}</span>
            </span>
            <span class="card-domain-tag">Calibración Previa</span>
          </div>
          <h3>{lingCheck.title}</h3>
          <p>{lingCheck.desc}</p>
          <div class="card-tags-row">
            {lingCheck.tags.map(t => (
              <span class="micro-tag">{t}</span>
            ))}
          </div>
        </article>

        <!-- 10 Therapy Blocks Container -->
        <div class="blocks-carousel-scroller" id="blocks-scroller">
          {blocks.map((block) => (
            <article 
              class="glass-card clinical-card" 
              data-domain={block.domain}
              data-img={block.img}
              data-title={`${block.num}. ${block.title}`}
              data-caption={block.desc}
            >
              <div class="card-top-row">
                <span class={`badge badge-${block.badgeColor}`}>
                  <span class="block-num-badge">#{block.num}</span>
                  <span>{block.badge}</span>
                </span>
                <span class="card-category-text">{block.category}</span>
              </div>
              <h3>{block.num}. {block.title}</h3>
              <p>{block.desc}</p>
              <div class="card-action-cue">
                <span>Ver pantalla en visor</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.domain-tab');
    const cards = document.querySelectorAll('.clinical-card');
    const previewImg = document.getElementById('active-clinical-img') as HTMLImageElement;
    const previewTitle = document.getElementById('preview-screen-title');
    const previewCaption = document.getElementById('preview-caption');

    // Interactive Tab Filter
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const domain = tab.getAttribute('data-domain');
        cards.forEach(card => {
          const cardDomain = card.getAttribute('data-domain');
          if (domain === 'all' || cardDomain === domain) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Interactive Screen Preview Switcher on Hover / Tap
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => updatePreview(card));
      card.addEventListener('click', () => updatePreview(card));
    });

    function updatePreview(cardElement: Element) {
      cards.forEach(c => c.classList.remove('active-card'));
      cardElement.classList.add('active-card');

      const newImg = cardElement.getAttribute('data-img');
      const newTitle = cardElement.getAttribute('data-title');
      const newCaption = cardElement.getAttribute('data-caption');

      if (previewImg && newImg) {
        previewImg.style.opacity = '0.3';
        previewImg.style.transform = 'scale(0.98)';
        setTimeout(() => {
          previewImg.src = newImg;
          previewImg.style.opacity = '1';
          previewImg.style.transform = 'scale(1)';
        }, 120);
      }

      if (previewTitle && newTitle) {
        previewTitle.textContent = newTitle;
      }
      if (previewCaption && newCaption) {
        previewCaption.textContent = newCaption;
      }
    }
  });
</script>

<style>
  .therapy-section {
    padding: 90px 0;
    position: relative;
    background: radial-gradient(circle at 50% 10%, rgba(138, 43, 226, 0.04) 0%, transparent 60%);
  }

  .domain-tabs-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 2rem auto 0 auto;
    max-width: 820px;
  }

  .domain-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-light);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .domain-tab:hover {
    color: var(--text-main);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
  }

  .domain-tab.active {
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.16) 0%, rgba(138, 43, 226, 0.16) 100%);
    border-color: rgba(0, 242, 254, 0.5);
    color: #FFFFFF;
    box-shadow: 0 0 16px rgba(0, 242, 254, 0.15);
  }

  .tab-count {
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-dim);
  }

  .domain-tab.active .tab-count {
    background: rgba(0, 242, 254, 0.2);
    color: var(--accent-cyan);
  }

  /* Workspace Grid Layout */
  .clinical-workspace-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 2rem;
    align-items: start;
    margin-top: 3.5rem;
  }

  /* Left Column: Preview Stage */
  .workspace-preview-stage {
    position: sticky;
    top: 96px;
  }

  .preview-device-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: var(--radius-lg);
    background: rgba(11, 15, 25, 0.75);
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6);
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .preview-status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .status-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .preview-screen-frame {
    border-radius: 18px;
    overflow: hidden;
    background: #040711;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
  }

  .active-screen-img {
    width: 100%;
    height: auto;
    aspect-ratio: 360 / 780;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .preview-footer-note {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .preview-footer-note svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--accent-cyan);
  }

  /* Right Column: Cards */
  .workspace-cards-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .clinical-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.35rem 1.6rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    border: 1px solid var(--border-light);
    background: rgba(15, 23, 42, 0.5);
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .clinical-card:hover,
  .clinical-card.active-card {
    background: rgba(20, 30, 52, 0.75);
    border-color: rgba(0, 242, 254, 0.45);
    box-shadow: 0 10px 30px -8px rgba(0, 242, 254, 0.15);
    transform: translateX(4px);
  }

  .ling-anchor-card {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(15, 23, 42, 0.65) 100%);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .ling-anchor-card:hover,
  .ling-anchor-card.active-card {
    border-color: rgba(245, 158, 11, 0.65);
    box-shadow: 0 10px 30px -8px rgba(245, 158, 11, 0.2);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .block-num-badge {
    font-weight: 800;
    opacity: 0.85;
  }

  .card-domain-tag,
  .card-category-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .clinical-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .clinical-card p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .card-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .micro-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #fef3c7;
  }

  .card-action-cue {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-top: 0.2rem;
    opacity: 0.8;
  }

  .workspace-cards-column {
    min-width: 0;
    max-width: 100%;
    width: 100%;
  }

  .blocks-carousel-scroller {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
  }

  /* Responsive & Mobile-First Carousel */
  @media (max-width: 900px) {
    .clinical-workspace-grid {
      grid-template-columns: 1fr;
      min-width: 0;
      max-width: 100%;
    }

    .workspace-preview-stage {
      position: static;
      max-width: 280px;
      margin: 0 auto 1.5rem auto;
    }

    .blocks-carousel-scroller {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      gap: 1rem;
      -webkit-overflow-scrolling: touch;
      min-width: 0;
      max-width: 100%;
      width: 100%;
    }

    .clinical-card {
      min-width: 280px;
      max-width: 320px;
      scroll-snap-align: center;
      flex-shrink: 0;
    }

    .clinical-card:hover,
    .clinical-card.active-card {
      transform: none;
    }
  }
</style>
