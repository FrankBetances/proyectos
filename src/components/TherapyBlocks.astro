---
const blocks = [
  {
    id: "ling",
    icon: "👂",
    title: "Test de Ling (6 Sonidos)",
    category: "Comprobación Previa",
    desc: "Chequeo rápido con los 6 sonidos [a, i, u, m, s, ʃ] para verificar que el audífono o implante coclear funciona antes de empezar la sesión.",
    badge: "Comprobación Rápida",
    badgeColor: "amber",
    items: ["Detección de frecuencias clave", "Sin fatiga auditiva", "Imprescindible para audífonos e implantes"]
  },
  {
    id: "sensorial",
    icon: "🎧",
    title: "Integración Sensorial Auditiva",
    category: "Sobre-Responsividad Acústica (SOR)",
    desc: "Para el niño que se tapa los oídos con la aspiradora, la batidora o el timbre del colegio. Desensibilización con 11 sonidos reales sintetizados propios y control adulto.",
    badge: "Nuevo en v14 · 6 Actividades",
    badgeColor: "cyan",
    items: ["11 estímulos (aparatos, alertas y 3 ambientes reales)", "El adulto fija intensidad (1-5) y tiempo", "Pausar nunca resta: ¡siempre suma puntos!"]
  },
  {
    id: "pares",
    icon: "🗣️",
    title: "Pares Mínimos (15 Pares)",
    category: "Dislalias y Pronunciación",
    desc: "15 pares de palabras casi iguales (rana/lana, rata/lata) en 6 grupos de sonidos. Evaluador inteligente D7 que reconoce aproximaciones del habla sin castigos.",
    badge: "15 Pares · Evaluador D7",
    badgeColor: "purple",
    items: ["Rotacismo, sigmatismo y sonidos difíciles", "Misión física compartida en familia", "Sello doble de aprobación padre-hijo"]
  },
  {
    id: "expansion",
    icon: "🧩",
    title: "Expansión Semántica",
    category: "Intervención Temprana y Léxico",
    desc: "Ampliación de vocabulario en 4 etapas: 5 escenarios de casa, 5 categorías por familiaridad, 9 familias de palabras y 8 contrastes con doble vuelta.",
    badge: "Doble Vuelta (Comprensión + Habla)",
    badgeColor: "emerald",
    items: ["66 pictogramas en píxel art propio", "Primero tocar el dibujo, luego hablar", "Antesala con el material necesario"]
  },
  {
    id: "audicion",
    icon: "👂",
    title: "Audición (18 Ejercicios)",
    category: "Protocolo ACOPROS",
    desc: "Estimulación auditivo-verbal integral: reconocer sonidos, palabras, frases y aprender a escuchar con ruido de fondo como en una cafetería (RA-1 a RA-5).",
    badge: "Validación ACOPROS",
    badgeColor: "cyan",
    items: ["Escucha en ruido babble graduable", "Discriminación fina de fonemas", "Hasta 3 rondas variadas por ejercicio"]
  },
  {
    id: "lenguaje",
    icon: "💬",
    title: "Lenguaje (7 Ejercicios)",
    category: "Protocolo Familiar",
    desc: "Estimulación del habla en el hogar: mirar juntos (atención conjunta), imitar gestos y sonidos, comprender órdenes, expresar deseos y regularse.",
    badge: "Rutina Diaria en Casa",
    badgeColor: "purple",
    items: ["Atención triangulada y juego compartido", "Comunicación funcional sin presiones", "Materiales cotidianos del hogar"]
  },
  {
    id: "tea",
    icon: "🧠",
    title: "TEA (6 Ejercicios)",
    category: "Espectro Autista (PRT + TCC)",
    desc: "Apoyo en comunicación y flexibilidad: atención conjunta, turnos de juego, transición entre tareas y quiebre pragmático con estresores 100% manuales.",
    badge: "Estresores Manuales",
    badgeColor: "amber",
    items: ["Time Delay y sello doble", "Sin sobrecarga sensorial automática", "Anticipación visual estructurada"]
  },
  {
    id: "dislexia",
    icon: "📖",
    title: "Dislexia (6 Ejercicios)",
    category: "Conciencia Fonológica",
    desc: "Juegos auditivos de sonidos intrusos, ritmo con palmadas, criba de palabras inventadas y rastreo visual para no confundir letras parecidas (b/d y p/q).",
    badge: "Lectura y Conciencia Sonora",
    badgeColor: "cyan",
    items: ["Detección de giros b/d y p/q", "Ritmo dactilar guiado por el adulto", "Denominación rápida de objetos (RAN)"]
  },
  {
    id: "grafomotricidad",
    icon: "✏️",
    title: "La Pizarra Mágica de Lúa (6 Trazos)",
    category: "Grafomotricidad y Escritura",
    desc: "Trazado guiado sobre lienzo con pauta Montessori y puntos numerados (1, 2, 3) que fijan el orden del trazo para evitar que confundan la 'b' y la 'd'.",
    badge: "Puntos Numerados Anti-Inversión",
    badgeColor: "emerald",
    items: ["Letras críticas (b, d, p, m) y calentamiento", "Pauta Montessori regulable en pantalla", "Elogios locutados en 5 variedades"]
  },
  {
    id: "ar",
    icon: "🎯",
    title: "Realidad Aumentada (6 Ejercicios)",
    category: "Sensor Motor · Solo Android",
    desc: "La cámara frontal funciona como sensor motor con micrófono apagado (ARCore + MediaPipe): el premio 3D sale solo cuando el niño hace la postura o gesto correcto.",
    badge: "ARCore + MediaPipe 3D",
    badgeColor: "purple",
    items: ["Boquita de beso, giro de cabeza y fijación visual", "Cero fotos ni vídeos almacenados (privacidad)", "Prueba de aptitud del móvil"]
  }
];
---

<section id="terapias" class="therapy-section section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Módulos Especializados</span>
      <h2>9 Bloques de Ejercicios + <span class="gradient-text">Test de Ling</span></h2>
      <p>Un recorrido completo y respetuoso: desde la integración sensorial y los primeros sonidos hasta la pronunciación, la lectura y la Realidad Aumentada.</p>
    </div>

    <div class="screenshot-wrapper">
      <img 
        src={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL}/assets/05-hub-bloques.png`} 
        alt="Hub de Bloques de Ejercicios en Valeria+" 
        class="manual-screenshot" 
        loading="lazy" 
        decoding="async"
      />
    </div>

    <div class="blocks-grid">
      {blocks.map((block) => (
        <div class="glass-card block-card">
          <div class="block-top">
            <span class="block-icon">{block.icon}</span>
            <span class={`badge badge-${block.badgeColor}`}>{block.badge}</span>
          </div>

          <span class="block-category">{block.category}</span>
          <h3>{block.title}</h3>
          <p class="block-desc">{block.desc}</p>

          <ul class="block-items">
            {block.items.map((item) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .therapy-section {
    padding: 100px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
  }

  .screenshot-wrapper {
    max-width: 320px;
    margin: 0 auto 3rem auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-light);
  }

  .manual-screenshot {
    width: 100%;
    height: auto;
    display: block;
  }

  .blocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .block-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .block-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .block-icon {
    font-size: 2rem;
  }

  .block-category {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .block-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .block-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .block-items {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-light);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .block-items li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-main);
  }

  .check-icon {
    color: var(--accent-emerald);
    font-weight: bold;
  }
</style>
