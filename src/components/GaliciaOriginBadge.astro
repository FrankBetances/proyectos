---
interface Props {
  label?: string;
  detail?: string;
  variant?: 'hero' | 'footer' | 'header' | 'inline';
}

const {
  label = "Diseñado en Galicia",
  detail = "Vigo · Santiago · Lugo",
  variant = 'hero'
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<div class={`galicia-origin-seal seal-${variant}`} role="note" aria-label={detail ? `${label} (${detail})` : label}>
  <div class="galicia-emblems-group" aria-hidden="true">
    <img
      src={`${baseUrl}/assets/galicia/bandera-galicia.svg`}
      alt=""
      class="galicia-flag-icon"
      loading="lazy"
      decoding="async"
    />
    <img
      src={`${baseUrl}/assets/galicia/escudo-galicia.svg`}
      alt=""
      class="galicia-crest-icon"
      loading="lazy"
      decoding="async"
    />
  </div>

  <span class="galicia-seal-text">
    <strong class="galicia-main-label">{label}</strong>
    {detail && <span class="galicia-detail-sep" aria-hidden="true">·</span>}
    {detail && <span class="galicia-detail-text">{detail}</span>}
  </span>
</div>

<style>
  .galicia-origin-seal {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.44rem 1.08rem;
    border-radius: 9999px;
    background: rgba(11, 24, 48, 0.82);
    border: 1.5px solid rgba(56, 189, 248, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #F8FAFC;
    font-size: 0.94rem;
    line-height: 1.25;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28), 0 0 12px rgba(0, 153, 204, 0.14);
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    max-width: 100%;
    flex-wrap: wrap;
    justify-content: center;
  }

  .galicia-origin-seal:hover {
    border-color: rgba(56, 189, 248, 0.7);
    background: rgba(15, 32, 62, 0.9);
  }

  .seal-hero {
    margin: 0 auto 1rem auto;
  }

  .seal-footer {
    margin-top: 0.95rem;
    padding: 0.4rem 0.98rem;
    font-size: 0.9rem;
    background: rgba(11, 24, 48, 0.72);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .seal-inline {
    padding: 0.34rem 0.85rem;
    font-size: 0.86rem;
    gap: 0.52rem;
    background: rgba(0, 153, 204, 0.14);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .seal-header {
    padding: 0.24rem 0.68rem;
    font-size: 0.8rem;
    gap: 0.45rem;
    background: rgba(0, 153, 204, 0.14);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .galicia-emblems-group {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .galicia-flag-icon {
    width: 28px;
    height: 19px;
    display: block;
    object-fit: contain;
    border-radius: 2.5px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.45);
  }

  .galicia-crest-icon {
    width: 23px;
    height: 28px;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.55));
  }

  .seal-footer .galicia-flag-icon {
    width: 26px;
    height: 17px;
  }

  .seal-footer .galicia-crest-icon {
    width: 21px;
    height: 26px;
  }

  .seal-inline .galicia-flag-icon,
  .seal-header .galicia-flag-icon {
    width: 22px;
    height: 15px;
  }

  .seal-inline .galicia-crest-icon,
  .seal-header .galicia-crest-icon {
    width: 19px;
    height: 23px;
  }

  .galicia-seal-text {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: #E2E8F0;
    font-weight: 500;
  }

  .galicia-main-label {
    color: #FFFFFF;
    font-weight: 700;
    letter-spacing: 0.015em;
  }

  .galicia-detail-sep {
    color: #38BDF8;
    font-weight: 700;
  }

  .galicia-detail-text {
    color: #CBD5E1;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .seal-inline .galicia-detail-text,
  .seal-header .galicia-detail-text {
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .galicia-origin-seal {
      padding: 0.36rem 0.84rem;
      font-size: 0.86rem;
      gap: 0.5rem;
    }
    .galicia-flag-icon {
      width: 24px;
      height: 16px;
    }
    .galicia-crest-icon {
      width: 20px;
      height: 24px;
    }
    .galicia-detail-sep,
    .galicia-detail-text {
      display: none;
    }
  }
</style>
