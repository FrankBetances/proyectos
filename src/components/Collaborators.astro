---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const collaborators = [
  {
    id: "starttic",
    name: "startTIC · Alta Tecnología",
    badge: "Incubación TIC",
    badgeColor: "cyan",
    desc: "Zona Franca de Vigo, GRADIANT y Cámara PVV (FEDER / INCYDE). Aceleración, conectividad y validación tecnológica.",
    logo: "",
    logoBg: "dark",
    alt: "Logo startTIC - Incubadora de Alta Tecnología Vigo",
    customMark: true
  },
  {
    id: "acopros",
    name: "ACOPROS",
    badge: "Validación Logopédica",
    badgeColor: "amber",
    desc: "Asociación de Familias de Niños Sordos (A Coruña). Revisión del corpus auditivo-verbal y validación de LSE.",
    logo: `${baseUrl}/assets/collaborators/logo-acopros.png`,
    logoBg: "light",
    alt: "Logo ACOPROS - Asociación de Familias de Niños Sordos",
    width: 671,
    height: 183
  },
  {
    id: "itemas",
    name: "ITEMAS / ISCIII",
    badge: "Sello de Calidad 2024",
    badgeColor: "cyan",
    desc: "Plataforma de dinamización e innovación del Sistema Nacional de Salud (Instituto de Salud Carlos III).",
    logo: `${baseUrl}/assets/collaborators/logo-itemas.png`,
    logoBg: "light",
    alt: "Sello de Calidad ITEMAS ISCIII 2024 - Instituto de Salud Carlos III",
    width: 659,
    height: 906
  },
  {
    id: "sgorl",
    name: "SGORL",
    badge: "Sociedad Científica",
    badgeColor: "purple",
    desc: "Sociedad Gallega de Otorrinolaringología y Cirugía de Cabeza y Cuello. Aval clínico en salud auditiva infantil.",
    logo: `${baseUrl}/assets/collaborators/logo-sgorl.png`,
    logoBg: "dark",
    alt: "Logo SGORL - Sociedad Gallega de Otorrinolaringología",
    width: 558,
    height: 549
  },
  {
    id: "acis",
    name: "ACIS - SERGAS",
    badge: "1.er Premio Innovación",
    badgeColor: "emerald",
    desc: "Axencia de Coñecemento en Saúde. 1.er Premio de Innovación en Salud del Servizo Galego de Saúde.",
    logo: `${baseUrl}/assets/collaborators/logo-acis.png`,
    logoBg: "light",
    alt: "Logo ACIS - Axencia de Coñecemento en Saúde (Servizo Galego de Saúde)",
    width: 1024,
    height: 260
  }
];
---

<section id="avales" class="collaborators-section">
  <div class="container" id="colaboradores">
    <div class="section-header">
      <span class="tag">Acreditación & Respaldo Sanitario</span>
      <h2>Avales Institucionales & <span class="gradient-text">Sellos de Calidad</span></h2>
      <p>Validación continua de sociedades científicas, incubadoras de alta tecnología y agencias públicas de salud.</p>
    </div>

    <div class="collab-grid">
      {collaborators.map((c) => (
        <div class={`glass-card collab-card ${c.id === 'starttic' ? 'collab-card-highlight' : ''}`}>
          <div class={`logo-container ${c.logoBg}`}>
            {c.customMark ? (
              <div class="starttic-brand-mark">
                <div class="starttic-top-row">
                  <span class="starttic-icon">🚀</span>
                  <span class="starttic-title">start<span class="highlight-tic">TIC</span></span>
                </div>
                <span class="starttic-sub">INCUBADORA ALTA TECNOLOGÍA</span>
                <span class="starttic-partners">CZFV · GRADIANT · CPVV · FEDER</span>
              </div>
            ) : (
              <img 
                src={c.logo} 
                alt={c.alt} 
                class={`collab-img img-${c.id}`} 
                width={c.width}
                height={c.height}
                loading="lazy" 
                decoding="async" 
              />
            )}
          </div>

          <div class="collab-body">
            <div class="collab-top">
              <h3 class="collab-name">{c.name}</h3>
              <span class={`badge badge-${c.badgeColor}`}>{c.badge}</span>
            </div>
            <p class="collab-desc">{c.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .collaborators-section {
    padding: 80px 0;
    position: relative;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(10, 15, 26, 0.9) 100%);
    border-top: 1px solid var(--border-light);
  }

  .collab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .collab-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .collab-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .collab-card-highlight {
    border-color: rgba(0, 242, 254, 0.35);
    background: linear-gradient(180deg, rgba(0, 242, 254, 0.04) 0%, rgba(15, 23, 42, 0.6) 100%);
  }

  .starttic-brand-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.2rem;
    padding: 0.5rem;
  }

  .starttic-top-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .starttic-icon {
    font-size: 1.25rem;
  }

  .starttic-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #FFFFFF;
  }

  .highlight-tic {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .starttic-sub {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .starttic-partners {
    font-size: 0.625rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .logo-container {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border-light);
  }

  .logo-container.light {
    background: #FFFFFF;
  }

  .logo-container.dark {
    background: linear-gradient(135deg, #090E17 0%, #0F172A 100%);
  }

  .collab-img {
    max-height: 70px;
    max-width: 85%;
    width: auto;
    object-fit: contain;
    transition: transform 0.25s ease;
  }

  .collab-card:hover .collab-img {
    transform: scale(1.05);
  }

  .img-itemas {
    max-height: 90px;
  }

  .img-acis {
    max-height: 55px;
  }

  .img-acopros {
    max-height: 60px;
  }

  .img-sgorl {
    max-height: 75px;
  }

  .collab-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .collab-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .collab-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .collab-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 768px) {
    .collab-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
