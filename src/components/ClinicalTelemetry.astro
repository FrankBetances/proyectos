---
const telemetryItems = [
  {
    icon: "⏱️",
    title: "Tiempo Activo y Dosificación",
    desc: "Permanencia por bloque clínico para monitorizar la atención y prevenir la fatiga auditiva o visual del menor."
  },
  {
    icon: "👆",
    title: "Accesibilidad Motora",
    desc: "Detección de pulsaciones erróneas para perfeccionar el área táctil y adaptar los ejercicios a manos infantiles."
  },
  {
    icon: "📋",
    title: "Cuestionario de Usabilidad SUS",
    desc: "Métrica breve y validada para medir la satisfacción y claridad de las pautas en el entorno del hogar."
  },
  {
    icon: "📱",
    title: "Traspaso Clínico por QR Offline",
    desc: "El logopeda o médico escanea la progresión en consulta mediante un código QR sin dependencia de nube ni cables."
  }
];
---

<section id="telemetria" class="telemetry-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Privacidad & Evidencia</span>
      <h2>Telemetría Zero-PHI · <span class="gradient-text-emerald">Privacidad Absoluta</span></h2>
      <p>
        Métricas de usabilidad <strong>100% anónimas y sin conexión</strong> para optimizar la experiencia clínica sin guardar grabaciones, fotos ni datos sensibles.
      </p>
    </div>

    <!-- 4 Telemetry Cards - Symmetrical & Centered -->
    <div class="telemetry-grid">
      {telemetryItems.map((item) => (
        <div class="glass-card telemetry-card">
          <span class="telemetry-icon">{item.icon}</span>
          <div class="telemetry-body">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .telemetry-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid var(--border-light);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .telemetry-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .telemetry-card:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.35);
  }

  .telemetry-icon {
    font-size: 1.8rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    margin: 0 auto 1.25rem auto;
    flex-shrink: 0;
  }

  .telemetry-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .telemetry-body h3 {
    font-size: 1.18rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    color: var(--text-main);
    text-align: center;
  }

  .telemetry-body p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    text-align: center;
    max-width: 440px;
  }

  @media (max-width: 768px) {
    .telemetry-section {
      padding: 50px 0;
    }

    .telemetry-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .telemetry-card {
      padding: 1.35rem 1.15rem;
    }

    .telemetry-icon {
      width: 44px;
      height: 44px;
      font-size: 1.4rem;
      margin-bottom: 0.85rem;
    }

    .telemetry-body h3 {
      font-size: 1.1rem;
    }

    .telemetry-body p {
      font-size: 0.86rem;
    }
  }
</style>
