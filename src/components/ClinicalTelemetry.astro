---
const telemetryItems = [
  {
    iconType: "clock",
    title: "Tiempo Activo y Dosificación",
    desc: "Permanencia por bloque clínico para monitorizar la atención y prevenir la fatiga auditiva o visual del menor."
  },
  {
    iconType: "touch",
    title: "Accesibilidad Motora",
    desc: "Detección de pulsaciones erróneas para perfeccionar el área táctil y adaptar los ejercicios a manos infantiles."
  },
  {
    iconType: "clipboard",
    title: "Cuestionario de Usabilidad SUS",
    desc: "Métrica breve y validada para medir la satisfacción y claridad de las pautas en el entorno del hogar."
  },
  {
    iconType: "qr",
    title: "Traspaso Clínico por QR Offline",
    desc: "El logopeda o médico escanea la progresión en consulta mediante un código QR sin dependencia de nube ni cables."
  }
];
---

<!-- Telemetría Zero-PHI: Privacidad Absoluta y Cero Nube -->
<section id="telemetria" class="telemetry-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Privacidad & Evidencia</span>
      <h2>Telemetría Zero-PHI · <span class="gradient-text-emerald">Privacidad Absoluta</span></h2>
      <p>
        Métricas de usabilidad <strong>100% anónimas y sin conexión</strong> para optimizar la experiencia clínica sin guardar grabaciones, fotos ni datos sensibles.
      </p>
    </div>

    <!-- 4 Telemetry Cards - Symmetrical & Centered -->
    <div class="telemetry-grid">
      {telemetryItems.map((item) => (
        <div class="glass-card telemetry-card">
          <div class="telemetry-icon-box">
            {item.iconType === 'clock' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            )}
            {item.iconType === 'touch' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/><path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 13"/>
              </svg>
            )}
            {item.iconType === 'clipboard' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>
              </svg>
            )}
            {item.iconType === 'qr' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/>
              </svg>
            )}
          </div>
          <div class="telemetry-body">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .telemetry-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid var(--border-light);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .telemetry-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-light);
    transition: all 0.22s ease;
  }

  .telemetry-card:hover {
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(20, 32, 54, 0.75);
    transform: translateY(-2px);
  }

  .telemetry-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .telemetry-body h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text-main);
  }

  .telemetry-body p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .telemetry-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .telemetry-card {
      padding: 1.35rem 1.15rem;
    }
  }
</style>
