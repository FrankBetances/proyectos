---
const telemetryItems = [
  {
    iconType: "clock",
    title: "Tiempo Activo y Dosificación",
    desc: "Permanencia por bloque clínico para monitorizar la atención y prevenir la fatiga auditiva o visual del menor."
  },
  {
    iconType: "target",
    title: "Accesibilidad Motora",
    desc: "Detección de pulsaciones erróneas para perfeccionar el área táctil y adaptar los ejercicios a manos infantiles."
  },
  {
    iconType: "clipboard",
    title: "Cuestionario de Usabilidad SUS",
    desc: "Métrica breve y validada para medir la satisfacción y claridad de las pautas en el entorno del hogar."
  },
  {
    iconType: "qr",
    title: "Traspaso Clínico por QR Offline",
    desc: "El logopeda o médico escanea la progresión en consulta mediante un código QR sin dependencia de nube ni cables."
  }
];
---

<section id="telemetria" class="telemetry-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Privacidad & Evidencia</span>
      <h2>Telemetría Zero-PHI · <span class="gradient-text-emerald">Privacidad Absoluta</span></h2>
      <p>
        Métricas de usabilidad <strong>100% anónimas y sin conexión</strong> para optimizar la experiencia clínica sin guardar grabaciones, fotos ni datos sensibles.
      </p>
    </div>

    <!-- 4 Telemetry Cards - Symmetrical & Centered -->
    <div class="telemetry-grid">
      {telemetryItems.map((item) => (
        <div class="glass-card telemetry-card">
          <div class="telemetry-icon" aria-hidden="true">
            {item.iconType === 'clock' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            )}
            {item.iconType === 'target' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            )}
            {item.iconType === 'clipboard' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
                <path d="m9 14 2 2 4-4"/>
              </svg>
            )}
            {item.iconType === 'qr' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
                <line x1="7" y1="17" x2="7" y2="17.01"/>
                <line x1="17" y1="7" x2="17.01" y2="7"/>
              </svg>
            )}
          </div>
          <div class="telemetry-body">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .telemetry-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid var(--border-light);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .telemetry-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .telemetry-card:hover {
    transform: translateY(-3px);
    border-color: rgba(16, 185, 129, 0.35);
  }

  .telemetry-icon {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    margin: 0 auto 1.25rem auto;
    flex-shrink: 0;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .telemetry-card:hover .telemetry-icon {
    transform: scale(1.05);
    border-color: rgba(16, 185, 129, 0.6);
  }

  .telemetry-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .telemetry-body h3 {
    font-size: 1.18rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    color: var(--text-main);
    text-align: center;
  }

  .telemetry-body p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    text-align: center;
    max-width: 440px;
  }

  @media (max-width: 768px) {
    .telemetry-section {
      padding: 50px 0;
    }

    .telemetry-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .telemetry-card {
      padding: 1.35rem 1.15rem;
    }

    .telemetry-icon {
      width: 44px;
      height: 44px;
      font-size: 1.4rem;
      margin-bottom: 0.85rem;
    }

    .telemetry-body h3 {
      font-size: 1.1rem;
    }

    .telemetry-body p {
      font-size: 0.86rem;
    }
  }
</style>
