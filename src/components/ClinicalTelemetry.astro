---
const partners = [
  { name: "ACOPROS", desc: "Asociación de Familias de Niños Sordos (A Coruña)" },
  { name: "startTIC", desc: "Incubadora Alta Tecnología (CZFV / Gradiant / FEDER)" },
  { name: "Quisqueya Habla", desc: "UFHEC / MESCYT (FONDOCYT)" },
  { name: "USC", desc: "Universidade de Santiago de Compostela" },
  { name: "Proxecto Nós", desc: "Tecnoloxías do Galego na Era Dixital" },
  { name: "HiTZ / UPV-EHU", desc: "Centro Vasco de Tecnología del Lenguaje" },
  { name: "Projecte AINA", desc: "Barcelona Supercomputing Center (BSC)" }
];
---

<section id="telemetria" class="telemetry-section">
  <div class="container">
    <div class="telemetry-grid">
      <div class="glass-card telemetry-info">
        <span class="badge badge-emerald">Evidencia de Usabilidad</span>
        <h2>Telemetría Zero-PHI · <span class="gradient-text-emerald">Privacidad Absoluta</span></h2>
        <p>
          Para perfeccionar la app sin vulnerar la intimidad familiar, Valeria+ registra métricas de usabilidad <strong>100% anónimas, sin conexión y sin guardar audios ni fotos</strong>:
        </p>

        <div class="telemetry-bento">
          <div class="telemetry-chip">
            <span class="chip-icon">⏱️</span>
            <div>
              <strong>Tiempo Activo</strong>
              <p>Permanencia por módulo para prevenir fatiga.</p>
            </div>
          </div>

          <div class="telemetry-chip">
            <span class="chip-icon">👆</span>
            <div>
              <strong>Mapa de Toques</strong>
              <p>Detección de pulsaciones erróneas para pulir la interfaz.</p>
            </div>
          </div>

          <div class="telemetry-chip">
            <span class="chip-icon">📋</span>
            <div>
              <strong>Cuestionario SUS</strong>
              <p>Encuesta semanal breve para medir satisfacción en el hogar.</p>
            </div>
          </div>

          <div class="telemetry-chip">
            <span class="chip-icon">📱</span>
            <div>
              <strong>Código QR Offline</strong>
              <p>El logopeda escanea los avances en consulta sin cables ni nube.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="glass-card partners-card">
        <h3>Alianzas de Investigación</h3>
        <p class="partners-sub">Red académica y tecnológica de soporte:</p>

        <div class="partners-list">
          {partners.map((p) => (
            <div class="partner-item">
              <span class="partner-name">{p.name}</span>
              <span class="partner-desc">{p.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .telemetry-section {
    padding: 80px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid var(--border-light);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
  }

  .telemetry-info {
    padding: 2.25rem;
  }

  .telemetry-info h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    margin: 0.75rem 0 1rem 0;
  }

  .telemetry-info p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .telemetry-info strong {
    color: var(--text-main);
  }

  .telemetry-bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .telemetry-chip {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .chip-icon {
    font-size: 1.3rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .telemetry-chip strong {
    display: block;
    font-size: 0.88rem;
    color: var(--text-main);
    margin-bottom: 0.15rem;
  }

  .telemetry-chip p {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .partners-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .partners-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .partners-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .partners-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .partner-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .partner-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-cyan);
  }

  .partner-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .telemetry-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .telemetry-bento {
      grid-template-columns: 1fr;
    }
  }
</style>
