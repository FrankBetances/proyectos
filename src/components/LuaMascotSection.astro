---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const luaPillars = [
  {
    icon: "🐱",
    title: "Cero Castigo ni Frustración",
    desc: "Celebra cada intento con ronroneo en pantalla y nunca se entristece ni resta puntos si la familia se toma un descanso."
  },
  {
    icon: "👀",
    title: "Descanso Visual (Regla 20-20-20)",
    desc: "Cada 20 minutos de uso, Lúa duerme una siesta de 20 segundos para invitar al menor a relajar la vista mirando a lo lejos."
  },
  {
    icon: "🏆",
    title: "Gamificación con Propósito",
    desc: "12 niveles evolutivos y recompensas para su armario (pescadito, flor, cascabel) que refuerzan la constancia."
  },
  {
    icon: "📟",
    title: "Hardware Oficial (ESP32-C3)",
    desc: "Dispositivo físico con pantalla circular GC9A01, enlace BLE y silencio clínico total sin micrófonos."
  }
];
---

<section id="lua-mascota" class="lua-mascot-section">
  <div class="container">
    <div class="glass-card lua-box">
      <div class="section-header lua-header">
        <span class="tag tag-orange">Acompañamiento Pediátrico</span>
        <h2>Lúa: La Amiga que <span class="gradient-text-orange">Acompaña cada Logro</span></h2>
        <p>
          Transforma la terapia en una experiencia positiva: refuerzo motivacional, descanso visual y respeto absoluto al ritmo infantil.
        </p>
      </div>

      <!-- 4 Pillars Grid - Centered & Symmetrical -->
      <div class="lua-features-grid">
        {luaPillars.map((item) => (
          <div class="lua-feature-card">
            <span class="lua-icon">{item.icon}</span>
            <div class="lua-card-body">
              <h4>{item.title}</h4>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Centered Link to Hardware -->
      <div class="lua-cta-row">
        <a href={`${baseUrl}/lua`} class="btn-pill-link">
          <span>Ver Dispositivo y Hardware de Lúa →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .lua-mascot-section {
    padding: 85px 0;
    position: relative;
    border-top: 1px solid var(--border-light);
  }

  .lua-box {
    padding: 3rem 2.5rem;
    max-width: 1060px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(67, 20, 7, 0.3) 100%);
    border: 1px solid rgba(249, 115, 22, 0.35);
    box-shadow: 0 10px 40px rgba(249, 115, 22, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lua-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .tag-orange {
    color: #fb923c !important;
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #fb923c 0%, #f43f5e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lua-header p {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .lua-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    width: 100%;
  }

  .lua-feature-card {
    background: rgba(2, 6, 23, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .lua-feature-card:hover {
    transform: translateY(-3px);
    border-color: rgba(249, 115, 22, 0.4);
    background: rgba(2, 6, 23, 0.65);
  }

  .lua-icon {
    font-size: 1.8rem;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.25);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    margin: 0 auto 1rem auto;
    flex-shrink: 0;
  }

  .lua-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .lua-card-body h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text-main);
    text-align: center;
  }

  .lua-card-body p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    text-align: center;
    max-width: 420px;
  }

  .lua-cta-row {
    display: flex;
    justify-content: center;
    margin: 0 auto;
  }

  .btn-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.4);
    color: #fdba74;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-pill-link:hover {
    background: rgba(249, 115, 22, 0.25);
    border-color: rgba(249, 115, 22, 0.7);
    color: #fff;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .lua-box {
      padding: 2rem 1.25rem;
    }
    .lua-features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
