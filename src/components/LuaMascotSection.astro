---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const luaPillars = [
  {
    iconName: "heart",
    title: "Cero Castigo ni Frustración",
    desc: "Refuerzo positivo inmediato con ronroneo animado en pantalla. Lúa nunca resta puntos ni entristece ante pausas o fallos de pronunciación."
  },
  {
    iconName: "eye",
    title: "Descanso Visual (Regla 20-20-20)",
    desc: "Cada 20 minutos de estimulación, Lúa duerme una siesta programada de 20 segundos invitando al menor a mirar a lo lejos para relajar la vista."
  },
  {
    iconName: "award",
    title: "Gamificación con Propósito",
    desc: "12 niveles evolutivos, 18 insignias de superación y complementos para su armario (flores, cascabel, lazo) sin compras dentro de la app."
  },
  {
    iconName: "cpu",
    title: "Dispositivo Hardware startTIC",
    desc: "Mascota física complementaria con microcontrolador ESP32-C3, pantalla redonda GC9A01, enlace BLE y silencio acústico estricto sin micrófonos."
  }
];
---

<!-- Lúa: Acompañamiento Pediátrico & Píxel Art -->
<section id="lua-mascota" class="lua-mascot-section">
  <div class="container">
    <div class="glass-card lua-box">
      <!-- Section Header -->
      <div class="section-header lua-header">
        <span class="tag tag-orange">Acompañamiento Pediátrico & Neuroeducación</span>
        <h2>Lúa: La Amiga que <span class="gradient-text-orange">Celebra cada Logro</span></h2>
        <p>
          Convierte la intervención clínica en una experiencia lúdica segura: motivación afectiva, respeto al descanso visual y cero ansiedad.
        </p>
      </div>

      <!-- Asymmetrical Layout: Mascot Art Showcase + 4 Pillars -->
      <div class="lua-grid-layout">
        <!-- Visual Column: Lúa Pixel Art Frame -->
        <div class="lua-art-card">
          <div class="lua-ambient-glow" aria-hidden="true"></div>
          <div class="lua-art-frame">
            <img 
              src={`${baseUrl}/assets/lua-pixel-art.png`} 
              alt="Lúa la mascota oficial de Valeria+ en pixel art de alta resolución" 
              class="lua-pixel-img"
              width="400"
              height="400"
              loading="lazy"
              decoding="async"
            />
            <div class="lua-art-meta">
              <span class="lua-meta-pill">Matriz 24×24 Pixel Art</span>
              <span class="lua-meta-pill">28 Expresiones Afectivas</span>
            </div>
          </div>
        </div>

        <!-- Pillars Column -->
        <div class="lua-pillars-column">
          {luaPillars.map((item) => (
            <div class="lua-pillar-card">
              <div class="pillar-icon-box">
                {item.iconName === 'heart' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                )}
                {item.iconName === 'eye' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                )}
                {item.iconName === 'award' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                )}
                {item.iconName === 'cpu' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                    <rect x="9" y="9" width="6" height="6"></rect>
                    <line x1="9" y1="1" x2="9" y2="4"></line>
                    <line x1="15" y1="1" x2="15" y2="4"></line>
                    <line x1="9" y1="20" x2="9" y2="23"></line>
                    <line x1="15" y1="20" x2="15" y2="23"></line>
                    <line x1="20" y1="9" x2="23" y2="9"></line>
                    <line x1="20" y1="14" x2="23" y2="14"></line>
                    <line x1="1" y1="9" x2="4" y2="9"></line>
                    <line x1="1" y1="14" x2="4" y2="14"></line>
                  </svg>
                )}
              </div>
              <div class="pillar-text">
                <h4>{item.title}</h4>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Link to Dedicated Hardware Page -->
      <div class="lua-cta-row">
        <a href={`${baseUrl}/lua`} class="btn-pill-link touch-target">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span>Conoce el Dispositivo Físico de Lúa (ESP32-C3) →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .lua-mascot-section {
    padding: 85px 0;
    position: relative;
    border-top: 1px solid var(--border-light);
  }

  .lua-box {
    padding: 3.5rem 3rem;
    max-width: 1120px;
    margin: 0 auto;
    background: linear-gradient(145deg, rgba(15, 23, 42, 0.88) 0%, rgba(45, 17, 8, 0.35) 100%);
    border: 1px solid rgba(249, 115, 22, 0.35);
    box-shadow: 0 15px 45px rgba(249, 115, 22, 0.12);
  }

  .tag-orange {
    color: #fb923c !important;
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #fb923c 0%, #f43f5e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lua-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .lua-header p {
    max-width: 740px;
    margin: 0 auto;
  }

  .lua-grid-layout {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2.75rem;
  }

  /* Mascot Art Frame */
  .lua-art-card {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .lua-ambient-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.28) 0%, transparent 70%);
    filter: blur(40px);
    z-index: 0;
    pointer-events: none;
  }

  .lua-art-frame {
    position: relative;
    z-index: 1;
    background: rgba(10, 14, 23, 0.85);
    border: 1px solid rgba(249, 115, 22, 0.4);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.7);
  }

  .lua-pixel-img {
    width: 220px;
    height: auto;
    object-fit: contain;
    image-rendering: pixelated;
    display: block;
    margin-bottom: 1.25rem;
    transition: transform 0.3s ease;
  }

  .lua-art-card:hover .lua-pixel-img {
    transform: scale(1.05);
  }

  .lua-art-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .lua-meta-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: #fdba74;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: var(--radius-full);
    padding: 0.25rem 0.65rem;
  }

  /* Pillars Column */
  .lua-pillars-column {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .lua-pillar-card {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    background: rgba(2, 6, 23, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .lua-pillar-card:hover {
    transform: translateX(4px);
    border-color: rgba(249, 115, 22, 0.4);
    background: rgba(2, 6, 23, 0.7);
  }

  .pillar-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: #fb923c;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pillar-text h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.3rem;
  }

  .pillar-text p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .lua-cta-row {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .btn-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.8rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.14);
    border: 1px solid rgba(249, 115, 22, 0.45);
    color: #fdba74;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-pill-link:hover {
    background: rgba(249, 115, 22, 0.25);
    border-color: rgba(249, 115, 22, 0.75);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(249, 115, 22, 0.25);
  }

  @media (max-width: 960px) {
    .lua-grid-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .lua-box {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .lua-mascot-section {
      padding: 50px 0;
    }

    .lua-pillar-card {
      padding: 1rem;
      gap: 0.85rem;
    }

    .pillar-icon-box {
      width: 38px;
      height: 38px;
    }

    .pillar-text h4 {
      font-size: 0.98rem;
    }

    .pillar-text p {
      font-size: 0.84rem;
    }

    .btn-pill-link {
      width: 100%;
      justify-content: center;
      font-size: 0.88rem;
    }
  }
</style>
