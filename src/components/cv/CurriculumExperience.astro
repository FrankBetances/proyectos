<section id="seccion-experiencia" class="cv-section">
  <div class="container">
    <div class="section-header align-left">
      <span class="tag">Trayectoria Médica & Docente</span>
      <h2>Experiencia Profesional</h2>
      <p>Desempeño clínico en servicios de Otorrinolaringología, Audiología Infantil, Cirugía Otológica y docencia universitaria.</p>
    </div>

    <div class="timeline">
      <!-- Item 1 -->
      <div class="timeline-item active">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <span class="role-badge">Puesto Actual</span>
              <h3 class="role-title">Facultativo Especialista de Área (FEA) de Otorrinolaringología</h3>
              <h4 class="institution">Hospital Ribera Polusa · Lugo, España</h4>
            </div>
            <span class="timeline-date">Marzo 2026 — Presente</span>
          </div>
          <p class="timeline-desc">
            Atención especializada en Otorrinolaringología, audiología diagnóstica, patología cervicofacial y desarrollo de técnicas avanzadas.
          </p>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Facultativo Especialista de Área (FEA) de Otorrinolaringología</h3>
              <h4 class="institution">Hospital Universitario de Guadalajara · Guadalajara, España</h4>
            </div>
            <span class="timeline-date">Julio 2025 — Noviembre 2025</span>
          </div>
          <p class="timeline-desc">
            Asistencia médica y quirúrgica en patología ORL. Miembro activo del grupo multidisciplinar de investigación clínica HUGU / IDISCAM.
          </p>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Facultativo Especialista de Área (FEA) de Otorrinolaringología</h3>
              <h4 class="institution">Hospital Universitario Lucus Augusti (HULA) · Lugo, España</h4>
            </div>
            <span class="timeline-date">Enero 2021 — Julio 2024</span>
          </div>
          <p class="timeline-desc">
            Actividad médica y quirúrgica avanzada en otología, audiología infantil, rehabilitación vestibular e impulso de proyectos de innovación en salud digital (Primer Premio Innovación SERGAS 2023).
          </p>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">FEA Otorrinolaringología — Unidad de Audiología Infantil</h3>
              <h4 class="institution">Hospital Universitario de Donostia · Gipuzkoa, España</h4>
            </div>
            <span class="timeline-date">Enero 2019 — Enero 2021</span>
          </div>
          <p class="timeline-desc">
            Especialización en cribado auditivo neonatal, audiometría infantil, selección y adaptación de audífonos e implantes cocleares en población pediátrica.
          </p>
        </div>
      </div>

      <!-- Item 5 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <span class="role-badge badge-academic">Docencia Universitaria</span>
              <h3 class="role-title">Docente de Metodología de la Investigación Médica</h3>
              <h4 class="institution">Escuela de Medicina — Universidad Católica del Cibao (UCATECI)</h4>
            </div>
            <span class="timeline-date">Septiembre 2020 — Abril 2025</span>
          </div>
          <p class="timeline-desc">
            Impartición de docencia universitaria a estudiantes de medicina en diseño de proyectos de investigación científica, epidemiología clínica y bioestadística.
          </p>
        </div>
      </div>

      <!-- Item 6 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Facultativo Especialista de Área (FEA) de Otorrinolaringología</h3>
              <h4 class="institution">Hospital Obispo Polanco · Teruel, España</h4>
            </div>
            <span class="timeline-date">Septiembre 2017 — Enero 2019</span>
          </div>
          <p class="timeline-desc">
            Diagnóstico y cirugía ORL general. Desarrollo del prototipo VideoFrenzel de bajo coste galardonado con el Premio Jóvenes Creadores Aragoneses.
          </p>
        </div>
      </div>

      <!-- Item 7 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Clinical & Research Fellowship in Skull Base & Otology</h3>
              <h4 class="institution">Gruppo Otologico · Piacenza, Italia</h4>
            </div>
            <span class="timeline-date">Junio 2016</span>
          </div>
          <p class="timeline-desc">
            Fellowship intensivo con el Prof. Mario Sanna en cirugía de la base lateral del cráneo, otología avanzada, neurootología y cirugía de implantes cocleares.
          </p>
        </div>
      </div>

      <!-- Item 8 -->
      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="marker-dot"></span>
        </div>
        <div class="timeline-content glass-card">
          <div class="timeline-header">
            <div>
              <h3 class="role-title">Médico Residente (MIR) de Otorrinolaringología</h3>
              <h4 class="institution">Complexo Hospitalario Universitario de Vigo (CHUVI) · Vigo, España</h4>
            </div>
            <span class="timeline-date">Mayo 2013 — Mayo 2017</span>
          </div>
          <p class="timeline-desc">
            Formación vía MIR de 4 años abarcando cirugía oncología de cabeza y cuello, otología, rinología endoscópica, laringología y patología del oído interno.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cv-section {
    padding: 3.5rem 0;
  }

  .align-left {
    text-align: left;
    max-width: 100%;
    margin-bottom: 2.5rem;
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 15px;
    bottom: 15px;
    left: 7px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-cyan) 0%, rgba(138, 43, 226, 0.4) 100%);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 1.75rem;
  }

  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 24px;
    transform: translateX(-50%);
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-dark);
    border: 3px solid var(--accent-cyan);
    display: block;
    box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
  }

  .timeline-item.active .marker-dot {
    background: var(--accent-cyan);
    box-shadow: 0 0 15px var(--accent-cyan);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .role-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.3);
    margin-bottom: 0.4rem;
  }

  .role-badge.badge-academic {
    background: rgba(138, 43, 226, 0.12);
    color: #C084FC;
    border-color: rgba(138, 43, 226, 0.35);
  }

  .role-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .institution {
    font-size: 0.95rem;
    color: var(--accent-blue);
    font-weight: 500;
  }

  .timeline-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dim);
    background: var(--bg-pill);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-light);
    white-space: nowrap;
  }

  .timeline-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media print {
    .timeline::before {
      background: #ccc !important;
    }
    .marker-dot {
      border-color: #000 !important;
    }
    .timeline-content {
      background: none !important;
      border: 1px solid #ddd !important;
      color: #000 !important;
    }
    .role-title, .institution {
      color: #000 !important;
    }
    .timeline-desc {
      color: #333 !important;
    }
  }
</style>
