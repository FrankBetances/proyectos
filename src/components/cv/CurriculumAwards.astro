<section id="seccion-premios" class="cv-section">
  <div class="container">
    <div class="section-header align-left">
      <span class="tag">Reconocimientos & Premios</span>
      <h2>Distinciones, Premios de Innovación & Sellos</h2>
      <p>Reconocimientos a la trayectoria científica, clínica y a la transferencia tecnológica en salud digital.</p>
    </div>

    <div class="awards-timeline">
      {awards.map((award) => (
        <div class="award-item glass-card">
          <div class="award-year-col">
            <span class="award-year-badge">{award.year}</span>
          </div>
          <div class="award-info-col">
            <h3 class="award-title">{award.title}</h3>
            <span class="award-entity">{award.entity}</span>
            <p class="award-desc">{award.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cv-section {
    padding: 3.5rem 0;
  }

  .align-left {
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .section-header .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.3);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 700px;
  }

  .awards-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .award-item {
    display: flex;
    gap: 2rem;
    padding: 1.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .award-item:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 158, 11, 0.4);
  }

  .award-year-col {
    flex-shrink: 0;
  }

  .award-year-badge {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #FCD34D;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    border-radius: var(--radius-sm);
  }

  .award-info-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .award-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.3;
  }

  .award-entity {
    font-size: 0.9rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .award-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .award-item {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem;
    }
  }
</style>
