const articuloCount = publications.filter(p => p.category === 'articulo').length;
const libroCount = publications.filter(p => p.category === 'libro').length;
const preprintCount = publications.filter(p => p.category === 'preprint').length;
---

<section id="seccion-publicaciones" class="cv-section">
  <div class="container">
    <div class="section-header align-left">
      <span class="tag">Producción Científica</span>
      <h2>Publicaciones & Capítulos de Libros</h2>
      <p>Artículos biomédicos indexados, capítulos de libros y publicaciones de investigación en tecnología de audición e IA.</p>
    </div>

    <!-- Filter & Search Controls -->
    <div class="pub-controls print-hide">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="pub-search" placeholder="Buscar por título, autor o revista..." aria-label="Buscar publicaciones por texto" />
      </div>

      <div class="filter-buttons" role="group" aria-label="Filtrar publicaciones por categoría">
        <button class="pub-filter active" aria-pressed="true" data-cat="all">
          <span>Todos</span> <span class="filter-count">{totalCount}</span>
        </button>
        <button class="pub-filter" aria-pressed="false" data-cat="articulo">
          <span>Artículos</span> <span class="filter-count">{articuloCount}</span>
        </button>
        <button class="pub-filter" aria-pressed="false" data-cat="libro">
          <span>Libros</span> <span class="filter-count">{libroCount}</span>
        </button>
        <button class="pub-filter" aria-pressed="false" data-cat="preprint">
          <span>Preprints / Zenodo</span> <span class="filter-count">{preprintCount}</span>
        </button>
      </div>
    </div>

    <div class="pub-list" id="pub-list-container">
      {publications.map((pub) => (
        <div class="pub-card glass-card" data-category={pub.category}>
          <div class="pub-header">
            <span class="pub-year">{pub.year}</span>
            <span class="badge badge-cyan">{pub.category.toUpperCase()}</span>
          </div>

          <h3 class="pub-title">{pub.title}</h3>
          <p class="pub-authors">{pub.authors}</p>
          <p class="pub-journal">
            <strong>{pub.journal}</strong> · <span class="pub-details">{pub.details}</span>
          </p>

          {pub.url && (
            <a href={pub.url} target="_blank" rel="noopener noreferrer" class="pub-link print-hide">
              <span>Ver Publicación / DOI</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('pub-search') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.pub-filter');
    const pubCards = document.querySelectorAll('.pub-card');

    let currentCategory = 'all';
    let currentQuery = '';

    function filterPubs() {
      pubCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const text = card.textContent?.toLowerCase() || '';

        const matchesCat = currentCategory === 'all' || cat === currentCategory;
        const matchesQuery = !currentQuery || text.includes(currentQuery);

        if (matchesCat && matchesQuery) {
          (card as HTMLElement).style.display = 'flex';
          (card as HTMLElement).style.opacity = '1';
        } else {
          (card as HTMLElement).style.display = 'none';
          (card as HTMLElement).style.opacity = '0';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase();
        filterPubs();
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        currentCategory = btn.getAttribute('data-cat') || 'all';
        filterPubs();
      });
    });
  });
</script>

<style>
