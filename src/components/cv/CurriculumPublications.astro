    gap: 1.25rem;
  }

  .pub-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .pub-year {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--accent-cyan);
  }

  .pub-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }

  .pub-authors {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .pub-journal {
    color: var(--text-dim);
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-blue);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.2s ease;
  }

  .pub-link:hover {
    color: var(--accent-cyan);
    text-decoration: underline;
  }

  @media print {
    .pub-card {
      background: none !important;
      border: 1px solid #eee !important;
      break-inside: avoid;
    }
    .pub-title, .pub-authors, .pub-journal {
      color: #000 !important;
    }
  }
</style>
