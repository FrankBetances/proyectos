---
---

<div id="contact-modal" class="modal-overlay print-hide" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
  <div class="modal-card glass-card">
    <button id="close-modal" type="button" class="close-btn" aria-label="Cerrar ventana de contacto">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-header">
      <div class="modal-icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </div>
      <h3 id="contact-modal-title">Contacto con el Dr. Frank Betances</h3>
      <p>Pilotos en escuelas o consultas, licencias institucionales y colaboraciones técnicas.</p>
    </div>

    <div class="modal-body">
      <div class="contact-links">
        <a href="mailto:frank.alberto.betances.reinoso@gmail.com?subject=Consulta%20Earlify%20Health" class="contact-card contact-card-primary">
          <div class="contact-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div>
            <h4>Correo directo</h4>
            <p class="mono-mail">frank.alberto.betances.reinoso@gmail.com</p>
          </div>
        </a>

        <a href="https://orcid.org/0000-0002-6349-9537" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="contact-icon id-orcid" aria-hidden="true">ID</div>
          <div>
            <h4>ORCID · Registro científico</h4>
            <p>0000-0002-6349-9537</p>
          </div>
        </a>

        <a href="https://github.com/FrankBetances" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="contact-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </div>
          <div>
            <h4>GitHub · Repositorios</h4>
            <p>Código abierto educativo y documentación pública.</p>
          </div>
        </a>
      </div>

      <form class="contact-form" id="contact-direct-form">
        <h4>Preparar correo directo</h4>
        <div class="form-group">
          <label for="contact-name">Nombre y centro o familia</label>
          <input type="text" id="contact-name" placeholder="Ej. Ana López · Escuela Infantil de Vigo" required />
        </div>
        <div class="form-group">
          <label for="contact-topic">Proyecto de interés</label>
          <input type="text" id="contact-topic" placeholder="Ej. Piloto Descubre con Lúa / Demo VIA+ / Valeria+" required />
        </div>
        <div class="form-group">
          <label for="contact-msg">Mensaje</label>
          <textarea id="contact-msg" rows="3" placeholder="Cuéntame brevemente qué necesitas probar o acordar..." required></textarea>
        </div>
        <button type="submit" class="btn-primary full-width">Abrir en mi gestor de correo</button>
      </form>
    </div>
  </div>
</div>

<script>
  function initContactModal() {
    const modal = document.getElementById('contact-modal');
    const openBtns = document.querySelectorAll('#open-contact-modal, #open-contact-modal-footer, [data-open-contact]');
    const closeBtn = document.getElementById('close-modal');
    const form = document.getElementById('contact-direct-form') as HTMLFormElement | null;

    function openModal() {
      if (modal) {
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    openBtns.forEach((btn) => btn.addEventListener('click', openModal));
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim() || '';
        const topic = (document.getElementById('contact-topic') as HTMLInputElement)?.value.trim() || 'Consulta Earlify Health';
        const msg = (document.getElementById('contact-msg') as HTMLTextAreaElement)?.value.trim() || '';
        const subject = encodeURIComponent(`[Web Earlify] ${topic}`);
        const body = encodeURIComponent(`Nombre / Centro: ${name}\n\n${msg}`);
        window.location.href = `mailto:frank.alberto.betances.reinoso@gmail.com?subject=${subject}&body=${body}`;
        closeModal();
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('open')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactModal);
  } else {
    initContactModal();
  }
</script>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(7, 9, 14, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-card {
    max-width: 560px;
    width: 100%;
    position: relative;
    padding: 2rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-btn {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-light);
    color: var(--text-muted);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .close-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: var(--text-main);
  }

  .modal-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .modal-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 0.75rem;
    border-radius: 14px;
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.3);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-header h3 {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }

  .modal-header p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.4rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .contact-card-primary {
    border-color: rgba(0, 242, 254, 0.35);
    background: rgba(0, 242, 254, 0.06);
  }

  .contact-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent-cyan);
  }

  .contact-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-icon.id-orcid {
    font-weight: 800;
    font-size: 0.8rem;
    background: #a6ce39;
    color: #000;
    padding: 4px 6px;
    border-radius: 4px;
  }

  .contact-card h4 {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .contact-card p {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .mono-mail {
    font-family: 'JetBrains Mono', monospace;
    color: #67e8f9 !important;
    word-break: break-all;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-light);
  }

  .contact-form h4 {
    font-size: 1rem;
    font-weight: 700;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.7rem 0.95rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.92rem;
    outline: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent-cyan);
  }

  .full-width {
    width: 100%;
    justify-content: center;
  }
</style>
