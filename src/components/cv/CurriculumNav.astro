---

<div class="cv-nav-sticky print-hide">
  <div class="container">
    <nav class="cv-tabs" role="tablist" aria-label="Secciones del Currículum">
      <button class="tab-btn active" role="tab" aria-selected="true" aria-controls="seccion-experiencia" data-target="seccion-experiencia">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        <span>Experiencia</span>
      </button>

      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="seccion-proyectos" data-target="seccion-proyectos">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        <span>Proyectos</span>
      </button>

      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="seccion-premios" data-target="seccion-premios">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
        <span>Premios</span>
      </button>

      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="seccion-formacion" data-target="seccion-formacion">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
        <span>Formación</span>
      </button>

      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="seccion-publicaciones" data-target="seccion-publicaciones">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        <span>Publicaciones</span>
      </button>

      <button class="tab-btn" role="tab" aria-selected="false" aria-controls="seccion-comunicaciones" data-target="seccion-comunicaciones">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Ponencias</span>
      </button>
    </nav>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const sectionIds = Array.from(tabButtons).map(btn => btn.getAttribute('data-target')).filter(Boolean);
    const sections = sectionIds.map(id => document.getElementById(id!)).filter(Boolean) as HTMLElement[];

    let isManualScrolling = false;

    function setActiveTab(targetId: string) {
      tabButtons.forEach(btn => {
        const isTarget = btn.getAttribute('data-target') === targetId;
        if (isTarget) {
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        }
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        isManualScrolling = true;
        setActiveTab(targetId);

        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          const offset = 140;
          const targetPos = targetEl.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top: targetPos, behavior: 'smooth' });

          setTimeout(() => {
            isManualScrolling = false;
          }, 800);
        }
      });
    });

    if ('IntersectionObserver' in window && sections.length > 0) {
      const observerOptions = {
        root: null,
        rootMargin: '-130px 0px -40% 0px',
        threshold: [0, 0.1, 0.25, 0.5]
      };

      const observer = new IntersectionObserver((entries) => {
        if (isManualScrolling) return;

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            setActiveTab(entry.target.id);
          }
        });
      }, observerOptions);

      sections.forEach(sec => observer.observe(sec));
    }
  });
</script>

<style>
  .cv-nav-sticky {
    position: sticky;
    top: 76px;
    z-index: 90;
    background: rgba(7, 9, 14, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-light);
    padding: 0.5rem 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .cv-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0.1rem 0;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    justify-content: flex-start;
  }

  .cv-tabs::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-light);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    outline: none;
    flex-shrink: 0;
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .tab-btn.active {
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.18) 0%, rgba(79, 172, 254, 0.22) 100%);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    font-weight: 700;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.2);
  }

  @media print {
    .cv-nav-sticky {
      display: none !important;
    }
  }
</style>
