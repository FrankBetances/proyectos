---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const languages = [
  {
    type: "es",
    name: "Castellano",
    code: "es",
    count: "1.444 locuciones",
    voice: "Voz Sharvard",
    engine: "Neuronal pregenerada offline",
    desc: "Banco normativo estándar para la terapia del lenguaje infantil."
  },
  {
    type: "gl",
    name: "Galego",
    code: "gl",
    project: "Proxecto Nós / ILENIA",
    count: "1.430 locuciones",
    voice: "Voz Celtia",
    engine: "Neuronal Proxecto Nós",
    desc: "Banco propio en los 10 bloques validado por logopedas de ACOPROS."
  },
  {
    type: "es-DO",
    name: "Dominicano",
    code: "es-DO",
    project: "Quisqueya Habla (UFHEC)",
    count: "Corpus Caribeño",
    voice: "Voz Latina",
    engine: "Motor local del dispositivo",
    desc: "Respeta el habla caribeña sin penalizar alófonos dialectales normales."
  },
  {
    type: "eu",
    name: "Euskara",
    code: "eu",
    project: "ILENIA / NEL-GAITU · HiTZ",
    count: "756 locuciones",
    voice: "HiTZ-TTS",
    engine: "Aholab / UPV-EHU",
    desc: "Contenido íntegro en euskera batua sin mezcla de idiomas en todos los módulos."
  },
  {
    type: "en-US",
    name: "US English",
    code: "en-US",
    project: "Howard University SLP",
    count: "814 locuciones",
    voice: "LJSpeech · Piper",
    engine: "Neuronal offline",
    desc: "Interfaz traducida completa, registro clínico SLP y guía dialectal AAVE."
  },
  {
    type: "ca",
    name: "Català",
    code: "ca",
    project: "Projecte AINA · BSC",
    count: "868 locuciones (52,6 min)",
    voice: "Matxa-TTS",
    engine: "Neuronal AINA / BSC",
    desc: "Contrastes fonológicos propios (/s/–/z/, /ʃ/–/ʒ/, /ɔ/–/o/, /ʎ/–/l/) revisados en Barcelona."
  }
];
---

<section id="idiomas" class="languages-section section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Variedad Lingüística & Síntesis Neuronal</span>
      <h2>6 Variedades de Voz <span class="gradient-text">100% Offline</span></h2>
      <p><strong>4.711 locuciones neuronales</strong> empaquetadas en la propia app: rigor fonético y naturalidad sin depender de conexión a internet. Además, 4 idiomas de interfaz (Castellano, Galego, Català y English).</p>
    </div>

    <div class="lang-content-layout">
      <!-- Screenshot Phone Mockup -->
      <div class="lang-screenshot-col">
        <div class="device-frame">
          <img 
            src={`${baseUrl}/assets/22-voz-variedad.png`} 
            alt="Selector de Variedad Lingüística en Valeria+" 
            class="manual-screenshot" 
            width="780"
            height="1688"
            loading="lazy" 
            decoding="async"
          />
          <span class="screenshot-chip">Desacoplamiento Voz / UI</span>
        </div>
      </div>

      <!-- Languages Grid -->
      <div class="languages-grid">
        {languages.map((lang) => (
          <div class="glass-card lang-card">
            <div class="lang-header">
              <span class="lang-flag">{lang.type}</span>
              <div class="lang-title-group">
                <h3>{lang.name}</h3>
                {lang.project && <span class="lang-project">{lang.project}</span>}
              </div>
              <span class="lang-code">{lang.code}</span>
            </div>

            <div class="lang-details">
              <div class="detail-row">
                <span class="detail-label">Volumen:</span>
                <span class="detail-value">{lang.count}</span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Voz Neuronal:</span>
                <span class="detail-value">{lang.voice}</span>
              </div>
            </div>

            <p class="lang-desc">{lang.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding: 80px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.15);
    border-top: 1px solid var(--border-light);
  }

  .lang-content-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 3rem;
    align-items: center;
  }

  .lang-screenshot-col {
    display: flex;
    justify-content: center;
  }

  .device-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .manual-screenshot {
    width: 280px;
    height: auto;
    border-radius: 28px;
    border: 2px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 15px 45px -10px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 242, 254, 0.12);
  }

  .screenshot-chip {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    height: 100%;
  }

  .lang-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
  }

  .lang-flag {
    font-size: 1.15rem;
    line-height: 1;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .lang-title-group {
    flex-grow: 1;
  }

  .lang-title-group h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .lang-project {
    font-size: 0.725rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .lang-code {
    font-size: 0.725rem;
    font-family: monospace;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    color: var(--text-dim);
  }

  .lang-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-md);
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .detail-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .detail-value {
    font-size: 0.8rem;
    color: var(--text-main);
    font-weight: 500;
  }

  .lang-desc {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 960px) {
    .lang-content-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .lang-screenshot-col {
      order: -1;
    }
  }
</style>
