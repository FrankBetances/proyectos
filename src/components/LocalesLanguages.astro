---
const languages = [
  {
    code: "es",
    name: "Castellano",
    project: "Estándar Normativo",
    count: "1.444 locuciones",
    voice: "Voz Sharvard",
    desc: "Banco de referencia para la terapia auditivo-verbal y del lenguaje infantil."
  },
  {
    code: "gl",
    name: "Galego",
    project: "Proxecto Nós / ILENIA",
    count: "1.430 locuciones",
    voice: "Voz Celtia",
    desc: "Banco propio en los 10 bloques revisado y validado por logopedas de ACOPROS."
  },
  {
    code: "es-DO",
    name: "Dominicano",
    project: "Quisqueya Habla (UFHEC)",
    count: "Corpus Caribeño",
    voice: "Voz Latina",
    desc: "Respeta el habla caribeña sin penalizar alófonos dialectales normales."
  },
  {
    code: "eu",
    name: "Euskara",
    project: "ILENIA / HiTZ · UPV",
    count: "756 locuciones",
    voice: "HiTZ-TTS",
    desc: "Contenido íntegro en euskera batua sin mezcla de idiomas en todos los módulos."
  },
  {
    code: "en-US",
    name: "US English",
    project: "Howard University SLP",
    count: "814 locuciones",
    voice: "LJSpeech · Piper",
    desc: "Interfaz traducida completa, registro clínico SLP y guía dialectal AAVE."
  },
  {
    code: "ca",
    name: "Català",
    project: "Projecte AINA · BSC",
    count: "868 locuciones",
    voice: "Matxa-TTS",
    desc: "Contrastes fonológicos propios (/s/–/z/, /ʃ/–/ʒ/, /ɔ/–/o/, /ʎ/–/l/) auditados."
  }
];
---

<section id="idiomas" class="languages-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Variedad Lingüística & Síntesis Neuronal</span>
      <h2>6 Variedades de Voz · <span class="gradient-text">100% Offline</span></h2>
      <p>
        <strong>4.711 locuciones neuronales</strong> empaquetadas en la app con rigor fonético y cero dependencia de internet. Además, interfaz disponible en 4 idiomas (Castellano, Galego, Català e Inglés).
      </p>
    </div>

    <!-- Languages Grid - Symmetrical & Centered -->
    <div class="languages-grid">
      {languages.map((lang) => (
        <div class="glass-card lang-card">
          <div class="lang-top">
            <span class="lang-flag">{lang.code}</span>
            <span class="badge badge-cyan">{lang.count}</span>
          </div>

          <div class="lang-body">
            <h3>{lang.name}</h3>
            <span class="lang-project">{lang.project}</span>
            <div class="voice-pill">
              <span class="voice-icon">🎙️</span>
              <span class="voice-name">{lang.voice}</span>
            </div>
            <p class="lang-desc">{lang.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.15);
    border-top: 1px solid var(--border-light);
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .lang-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .lang-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .lang-flag {
    font-size: 0.8rem;
    font-weight: 800;
    font-family: monospace;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.25);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .lang-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    flex-grow: 1;
    width: 100%;
  }

  .lang-body h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-main);
    text-align: center;
  }

  .lang-project {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .voice-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    margin: 0.25rem auto 0.5rem auto;
  }

  .voice-icon {
    font-size: 0.85rem;
  }

  .voice-name {
    color: var(--text-main);
    font-weight: 600;
  }

  .lang-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
    text-align: center;
  }

  @media (max-width: 768px) {
    .languages-section {
      padding: 50px 0;
    }

    .languages-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .lang-card {
      padding: 1.35rem 1.15rem;
    }

    .lang-top {
      margin-bottom: 0.9rem;
    }

    .lang-body h3 {
      font-size: 1.15rem;
    }

    .lang-desc {
      font-size: 0.86rem;
    }
  }
</style>
