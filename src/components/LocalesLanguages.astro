---
const languages = [
  {
    type: "es",
    name: "Castellano",
    code: "es",
    voice: "Voz Sharvard",
    engine: "Neuronal pregenerada offline (878 locuciones)",
    asr: "Reconocedor de sistema es-ES",
    desc: "Banco estándar adaptado para la terapia del lenguaje en territorio español."
  },
  {
    type: "gl",
    name: "Galego",
    code: "gl",
    project: "Proxecto Nós",
    voice: "Voz Celtia",
    engine: "Neuronal Proxecto Nós (816 locuciones offline)",
    asr: "Reconocedor gl-ES con recaída a expo-speech",
    desc: "Cubre todos los bloques (Pares Mínimos, Audición, Lenguaje, TEA y Dislexia) con fonética gallega propia y bandera oficial."
  },
  {
    type: "es-DO",
    name: "Dominicano",
    code: "es-DO",
    project: "Quisqueya Habla",
    voice: "Voz Latina",
    engine: "Catálogo latino del dispositivo (es-US/es-MX)",
    asr: "Reconocedor es-DO adaptado",
    desc: "Proyecto editorial que respeta el léxico caribeño y NO penaliza como trastorno los rasgos dialectales normales."
  },
  {
    type: "eu",
    name: "Euskara",
    code: "eu",
    project: "ILENIA / NEL-GAITU",
    voice: "HiTZ-TTS",
    engine: "Aholab / UPV-EHU (744 locuciones offline)",
    asr: "Reconocedor eu-ES con pliegue vasco (⟨h⟩ muda)",
    desc: "Contenido íntegro en euskera batua sin saltos ni mezclas de idiomas, con Ikurriña propia."
  },
  {
    type: "en-US",
    name: "Inglés (EE. UU.)",
    code: "en-US",
    project: "Fase 0",
    voice: "Voz Neuronal",
    engine: "En desarrollo (Howard University)",
    asr: "Reconocedor en-US",
    desc: "Revisión clínica en curso con respeto dialectal (inglés afroamericano y sureño). Separa idioma de interfaz y terapia."
  }
];
---

<section id="idiomas" class="languages-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Variedad Lingüística & Síntesis Neuronal</span>
      <h2>5 Variedades Idiomáticas <span class="gradient-text">Offline</span></h2>
      <p>Cada variedad cuenta con su propio banco de voz neuronal pregenerado en CI y empaquetado en el APK sin consumo de red.</p>
    </div>

    <div class="screenshot-wrapper">
      <img 
        src={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL}/assets/22-voz-variedad.png`} 
        alt="Selector de Variedades de Voz" 
        class="manual-screenshot" 
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="lang-grid">
      {languages.map((l) => (
        <div class="glass-card lang-card">
          <div class="lang-top">
            <div class="flag-box">
              {l.type === "es" && (
                <svg width="40" height="28" viewBox="0 0 40 28" fill="none" class="flag-svg">
                  <rect width="40" height="28" rx="4" fill="#AA1515"/>
                  <rect y="7" width="40" height="14" fill="#F1BF00"/>
                  <rect width="40" height="28" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
                </svg>
              )}
              {l.type === "gl" && (
                <svg width="40" height="28" viewBox="0 0 40 28" fill="none" class="flag-svg">
                  <rect width="40" height="28" rx="4" fill="#FFFFFF"/>
                  <path d="M 0 0 L 12 0 L 40 20 L 40 28 L 28 28 L 0 8 Z" fill="#0085C8"/>
                  <rect width="40" height="28" rx="4" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
                </svg>
              )}
              {l.type === "es-DO" && (
                <svg width="40" height="28" viewBox="0 0 40 28" fill="none" class="flag-svg">
                  <rect width="40" height="28" rx="4" fill="#FFFFFF"/>
                  <rect x="0" y="0" width="17" height="11" fill="#002D62"/>
                  <rect x="23" y="0" width="17" height="11" fill="#CE1126"/>
                  <rect x="0" y="17" width="17" height="11" fill="#CE1126"/>
                  <rect x="23" y="17" width="17" height="11" fill="#002D62"/>
                  <rect x="17" y="0" width="6" height="28" fill="#FFFFFF"/>
                  <rect x="0" y="11" width="40" height="6" fill="#FFFFFF"/>
                  <circle cx="20" cy="14" r="1.8" fill="#002D62"/>
                  <rect width="40" height="28" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
                </svg>
              )}
              {l.type === "eu" && (
                <svg width="40" height="28" viewBox="0 0 40 28" fill="none" class="flag-svg">
                  <rect width="40" height="28" rx="4" fill="#D52B1E"/>
                  <path d="M0 0 L6 0 L40 24 L40 28 L34 28 L0 4 Z" fill="#007A33"/>
                  <path d="M40 0 L34 0 L0 24 L0 28 L6 28 L40 4 Z" fill="#007A33"/>
                  <rect x="17" y="0" width="6" height="28" fill="#FFFFFF"/>
                  <rect x="0" y="11" width="40" height="6" fill="#FFFFFF"/>
                  <rect width="40" height="28" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
                </svg>
              )}
              {l.type === "en-US" && (
                <svg width="40" height="28" viewBox="0 0 40 28" fill="none" class="flag-svg">
                  <rect width="40" height="28" rx="4" fill="#FFFFFF"/>
                  <rect y="0" width="40" height="4.3" fill="#B22234"/>
                  <rect y="8.6" width="40" height="4.3" fill="#B22234"/>
                  <rect y="17.2" width="40" height="4.3" fill="#B22234"/>
                  <rect y="23.7" width="40" height="4.3" fill="#B22234"/>
                  <rect width="18" height="15" rx="2" fill="#3C3B6E"/>
                  <circle cx="4.5" cy="4" r="0.8" fill="#FFFFFF"/>
                  <circle cx="13.5" cy="4" r="0.8" fill="#FFFFFF"/>
                  <circle cx="9" cy="7.5" r="0.8" fill="#FFFFFF"/>
                  <circle cx="4.5" cy="11" r="0.8" fill="#FFFFFF"/>
                  <circle cx="13.5" cy="11" r="0.8" fill="#FFFFFF"/>
                  <rect width="40" height="28" rx="4" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
                </svg>
              )}
            </div>
            <div class="lang-title">
              <h3>{l.name} <code>({l.code})</code></h3>
              {l.project && <span class="project-tag">{l.project}</span>}
            </div>
          </div>

          <p class="lang-desc">{l.desc}</p>

          <div class="lang-specs">
            <div class="spec-item">
              <span class="spec-label">Voz Neuronal:</span>
              <span class="spec-val">{l.voice} — {l.engine}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Reconocimiento (ASR):</span>
              <span class="spec-val">{l.asr}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding: 100px 0;
    position: relative;
  }

  .lang-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .lang-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .flag-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }

  .flag-svg {
    border-radius: 4px;
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.3);
  }

  .lang-title h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .lang-title code {
    font-size: 0.85rem;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .project-tag {
    display: inline-block;
    font-size: 0.725rem;
    font-weight: 700;
    color: #C084FC;
    background: rgba(138, 43, 226, 0.15);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-full);
    margin-top: 0.2rem;
  }

  .lang-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .lang-specs {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .spec-label {
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .spec-val {
    font-size: 0.825rem;
    color: var(--text-main);
  }

  .screenshot-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .manual-screenshot {
    max-width: 100%;
    width: 300px;
    height: auto;
    border-radius: 18px;
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-glow);
  }
</style>
