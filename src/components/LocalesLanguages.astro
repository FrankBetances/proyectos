---
const languages = [
  {
    type: "es",
    name: "Castellano",
    code: "es",
    voice: "Voz Sharvard",
    engine: "Neuronal pregenerada offline (878 locuciones)",
    asr: "Reconocedor de sistema es-ES con motor local",
    desc: "Banco normativo estándar para la terapia del lenguaje en territorio español."
  },
  {
    type: "gl",
    name: "Galego",
    code: "gl",
    project: "Proxecto Nós / ILENIA",
    voice: "Voz Celtia",
    engine: "Neuronal Proxecto Nós (816 locuciones offline)",
    asr: "Reconocedor gl-ES con recaída a expo-speech",
    desc: "Cubre todos los bloques terapéuticos con banco propio gallego validado por logopedas de ACOPROS."
  },
  {
    type: "es-DO",
    name: "Dominicano",
    code: "es-DO",
    project: "Quisqueya Habla",
    voice: "Voz Latina",
    engine: "Catálogo latino del dispositivo (es-US/es-MX)",
    asr: "Reconocedor es-DO adaptado",
    desc: "Proyecto editorial que respeta el léxico caribeño y NO penaliza como error los alófonos ni rasgos dialectales normales."
  },
  {
    type: "eu",
    name: "Euskara",
    code: "eu",
    project: "ILENIA / NEL-GAITU · HiTZ",
    voice: "HiTZ-TTS",
    engine: "Aholab / UPV-EHU (744 locuciones offline)",
    asr: "Reconocedor eu-ES con pliegue vasco (⟨h⟩ muda)",
    desc: "Contenido íntegro en euskera batua sin mezclas de idiomas, cubriendo pares mínimos, Audición, Lenguaje, TEA y Dislexia."
  },
  {
    type: "en-US",
    name: "US English",
    code: "en-US",
    project: "Howard University SLP",
    voice: "LJSpeech · Piper",
    engine: "Neuronal offline (614 locuciones empaquetadas)",
    asr: "Reconocedor en-US con pista de tarea corta",
    desc: "Primera variedad con catálogo de interfaz traducido completo (strings.en.ts) y guía dialectal bloqueante."
  }
];
---

<section id="idiomas" class="languages-section section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Variedad Lingüística & Síntesis Neuronal</span>
      <h2>5 Variedades Idiomáticas <span class="gradient-text">Offline</span></h2>
      <p>Cada variedad cuenta con su propio banco de voz neuronal pregenerado en CI y empaquetado en el APK sin consumo de red.</p>
    </div>

    <div class="screenshot-wrapper">
      <img 
        src={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL}/assets/22-voz-variedad.png`} 
        alt="Selector de Variedad Lingüística" 
        class="manual-screenshot" 
        loading="lazy" 
        decoding="async"
      />
    </div>

    <div class="languages-grid">
      {languages.map((lang) => (
        <div class="glass-card lang-card">
          <div class="lang-header">
            <span class="lang-flag">{lang.type}</span>
            <div class="lang-title-group">
              <h3>{lang.name}</h3>
              {lang.project && <span class="lang-project">{lang.project}</span>}
            </div>
            <span class="lang-code">{lang.code}</span>
          </div>

          <div class="lang-details">
            <div class="detail-row">
              <span class="detail-label">Motor de Voz:</span>
              <span class="detail-value">{lang.voice}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Síntesis:</span>
              <span class="detail-value">{lang.engine}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Reconocimiento (ASR):</span>
              <span class="detail-value">{lang.asr}</span>
            </div>
          </div>

          <p class="lang-desc">{lang.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding: 100px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.2);
  }

  .screenshot-wrapper {
    max-width: 320px;
    margin: 0 auto 3rem auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-light);
  }

  .manual-screenshot {
    width: 100%;
    height: auto;
    display: block;
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .lang-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .lang-flag {
    font-size: 1.75rem;
    line-height: 1;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .lang-title-group {
    flex-grow: 1;
  }

  .lang-title-group h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .lang-project {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .lang-code {
    font-size: 0.75rem;
    font-family: monospace;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: var(--text-dim);
  }

  .lang-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    background: rgba(0, 0, 0, 0.2);
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .detail-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .detail-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .detail-value {
    font-size: 0.85rem;
    color: var(--text-main);
    font-weight: 500;
  }

  .lang-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }
</style>
