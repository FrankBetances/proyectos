---
const languages = [
  {
    code: "es",
    name: "Castellano",
    project: "Estándar Normativo",
    count: "1.444 locuciones",
    voice: "Voz Sharvard",
    desc: "Banco de referencia fonética para la terapia auditivo-verbal y del lenguaje infantil."
  },
  {
    code: "gl",
    name: "Galego",
    project: "Proxecto Nós / ILENIA",
    count: "1.430 locuciones",
    voice: "Voz Celtia",
    desc: "Banco lingüístico propio en los 10 bloques, auditado por logopedas de ACOPROS."
  },
  {
    code: "es-DO",
    name: "Dominicano",
    project: "Quisqueya Habla (UFHEC)",
    count: "Corpus Caribeño",
    voice: "Voz Dominicana",
    desc: "Respeta el habla caribeña sin penalizar alófonos dialectales y prosodia normal."
  },
  {
    code: "eu",
    name: "Euskara",
    project: "HiTZ / ILENIA · UPV",
    count: "756 locuciones",
    voice: "HiTZ-TTS",
    desc: "Contenido íntegro en euskera batua sin mezclas idiomáticas en ningún ejercicio."
  },
  {
    code: "en-US",
    name: "US English",
    project: "Howard University SLP",
    count: "814 locuciones",
    voice: "LJSpeech · Piper",
    desc: "Interfaz traducida completa, baremos de pronunciación SLP y adaptación dialectal."
  },
  {
    code: "ca",
    name: "Català",
    project: "Projecte AINA · BSC",
    count: "868 locuciones",
    voice: "Matxa-TTS",
    desc: "Contrastes fonológicos propios (/s/–/z/, /ʃ/–/ʒ/, /ɔ/–/o/, /ʎ/–/l/) auditados."
  }
];
---

<!-- 6 Variedades Lingüísticas: Scroll-Snap Táctil en Móviles & SVG Limpio -->
<section id="idiomas" class="languages-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Riqueza Lingüística & Síntesis Neuronal</span>
      <h2>6 Variedades de Voz · <span class="gradient-text">100% Offline</span></h2>
      <p>
        <strong>4.711 locuciones neuronales</strong> empaquetadas sin conexión a la red. Interfaz además disponible en 4 idiomas (Castellano, Galego, Català e Inglés).
      </p>
    </div>

    <!-- Languages Carousel / Grid (Mobile Scroll-Snap) -->
    <div class="languages-slider-container">
      <div class="languages-grid scroll-snap-x">
        {languages.map((lang) => (
          <article class="glass-card lang-card scroll-snap-item">
            <div class="lang-top">
              <span class="lang-badge-code">{lang.code}</span>
              <span class="badge badge-cyan">{lang.count}</span>
            </div>

            <div class="lang-body">
              <h3>{lang.name}</h3>
              <span class="lang-project">{lang.project}</span>
              
              <div class="voice-pill">
                <svg class="voice-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                  <line x1="12" y1="19" x2="12" y2="23"></line>
                  <line x1="8" y1="23" x2="16" y2="23"></line>
                </svg>
                <span class="voice-name">{lang.voice}</span>
              </div>

              <p class="lang-desc">{lang.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.15);
    border-top: 1px solid var(--border-light);
  }

  .languages-slider-container {
    max-width: 1120px;
    margin: 0 auto;
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .lang-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .lang-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .lang-badge-code {
    font-size: 0.78rem;
    font-weight: 800;
    font-family: monospace;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .lang-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex-grow: 1;
    width: 100%;
  }

  .lang-body h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-main);
  }

  .lang-project {
    font-size: 0.74rem;
    color: var(--accent-cyan);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .voice-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.8rem;
    font-size: 0.78rem;
    margin: 0.35rem 0 0.5rem 0;
    align-self: flex-start;
  }

  .voice-icon {
    color: #38bdf8;
    flex-shrink: 0;
  }

  .voice-name {
    color: var(--text-main);
    font-weight: 600;
  }

  .lang-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 768px) {
    .languages-section {
      padding: 50px 0;
    }

    /* Horizontal scroll-snap slider for mobile */
    .languages-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      gap: 1rem;
    }

    .lang-card {
      min-width: 280px;
      max-width: 300px;
      padding: 1.35rem 1.15rem;
      flex-shrink: 0;
      scroll-snap-align: start;
    }

    .lang-body h3 {
      font-size: 1.15rem;
    }
  }
</style>
