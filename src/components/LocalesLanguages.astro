---
const languages = [
  {
    code: "es",
    name: "Castellano",
    project: "Estándar Normativo",
    count: "1.444 locuciones",
    voice: "Voz Sharvard",
    desc: "Banco de referencia para la terapia auditivo-verbal y del lenguaje infantil."
  },
  {
    code: "gl",
    name: "Galego",
    project: "Proxecto Nós / ILENIA",
    count: "1.430 locuciones",
    voice: "Voz Celtia",
    desc: "Banco propio en los 10 bloques revisado y validado por logopedas de ACOPROS."
  },
  {
    code: "es-DO",
    name: "Dominicano",
    project: "Quisqueya Habla (UFHEC)",
    count: "Corpus Caribeño",
    voice: "Voz Latina",
    desc: "Respeta el habla caribeña sin penalizar alófonos dialectales normales."
  },
  {
    code: "eu",
    name: "Euskara",
    project: "ILENIA / HiTZ · UPV",
    count: "756 locuciones",
    voice: "HiTZ-TTS",
    desc: "Contenido íntegro en euskera batua sin mezcla de idiomas en todos los módulos."
  },
  {
    code: "en-US",
    name: "US English",
    project: "Howard University SLP",
    count: "814 locuciones",
    voice: "LJSpeech · Piper",
    desc: "Interfaz traducida completa, registro clínico SLP y guía dialectal AAVE."
  },
  {
    code: "ca",
    name: "Català",
    project: "Projecte AINA · BSC",
    count: "868 locuciones",
    voice: "Matxa-TTS",
    desc: "Contrastes fonológicos propios (/s/–/z/, /ʃ/–/ʒ/, /ɔ/–/o/, /ʎ/–/l/) auditados."
  }
];
---

<section id="idiomas" class="languages-section">
  <div class="container">
    <div class="section-header">
      <span class="tag">Variedad Lingüística & Síntesis Neuronal</span>
      <h2>6 Variedades de Voz · <span class="gradient-text">100% Offline</span></h2>
      <p>
        <strong>4.711 locuciones neuronales</strong> empaquetadas en la app con rigor fonético y cero dependencia de internet. Además, interfaz disponible en 4 idiomas (Castellano, Galego, Català e Inglés).
      </p>
    </div>

    <!-- Languages Grid - Symmetrical & Centered -->
    <div class="languages-grid">
      {languages.map((lang) => (
        <div class="glass-card lang-card">
          <div class="lang-header">
            <span class="lang-flag">{lang.code}</span>
            <div class="lang-title-group">
              <h3>{lang.name}</h3>
              <span class="lang-project">{lang.project}</span>
            </div>
            <span class="badge badge-cyan">{lang.count}</span>
          </div>

          <div class="lang-body">
            <div class="detail-row">
              <span class="detail-label">Voz Neuronal:</span>
              <span class="detail-value">{lang.voice}</span>
            </div>
            <p class="lang-desc">{lang.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding: 85px 0;
    position: relative;
    background: rgba(0, 0, 0, 0.15);
    border-top: 1px solid var(--border-light);
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .lang-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .lang-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .lang-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-light);
  }

  .lang-flag {
    font-size: 0.95rem;
    font-weight: 800;
    font-family: monospace;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.25);
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .lang-title-group {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .lang-title-group h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-main);
  }

  .lang-project {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .lang-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .detail-label {
    font-size: 0.78rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .detail-value {
    font-size: 0.82rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .lang-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 768px) {
    .languages-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
