---
// DengueTriage.astro - Módulo Interactivo de Triaje Clínico Comunitario (MISPAS)
---

<section class="dengue-triage-section" id="triaje">
  <div class="container">
    <div class="section-header text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-950/60 border border-red-500/30 rounded-full mb-3">
        <span class="w-2 h-2 rounded-full bg-alert-hemodynamic"></span>
        <span class="font-mono text-xs text-red-400 font-bold uppercase tracking-wider">PROTOCOLO DE BOLSILLO · MISPAS</span>
      </div>
      <h2 class="section-title">
        Triaje Comunitario de <span class="gradient-text-red">Signos de Alarma</span>
      </h2>
      <p class="section-lead">
        El dengue puede agravarse de forma súbita al descender la fiebre. Evalúa en 3 pasos los criterios clínicos del MISPAS para actuar a tiempo.
      </p>
    </div>

    <!-- Contenedor del Triaje Interactivo -->
    <div class="triage-wrapper">
      <div class="triage-card">
        <!-- Barra de Progreso y Ley 172-13 -->
        <div class="triage-status-bar font-mono text-xs">
          <span id="triage-step-label">PASO 1 DE 3: DURACIÓN DE LA FIEBRE</span>
          <span class="text-cyan flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            100 % confidencial (Ley núm. 172-13 · Sin envío de datos)
          </span>
        </div>

        <!-- PASO 1: DURACIÓN DE FIEBRE -->
        <div id="triage-p1" class="triage-panel">
          <h3 class="panel-question">
            ¿Cuántos días continuos de fiebre tiene la persona?
          </h3>
          <p class="panel-explanation">
            La fase crítica de escape de plasma ocurre con mayor frecuencia entre el <strong>3.er y 5.º día</strong>, al descender la temperatura.
          </p>

          <div class="fever-options-grid">
            <button type="button" class="fever-card" data-fever="1-2">
              <span class="fever-stage font-mono">FASE INICIAL</span>
              <span class="fever-days">1 a 2 días</span>
              <span class="fever-note">Fiebre alta repentina, dolor de cabeza, dolor retroocular y malestar general.</span>
            </button>

            <button type="button" class="fever-card fever-critical" data-fever="3-5">
              <div class="critical-pill font-mono">MÁXIMA ATENCIÓN</div>
              <span class="fever-stage font-mono">FASE CRÍTICA</span>
              <span class="fever-days">3 a 5 días</span>
              <span class="fever-note">La temperatura comienza a bajar, pero es el momento de mayor riesgo de extravasación de plasma.</span>
            </button>

            <button type="button" class="fever-card" data-fever="6+">
              <span class="fever-stage font-mono">FASE PROLONGADA</span>
              <span class="fever-days">6 días o más</span>
              <span class="fever-note">Requiere consulta médica presencial para descartar coinfecciones o complicaciones hematológicas.</span>
            </button>
          </div>
        </div>

        <!-- PASO 2: SIGNOS DE ALARMA -->
        <div id="triage-p2" class="triage-panel hidden">
          <h3 class="panel-question text-red flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            ¿Presenta alguno de estos SIGNOS DE ALARMA?
          </h3>
          <p class="panel-explanation">
            Cualquiera de estos signos constituye una urgencia médica que exige atención hospitalaria inmediata.
          </p>

          <div class="checklist-grid font-mono">
            <label class="check-item">
              <input type="checkbox" name="alarm" value="abdominal" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Dolor abdominal intenso y continuo</span>
                <span class="check-desc font-body">Dolor fuerte y constante en el abdomen que no alivia con reposo.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="vomiting" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Vómitos persistentes o incoercibles</span>
                <span class="check-desc font-body">Tres o más vómitos en 1 hora, o cuatro o más episodios en 6 horas.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="bleeding" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Sangrado espontáneo de mucosas o hematomas</span>
                <span class="check-desc font-body">Sangrado de encías, hemorragia nasal, sangrado vaginal anormal o manchas rojas en la piel.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="lethargy" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Letargo, somnolencia extrema o irritabilidad</span>
                <span class="check-desc font-body">Dificultad marcada para despertar al niño o adulto, confusión o mareo al ponerse de pie.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="fluid" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Dificultad respiratoria o hinchazón súbita</span>
                <span class="check-desc font-body">Respiración rápida, sensación de ahogo o abdomen distendido por acumulación de líquidos.</span>
              </div>
            </label>
          </div>

          <div class="panel-nav">
            <button type="button" id="btn-back-p1" class="btn-triage-back font-mono">
              &larr; Volver a días de fiebre
            </button>
            <button type="button" id="btn-go-p3" class="btn-triage-next font-mono">
              Continuar a factores de riesgo &rarr;
            </button>
          </div>
        </div>

        <!-- PASO 3: GRUPOS VULNERABLES -->
        <div id="triage-p3" class="triage-panel hidden">
          <h3 class="panel-question">
            Factores de vulnerabilidad (Grupo B1 del MISPAS)
          </h3>
          <p class="panel-explanation">
            Aun sin signos de alarma, estos grupos requieren evaluación médica presencial hoy mismo.
          </p>

          <div class="checklist-grid font-mono">
            <label class="check-item">
              <input type="checkbox" name="risk" value="age" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Lactante menor de 1 año o adulto de 65 años o más</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="pregnancy" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Embarazo confirmado o período de puerperio</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="chronic" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Enfermedad crónica: diabetes, hipertensión, falcemia, asma o ERC</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="drugs" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Uso habitual de anticoagulantes o antiagregantes plaquetarios</span>
              </div>
            </label>
          </div>

          <div class="panel-nav">
            <button type="button" id="btn-back-p2" class="btn-triage-back font-mono">
              &larr; Volver a signos de alarma
            </button>
            <button type="button" id="btn-eval" class="btn-dengue-primary font-mono">
              CALCULAR EVALUACIÓN DE TRIAJE
            </button>
          </div>
        </div>

        <!-- RESULTADOS CLÍNICOS -->
        <!-- 1. ALERTA ROJA (ALARMA HOSPITALARIA) -->
        <div id="triage-res-red" class="triage-result hidden">
          <div class="result-box result-red">
            <div class="result-header">
              <span class="result-badge-red font-mono">CÓDIGO ROJO · ATENCIÓN MÉDICA INMEDIATA</span>
              <h4 class="result-title">Signos de alarma detectados</h4>
              <p class="result-lead font-body">
                Criterios compatibles con <strong>dengue con signos de alarma</strong>. Requiere traslado urgente a emergencias para hidratación endovenosa y vigilancia de choque. <strong>No espere a mañana.</strong>
              </p>
            </div>

            <div class="emergency-cta-row">
              <a href="tel:911" class="btn-emergency-call">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>Llamar al Sistema 9-1-1</span>
              </a>
              <button type="button" class="btn-triage-reset font-mono">Reiniciar Evaluación</button>
            </div>

            <div class="contraindication-banner font-mono">
              <strong>ADVERTENCIA ESTRICTA MISPAS:</strong> PROHIBIDO administrar aspirina, ibuprofeno, metamizol (dipirona), AINE o inyecciones intramusculares por riesgo de hemorragia grave.
            </div>
          </div>
        </div>

        <!-- 2. ALERTA ÁMBAR (VALORACIÓN HOY) -->
        <div id="triage-res-amber" class="triage-result hidden">
          <div class="result-box result-amber">
            <div class="result-header">
              <span class="result-badge-amber font-mono">CÓDIGO ÁMBAR · VALORACIÓN MÉDICA HOY MISMO</span>
              <h4 class="result-title">Grupo vulnerable o ventana crítica (días 3 a 5)</h4>
              <p class="result-lead font-body">
                Criterio del <strong>Grupo B1 o ventana crítica (días 3 a 5)</strong>. Requiere valoración médica presencial hoy en un centro de salud para evaluación y hemograma.
              </p>
            </div>

            <div class="clinical-guidance-list font-mono">
              <div>• <strong>Hidratación inmediata:</strong> sales de rehidratación oral (SRO) o agua de coco en pequeños sorbos.</div>
              <div>• <strong>Mosquitero permanente:</strong> reposo bajo mosquitero para cortar la transmisión a convivientes.</div>
              <div>• <strong>Vigilancia extrema:</strong> ante vómitos persistentes o dolor abdominal, acuda al hospital de inmediato.</div>
              <div>• <strong>Antipiréticos:</strong> únicamente acetaminofén (paracetamol) en la dosis indicada por el médico.</div>
            </div>

            <div class="emergency-cta-row">
              <button type="button" class="btn-triage-reset font-mono">Evaluar a Otra Persona</button>
            </div>
          </div>
        </div>

        <!-- 3. CÓDIGO VERDE (MANEJO AMBULATORIO Y VIGILANCIA) -->
        <div id="triage-res-green" class="triage-result hidden">
          <div class="result-box result-green">
            <div class="result-header">
              <span class="result-badge-green font-mono">CÓDIGO VERDE · VIGILANCIA DOMICILIARIA ACTIVA</span>
              <h4 class="result-title">Sin signos de alarma identificados</h4>
              <p class="result-lead font-body">
                Sin signos de alarma ni factores de riesgo identificados. Reposo en el hogar, hidratación abundante, mosquitero permanente y vigilar con atención en el momento en que caiga la fiebre.
              </p>
            </div>

            <div class="clinical-guidance-list font-mono">
              <div>• <strong>Líquidos abundantes:</strong> agua, caldos, jugos naturales no ácidos y suero oral para mantener una hidratación adecuada.</div>
              <div>• <strong>Uso de mosquitero:</strong> durante todo el proceso febril para cortar la cadena de transmisión vectorial intradomiciliaria.</div>
              <div>• <strong>Atención a los días 3 a 5:</strong> el momento de mayor riesgo del dengue es cuando la fiebre desaparece. Si nota vómitos, mareo o dolor abdominal, acuda de inmediato a urgencias.</div>
            </div>

            <div class="emergency-cta-row">
              <button type="button" class="btn-triage-reset font-mono">Realizar Nueva Consulta</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .dengue-triage-section {
    padding: 5.5rem 0;
    background: #07090E;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-header {
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .section-lead {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .triage-wrapper {
    max-width: 880px;
    margin: 0 auto;
  }

  .triage-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .triage-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 2rem;
    color: var(--text-dim);
  }

  .panel-question {
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.25;
    margin-bottom: 0.65rem;
  }

  .panel-explanation {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .panel-explanation strong {
    color: var(--text-main);
  }

  /* Grid Paso 1: Opciones de Fiebre */
  .fever-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .fever-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 1.6rem 1.4rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .fever-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .fever-card.selected {
    border-color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
  }

  .fever-card.fever-critical {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.06);
  }

  .fever-card.fever-critical:hover {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.6);
  }

  .critical-pill {
    position: absolute;
    top: -10px;
    right: 14px;
    padding: 0.2rem 0.55rem;
    background: #EF4444;
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 700;
    border-radius: var(--radius-full);
  }

  .fever-stage {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .fever-days {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .fever-note {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Checklist Pasos 2 y 3 */
  .checklist-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.25rem;
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .check-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .check-item:has(.checkbox-input:checked) {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.45);
  }

  .checkbox-input {
    margin-top: 0.3rem;
    width: 18px;
    height: 18px;
    accent-color: #EF4444;
    cursor: pointer;
  }

  .check-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .check-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .check-desc {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Navegación entre Paneles */
  .panel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-triage-next, .btn-triage-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.92rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-next:hover, .btn-triage-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.4);
  }

  .btn-triage-back {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-muted);
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-back:hover {
    color: var(--text-main);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Estilos de las Cajas de Resultado */
  .triage-result {
    animation: fadeInResult 0.3s ease;
  }

  @keyframes fadeInResult {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-box {
    border-radius: var(--radius-md);
    padding: 2rem;
    margin-bottom: 1.5rem;
    border: 1px solid transparent;
  }

  .result-red {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.35);
  }

  .result-amber {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.35);
  }

  .result-green {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.35);
  }

  .result-badge-red {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #F87171;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .result-badge-amber {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #FCD34D;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .result-badge-green {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6EE7B7;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .result-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .result-lead {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .emergency-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .btn-emergency-call {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.85rem;
    border-radius: var(--radius-full);
    background: #EF4444;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.45);
    transition: all 0.2s ease;
  }

  .btn-emergency-call:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(239, 68, 68, 0.6);
  }

  .btn-triage-reset {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-reset:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .contraindication-banner {
    padding: 0.85rem 1rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-sm);
    color: #FCA5A5;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .clinical-guidance-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>

<script>
  // Lógica interactiva del triaje clínico MISPAS
  const p1 = document.getElementById('triage-p1');
  const p2 = document.getElementById('triage-p2');
  const p3 = document.getElementById('triage-p3');
  const resRed = document.getElementById('triage-res-red');
  const resAmber = document.getElementById('triage-res-amber');
  const resGreen = document.getElementById('triage-res-green');
  const stepLabel = document.getElementById('triage-step-label');

  let selectedFever = '';

  // Paso 1: Selección de fiebre
  const feverCards = document.querySelectorAll('.fever-card');
  feverCards.forEach(card => {
    card.addEventListener('click', () => {
      feverCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      selectedFever = card.getAttribute('data-fever') || '';

      setTimeout(() => {
        if (p1 && p2 && stepLabel) {
          p1.classList.add('hidden');
          p2.classList.remove('hidden');
          stepLabel.textContent = "PASO 2 DE 3: IDENTIFICACIÓN DE SIGNOS DE ALARMA";
        }
      }, 180);
    });
  });

  // Navegación P2 -> P1
  document.getElementById('btn-back-p1')?.addEventListener('click', () => {
    if (p1 && p2 && stepLabel) {
      p2.classList.add('hidden');
      p1.classList.remove('hidden');
      stepLabel.textContent = "PASO 1 DE 3: DURACIÓN DE LA FIEBRE";
    }
  });

  // Navegación P2 -> P3
  document.getElementById('btn-go-p3')?.addEventListener('click', () => {
    if (p2 && p3 && stepLabel) {
      p2.classList.add('hidden');
      p3.classList.remove('hidden');
      stepLabel.textContent = "PASO 3 DE 3: FACTORES DE VULNERABILIDAD Y RIESGO";
    }
  });

  // Navegación P3 -> P2
  document.getElementById('btn-back-p2')?.addEventListener('click', () => {
    if (p2 && p3 && stepLabel) {
      p3.classList.add('hidden');
      p2.classList.remove('hidden');
      stepLabel.textContent = "PASO 2 DE 3: IDENTIFICACIÓN DE SIGNOS DE ALARMA";
    }
  });

  // Evaluación final
  document.getElementById('btn-eval')?.addEventListener('click', () => {
    if (!p3 || !stepLabel) return;
    p3.classList.add('hidden');

    const alarms = Array.from(document.querySelectorAll('input[name="alarm"]:checked')).length;
    const risks = Array.from(document.querySelectorAll('input[name="risk"]:checked')).length;

    stepLabel.textContent = "EVALUACIÓN CLÍNICA FINALIZADA · MISPAS";

    if (alarms > 0) {
      resRed?.classList.remove('hidden');
    } else if (risks > 0 || selectedFever === '3-5') {
      resAmber?.classList.remove('hidden');
    } else {
      resGreen?.classList.remove('hidden');
    }
  });

  // Reiniciar
  document.querySelectorAll('.btn-triage-reset').forEach(btn => {
    btn.addEventListener('click', () => {
      resRed?.classList.add('hidden');
      resAmber?.classList.add('hidden');
      resGreen?.classList.add('hidden');
      if (p1 && stepLabel) {
        p1.classList.remove('hidden');
        stepLabel.textContent = "PASO 1 DE 3: DURACIÓN DE LA FIEBRE";
      }
      feverCards.forEach(c => c.classList.remove('selected'));
      document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        (cb as HTMLInputElement).checked = false;
      });
      selectedFever = '';
    });
  });
</script>
