---
// DengueTriage.astro - Módulo Interactivo de Triaje Clínico Comunitario (MISPAS)
---

<section class="dengue-triage-section" id="triaje">
  <div class="container">
    <div class="section-header text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-950/60 border border-red-500/30 rounded-full mb-3">
        <span class="w-2 h-2 rounded-full bg-alert-hemodynamic"></span>
        <span class="font-mono text-xs text-red-400 font-bold uppercase tracking-wider">PROTOCOLO DE BOLSILLO · MISPAS</span>
      </div>
      <h2 class="section-title">
        Triaje Comunitario de <span class="gradient-text-red">Signos de Alarma</span>
      </h2>
      <p class="section-lead">
        El dengue puede agravarse de forma súbita al descender la fiebre. Evalúa en 3 pasos los criterios clínicos del MISPAS para actuar a tiempo.
      </p>
    </div>

    <!-- Contenedor del Triaje Interactivo -->
    <div class="triage-wrapper">
      <div class="triage-card">
        <!-- Barra de Progreso y Ley 172-13 -->
        <div class="triage-status-bar font-mono text-xs">
          <span id="triage-step-label">PASO 1 DE 3: TEMPORALIDAD DE LA FIEBRE</span>
          <span class="text-cyan flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Zero-PHI (Ley 172-13 · 100% en tu dispositivo)
          </span>
        </div>

        <!-- PASO 1: DURACIÓN DE FIEBRE -->
        <div id="triage-p1" class="triage-panel">
          <h3 class="panel-question">
            ¿Cuántos días continuos de fiebre presenta la persona?
          </h3>
          <p class="panel-explanation">
            La fase crítica de escape de plasma ocurre con mayor frecuencia entre el <strong>3er y 5to día</strong>, al descender la temperatura.
          </p>

          <div class="fever-options-grid">
            <button type="button" class="fever-card" data-fever="1-2">
              <span class="fever-stage font-mono">FASE INICIAL</span>
              <span class="fever-days">1 a 2 Días</span>
              <span class="fever-note">Fiebre alta repentina, dolor de cabeza, dolor retroocular y malestar general.</span>
            </button>

            <button type="button" class="fever-card fever-critical" data-fever="3-5">
              <div class="critical-pill font-mono">MÁXIMA ATENCIÓN</div>
              <span class="fever-stage font-mono">FASE CRÍTICA</span>
              <span class="fever-days">3 a 5 Días</span>
              <span class="fever-note">La temperatura comienza a bajar, pero es el momento de mayor riesgo de extravasación de plasma.</span>
            </button>

            <button type="button" class="fever-card" data-fever="6+">
              <span class="fever-stage font-mono">FASE PROLONGADA</span>
              <span class="fever-days">6 Días o más</span>
              <span class="fever-note">Requiere consulta médica presencial para descartar coinfecciones o complicaciones hematológicas.</span>
            </button>
          </div>
        </div>

        <!-- PASO 2: SIGNOS DE ALARMA -->
        <div id="triage-p2" class="triage-panel hidden">
          <h3 class="panel-question text-red flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            ¿Presenta alguno de estos SIGNOS DE ALARMA?
          </h3>
          <p class="panel-explanation">
            Cualquiera de estos signos constituye una urgencia médica que exige atención hospitalaria inmediata.
          </p>

          <div class="checklist-grid font-mono">
            <label class="check-item">
              <input type="checkbox" name="alarm" value="abdominal" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Dolor abdominal intenso y continuo</span>
                <span class="check-desc font-body">Dolor fuerte y constante en el abdomen que no alivia con reposo.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="vomiting" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Vómitos persistentes o incoercibles</span>
                <span class="check-desc font-body">Tres o más vómitos en 1 hora, o cuatro o más episodios en 6 horas.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="bleeding" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Sangrado espontáneo de mucosas o moretones</span>
                <span class="check-desc font-body">Sangrado de encías, hemorragia nasal, sangrado vaginal anormal o manchas rojas en la piel.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="lethargy" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Letargo, somnolencia extrema o irritabilidad</span>
                <span class="check-desc font-body">Dificultad marcada para despertar al niño o adulto, confusión o mareo al ponerse de pie.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="fluid" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Dificultad respiratoria o hinchazón súbita</span>
                <span class="check-desc font-body">Respiración rápida, sensación de ahogo o abdomen distendido por acumulación de líquidos.</span>
              </div>
            </label>
          </div>

          <div class="panel-nav">
            <button type="button" id="btn-back-p1" class="btn-triage-back font-mono">
              &larr; Volver a días de fiebre
            </button>
            <button type="button" id="btn-go-p3" class="btn-triage-next font-mono">
              Continuar a Factores de Riesgo &rarr;
            </button>
          </div>
        </div>

        <!-- PASO 3: FACTORES DE RIESGO COEXISTENTES -->
        <div id="triage-p3" class="triage-panel hidden">
          <h3 class="panel-question flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            ¿Pertenece a un grupo vulnerable o tiene comorbilidades?
          </h3>
          <p class="panel-explanation">
            La presencia de factores de riesgo califica el caso como <strong>Grupo B1 (Manejo Ambulatorio Supervisado o Ingreso)</strong> según norma MISPAS.
          </p>

          <div class="checklist-grid font-mono">
            <label class="check-item">
              <input type="checkbox" name="risk" value="infant" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Lactante o menor de 2 años</span>
                <span class="check-desc font-body">Mayor susceptibilidad a deshidratación severa y choque hemodinámico.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="pregnancy" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Embarazo o posparto inmediato</span>
                <span class="check-desc font-body">Riesgo materno-fetal incrementado. Requiere monitorización obstétrica.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="elderly" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Adulto mayor de 65 años</span>
                <span class="check-desc font-body">Fragilidad hemodinámica y descompensación de patologías crónicas.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="chronic" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Condición crónica (Diabetes, HTA, Cardiopatía, Anemia Falciforme)</span>
                <span class="check-desc font-body">Alto riesgo de descompensación sistémica ante la infección por dengue.</span>
              </div>
            </label>
          </div>

          <div class="panel-nav">
            <button type="button" id="btn-back-p2" class="btn-triage-back font-mono">
              &larr; Volver a signos de alarma
            </button>
            <button type="button" id="btn-calculate" class="btn-triage-submit font-mono">
              Calcular Clasificación MISPAS &rarr;
            </button>
          </div>
        </div>

        <!-- RESULTADO: EVALUACIÓN SEGÚN PROTOCOLO MISPAS -->
        <div id="triage-result" class="triage-panel hidden">
          <div id="result-badge-container"></div>
          <h3 id="result-title" class="result-headline"></h3>
          <p id="result-desc" class="result-body"></p>

          <!-- Advertencia Estricta de Medicamentos Prohibidos -->
          <div class="med-warnings-box">
            <div class="med-warning-header font-mono">
              <span>⚠️ REGLAS FARMACOLÓGICAS ESTRICTAS (MISPAS)</span>
            </div>
            <div class="med-rules-grid">
              <div class="med-rule forbidden">
                <span class="rule-icon">🚫</span>
                <div>
                  <strong>PROHIBIDO: AINEs y Metamizol</strong>
                  <p>Ibuprofeno, Diclofenac, Aspirina, Naproxeno. Aumentan drásticamente el riesgo de hemorragia grave.</p>
                </div>
              </div>
              <div class="med-rule forbidden">
                <span class="rule-icon">🚫</span>
                <div>
                  <strong>PROHIBIDO: Inyecciones Intramusculares</strong>
                  <p>Riesgo de hematomas severos y abscesos por trombocitopenia (plaquetas bajas).</p>
                </div>
              </div>
              <div class="med-rule allowed">
                <span class="rule-icon">✅</span>
                <div>
                  <strong>ÚNICO ANTIPIRÉTICO INDICADO: Paracetamol (Acetaminofén)</strong>
                  <p>A dosis pediátricas o adultas exactas recomendadas por el médico. No exceder dosis máximas.</p>
                </div>
              </div>
              <div class="med-rule allowed">
                <span class="rule-icon">💧</span>
                <div>
                  <strong>HIDRATACIÓN ORAL ABUNDANTE: Suero Oral</strong>
                  <p>Sales de rehidratación oral (SRO), caldos y agua de coco. Evitar gaseosas y jugos ultraprocesados.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Botones de Acción para Centros de Salud de La Vega -->
          <div class="result-actions-row">
            <a href="tel:911" class="btn-call-emergency">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>Llamar al 9-1-1 (Emergencias RD)</span>
            </a>

            <button type="button" id="btn-restart-triage" class="btn-triage-restart font-mono">
              🔄 Reiniciar Evaluación
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dengue-triage-section {
    padding: 5.5rem 0;
    background: #0B0E17;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-header {
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .section-lead {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .triage-wrapper {
    max-width: 860px;
    margin: 0 auto;
  }

  .triage-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .triage-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 2rem;
    color: var(--text-dim);
  }

  .panel-question {
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.25;
    margin-bottom: 0.65rem;
  }

  .panel-explanation {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .panel-explanation strong {
    color: var(--text-main);
  }

  /* Grid Paso 1: Opciones de Fiebre */
  .fever-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .fever-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 1.6rem 1.4rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .fever-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .fever-card.selected {
    border-color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
  }

  .fever-card.fever-critical {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.06);
  }

  .fever-card.fever-critical:hover {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.6);
  }

  .critical-pill {
    position: absolute;
    top: -10px;
    right: 14px;
    padding: 0.2rem 0.55rem;
    background: #EF4444;
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 700;
    border-radius: var(--radius-full);
  }

  .fever-stage {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .fever-days {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .fever-note {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Checklist Pasos 2 y 3 */
  .checklist-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.25rem;
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .check-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .check-item:has(.checkbox-input:checked) {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.45);
  }

  .checkbox-input {
    margin-top: 0.3rem;
    width: 18px;
    height: 18px;
    accent-color: #EF4444;
    cursor: pointer;
  }

  .check-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .check-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .check-desc {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Navegación entre Paneles */
  .panel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-triage-next, .btn-triage-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.92rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-next:hover, .btn-triage-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.4);
  }

  .btn-triage-back {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-muted);
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-back:hover {
    color: var(--text-main);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Pantalla de Resultados */
  .result-headline {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }

  .result-body {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .med-warnings-box {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .med-warning-header {
    font-size: 0.78rem;
    color: #F87171;
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .med-rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .med-rule {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
  }

  .med-rule.forbidden {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .med-rule.allowed {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .med-rule strong {
    display: block;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .med-rule p {
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .result-actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .btn-call-emergency {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-full);
    background: #EF4444;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 4px 25px rgba(239, 68, 68, 0.45);
    transition: all 0.2s ease;
  }

  .btn-call-emergency:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 35px rgba(239, 68, 68, 0.6);
  }

  .btn-triage-restart {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-restart:hover {
    background: rgba(255, 255, 255, 0.12);
  }
</style>

<script>
  // Lógica de Triaje Clínico según Guía de Bolsillo MISPAS
  function initTriageEngine() {
    let selectedFever: string | null = null;
    let selectedAlarms: string[] = [];
    let selectedRisks: string[] = [];

    const p1 = document.getElementById('triage-p1');
    const p2 = document.getElementById('triage-p2');
    const p3 = document.getElementById('triage-p3');
    const pResult = document.getElementById('triage-result');
    const stepLabel = document.getElementById('triage-step-label');

    const feverCards = document.querySelectorAll('.fever-card');
    const btnBackP1 = document.getElementById('btn-back-p1');
    const btnGoP3 = document.getElementById('btn-go-p3');
    const btnBackP2 = document.getElementById('btn-back-p2');
    const btnCalculate = document.getElementById('btn-calculate');
    const btnRestart = document.getElementById('btn-restart-triage');

    // Paso 1: Selección de Días de Fiebre
    feverCards.forEach(card => {
      card.addEventListener('click', () => {
        feverCards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        selectedFever = card.getAttribute('data-fever');

        // Transición fluida a Paso 2
        setTimeout(() => {
          if (p1 && p2 && stepLabel) {
            p1.classList.add('hidden');
            p2.classList.remove('hidden');
            stepLabel.textContent = 'PASO 2 DE 3: RECONOCIMIENTO DE SIGNOS DE ALARMA';
          }
        }, 220);
      });
    });

    // Paso 2: Volver a Paso 1
    if (btnBackP1) {
      btnBackP1.addEventListener('click', () => {
        if (p1 && p2 && stepLabel) {
          p2.classList.add('hidden');
          p1.classList.remove('hidden');
          stepLabel.textContent = 'PASO 1 DE 3: TEMPORALIDAD DE LA FIEBRE';
        }
      });
    }

    // Paso 2: Continuar a Paso 3
    if (btnGoP3) {
      btnGoP3.addEventListener('click', () => {
        const checkedAlarms = document.querySelectorAll('input[name="alarm"]:checked');
        selectedAlarms = Array.from(checkedAlarms).map(input => (input as HTMLInputElement).value);

        if (p2 && p3 && stepLabel) {
          p2.classList.add('hidden');
          p3.classList.remove('hidden');
          stepLabel.textContent = 'PASO 3 DE 3: CONDICIONES COEXISTENTES Y VULNERABILIDAD';
        }
      });
    }

    // Paso 3: Volver a Paso 2
    if (btnBackP2) {
      btnBackP2.addEventListener('click', () => {
        if (p2 && p3 && stepLabel) {
          p3.classList.add('hidden');
          p2.classList.remove('hidden');
          stepLabel.textContent = 'PASO 2 DE 3: RECONOCIMIENTO DE SIGNOS DE ALARMA';
        }
      });
    }

    // Paso 3: Calcular Resultado Clínico MISPAS
    if (btnCalculate) {
      btnCalculate.addEventListener('click', () => {
        const checkedRisks = document.querySelectorAll('input[name="risk"]:checked');
        selectedRisks = Array.from(checkedRisks).map(input => (input as HTMLInputElement).value);

        evaluateTriage();
      });
    }

    function evaluateTriage() {
      if (p3 && pResult && stepLabel) {
        p3.classList.add('hidden');
        pResult.classList.remove('hidden');
        stepLabel.textContent = 'EVALUACIÓN CLÍNICA FINALIZADA · GUÍA DE BOLSILLO MISPAS';
      }

      const badgeContainer = document.getElementById('result-badge-container');
      const titleEl = document.getElementById('result-title');
      const descEl = document.getElementById('result-desc');

      const hasAlarmSigns = selectedAlarms.length > 0;
      const hasRisks = selectedRisks.length > 0;

      if (hasAlarmSigns) {
        // GRUPO B2 o C: ALARMA O CHOQUE (HOSPITALIZACIÓN URGENTE)
        if (badgeContainer) {
          badgeContainer.innerHTML = `
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-950/80 border border-red-500 rounded-full mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
              <span class="font-mono text-xs text-red-300 font-bold uppercase">GRUPO B2 / C · TRASLADO URGENTE</span>
            </div>
          `;
        }
        if (titleEl) {
          titleEl.textContent = 'Dengue con Signos de Alarma — Acuda de Inmediato a Urgencias';
          titleEl.style.color = '#EF4444';
        }
        if (descEl) {
          descEl.innerHTML = `
            Se han detectado <strong>${selectedAlarms.length} signo(s) de alarma</strong>. Indican escape de líquidos fuera de los vasos sanguíneos y riesgo inminente de choque. <strong>No espere la aparición de hemorragias externas</strong>. Traslade al paciente al Hospital Traumatológico y Quirúrgico Prof. Juan Bosch, Hospital Dr. Luis Morillo King o centro de segundo/tercer nivel más cercano.
          `;
        }
      } else if (hasRisks) {
        // GRUPO B1: CONDICIONES COEXISTENTES
        if (badgeContainer) {
          badgeContainer.innerHTML = `
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-950/80 border border-amber-500 rounded-full mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="font-mono text-xs text-amber-300 font-bold uppercase">GRUPO B1 · SUPERVISIÓN HOSPITALARIA / AMBULATORIA ESTRICTA</span>
            </div>
          `;
        }
        if (titleEl) {
          titleEl.textContent = 'Dengue sin Signos de Alarma con Factores de Riesgo';
          titleEl.style.color = '#F59E0B';
        }
        if (descEl) {
          descEl.innerHTML = `
            Aunque no hay signos de alarma en este momento, la presencia de <strong>factores de riesgo (lactante, embarazo, adulto mayor o comorbilidad)</strong> exige evaluación médica presencial en las próximas 24 horas y hemograma de control diario.
          `;
        }
      } else {
        // GRUPO A: MANEJO AMBULATORIO EN HOGAR
        if (badgeContainer) {
          badgeContainer.innerHTML = `
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-950/80 border border-emerald-500 rounded-full mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <span class="font-mono text-xs text-emerald-300 font-bold uppercase">GRUPO A · MANEJO EN EL HOGAR CON VIGILANCIA</span>
            </div>
          `;
        }
        if (titleEl) {
          titleEl.textContent = 'Dengue Probable sin Signos de Alarma';
          titleEl.style.color = '#10B981';
        }
        if (descEl) {
          descEl.innerHTML = `
            El paciente puede recibir soporte en casa con reposo estricto, <strong>hidratación oral abundante con suero oral (SRO)</strong> y paracetamol si hay dolor o fiebre. <strong>Atención crítica:</strong> Si entre el 3er y 5to día la fiebre baja pero surge vómito o dolor de barriga, acuda a urgencias de inmediato.
          `;
        }
      }
    }

    // Reiniciar Triaje
    if (btnRestart) {
      btnRestart.addEventListener('click', () => {
        selectedFever = null;
        selectedAlarms = [];
        selectedRisks = [];

        feverCards.forEach(c => c.classList.remove('selected'));
        document.querySelectorAll('input[type="checkbox"]').forEach(c => (c as HTMLInputElement).checked = false);

        if (pResult && p1 && stepLabel) {
          pResult.classList.add('hidden');
          p1.classList.remove('hidden');
          stepLabel.textContent = 'PASO 1 DE 3: TEMPORALIDAD DE LA FIEBRE';
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTriageEngine);
  } else {
    initTriageEngine();
  }
</script>
