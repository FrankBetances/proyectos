---
// DengueTriage.astro - Módulo Interactivo de Triaje Clínico Comunitario (MISPAS)
---

<section class="dengue-triage-section" id="triaje">
  <div class="container">
    <div class="section-header text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-950/60 border border-red-500/30 rounded-full mb-3">
        <span class="w-2 h-2 rounded-full bg-alert-hemodynamic"></span>
        <span class="font-mono text-xs text-red-400 font-bold uppercase tracking-wider">PROTOCOLO DE BOLSILLO · MISPAS</span>
      </div>
      <h2 class="section-title">
        Triaje Comunitario de <span class="gradient-text-red">Signos de Alarma</span>
      </h2>
      <p class="section-lead">
        El dengue puede evolucionar a choque de forma repentina cuando desciende la temperatura corporal. Evalúa en 3 pasos los criterios clínicos para actuar a tiempo y proteger la vida.
      </p>
    </div>

    <!-- Contenedor del Triaje Interactivo -->
    <div class="triage-wrapper">
      <div class="triage-card">
        <!-- Barra de Progreso y Ley 172-13 -->
        <div class="triage-status-bar font-mono text-xs">
          <span id="triage-step-label">PASO 1 DE 3: TEMPORALIDAD DE LA FIEBRE</span>
          <span class="text-cyan flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Zero-PHI (Ley 172-13 · 100% en tu dispositivo)
          </span>
        </div>

        <!-- PASO 1: DURACIÓN DE FIEBRE -->
        <div id="triage-p1" class="triage-panel">
          <h3 class="panel-question">
            ¿Cuántos días continuos de fiebre presenta la persona?
          </h3>
          <p class="panel-explanation">
            La fase crítica de escape de plasma y choque se concentra entre el <strong>3er y 5to día</strong>, frecuentemente cuando la fiebre empieza a ceder.
          </p>

          <div class="fever-options-grid">
            <button type="button" class="fever-card" data-fever="1-2">
              <span class="fever-stage font-mono">FASE INICIAL</span>
              <span class="fever-days">1 a 2 Días</span>
              <span class="fever-note">Fiebre alta repentina, dolor de cabeza, dolor retroocular y malestar general.</span>
            </button>

            <button type="button" class="fever-card fever-critical" data-fever="3-5">
              <div class="critical-pill font-mono">MÁXIMA ATENCIÓN</div>
              <span class="fever-stage font-mono">FASE CRÍTICA</span>
              <span class="fever-days">3 a 5 Días</span>
              <span class="fever-note">La temperatura comienza a bajar, pero es el momento de mayor riesgo de extravasación de plasma.</span>
            </button>

            <button type="button" class="fever-card" data-fever="6+">
              <span class="fever-stage font-mono">FASE PROLONGADA</span>
              <span class="fever-days">6 Días o más</span>
              <span class="fever-note">Requiere consulta médica presencial para descartar coinfecciones o complicaciones hematológicas.</span>
            </button>
          </div>
        </div>

        <!-- PASO 2: SIGNOS DE ALARMA -->
        <div id="triage-p2" class="triage-panel hidden">
          <h3 class="panel-question text-red flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Marca si presenta alguno de estos SIGNOS DE ALARMA CARDINALES:
          </h3>
          <p class="panel-explanation">
            Cualquiera de estos síntomas es una emergencia médica que indica posible fuga capilar y requiere atención en urgencias.
          </p>

          <div class="checklist-grid font-mono">
            <label class="check-item">
              <input type="checkbox" name="alarm" value="abdominal" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Dolor abdominal intenso y continuo</span>
                <span class="check-desc font-body">Dolor fuerte y constante en el abdomen que no alivia con reposo.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="vomiting" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Vómitos persistentes o incoercibles</span>
                <span class="check-desc font-body">Tres o más vómitos en 1 hora, o cuatro o más episodios en 6 horas.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="bleeding" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Sangrado espontáneo de mucosas o moretones</span>
                <span class="check-desc font-body">Sangrado de encías, hemorragia nasal, sangrado vaginal anormal o manchas rojas en la piel.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="lethargy" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Letargo, somnolencia extrema o irritabilidad</span>
                <span class="check-desc font-body">Dificultad marcada para despertar al niño o adulto, confusión o mareo al ponerse de pie.</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="alarm" value="fluid" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Dificultad respiratoria o hinchazón súbita</span>
                <span class="check-desc font-body">Respiración rápida, sensación de ahogo o abdomen distendido por acumulación de líquidos.</span>
              </div>
            </label>
          </div>

          <div class="panel-nav">
            <button type="button" id="btn-back-p1" class="btn-triage-back font-mono">
              &larr; Volver a días de fiebre
            </button>
            <button type="button" id="btn-go-p3" class="btn-triage-next font-mono">
              Continuar a Factores de Riesgo &rarr;
            </button>
          </div>
        </div>

        <!-- PASO 3: GRUPOS VULNERABLES -->
        <div id="triage-p3" class="triage-panel hidden">
          <h3 class="panel-question">
            Factores de Vulnerabilidad y Grupos Especiales (Grupo B1 MISPAS)
          </h3>
          <p class="panel-explanation">
            Aunque no presenten signos de alarma en este momento, las siguientes condiciones exigen valoración médica presencial el mismo día.
          </p>

          <div class="checklist-grid font-mono">
            <label class="check-item">
              <input type="checkbox" name="risk" value="age" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Lactante menor de 1 año o adulto de 65 años o más</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="pregnancy" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Embarazo confirmado o período de puerperio</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="chronic" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Enfermedad crónica: Diabetes, Hipertensión, Drepanocitosis (Falcemia), Asma o ERC</span>
              </div>
            </label>

            <label class="check-item">
              <input type="checkbox" name="risk" value="drugs" class="checkbox-input" />
              <div class="check-content">
                <span class="check-title">Uso regular de anticoagulantes o antiagregantes plaquetarios</span>
              </div>
            </label>
          </div>

          <div class="panel-nav">
            <button type="button" id="btn-back-p2" class="btn-triage-back font-mono">
              &larr; Volver a signos de alarma
            </button>
            <button type="button" id="btn-eval" class="btn-dengue-primary font-mono">
              CALCULAR DICTAMEN DE TRIAJE INMEDIATO
            </button>
          </div>
        </div>

        <!-- RESULTADOS CLÍNICOS -->
        <!-- 1. ALERTA ROJA (ALARMA HOSPITALARIA) -->
        <div id="triage-res-red" class="triage-result hidden">
          <div class="result-box result-red">
            <div class="result-header">
              <span class="result-badge-red font-mono">CÓDIGO ROJO · ATENCIÓN MÉDICA INMEDIATA</span>
              <h4 class="result-title">Signos de Alarma Detectados: Alto Riesgo de Choque</h4>
              <p class="result-lead font-body">
                El paciente presenta manifestaciones compatibles con <strong>Dengue con Signos de Alarma</strong>. Requiere ingreso hospitalario urgente para hidratación endovenosa y monitoreo continuo de hematocrito y plaquetas. <strong>No espere a mañana.</strong>
              </p>
            </div>

            <div class="emergency-cta-row">
              <a href="tel:911" class="btn-emergency-call">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>Llamar al Sistema 9-1-1</span>
              </a>
              <button type="button" class="btn-triage-reset font-mono">Reiniciar Evaluación</button>
            </div>

            <div class="contraindication-banner font-mono">
              <strong>ADVERTENCIA ESTRICTA DEL MISPAS:</strong> Queda terminantemente PROHIBIDO administrar Aspirina, Ibuprofeno, Metamizol (Dipirona) u otros AINEs, así como inyecciones intramusculares. Pueden precipitar hemorragias masivas fatales.
            </div>
          </div>
        </div>

        <!-- 2. ALERTA ÁMBAR (VALORACIÓN HOY) -->
        <div id="triage-res-amber" class="triage-result hidden">
          <div class="result-box result-amber">
            <div class="result-header">
              <span class="result-badge-amber font-mono">CÓDIGO ÁMBAR · VALORACIÓN MÉDICA HOY MISMO</span>
              <h4 class="result-title">Grupo Vulnerable o Ventana Crítica (Días 3–5)</h4>
              <p class="result-lead font-body">
                Aunque no se detecten signos de alarma cardinales en este instante, el paciente reúne criterios del <strong>Grupo B1</strong> o se encuentra en los días de mayor riesgo de complicaciones. Debe ser examinado hoy en un centro de salud.
              </p>
            </div>

            <div class="clinical-guidance-list font-mono">
              <div>• <strong>Hidratación Inmediata:</strong> Sales de Rehidratación Oral (SRO), sueros orales o agua de coco en pequeños sorbos frecuentes.</div>
              <div>• <strong>Mosquitero Permanente:</strong> Reposo bajo tela mosquitera para evitar que mosquitos le piquen y transmitan el virus a convivientes.</div>
              <div>• <strong>Vigilancia Extrema:</strong> Si aparecen vómitos, dolor de barriga o sangrado, acuda inmediatamente a emergencias sin esperar cita.</div>
              <div>• <strong>Antipiréticos:</strong> Únicamente Acetaminofén (Paracetamol) en la dosis indicada por el médico.</div>
            </div>

            <div class="emergency-cta-row">
              <button type="button" class="btn-triage-reset font-mono">Evaluar a Otra Persona</button>
            </div>
          </div>
        </div>

        <!-- 3. CÓDIGO VERDE (MANEJO AMBULATORIO Y VIGILANCIA) -->
        <div id="triage-res-green" class="triage-result hidden">
          <div class="result-box result-green">
            <div class="result-header">
              <span class="result-badge-green font-mono">CÓDIGO VERDE · VIGILANCIA DOMICILIARIA ACTIVA</span>
              <h4 class="result-title">Sin Signos de Alarma Identificados</h4>
              <p class="result-lead font-body">
                El paciente no presenta signos de alarma ni factores de riesgo identificados. Puede mantenerse en reposo en el hogar con vigilancia estrecha, prestando especial atención en el momento en que baje la fiebre.
              </p>
            </div>

            <div class="clinical-guidance-list font-mono">
              <div>• <strong>Líquidos Abundantes:</strong> Agua, caldos, jugos naturales no ácidos y suero oral para mantener una hidratación adecuada.</div>
              <div>• <strong>Uso de Mosquitero:</strong> Durante todo el proceso febril para cortar la cadena de transmisión vectorial intradomiciliaria.</div>
              <div>• <strong>Atención al Día 3 a 5:</strong> El momento más peligroso del dengue es cuando la fiebre desaparece. Si entonces nota debilidad extrema, vómitos o dolor de estómago, acuda de inmediato a urgencias.</div>
            </div>

            <div class="emergency-cta-row">
              <button type="button" class="btn-triage-reset font-mono">Realizar Nueva Consulta</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .dengue-triage-section {
    padding: 5.5rem 0;
    background: #07090E;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-header {
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .section-lead {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .triage-wrapper {
    max-width: 880px;
    margin: 0 auto;
  }

  .triage-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    backdrop-filter: blur(16px);
  }

  .triage-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  .panel-question {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .panel-explanation {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Grid Paso 1: Fiebre */
  .fever-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .fever-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
  }

  .fever-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 242, 254, 0.4);
    transform: translateY(-2px);
  }

  .fever-critical {
    border-color: rgba(245, 158, 11, 0.45);
    background: rgba(245, 158, 11, 0.04);
  }

  .fever-critical:hover {
    border-color: #F59E0B;
    background: rgba(245, 158, 11, 0.08);
  }

  .critical-pill {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full);
    background: #F59E0B;
    color: #040914;
    font-weight: 700;
  }

  .fever-stage {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .fever-days {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .fever-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Checklist Pasos 2 y 3 */
  .checklist-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .check-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(239, 68, 68, 0.35);
  }

  .checkbox-input {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.2rem;
    accent-color: #EF4444;
    flex-shrink: 0;
  }

  .check-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .check-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .check-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .panel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.5rem;
  }

  .btn-triage-back {
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-size: 0.82rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .btn-triage-back:hover {
    color: var(--text-main);
  }

  .btn-triage-next {
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-main);
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-next:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Resultados */
  .result-box {
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .result-red {
    background: rgba(239, 68, 68, 0.08);
    border: 2px solid #EF4444;
  }

  .result-amber {
    background: rgba(245, 158, 11, 0.08);
    border: 2px solid #F59E0B;
  }

  .result-green {
    background: rgba(16, 185, 129, 0.08);
    border: 2px solid #10B981;
  }

  .result-badge-red {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: #EF4444;
    color: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
  }

  .result-badge-amber {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: #F59E0B;
    color: #040914;
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
  }

  .result-badge-green {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: #10B981;
    color: #040914;
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
  }

  .result-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .result-lead {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .result-lead strong {
    color: var(--text-main);
  }

  .emergency-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn-emergency-call {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-full);
    background: #EF4444;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.4);
    transition: all 0.25s ease;
  }

  .btn-emergency-call:hover {
    background: #DC2626;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(239, 68, 68, 0.6);
  }

  .btn-triage-reset {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-triage-reset:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .contraindication-banner {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #FCA5A5;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .clinical-guidance-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    background: rgba(0, 0, 0, 0.4);
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .clinical-guidance-list strong {
    color: var(--text-main);
  }

  @media (max-width: 640px) {
    .triage-card {
      padding: 1.5rem;
    }

    .emergency-cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-emergency-call, .btn-triage-reset {
      justify-content: center;
    }
  }
</style>

<script>
  let selectedFeverDays: string | null = null;

  const stepLabel = document.getElementById('triage-step-label');
  const panelP1 = document.getElementById('triage-p1');
  const panelP2 = document.getElementById('triage-p2');
  const panelP3 = document.getElementById('triage-p3');

  const resRed = document.getElementById('triage-res-red');
  const resAmber = document.getElementById('triage-res-amber');
  const resGreen = document.getElementById('triage-res-green');

  // Selección de fiebre en Paso 1
  const feverCards = document.querySelectorAll('.fever-card');
  feverCards.forEach(card => {
    card.addEventListener('click', () => {
      selectedFeverDays = card.getAttribute('data-fever');
      panelP1?.classList.add('hidden');
      panelP2?.classList.remove('hidden');
      if (stepLabel) stepLabel.textContent = "PASO 2 DE 3: VERIFICACIÓN DE SIGNOS DE ALARMA CARDINALES";
    });
  });

  // Volver de 2 a 1
  document.getElementById('btn-back-p1')?.addEventListener('click', () => {
    panelP2?.classList.add('hidden');
    panelP1?.classList.remove('hidden');
    if (stepLabel) stepLabel.textContent = "PASO 1 DE 3: TEMPORALIDAD DE LA FIEBRE";
  });

  // Avanzar de 2 a 3
  document.getElementById('btn-go-p3')?.addEventListener('click', () => {
    panelP2?.classList.add('hidden');
    panelP3?.classList.remove('hidden');
    if (stepLabel) stepLabel.textContent = "PASO 3 DE 3: FACTORES DE VULNERABILIDAD Y RIESGO";
  });

  // Volver de 3 a 2
  document.getElementById('btn-back-p2')?.addEventListener('click', () => {
    panelP3?.classList.add('hidden');
    panelP2?.classList.remove('hidden');
    if (stepLabel) stepLabel.textContent = "PASO 2 DE 3: VERIFICACIÓN DE SIGNOS DE ALARMA CARDINALES";
  });

  // Calcular Dictamen Clínico
  document.getElementById('btn-eval')?.addEventListener('click', () => {
    const alarmChecks = document.querySelectorAll<HTMLInputElement>('input[name="alarm"]:checked');
    const riskChecks = document.querySelectorAll<HTMLInputElement>('input[name="risk"]:checked');

    const hasAlarms = alarmChecks.length > 0;
    const hasRisks = riskChecks.length > 0;
    const isCriticalTime = selectedFeverDays === '3-5' || selectedFeverDays === '6+';

    panelP3?.classList.add('hidden');
    if (stepLabel) stepLabel.textContent = "DICTAMEN CLÍNICO PROCESADO CON ÉXITO";

    if (hasAlarms) {
      resRed?.classList.remove('hidden');
    } else if (hasRisks || isCriticalTime) {
      resAmber?.classList.remove('hidden');
    } else {
      resGreen?.classList.remove('hidden');
    }
  });

  // Reiniciar Triaje
  function resetAllTriage() {
    selectedFeverDays = null;
    document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(c => c.checked = false);

    resRed?.classList.add('hidden');
    resAmber?.classList.add('hidden');
    resGreen?.classList.add('hidden');
    panelP2?.classList.add('hidden');
    panelP3?.classList.add('hidden');
    panelP1?.classList.remove('hidden');

    if (stepLabel) stepLabel.textContent = "PASO 1 DE 3: TEMPORALIDAD DE LA FIEBRE";
  }

  document.querySelectorAll('.btn-triage-reset').forEach(btn => {
    btn.addEventListener('click', resetAllTriage);
  });
</script>
