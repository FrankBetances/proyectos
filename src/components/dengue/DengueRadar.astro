  function setupRadar() {
    const tabs = document.querySelectorAll('.sector-tab');
    const polys = document.querySelectorAll('.sector-poly');

    const badgeEl = document.getElementById('selected-level-badge');
    const titleEl = document.getElementById('selected-sector-title');
    const coordsEl = document.getElementById('selected-coords');
    const n7El = document.getElementById('selected-n7-val');
    const criaderosEl = document.getElementById('selected-criaderos-val');
    const iconEl = document.getElementById('directive-icon-el');
    const dTitleEl = document.getElementById('directive-title-el');
    const dTextEl = document.getElementById('directive-text-el');
    const directiveBox = document.getElementById('selected-directive-box');

    function selectSector(sectorKey: string) {
      const data = SECTOR_DATA[sectorKey];
      if (!data) return;

      // Update Tabs
      tabs.forEach(tab => {
        if (tab.getAttribute('data-sector') === sectorKey) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      // Update Polygons
      polys.forEach(poly => {
        if (poly.getAttribute('data-sector') === sectorKey) {
          poly.classList.add('active');
        } else {
          poly.classList.remove('active');
        }
      });

      // Update Texts
      if (titleEl) titleEl.textContent = `Sector ${data.name}`;
      if (badgeEl) {
        badgeEl.textContent = data.badge;
        if (data.level === 'tension') badgeEl.style.color = '#F87171';
        else if (data.level === 'vigilancia') badgeEl.style.color = '#FCD34D';
        else badgeEl.style.color = '#6EE7B7';
      }
      if (coordsEl) coordsEl.textContent = data.coords;
      if (n7El) n7El.textContent = data.n7;
      if (criaderosEl) criaderosEl.textContent = String(data.criaderos);
      if (iconEl) iconEl.textContent = data.icon;
      if (dTitleEl) dTitleEl.textContent = data.title;
      if (dTextEl) dTextEl.textContent = data.desc;

      if (directiveBox) {
        if (data.level === 'tension') {
          directiveBox.style.borderColor = 'rgba(239, 68, 68, 0.4)';
          directiveBox.style.background = 'rgba(239, 68, 68, 0.1)';
        } else if (data.level === 'vigilancia') {
          directiveBox.style.borderColor = 'rgba(245, 158, 11, 0.4)';
          directiveBox.style.background = 'rgba(245, 158, 11, 0.08)';
        } else {
          directiveBox.style.borderColor = 'rgba(16, 185, 129, 0.4)';
          directiveBox.style.background = 'rgba(16, 185, 129, 0.08)';
        }
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const sec = tab.getAttribute('data-sector');
        if (sec) selectSector(sec);
      });
    });

    polys.forEach(poly => {
      poly.addEventListener('click', () => {
        const sec = poly.getAttribute('data-sector');
        if (sec) selectSector(sec);
      });
    });

    // Geolocalización local en cliente (Zero-PHI)
    const btnDetect = document.getElementById('btn-detect-local');
    const geoMsg = document.getElementById('local-geo-msg');

    if (btnDetect && navigator.geolocation) {
      btnDetect.addEventListener('click', () => {
        if (geoMsg) {
          geoMsg.classList.remove('hidden');
          geoMsg.textContent = 'Detectando centroide localmente...';
        }

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const userLat = pos.coords.latitude;
            const userLon = pos.coords.longitude;

            // Encontrar sector más cercano
            let closestSector = 'ARENOSO';
            let minDist = Infinity;

            const CENTROIDS: Record<string, [number, number]> = {
              ARENOSO: [19.242, -70.528],
              DON_BOSCO: [19.215, -70.526],
              EL_HATICO: [19.227, -70.548],
              JUAN_PABLO_DUARTE: [19.212, -70.545],
              LA_LAGUNA: [19.243, -70.552],
              LA_SABANA: [19.211, -70.512],
              LAS_MARAS: [19.238, -70.505],
              PALMARITO: [19.231, -70.518],
              VILLA_ROSA: [19.204, -70.531],
            };

            for (const [key, coords] of Object.entries(CENTROIDS)) {
              const dLat = userLat - coords[0];
              const dLon = userLon - coords[1];
              const d = Math.sqrt(dLat * dLat + dLon * dLon);
              if (d < minDist) {
                minDist = d;
                closestSector = key;
              }
            }

            selectSector(closestSector);
            if (geoMsg) {
              geoMsg.textContent = `Asignado localmente a Sector ${SECTOR_DATA[closestSector].name} (Zero-PHI: GPS no transmitido).`;
            }
          },
          (err) => {
            if (geoMsg) {
              geoMsg.textContent = 'Permiso no otorgado. Selecciona un sector en la lista.';
            }
          },
          { enableHighAccuracy: false, timeout: 5000 }
        );
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRadar);
  } else {
    setupRadar();
  }
</script>
