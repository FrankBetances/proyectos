---
// DengueRadar.astro - Radar Geoespacial Interactivo del Piloto La Vega
---

<section class="dengue-radar-section" id="radar">
  <div class="container">
    <div class="section-header text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-950/60 border border-red-500/30 rounded-full mb-3">
        <span class="w-2 h-2 rounded-full bg-alert-hemodynamic animate-ping"></span>
        <span class="font-mono text-xs text-red-400 font-bold uppercase tracking-wider">GEO-TELEMETRÍA EN TIEMPO REAL</span>
      </div>
      <h2 class="section-title">
        Radar de Sectores <span class="gradient-text-red">La Vega</span>
      </h2>
      <p class="section-lead">
        Monitoreo en 9 sectores territoriales con polígonos Voronoi. Detección automática de zonas en tensión epidemiológica y criaderos activos.
      </p>
    </div>

    <!-- Panel Interactivo de Control Geoespacial -->
    <div class="radar-console">
      <!-- Selector de Sectores (Columna Izquierda) -->
      <div class="sectors-sidebar">
        <div class="sidebar-top">
          <span class="font-mono text-xs text-text-dim">SECTORES ACTIVOS (9)</span>
          <button id="btn-detect-local" class="btn-geo-detect" title="Detectar sector localmente sin enviar coordenadas">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Mi Zona (Local)</span>
          </button>
        </div>

        <div id="local-geo-msg" class="local-msg-box hidden font-mono text-xs"></div>

        <div class="sectors-list" role="tablist">
          <!-- Sector 1: Arenoso -->
          <button class="sector-tab active" data-sector="ARENOSO" data-name="Arenoso" data-level="tension" data-n7="14" data-criaderos="9" data-lat="19.242" data-lon="-70.528" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">Arenoso</span>
              <span class="pill-status pill-tension">Tensión</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: 14 reportes</span>
              <span>•</span>
              <span>Criaderos: 9</span>
            </div>
          </button>

          <!-- Sector 2: Don Bosco -->
          <button class="sector-tab" data-sector="DON_BOSCO" data-name="Don Bosco" data-level="vigilancia" data-n7="8" data-criaderos="5" data-lat="19.215" data-lon="-70.526" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">Don Bosco</span>
              <span class="pill-status pill-vigilancia">Vigilancia</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: 8 reportes</span>
              <span>•</span>
              <span>Criaderos: 5</span>
            </div>
          </button>

          <!-- Sector 3: El Hatico -->
          <button class="sector-tab" data-sector="EL_HATICO" data-name="El Hatico" data-level="tension" data-n7="11" data-criaderos="7" data-lat="19.227" data-lon="-70.548" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">El Hatico</span>
              <span class="pill-status pill-tension">Tensión</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: 11 reportes</span>
              <span>•</span>
              <span>Criaderos: 7</span>
            </div>
          </button>

          <!-- Sector 4: Juan Pablo Duarte -->
          <button class="sector-tab" data-sector="JUAN_PABLO_DUARTE" data-name="Juan Pablo Duarte" data-level="vigilancia" data-n7="7" data-criaderos="4" data-lat="19.212" data-lon="-70.545" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">Juan Pablo Duarte</span>
              <span class="pill-status pill-vigilancia">Vigilancia</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: 7 reportes</span>
              <span>•</span>
              <span>Criaderos: 4</span>
            </div>
          </button>

          <!-- Sector 5: La Laguna -->
          <button class="sector-tab" data-sector="LA_LAGUNA" data-name="La Laguna" data-level="normal" data-n7="< 5" data-criaderos="3" data-lat="19.243" data-lon="-70.552" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">La Laguna</span>
              <span class="pill-status pill-normal">Normal</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: &lt; 5 (Supresión)</span>
              <span>•</span>
              <span>Criaderos: 3</span>
            </div>
          </button>

          <!-- Sector 6: La Sabana -->
          <button class="sector-tab" data-sector="LA_SABANA" data-name="La Sabana" data-level="normal" data-n7="< 5" data-criaderos="2" data-lat="19.211" data-lon="-70.512" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">La Sabana</span>
              <span class="pill-status pill-normal">Normal</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: &lt; 5 (Supresión)</span>
              <span>•</span>
              <span>Criaderos: 2</span>
            </div>
          </button>

          <!-- Sector 7: Las Maras -->
          <button class="sector-tab" data-sector="LAS_MARAS" data-name="Las Maras" data-level="vigilancia" data-n7="6" data-criaderos="5" data-lat="19.238" data-lon="-70.505" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">Las Maras</span>
              <span class="pill-status pill-vigilancia">Vigilancia</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: 6 reportes</span>
              <span>•</span>
              <span>Criaderos: 5</span>
            </div>
          </button>

          <!-- Sector 8: Palmarito -->
          <button class="sector-tab" data-sector="PALMARITO" data-name="Palmarito" data-level="tension" data-n7="13" data-criaderos="8" data-lat="19.231" data-lon="-70.518" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">Palmarito</span>
              <span class="pill-status pill-tension">Tensión</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: 13 reportes</span>
              <span>•</span>
              <span>Criaderos: 8</span>
            </div>
          </button>

          <!-- Sector 9: Villa Rosa -->
          <button class="sector-tab" data-sector="VILLA_ROSA" data-name="Villa Rosa" data-level="normal" data-n7="< 5" data-criaderos="1" data-lat="19.204" data-lon="-70.531" role="tab">
            <div class="sector-tab-main">
              <span class="sector-name">Villa Rosa</span>
              <span class="pill-status pill-normal">Normal</span>
            </div>
            <div class="sector-tab-meta font-mono">
              <span>N7: &lt; 5 (Supresión)</span>
              <span>•</span>
              <span>Criaderos: 1</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Visor de Telemetría y Mapa Vectorial (Columna Central & Derecha) -->
      <div class="radar-display">
        <!-- Barra de Estado del Sector Seleccionado -->
        <div class="display-header">
          <div class="display-title-group">
            <span class="display-badge font-mono" id="selected-level-badge">ZONA EN TENSIÓN EPIDEMIOLÓGICA</span>
            <h3 class="display-sector-name" id="selected-sector-title">Sector Arenoso</h3>
            <p class="display-coords font-mono" id="selected-coords">Centroide: 19.2420° N, -70.5280° W</p>
          </div>

          <div class="display-stats-row font-mono">
            <div class="stat-box">
              <span class="stat-label">CASOS N7</span>
              <span class="stat-value text-red" id="selected-n7-val">14</span>
            </div>
            <div class="stat-box">
              <span class="stat-label">CRIADEROS</span>
              <span class="stat-value text-amber" id="selected-criaderos-val">9</span>
            </div>
            <div class="stat-box">
              <span class="stat-label">PLUVIOMETRÍA</span>
              <span class="stat-value text-cyan">42 mm/sem</span>
            </div>
          </div>
        </div>

        <!-- Canvas SVG Mapa Interactivo de Sectores Voronoi -->
        <div class="radar-canvas-box">
          <svg id="voronoi-svg" viewBox="0 0 600 450" class="w-full h-full">
            <defs>
              <pattern id="radar-grid-pattern" width="30" height="30" patternUnits="userSpaceOnUse">
                <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>
              </pattern>
              <radialGradient id="sweep-gradient" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="rgba(239, 68, 68, 0.25)"/>
                <stop offset="100%" stop-color="rgba(239, 68, 68, 0)"/>
              </radialGradient>
            </defs>

            <!-- Fondo Cuadrícula -->
            <rect width="600" height="450" fill="#090D16" />
            <rect width="600" height="450" fill="url(#radar-grid-pattern)" />

            <!-- Anillos de Rango Radar -->
            <circle cx="300" cy="225" r="80" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="3 3"/>
            <circle cx="300" cy="225" r="160" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="3 3"/>
            <circle cx="300" cy="225" r="240" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>

            <!-- Polígonos Voronoi (Sectores de La Vega) -->
            <!-- 1. Arenoso (Norte-Centro) -->
            <polygon id="poly-ARENOSO" class="sector-poly active poly-tension" points="260,30 400,50 440,160 310,170 240,110" data-sector="ARENOSO"/>
            <!-- 2. Don Bosco (Centro-Sur) -->
            <polygon id="poly-DON_BOSCO" class="sector-poly poly-vigilancia" points="310,250 430,240 450,340 330,370 290,290" data-sector="DON_BOSCO"/>
            <!-- 3. El Hatico (Oeste) -->
            <polygon id="poly-EL_HATICO" class="sector-poly poly-tension" points="100,120 240,110 270,220 180,290 80,220" data-sector="EL_HATICO"/>
            <!-- 4. Juan Pablo Duarte (Suroeste) -->
            <polygon id="poly-JUAN_PABLO_DUARTE" class="sector-poly poly-vigilancia" points="180,290 290,290 270,390 150,420 130,330" data-sector="JUAN_PABLO_DUARTE"/>
            <!-- 5. La Laguna (Noroeste) -->
            <polygon id="poly-LA_LAGUNA" class="sector-poly poly-normal" points="60,30 260,30 240,110 100,120" data-sector="LA_LAGUNA"/>
            <!-- 6. La Sabana (Sureste) -->
            <polygon id="poly-LA_SABANA" class="sector-poly poly-normal" points="430,240 560,250 540,390 450,340" data-sector="LA_SABANA"/>
            <!-- 7. Las Maras (Noreste) -->
            <polygon id="poly-LAS_MARAS" class="sector-poly poly-vigilancia" points="400,50 550,60 560,250 440,160" data-sector="LAS_MARAS"/>
            <!-- 8. Palmarito (Centro-Este) -->
            <polygon id="poly-PALMARITO" class="sector-poly poly-tension" points="310,170 440,160 430,240 310,250 270,220" data-sector="PALMARITO"/>
            <!-- 9. Villa Rosa (Sur) -->
            <polygon id="poly-VILLA_ROSA" class="sector-poly poly-normal" points="270,390 330,370 450,340 410,430 250,430" data-sector="VILLA_ROSA"/>

            <!-- Rótulos de Nombres en SVG -->
            <text x="330" y="110" class="svg-sector-label">Arenoso</text>
            <text x="360" y="310" class="svg-sector-label">Don Bosco</text>
            <text x="170" y="200" class="svg-sector-label">El Hatico</text>
            <text x="210" y="350" class="svg-sector-label">J. P. Duarte</text>
            <text x="140" y="70" class="svg-sector-label">La Laguna</text>
            <text x="490" y="320" class="svg-sector-label">La Sabana</text>
            <text x="470" y="120" class="svg-sector-label">Las Maras</text>
            <text x="350" y="210" class="svg-sector-label">Palmarito</text>
            <text x="340" y="410" class="svg-sector-label">Villa Rosa</text>

            <!-- Puntos de Hotspots de Criaderos -->
            <g id="criaderos-hotspots">
              <circle cx="330" cy="130" r="4" class="svg-hotspot-criadero" />
              <circle cx="355" cy="95" r="3" class="svg-hotspot-criadero" />
              <circle cx="290" cy="140" r="4" class="svg-hotspot-criadero" />
              <circle cx="370" cy="190" r="4" class="svg-hotspot-criadero" />
              <circle cx="330" cy="230" r="3.5" class="svg-hotspot-criadero" />
              <circle cx="160" cy="180" r="4" class="svg-hotspot-criadero" />
              <circle cx="210" cy="230" r="3" class="svg-hotspot-criadero" />
            </g>
          </svg>
        </div>

        <!-- Barra de Acción Directa e Instrucciones Clínicas del Sector -->
        <div class="display-directive" id="selected-directive-box">
          <div class="directive-icon" id="directive-icon-el">⚠️</div>
          <div class="directive-content">
            <h4 class="directive-title" id="directive-title-el">Directiva Operativa: Sector Arenoso</h4>
            <p class="directive-text" id="directive-text-el">
              Alta tensión febril comunitaria combinada con densidad de criaderos. Prioridad máxima de descacharrización y vigilancia domiciliaria.
            </p>
          </div>
          <a href="https://t.me/AlertaDengueRDbot" target="_blank" rel="noopener noreferrer" class="btn-sector-report">
            Reportar en este Sector
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dengue-radar-section {
    padding: 5.5rem 0;
    background: #07090E;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-header {
    max-width: 780px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .section-lead {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .radar-console {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 1.75rem;
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  /* Sidebar */
  .sectors-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-geo-detect {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-family: var(--font-heading);
    padding: 0.25rem 0.65rem;
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    color: var(--accent-cyan);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-geo-detect:hover {
    background: rgba(0, 242, 254, 0.2);
  }

  .local-msg-box {
    padding: 0.5rem 0.75rem;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: var(--radius-sm);
    color: var(--accent-cyan);
    line-height: 1.4;
  }

  .sectors-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 480px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .sectors-list::-webkit-scrollbar {
    width: 4px;
  }
  .sectors-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .sector-tab {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: left;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sector-tab:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .sector-tab.active {
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.4);
    box-shadow: 0 0 15px rgba(239, 68, 68, 0.1);
  }

  .sector-tab-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sector-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .pill-status {
    font-size: 0.68rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pill-tension {
    background: rgba(239, 68, 68, 0.2);
    color: #F87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .pill-vigilancia {
    background: rgba(245, 158, 11, 0.2);
    color: #FCD34D;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .pill-normal {
    background: rgba(16, 185, 129, 0.15);
    color: #6EE7B7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .sector-tab-meta {
    font-size: 0.74rem;
    color: var(--text-dim);
    display: flex;
    gap: 0.5rem;
  }

  /* Radar Display */
  .radar-display {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .display-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .display-badge {
    font-size: 0.72rem;
    color: #F87171;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.35rem;
    display: block;
  }

  .display-sector-name {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
  }

  .display-coords {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-top: 0.25rem;
  }

  .display-stats-row {
    display: flex;
    gap: 1.5rem;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
  }

  .stat-label {
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .stat-value {
    font-size: 1.4rem;
    font-weight: 800;
  }

  /* Radar Canvas Box */
  .radar-canvas-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 380px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sector-poly {
    cursor: pointer;
    stroke-width: 1.5;
    transition: all 0.25s ease;
  }

  .poly-tension {
    fill: rgba(239, 68, 68, 0.18);
    stroke: rgba(239, 68, 68, 0.6);
  }

  .poly-vigilancia {
    fill: rgba(245, 158, 11, 0.14);
    stroke: rgba(245, 158, 11, 0.5);
  }

  .poly-normal {
    fill: rgba(16, 185, 129, 0.08);
    stroke: rgba(16, 185, 129, 0.4);
  }

  .sector-poly:hover {
    fill-opacity: 0.45;
    stroke-width: 2.5;
  }

  .sector-poly.active {
    fill-opacity: 0.6;
    stroke: #FFFFFF;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.5));
  }

  .svg-sector-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    fill: rgba(255, 255, 255, 0.7);
    pointer-events: none;
    text-anchor: middle;
  }

  .svg-hotspot-criadero {
    fill: #F59E0B;
    stroke: #FFFFFF;
    stroke-width: 1;
    animation: hotspotPulse 2s infinite;
  }

  @keyframes hotspotPulse {
    0%, 100% { r: 3.5; opacity: 1; }
    50% { r: 5; opacity: 0.6; }
  }

  /* Directives Box */
  .display-directive {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: var(--radius-md);
  }

  .directive-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .directive-content {
    flex-grow: 1;
  }

  .directive-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .directive-text {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .btn-sector-report {
    flex-shrink: 0;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-full);
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-sector-report:hover {
    background: #EF4444;
  }

  @media (max-width: 900px) {
    .radar-console {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Script Interactivo del Radar de Sectores Voronoi
  const SECTOR_DATA: Record<string, {
    name: string;
    level: 'tension' | 'vigilancia' | 'normal';
    badge: string;
    n7: string;
    criaderos: number;
    coords: string;
    icon: string;
    title: string;
    desc: string;
  }> = {
    ARENOSO: {
      name: "Arenoso",
      level: "tension",
      badge: "ZONA EN TENSIÓN EPIDEMIOLÓGICA",
      n7: "14",
      criaderos: 9,
      coords: "Centroide: 19.2420° N, -70.5280° W",
      icon: "🚨",
