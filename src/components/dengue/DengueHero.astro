---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="dengue-hero-section">
  <!-- Interactive Vector Canvas for Aedes aegypti swarm dynamics with touch/pointer repulsion -->
  <div class="canvas-wrapper" aria-hidden="true">
    <canvas id="aedes-canvas"></canvas>
    <div class="canvas-vignette"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="container relative z-10">
    <!-- Eyebrow & Badges -->
    <div class="hero-top-bar">
      <div class="status-indicator">
        <span class="pulse-dot"></span>
        <span class="status-text">VIGILANCIA PARTICIPATIVA ACTIVA · REPÚBLICA DOMINICANA</span>
      </div>
      <div class="hud-coords font-mono">
        <span class="badge-pilot">PILOTO: LA VEGA</span>
        <span class="divider">|</span>
        <span class="geo-coord">LAT: 19.2220° N · LONG: 70.5296° O</span>
      </div>
    </div>

    <!-- Main Title & Narrative -->
    <div class="hero-content">
      <div class="badges-row" role="list">
        <span class="badge-pill pill-red">🦟 Vector <em>Aedes aegypti</em></span>
        <span class="badge-pill pill-amber">🇩🇴 Piloto La Vega (9 sectores)</span>
        <span class="badge-pill pill-cyan">🔬 Protocolo oficial del MISPAS</span>
        <span class="badge-pill pill-purple">🤖 Bot de Telegram</span>
        <span class="badge-pill pill-emerald">🔒 Ley 172-13 (Datos protegidos)</span>
      </div>

      <h1 class="hero-title">
        Alerta Dengue <span class="gradient-text-red">RD</span>
      </h1>

      <p class="hero-subtitle">
        Vigilancia comunitaria del vector <em>Aedes aegypti</em>, detección temprana de zonas en tensión febril y triaje clínico según el protocolo oficial del <strong>MISPAS</strong>. Piloto La Vega coordinado por el <strong>Dr. Frank Betances</strong> y estudiantes de Medicina de <strong>UCATECI</strong>.
      </p>

      <!-- Action CTAs -->
      <div class="hero-actions">
        <a href="#triaje" class="btn-dengue-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>Iniciar triaje de signos de alarma</span>
        </a>

        <a href="#radar" class="btn-dengue-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m4.93 4.93 4.24 4.24"></path>
            <path d="m14.83 9.17 4.24-4.24"></path>
            <path d="m14.83 14.83 4.24 4.24"></path>
            <path d="m9.17 14.83-4.24 4.24"></path>
          </svg>
          <span>Radar de sectores</span>
        </a>

        <a href="https://t.me/AlertaDengueRDbot" target="_blank" rel="noopener noreferrer" class="btn-dengue-telegram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .37z"/>
          </svg>
          <span>Bot de Telegram</span>
        </a>
      </div>
    </div>

    <!-- Live Telemetry HUD Metrics (Optimized Cockpit Grid) -->
    <div class="telemetry-hud" id="hero-hud">
      <div class="telemetry-card">
        <span class="hud-label font-mono">SECTORES EN VIGILANCIA</span>
        <div class="hud-value">
          <span class="val-num counter-target" data-target="9">9</span>
          <span class="val-sub">Sectores de La Vega</span>
        </div>
        <p class="hud-desc">Monitorización activa y detección temprana de brotes por sector.</p>
      </div>

      <div class="telemetry-card">
        <span class="hud-label font-mono">PROTECCIÓN DE DATOS</span>
        <div class="hud-value text-cyan">
          <span class="val-num counter-target" data-target="100" data-suffix=" %">100 %</span>
          <span class="val-sub">Ley núm. 172-13</span>
        </div>
        <p class="hud-desc">Sin registro de nombres ni datos personales. Totalmente confidencial.</p>
      </div>

      <div class="telemetry-card">
        <span class="hud-label font-mono">VENTANA CRÍTICA DE ALERTA</span>
        <div class="hud-value text-red">
          <span class="val-num">Días 3 a 5</span>
          <span class="val-sub">Descenso febril</span>
        </div>
        <p class="hud-desc">Mayor riesgo de choque y extravasación cuando desaparece la fiebre.</p>
      </div>

      <div class="telemetry-card">
        <span class="hud-label font-mono">VALIDACIÓN COMUNITARIA</span>
        <div class="hud-value text-amber">
          <span class="val-num counter-target" data-target="30" data-suffix=" m">30 m</span>
          <span class="val-sub">Radio de proximidad</span>
        </div>
        <p class="hud-desc">Eliminación automática de reportes duplicados y confirmación vecinal.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .dengue-hero-section {
    position: relative;
    padding: clamp(5.5rem, 9vw, 8rem) 0 clamp(3.5rem, 6vw, 5rem);
    overflow: hidden;
    background: radial-gradient(circle at 50% 18%, rgba(239, 68, 68, 0.09) 0%, rgba(7, 9, 14, 0.98) 72%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .canvas-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  #aedes-canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.72;
    touch-action: none;
  }

  .canvas-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 35%, rgba(7, 9, 14, 0.9) 92%);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-size: 36px 36px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  }

  .hero-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 2rem;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: var(--radius-full);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #EF4444;
    box-shadow: 0 0 10px #EF4444;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .status-text {
    font-family: var(--font-heading);
    font-size: clamp(0.72rem, 1.4vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #F87171;
  }

  .hud-coords {
    font-size: clamp(0.72rem, 1.3vw, 0.8rem);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .divider {
    color: rgba(255, 255, 255, 0.2);
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .badge-pill {
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: clamp(0.75rem, 1.3vw, 0.82rem);
    font-weight: 600;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.2s ease;
  }

  .badge-pill:hover {
    transform: translateY(-1px);
  }

  .pill-red {
    background: rgba(239, 68, 68, 0.15);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }

  .pill-amber {
    background: rgba(245, 158, 11, 0.15);
    color: #FCD34D;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.15);
    color: #D8B4FE;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.15);
    color: #6EE7B7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 5.4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .hero-subtitle strong {
    color: var(--text-main);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .btn-dengue-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.85rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.35);
    touch-action: manipulation;
  }

  .btn-dengue-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(239, 68, 68, 0.5);
  }

  .btn-dengue-primary:active {
    transform: scale(0.97);
  }

  .btn-dengue-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: all 0.2s ease;
    touch-action: manipulation;
  }

  .btn-dengue-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .btn-dengue-secondary:active {
    transform: scale(0.97);
  }

  .btn-dengue-telegram {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-full);
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: all 0.2s ease;
    touch-action: manipulation;
  }

  .btn-dengue-telegram:hover {
    background: rgba(0, 242, 254, 0.18);
    border-color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  .btn-dengue-telegram:active {
    transform: scale(0.97);
  }

  /* Telemetry HUD Cockpit Grid */
  .telemetry-hud {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .telemetry-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.35rem 1.5rem;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: all 0.25s ease;
  }

  .telemetry-card:hover {
    border-color: rgba(239, 68, 68, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .hud-label {
    font-size: 0.73rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .hud-value {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    flex-wrap: wrap;
  }

  .val-num {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.8vw, 1.95rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.05;
  }

  .val-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .text-cyan .val-num { color: var(--accent-cyan); }
  .text-red .val-num { color: #EF4444; }
  .text-amber .val-num { color: #F59E0B; }

  .hud-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  @media (max-width: 768px) {
    .hero-top-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
      margin-bottom: 1.5rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
    }

    .btn-dengue-primary, .btn-dengue-secondary, .btn-dengue-telegram {
      justify-content: center;
      padding: 0.9rem 1.25rem;
    }

    /* 2x2 cockpit grid on mobile for compact telemetry presentation */
    .telemetry-hud {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }

    .telemetry-card {
      padding: 1rem 0.95rem;
    }

    .val-num {
      font-size: 1.45rem;
    }

    .hud-desc {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 440px) {
    .telemetry-hud {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Canvas Vector Particle Simulation (Aedes aegypti) with Elastic Repulsion Field
  function initAedesCanvas() {
    const canvas = document.getElementById('aedes-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = canvas.parentElement?.clientWidth || window.innerWidth);
    let height = (canvas.height = canvas.parentElement?.clientHeight || 600);

    const isMobile = window.innerWidth <= 768;
    const COUNT = isMobile ? 22 : Math.min(48, Math.floor(width / 24));

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      baseVx: number;
      baseVy: number;
      size: number;
      alpha: number;
      pulse: number;
      wobble: number;
    }

    const particles: Particle[] = [];

    for (let i = 0; i < COUNT; i++) {
      const vx = (Math.random() - 0.5) * 1.1;
      const vy = (Math.random() - 0.5) * 1.1;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx,
        vy,
        baseVx: vx,
        baseVy: vy,
        size: Math.random() * 2 + 1,
        alpha: Math.random() * 0.5 + 0.3,
        pulse: Math.random() * 0.05 + 0.01,
        wobble: Math.random() * Math.PI * 2
      });
    }

    // Pointer & Touch Repulsion Coordinator
    let pointerX: number | null = null;
    let pointerY: number | null = null;

    const handlePointerMove = (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointerX = e.clientX - rect.left;
      pointerY = e.clientY - rect.top;
    };

    const handlePointerLeave = () => {
      pointerX = null;
      pointerY = null;
    };

    const handleTouchMove = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const rect = canvas.getBoundingClientRect();
        pointerX = e.touches[0].clientX - rect.left;
        pointerY = e.touches[0].clientY - rect.top;
      }
    };

    const handleTouchEnd = () => {
      pointerX = null;
      pointerY = null;
    };

    window.addEventListener('mousemove', handlePointerMove, { passive: true });
    window.addEventListener('mouseout', handlePointerLeave, { passive: true });
    window.addEventListener('touchmove', handleTouchMove, { passive: true });
    window.addEventListener('touchend', handleTouchEnd, { passive: true });

    function resize() {
      if (!canvas || !canvas.parentElement) return;
      width = canvas.width = canvas.parentElement.clientWidth;
      height = canvas.height = canvas.parentElement.clientHeight;
    }
    window.addEventListener('resize', resize, { passive: true });

    let animId: number;

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const REPEL_RADIUS = isMobile ? 85 : 120;
      const REPEL_FORCE = 0.55;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.wobble += 0.04;

        // Apply natural insect flutter
        p.x += p.vx + Math.cos(p.wobble) * 0.45;
        p.y += p.vy + Math.sin(p.wobble) * 0.45;

        // Return smoothly to base velocity
        p.vx = p.vx * 0.96 + p.baseVx * 0.04;
        p.vy = p.vy * 0.96 + p.baseVy * 0.04;

        // Pointer/touch repulsion physics (ultrasonic avoidance behavior)
        if (pointerX !== null && pointerY !== null) {
          const dx = p.x - pointerX;
          const dy = p.y - pointerY;
          const dist = Math.hypot(dx, dy);

          if (dist < REPEL_RADIUS && dist > 1) {
            const force = (1 - dist / REPEL_RADIUS) * REPEL_FORCE;
            const angle = Math.atan2(dy, dx);
            p.vx += Math.cos(angle) * force * 2.2;
            p.vy += Math.sin(angle) * force * 2.2;
          }
        }

        // Boundary wrapping
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(239, 68, 68, ${p.alpha})`;
        ctx.fill();

        // Connect vectors in proximity
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.hypot(dx, dy);

          if (dist < 80) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(245, 158, 11, ${0.16 * (1 - dist / 80)})`;
            ctx.lineWidth = 0.55;
            ctx.stroke();
          }
        }
      }

      animId = requestAnimationFrame(animate);
    }

    animate();
  }

  // Smooth Numeric Counter reveal for HUD cards
  function initCounters() {
    const targets = document.querySelectorAll<HTMLElement>('.counter-target');
    if (!targets.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const targetNum = parseInt(el.getAttribute('data-target') || '0', 10);
          const suffix = el.getAttribute('data-suffix') || '';
          if (isNaN(targetNum)) return;

          let start = 0;
          const duration = 1200;
          const startTime = performance.now();

          const updateCounter = (currentTime: number) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Ease out quad
            const currentVal = Math.floor(progress * (2 - progress) * targetNum);
            el.textContent = `${currentVal}${suffix}`;

            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              el.textContent = `${targetNum}${suffix}`;
            }
          };

          requestAnimationFrame(updateCounter);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    targets.forEach(t => observer.observe(t));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initAedesCanvas();
      initCounters();
    });
  } else {
    initAedesCanvas();
    initCounters();
  }
</script>
