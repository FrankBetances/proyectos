---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="dengue-hero-section">
  <!-- Interactive Vector Canvas for Aedes aegypti swarm dynamics -->
  <div class="canvas-wrapper" aria-hidden="true">
    <canvas id="aedes-canvas"></canvas>
    <div class="canvas-vignette"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="container relative z-10">
    <!-- Eyebrow & Badges -->
    <div class="hero-top-bar">
      <div class="status-indicator">
        <span class="pulse-dot"></span>
        <span class="status-text">VIGILANCIA PARTICIPATIVA ACTIVA · REPÚBLICA DOMINICANA</span>
      </div>
      <div class="hud-coords font-mono">
        <span>PILOTO: LA VEGA</span>
        <span class="divider">|</span>
        <span>LAT: 19.2220° N · LON: 70.5296° W</span>
      </div>
    </div>

    <!-- Main Title & Narrative -->
    <div class="hero-content">
      <div class="badges-row">
        <span class="badge-pill pill-red">🦟 Vector Aedes aegypti</span>
        <span class="badge-pill pill-amber">🇩🇴 Piloto La Vega (9 Sectores)</span>
        <span class="badge-pill pill-cyan">🔬 Protocolo Oficial MISPAS</span>
        <span class="badge-pill pill-purple">🤖 Bot @AlertaDengueRDbot</span>
        <span class="badge-pill pill-emerald">🔒 Ley 172-13 (Zero-PHI)</span>
      </div>

      <h1 class="hero-title">
        Alerta Dengue <span class="gradient-text-red">RD</span>
      </h1>

      <p class="hero-subtitle">
        Plataforma comunitaria de <strong>vigilancia epidemiológica participativa</strong>, detección temprana de zonas en tensión febril y triaje clínico rápido frente al dengue. Una iniciativa liderada por el <strong>Dr. Frank Alberto Betances Reinoso</strong> junto a investigadores médicos de <strong>UCATECI</strong>.
      </p>

      <!-- Action CTAs -->
      <div class="hero-actions">
        <a href="#triaje" class="btn-dengue-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <span>Iniciar Triaje de Signos de Alarma</span>
        </a>

        <a href="#radar" class="btn-dengue-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m4.93 4.93 4.24 4.24"></path>
            <path d="m14.83 9.17 4.24-4.24"></path>
            <path d="m14.83 14.83 4.24 4.24"></path>
            <path d="m9.17 14.83-4.24 4.24"></path>
          </svg>
          <span>Radar de Sectores</span>
        </a>

        <a href="https://t.me/AlertaDengueRDbot" target="_blank" rel="noopener noreferrer" class="btn-dengue-telegram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .37z"/>
          </svg>
          <span>Bot en Telegram</span>
        </a>
      </div>
    </div>

    <!-- Live Telemetry HUD Metrics -->
    <div class="telemetry-hud">
      <div class="telemetry-card">
        <span class="hud-label font-mono">SECTORES MONITOREADOS</span>
        <div class="hud-value">
          <span class="val-num">9</span>
          <span class="val-sub">Voronoi (La Vega)</span>
        </div>
        <p class="hud-desc">División geométrica de 9 unidades para línea base estable y supresión de celda.</p>
      </div>

      <div class="telemetry-card">
        <span class="hud-label font-mono">UMBRAL DE PRIVACIDAD</span>
        <div class="hud-value text-cyan">
          <span class="val-num">k &ge; 5</span>
          <span class="val-sub">Ley 172-13</span>
        </div>
        <p class="hud-desc">Cero datos de salud individuales. Supresión estricta en sectores con menos de 5 casos.</p>
      </div>

      <div class="telemetry-card">
        <span class="hud-label font-mono">VENTANA CRÍTICA DE ALERTA</span>
        <div class="hud-value text-red">
          <span class="val-num">DÍAS 3–5</span>
          <span class="val-sub">Caída de Fiebre</span>
        </div>
        <p class="hud-desc">Momento de mayor riesgo de extravasación de plasma y choque según protocolo MISPAS.</p>
      </div>

      <div class="telemetry-card">
        <span class="hud-label font-mono">VALIDACIÓN COMUNITARIA</span>
        <div class="hud-value text-amber">
          <span class="val-num">30 m</span>
          <span class="val-sub">Radio de Cruce</span>
        </div>
        <p class="hud-desc">Deduplicación automática y validación por vecinos o brigadas municipales.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .dengue-hero-section {
    position: relative;
    padding: 7.5rem 0 4.5rem;
    overflow: hidden;
    background: radial-gradient(circle at 50% 20%, rgba(239, 68, 68, 0.08) 0%, rgba(7, 9, 14, 0.98) 70%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .canvas-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  #aedes-canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.65;
  }

  .canvas-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 40%, rgba(7, 9, 14, 0.85) 90%);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-size: 36px 36px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  }

  .hero-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 2.5rem;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: var(--radius-full);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #EF4444;
    box-shadow: 0 0 10px #EF4444;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .status-text {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #F87171;
  }

  .hud-coords {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .divider {
    color: rgba(255, 255, 255, 0.2);
  }

  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .badge-pill {
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .pill-red {
    background: rgba(239, 68, 68, 0.15);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }

  .pill-amber {
    background: rgba(245, 158, 11, 0.15);
    color: #FCD34D;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.15);
    color: #D8B4FE;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.15);
    color: #6EE7B7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .hero-title {
    font-size: clamp(2.8rem, 6.5vw, 5.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .hero-subtitle strong {
    color: var(--text-main);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .btn-dengue-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.85rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.35);
  }

  .btn-dengue-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(239, 68, 68, 0.5);
  }

  .btn-dengue-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-dengue-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .btn-dengue-telegram {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-full);
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-dengue-telegram:hover {
    background: rgba(0, 242, 254, 0.18);
    border-color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  /* Telemetry HUD Grid */
  .telemetry-hud {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .telemetry-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.35rem 1.5rem;
    backdrop-filter: blur(12px);
    transition: all 0.25s ease;
  }

  .telemetry-card:hover {
    border-color: rgba(239, 68, 68, 0.35);
    transform: translateY(-2px);
  }

  .hud-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .hud-value {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .val-num {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1;
  }

  .val-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .text-cyan .val-num { color: var(--accent-cyan); }
  .text-red .val-num { color: #EF4444; }
  .text-amber .val-num { color: #F59E0B; }

  .hud-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  @media (max-width: 768px) {
    .dengue-hero-section {
      padding: 6rem 0 3.5rem;
    }

    .hero-top-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-dengue-primary, .btn-dengue-secondary, .btn-dengue-telegram {
      justify-content: center;
    }
  }
</style>

<script>
  // Canvas Vector Particle Simulation (Aedes aegypti)
  function initAedesCanvas() {
    const canvas = document.getElementById('aedes-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = canvas.parentElement?.clientWidth || window.innerWidth);
    let height = (canvas.height = canvas.parentElement?.clientHeight || 600);

    const particles: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      alpha: number;
      pulse: number;
      wobble: number;
    }> = [];

    const COUNT = Math.min(50, Math.floor(width / 22));

    for (let i = 0; i < COUNT; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 1.1,
        vy: (Math.random() - 0.5) * 1.1,
        size: Math.random() * 2 + 1,
        alpha: Math.random() * 0.6 + 0.25,
        pulse: Math.random() * 0.05 + 0.01,
        wobble: Math.random() * Math.PI * 2
      });
    }

    function resize() {
      if (!canvas || !canvas.parentElement) return;
      width = canvas.width = canvas.parentElement.clientWidth;
      height = canvas.height = canvas.parentElement.clientHeight;
    }
    window.addEventListener('resize', resize, { passive: true });

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.wobble += 0.04;
        p.x += p.vx + Math.cos(p.wobble) * 0.5;
        p.y += p.vy + Math.sin(p.wobble) * 0.5;

        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(239, 68, 68, ${p.alpha})`;
        ctx.fill();

        // Connect vectors in proximity
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 85) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(245, 158, 11, ${0.18 * (1 - dist / 85)})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAedesCanvas);
  } else {
    initAedesCanvas();
  }
</script>
