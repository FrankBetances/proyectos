---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Official Valeria+ App Icon Logo -->
    <div class="valeria-app-icon-wrapper">
      <img 
        src={`${baseUrl}/assets/valeria_lua.png`} 
        alt="Logo Oficial de Valeria+ (Terapia Auditivo-Verbal y del Lenguaje)" 
        class="valeria-app-icon-img" 
        width="96"
        height="96"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="hero-badge">
      <span class="pulse-dot"></span>
      <span>Valeria+ v12 · Producción Clínica Aprobada</span>
    </div>

    <h1 class="hero-title">
      Terapia auditivo‑verbal y del lenguaje, <span class="gradient-text">offline y en tu bolsillo</span>
    </h1>

    <p class="hero-description">
      App móvil para niñas y niños con hipoacusia, implante coclear, dislalias, TEA, dislexia o dificultades del lenguaje. 
      Basada en el principio clínico <strong>MDR</strong>: el adulto es el motor de voz y el juez clínico definitivo de cada respuesta.
    </p>

    <div class="hero-badges">
      <span class="badge badge-cyan">🗣️ 5 Variedades Lingüísticas</span>
      <span class="badge badge-purple">⚡ Expo SDK 54 / React Native 0.81</span>
      <span class="badge badge-emerald">🔒 100% Offline & ASR Local</span>
      <span class="badge badge-amber">🎯 7 Bloques + Realidad Aumentada</span>
    </div>

    <div class="hero-actions">
      <a href={`${baseUrl}/cv`} class="btn-primary">
        <span>Ver Currículum Vítae (CV)</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#terapias" class="btn-secondary">
        <span>7 Bloques de Terapia</span>
      </a>
      <a href={`${baseUrl}/lua`} class="btn-secondary">
        <span>Mascota & Hardware Lúa</span>
      </a>
      <a href="https://github.com/FrankBetances/Valeria" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    <!-- Visual App Showcase with Real Screenshots -->
    <div class="app-visual-grid">
      <div class="phone-mockup-card glass-card">
        <div class="phone-header">
          <span class="phone-notch"></span>
          <span class="phone-title">Valeria+ Mobile App v12</span>
        </div>
        <img 
          src={`${baseUrl}/assets/valeria-app-1.png`} 
          alt="Captura real de la app Valeria+ v12 con la mascota Lúa, estrellas EPT-3 y niveles de progreso" 
          class="phone-img" 
          width="360"
          height="780"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-mockup">
        <div class="mockup-header">
          <div class="dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="title-bar">Valeria+ Mobile Therapy Hub</div>
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span>OFFLINE READY</span>
          </div>
        </div>
        
        <div class="mockup-content">
          <div class="card-demo card-ling">
            <div class="card-icon">👂</div>
            <div class="card-info">
              <h4>Test de Ling & Audición en Ruido</h4>
              <p>Comprobación auditiva previa [a, i, u, m, s, ʃ] y entrenamiento en ruido babble (RA-1 a RA-5)</p>
            </div>
            <span class="status-badge">Completado</span>
          </div>

          <div class="card-demo card-minimal">
            <div class="card-icon">🗣️</div>
            <div class="card-info">
              <h4>Pares Mínimos D7 (Vecino O2)</h4>
              <p>Dislalias fonológicas (rana/lana) con evaluador O2 (35/35 contrastes) y sello doble adulto-niño</p>
            </div>
            <span class="status-badge">Completado</span>
          </div>

          <div class="card-demo card-academy">
            <div class="card-icon">🎯</div>
            <div class="card-info">
              <h4>Realidad Aumentada 3D & LSE</h4>
              <p>Cinemática orofacial sin micrófono (AR-1..3) y 27 configuraciones dactilológicas de LSE en Academy</p>
            </div>
            <span class="status-badge">Multidominio</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 140px;
    padding-bottom: 80px;
    position: relative;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .valeria-app-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.5rem auto 1.5rem auto;
  }

  .valeria-app-icon-img {
    border-radius: 22px;
    box-shadow: 0 10px 30px rgba(168, 85, 247, 0.35);
    border: 2px solid rgba(168, 85, 247, 0.4);
    background: #0f172a;
    transition: transform 0.3s ease;
  }

  .valeria-app-icon-img:hover {
    transform: scale(1.05);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-cyan);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 242, 254, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(0, 242, 254, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 242, 254, 0); }
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    max-width: 900px;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 760px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero-description strong {
    color: var(--text-main);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all var(--transition-base);
    text-decoration: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-blue) 100%);
    color: var(--bg-dark);
    box-shadow: var(--shadow-cyan);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 242, 254, 0.5);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    border: 1px solid var(--border-light);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }

  /* Visual app grid */
  .app-visual-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2rem;
    max-width: 950px;
    width: 100%;
    align-items: center;
  }

  .phone-mockup-card {
    padding: 1rem;
    border-radius: 36px;
    background: rgba(15, 23, 42, 0.7);
    border: 2px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .phone-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .phone-notch {
    width: 40px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
  }

  .phone-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .phone-img {
    width: 100%;
    max-width: 320px;
    height: auto;
    border-radius: 24px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-mockup {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .mockup-header {
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-light);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .title-bar {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-emerald);
    letter-spacing: 0.05em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
  }

  .mockup-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-demo {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    text-align: left;
    transition: transform var(--transition-fast);
  }

  .card-demo:hover {
    transform: translateX(4px);
    background: rgba(255, 255, 255, 0.04);
  }

  .card-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .card-info {
    flex-grow: 1;
  }

  .card-info h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .card-info p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    background: rgba(0, 242, 254, 0.1);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.2);
  }

  @media (max-width: 860px) {
    .app-visual-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.25rem;
    }
    .hero-badges {
      gap: 0.5rem;
    }
    .card-demo {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .status-badge {
      align-self: flex-end;
    }
  }
</style>
