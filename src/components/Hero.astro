---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- Cinematic Medical Hero for Valeria+ (Dynamic Motion, Acoustic Waves & Mobile-First Precision) -->
<section id="valeria-hero" class="hero-native-section">
  <!-- Dynamic Acoustic Waveform & Ambient Stage -->
  <div class="hero-backdrop-layer" aria-hidden="true">
    <div class="ambient-glow glow-purple"></div>
    <div class="ambient-glow glow-cyan"></div>
    <div class="hero-grid-overlay"></div>
    
    <!-- SVG Bio-Acoustic Spectrum Waveform -->
    <svg class="acoustic-wave-canvas" viewBox="0 0 1440 280" fill="none" preserveAspectRatio="none">
      <defs>
        <linearGradient id="waveGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#8A2BE2" stop-opacity="0.25"/>
          <stop offset="50%" stop-color="#00F2FE" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#8A2BE2" stop-opacity="0.15"/>
        </linearGradient>
        <linearGradient id="waveGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#00F2FE" stop-opacity="0.15"/>
          <stop offset="50%" stop-color="#8A2BE2" stop-opacity="0.2"/>
          <stop offset="100%" stop-color="#00F2FE" stop-opacity="0.1"/>
        </linearGradient>
      </defs>
      <path class="wave-path wave-1" d="M0,140 C240,60 480,220 720,130 C960,40 1200,200 1440,120 L1440,280 L0,280 Z" fill="url(#waveGrad1)"/>
      <path class="wave-path wave-2" d="M0,160 C320,240 640,80 960,180 C1180,230 1340,110 1440,150 L1440,280 L0,280 Z" fill="url(#waveGrad2)"/>
    </svg>
  </div>

  <div class="container hero-container">
    <!-- Institutional Badges Strip (Pure Micro-SVG, Zero Emojis) -->
    <div class="hero-badges-row" aria-label="Acreditaciones institucionales y regulatorias">
      <div class="hero-badge badge-starttic">
        <svg class="micro-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span><strong>startTIC</strong> · Alta Tecnología</span>
      </div>
      <div class="hero-badge badge-itemas">
        <svg class="micro-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"></path>
          <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"></path>
          <circle cx="20" cy="10" r="2"></circle>
        </svg>
        <span><strong>ITEMAS-ISCIII 2024</strong></span>
      </div>
      <div class="hero-badge badge-offline">
        <svg class="micro-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span><strong>100% Offline</strong> · Zero-PHI</span>
      </div>
      <div class="hero-badge badge-mdr">
        <svg class="micro-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span><strong>Marco MDR</strong> · Control Adulto</span>
      </div>
    </div>

    <!-- Editorial Hierarchy: Title & Value Proposition -->
    <div class="hero-main-content">
      <h1 class="hero-title">
        Rehabilitación del lenguaje en casa: <span class="gradient-text-purple">la familia acompaña, Lúa refuerza</span>
      </h1>

      <p class="hero-lead">
        Estimulación clínica estructurada para dificultades del habla, hipoacusia, TEA y dislexia. Capacitación parental previa con Academy y práctica lúdica adaptada en el hogar, sin publicidad ni recolección de datos infantiles.
      </p>

      <!-- Clean Action Row (Ergonomic Touch Targets) -->
      <div class="hero-actions-row">
        <a 
          href="https://play.google.com/store/apps/details?id=eu.futureforkids.valeria" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-playstore"
          aria-label="Descargar Valeria+ en Google Play Store"
        >
          <svg class="play-svg-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186A2.02 2.02 0 0 1 3.39 21.8C3.14 21.28 3 20.67 3 19.98V4.02c0-.69.14-1.3.39-1.82.065-.137.14-.268.219-.386z" fill="#00D2FF"/>
            <path d="M17.472 8.448L5.037.824 13.792 12l3.68-3.552z" fill="#00E676"/>
            <path d="M17.472 15.552L13.792 12 5.037 23.176l12.435-7.624z" fill="#FF5252"/>
            <path d="M20.803 10.428l-3.331-2.043-3.68 3.615 3.68 3.552 3.331-2.043c.96-.588.96-2.493 0-3.081z" fill="#FFD600"/>
          </svg>
          <span class="btn-play-content">
            <span class="btn-play-sub">DISPONIBLE EN</span>
            <span class="btn-play-main">Google Play</span>
          </span>
        </a>

        <a href="#bloques-clinicos" class="btn-primary">
          <span>Explorar los Bloques</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </a>

        <a href="#lua-mascota" class="btn-lua-link">
          <img 
            src={`${baseUrl}/assets/lua-mascota-valeria.png`} 
            alt="Mascota Lúa" 
            class="lua-btn-avatar" 
            width="22" 
            height="22"
          />
          <span>Conoce a Lúa</span>
        </a>
      </div>

      <!-- Essential KPI Strip -->
      <div class="hero-kpi-strip" aria-label="Cifras clave de Valeria+">
        <div class="kpi-item">
          <span class="kpi-num">10</span>
          <span class="kpi-label">Bloques Clínicos</span>
        </div>
        <div class="kpi-divider" aria-hidden="true"></div>
        <div class="kpi-item">
          <span class="kpi-num">4.711</span>
          <span class="kpi-label">Locuciones Offline</span>
        </div>
        <div class="kpi-divider" aria-hidden="true"></div>
        <div class="kpi-item">
          <span class="kpi-num">6</span>
          <span class="kpi-label">Variedades de Voz</span>
        </div>
        <div class="kpi-divider" aria-hidden="true"></div>
        <div class="kpi-item">
          <span class="kpi-num">Zero-PHI</span>
          <span class="kpi-label">Privacidad Estricta</span>
        </div>
      </div>

      <!-- Cinematic Product Stage: Device Screen Placed Gracefully Below the Content -->
      <div class="hero-showcase-stage">
        <div class="stage-ambient-glow" aria-hidden="true"></div>
        <div class="device-mockup">
          <div class="device-notch"></div>
          <div class="device-screen">
            <img 
              src={`${baseUrl}/assets/valeria-screen-bienvenida.png`} 
              alt="Pantalla oficial de Bienvenida de Valeria+ v14 con la mascota Lúa" 
              class="device-screen-img"
              width="340"
              height="756"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
        <!-- Floating Interactive Mascot Pill -->
        <div class="stage-floating-pill">
          <img 
            src={`${baseUrl}/assets/lua-mascota-valeria.png`} 
            alt="Lúa la gata oficial de Valeria+" 
            class="stage-lua-icon" 
            width="32" 
            height="32"
          />
          <div class="stage-pill-text">
            <strong>Lúa · Mascota Pediátrica</strong>
            <span>Ronroneo y refuerzo positivo sin castigo</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-native-section {
    position: relative;
    padding-top: 110px;
    padding-bottom: 60px;
    overflow: hidden;
    background-color: var(--bg-dark);
  }

  .hero-backdrop-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.25;
  }

  .glow-purple {
    top: 5%;
    left: 20%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.28) 0%, transparent 70%);
  }

  .glow-cyan {
    top: 12%;
    right: 18%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.22) 0%, transparent 70%);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at 50% 35%, black 25%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 35%, black 25%, transparent 80%);
  }

  /* SVG Acoustic Waveform Motion */
  .acoustic-wave-canvas {
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 100%;
    height: 180px;
    opacity: 0.7;
    pointer-events: none;
  }

  .wave-path {
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }

  .wave-1 {
    animation: wavePulse1 12s infinite;
  }

  .wave-2 {
    animation: wavePulse2 16s infinite;
  }

  @keyframes wavePulse1 {
    0% { transform: translateY(0) scaleY(1); }
    50% { transform: translateY(-8px) scaleY(1.05); }
    100% { transform: translateY(4px) scaleY(0.96); }
  }

  @keyframes wavePulse2 {
    0% { transform: translateY(0) scaleY(0.95); }
    50% { transform: translateY(10px) scaleY(1.04); }
    100% { transform: translateY(-6px) scaleY(1); }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  /* Badges Strip */
  .hero-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 auto;
    max-width: 880px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.8rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .hero-badge:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .micro-icon {
    flex-shrink: 0;
  }

  .badge-starttic {
    border-color: rgba(0, 242, 254, 0.25);
    background: rgba(0, 242, 254, 0.05);
    color: #e0f2fe;
  }
  .badge-starttic .micro-icon { color: var(--accent-cyan); }

  .badge-itemas {
    border-color: rgba(168, 85, 247, 0.25);
    background: rgba(168, 85, 247, 0.05);
    color: #f3e8ff;
  }
  .badge-itemas .micro-icon { color: #c084fc; }

  .badge-offline {
    border-color: rgba(16, 185, 129, 0.25);
    background: rgba(16, 185, 129, 0.05);
    color: #ecfdf5;
  }
  .badge-offline .micro-icon { color: #34d399; }

  .badge-mdr {
    border-color: rgba(245, 158, 11, 0.25);
    background: rgba(245, 158, 11, 0.05);
    color: #fffbeb;
  }
  .badge-mdr .micro-icon { color: #fbbf24; }

  .hero-badge strong {
    color: var(--text-main);
  }

  /* Main Editorial Content */
  .hero-main-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-main);
    text-align: center;
    margin: 0 auto 1.25rem auto;
    max-width: 920px;
  }

  .gradient-text-purple {
    background: linear-gradient(135deg, #c084fc 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(0.95rem, 1.4vw, 1.125rem);
    line-height: 1.65;
    color: var(--text-muted);
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2rem auto;
  }

  /* Actions Row */
  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin: 0 auto 2.25rem auto;
  }

  .btn-playstore {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 1.35rem;
    border-radius: 14px;
    background: #090D16;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45), 0 0 16px rgba(0, 242, 254, 0.12);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-playstore:hover {
    border-color: rgba(0, 242, 254, 0.6);
    background: #0D1322;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 26px rgba(0, 242, 254, 0.3);
  }

  .btn-play-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    line-height: 1.15;
  }

  .btn-play-sub {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .btn-play-main {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .btn-lua-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.3rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fdba74;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-lua-link:hover {
    background: rgba(249, 115, 22, 0.22);
    border-color: rgba(249, 115, 22, 0.6);
    color: #fff;
    transform: translateY(-2px);
  }

  .lua-btn-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  /* KPI Metrics Strip */
  .hero-kpi-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 1.1rem 1.75rem;
    border-radius: var(--radius-lg);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(14px);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.4);
  }

  .kpi-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    flex: 1;
  }

  .kpi-divider {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.08);
  }

  .kpi-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-cyan);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .kpi-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Cinematic Product Stage */
  .hero-showcase-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 2.5rem;
  }

  .stage-ambient-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(0, 242, 254, 0.12) 50%, transparent 75%);
    filter: blur(35px);
    z-index: 0;
    pointer-events: none;
    border-radius: 40px;
  }

  .device-mockup {
    position: relative;
    z-index: 1;
    width: 210px;
    padding: 8px;
    border-radius: 28px;
    background: linear-gradient(145deg, #1e293b, #090d16);
    border: 2px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 20px 45px -8px rgba(0, 0, 0, 0.75), 0 0 30px rgba(0, 242, 254, 0.14);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .device-mockup:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px -6px rgba(0, 0, 0, 0.85), 0 0 40px rgba(168, 85, 247, 0.25);
  }

  .device-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 9px;
    border-radius: var(--radius-full);
    background: #030712;
    z-index: 2;
  }

  .device-screen {
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    background: #050811;
  }

  .device-screen-img {
    width: 100%;
    height: auto;
    aspect-ratio: 340 / 756;
    object-fit: cover;
    display: block;
  }

  /* Floating Mascot Badge on Device Stage */
  .stage-floating-pill {
    position: relative;
    z-index: 2;
    margin-top: -14px;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 1rem;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(249, 115, 22, 0.35);
    border-radius: var(--radius-full);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(249, 115, 22, 0.15);
    transition: transform 0.2s ease;
  }

  .stage-floating-pill:hover {
    transform: translateY(-2px);
    border-color: rgba(249, 115, 22, 0.6);
  }

  .stage-lua-icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    image-rendering: pixelated;
    border: 1.5px solid rgba(249, 115, 22, 0.5);
  }

  .stage-pill-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    line-height: 1.15;
  }

  .stage-pill-text strong {
    font-size: 0.78rem;
    color: #fdba74;
    font-weight: 700;
  }

  .stage-pill-text span {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero-native-section {
      padding-top: 95px;
      padding-bottom: 45px;
    }

    .hero-container {
      gap: 1.25rem;
    }

    .hero-badges-row {
      gap: 0.35rem;
    }

    .hero-badge {
      font-size: 0.72rem;
      padding: 0.26rem 0.6rem;
    }

    .hero-title {
      font-size: 2.1rem;
    }

    .hero-lead {
      font-size: 0.92rem;
      line-height: 1.55;
      margin-bottom: 1.5rem;
      padding: 0 0.5rem;
    }

    .hero-actions-row {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
      gap: 0.65rem;
      margin-bottom: 1.5rem;
    }

    .hero-actions-row .btn-playstore,
    .hero-actions-row .btn-primary,
    .hero-actions-row .btn-lua-link {
      width: 100%;
      justify-content: center;
    }

    .hero-kpi-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      padding: 0.9rem;
    }

    .kpi-divider {
      display: none;
    }

    .kpi-num {
      font-size: 1.45rem;
    }

    .device-mockup {
      width: 165px;
      padding: 6px;
      border-radius: 22px;
    }

    .stage-floating-pill {
      padding: 0.35rem 0.75rem;
      margin-top: -10px;
    }

    .stage-lua-icon {
      width: 24px;
      height: 24px;
    }

    .stage-pill-text strong {
      font-size: 0.72rem;
    }

    .stage-pill-text span {
      font-size: 0.62rem;
    }
  }
</style>
