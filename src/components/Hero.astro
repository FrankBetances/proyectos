---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- Award-Winning Cinematic Hero for Valeria+ (Dark Medical Premium & Mobile-First) -->
<section id="valeria-hero" class="hero-native-section">
  <!-- Subtle Ambient Backdrop Glows -->
  <div class="hero-backdrop-layer" aria-hidden="true">
    <div class="ambient-glow glow-purple"></div>
    <div class="ambient-glow glow-cyan"></div>
    <div class="hero-grid-overlay"></div>
  </div>

  <div class="container hero-container">
    <!-- Unified Institutional Accreditations Pill Strip (SVG Micro-vectors) -->
    <div class="hero-badges-row" aria-label="Acreditaciones institucionales y regulatorias">
      <div class="hero-badge badge-starttic">
        <svg class="micro-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span><strong>startTIC</strong> · Incubadora Alta Tecnología</span>
      </div>
      <div class="hero-badge badge-itemas">
        <svg class="micro-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"></path>
          <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"></path>
          <circle cx="20" cy="10" r="2"></circle>
        </svg>
        <span><strong>ITEMAS-ISCIII 2024</strong></span>
      </div>
      <div class="hero-badge badge-offline">
        <svg class="micro-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span><strong>100% Offline</strong> · Zero-PHI</span>
      </div>
      <div class="hero-badge badge-mdr">
        <svg class="micro-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span><strong>MDR Clase I</strong> · Control Adulto</span>
      </div>
    </div>

    <!-- Centered Editorial Content -->
    <div class="hero-main-content">
      <h1 class="hero-title">
        Rehabilitación del lenguaje en casa: <span class="gradient-text-purple">la familia acompaña, Lúa refuerza</span>
      </h1>

      <!-- Concise, Non-Redundant Value Proposition -->
      <p class="hero-lead">
        Estimulación clínica estructurada para dificultades del habla, hipoacusia, TEA y dislexia. Capacitación parental previa con Academy y práctica lúdica adaptada en el hogar, sin publicidad ni recolección de datos infantiles.
      </p>

      <!-- Clean Dual Action Row -->
      <div class="hero-actions-row">
        <a 
          href="https://play.google.com/store/apps/details?id=eu.futureforkids.valeria" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-playstore touch-target"
          aria-label="Descargar Valeria+ en Google Play Store"
        >
          <svg class="play-svg-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186A2.02 2.02 0 0 1 3.39 21.8C3.14 21.28 3 20.67 3 19.98V4.02c0-.69.14-1.3.39-1.82.065-.137.14-.268.219-.386z" fill="#00D2FF"/>
            <path d="M17.472 8.448L5.037.824 13.792 12l3.68-3.552z" fill="#00E676"/>
            <path d="M17.472 15.552L13.792 12 5.037 23.176l12.435-7.624z" fill="#FF5252"/>
            <path d="M20.803 10.428l-3.331-2.043-3.68 3.615 3.68 3.552 3.331-2.043c.96-.588.96-2.493 0-3.081z" fill="#FFD600"/>
          </svg>
          <span class="btn-play-content">
            <span class="btn-play-sub">DISPONIBLE EN</span>
            <span class="btn-play-main">Google Play</span>
          </span>
        </a>

        <a href="#bloques-clinicos" class="btn-primary touch-target">
          <span>Explorar los Bloques</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </a>

        <a href={`${baseUrl}/lua`} class="btn-pill-link touch-target">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2a5 5 0 0 1 5 5v3a5 5 0 0 1-10 0V7a5 5 0 0 1 5-5z"></path>
            <path d="M19 11v1a7 7 0 0 1-14 0v-1"></path>
          </svg>
          <span>Lúa Mascota & Hardware</span>
        </a>
      </div>

      <!-- Single KPI Metrics Strip -->
      <div class="hero-kpi-strip" aria-label="Métricas clínicas principales">
        <div class="kpi-item">
          <span class="kpi-num">10</span>
          <span class="kpi-label">Bloques Clínicos</span>
        </div>
        <div class="kpi-divider" aria-hidden="true"></div>
        <div class="kpi-item">
          <span class="kpi-num">4.711</span>
          <span class="kpi-label">Locuciones Offline</span>
        </div>
        <div class="kpi-divider" aria-hidden="true"></div>
        <div class="kpi-item">
          <span class="kpi-num">6</span>
          <span class="kpi-label">Variedades de Voz</span>
        </div>
        <div class="kpi-divider" aria-hidden="true"></div>
        <div class="kpi-item">
          <span class="kpi-num">Zero-PHI</span>
          <span class="kpi-label">Privacidad Estricta</span>
        </div>
      </div>

      <!-- Visual Device Mockup with Real In-App Screenshot -->
      <div class="hero-showcase-center">
        <div class="device-mockup-wrap">
          <div class="device-ambient-halo" aria-hidden="true"></div>
          <div class="device-mockup">
            <div class="device-notch"></div>
            <div class="device-screen">
              <img 
                src={`${baseUrl}/assets/valeria-screen-bienvenida.png`} 
                alt="Pantalla oficial de Bienvenida de Valeria+ v14 con la gata Lúa" 
                class="device-screen-img"
                width="340"
                height="756"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-native-section {
    position: relative;
    padding-top: 115px;
    padding-bottom: 75px;
    overflow: hidden;
    background-color: var(--bg-dark);
  }

  .hero-backdrop-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.28;
  }

  .glow-purple {
    top: 6%;
    left: 20%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.25) 0%, transparent 70%);
  }

  .glow-cyan {
    top: 14%;
    right: 18%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.2) 0%, transparent 70%);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at 50% 40%, black 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, black 30%, transparent 85%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  /* Institutional Badges Strip */
  .hero-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin: 0 auto;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(12px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .hero-badge:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .micro-icon {
    flex-shrink: 0;
  }

  .badge-starttic {
    border-color: rgba(0, 242, 254, 0.3);
    background: rgba(0, 242, 254, 0.06);
    color: #e0f2fe;
  }
  .badge-starttic .micro-icon { color: var(--accent-cyan); }

  .badge-itemas {
    border-color: rgba(168, 85, 247, 0.3);
    background: rgba(168, 85, 247, 0.06);
    color: #f3e8ff;
  }
  .badge-itemas .micro-icon { color: #c084fc; }

  .badge-offline {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.06);
    color: #ecfdf5;
  }
  .badge-offline .micro-icon { color: #34d399; }

  .badge-mdr {
    border-color: rgba(245, 158, 11, 0.3);
    background: rgba(245, 158, 11, 0.06);
    color: #fffbeb;
  }
  .badge-mdr .micro-icon { color: #fbbf24; }

  .hero-badge strong {
    color: var(--text-main);
  }

  /* Main Editorial Content */
  .hero-main-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: var(--font-hero);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-main);
    text-align: center;
    margin: 0 auto 1.25rem auto;
    max-width: 940px;
  }

  .gradient-text-purple {
    background: linear-gradient(135deg, #c084fc 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(0.95rem, 1.4vw, 1.125rem);
    line-height: 1.65;
    color: var(--text-muted);
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2rem auto;
  }

  /* Showcase Mockup */
  .hero-showcase-center {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 2.25rem auto 0.5rem auto;
  }

  .device-mockup-wrap {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .device-ambient-halo {
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.3) 0%, rgba(0, 242, 254, 0.15) 50%, transparent 75%);
    filter: blur(28px);
    z-index: 0;
    pointer-events: none;
    border-radius: 40px;
  }

  .device-mockup {
    position: relative;
    z-index: 1;
    width: 210px;
    padding: 8px;
    border-radius: 28px;
    background: linear-gradient(145deg, #1e293b, #090d16);
    border: 2px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 20px 45px -8px rgba(0, 0, 0, 0.75), 0 0 35px rgba(0, 242, 254, 0.18);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .device-mockup:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px -6px rgba(0, 0, 0, 0.85), 0 0 45px rgba(168, 85, 247, 0.3);
  }

  .device-notch {
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 9px;
    border-radius: var(--radius-full);
    background: #030712;
    z-index: 2;
  }

  .device-screen {
    border-radius: 19px;
    overflow: hidden;
    position: relative;
    background: #050811;
  }

  .device-screen-img {
    width: 100%;
    height: auto;
    aspect-ratio: 340 / 756;
    object-fit: cover;
    display: block;
  }

  /* Actions Row */
  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin: 0 auto 2.5rem auto;
  }

  .btn-playstore {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 1.35rem;
    border-radius: 14px;
    background: #090D16;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45), 0 0 16px rgba(0, 242, 254, 0.15);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-playstore:hover {
    border-color: rgba(0, 242, 254, 0.7);
    background: #0D1322;
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 242, 254, 0.35);
  }

  .btn-play-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    line-height: 1.15;
  }

  .btn-play-sub {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .btn-play-main {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .btn-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fdba74;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-pill-link:hover {
    background: rgba(249, 115, 22, 0.22);
    border-color: rgba(249, 115, 22, 0.6);
    color: #fff;
    transform: translateY(-2px);
  }

  /* KPI Metrics Strip */
  .hero-kpi-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    border-radius: var(--radius-lg);
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(16px);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.5);
  }

  .kpi-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .kpi-divider {
    width: 1px;
    height: 38px;
    background: rgba(255, 255, 255, 0.08);
  }

  .kpi-num {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-cyan);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .kpi-label {
    font-size: 0.725rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .hero-native-section {
      padding-top: 100px;
      padding-bottom: 50px;
    }

    .hero-container {
      gap: 1.5rem;
    }

    .hero-badges-row {
      gap: 0.4rem;
    }

    .hero-badge {
      font-size: 0.72rem;
      padding: 0.28rem 0.65rem;
    }

    .hero-lead {
      font-size: 0.92rem;
      line-height: 1.55;
      margin-bottom: 1.5rem;
      padding: 0 0.5rem;
    }

    .hero-actions-row {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.7rem;
      margin-bottom: 1.75rem;
    }

    .hero-actions-row .btn-playstore,
    .hero-actions-row .btn-primary,
    .hero-actions-row .btn-pill-link {
      width: 100%;
      justify-content: center;
    }

    .hero-kpi-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      padding: 1rem;
    }

    .kpi-divider {
      display: none;
    }

    .kpi-num {
      font-size: 1.5rem;
    }

    .device-mockup {
      width: min(155px, 50vw);
      padding: 5px;
      border-radius: 20px;
    }
  }
</style>
