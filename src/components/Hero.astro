---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section for Valeria+ inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="valeria-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Lifestyle Backdrop Graphic with Parallax -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div id="v-hero-bg-stage" class="hero-lifestyle-bg-stage">
        <img 
          src={`${baseUrl}/assets/valeria-lua-hero-bg.jpg?v=1`} 
          alt="Dispositivo interactivo de Lúa con pantalla circular mostrando a la gata Lúa en pixel art sobre mesa de madera, con adulto y niño celebrando con choque de manos" 
          class="lifestyle-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="lifestyle-overlay-gradient"></div>
      </div>
      <div class="glow-orb orb-purple"></div>
      <div class="glow-orb orb-cyan"></div>
      <div class="glow-orb orb-emerald"></div>
      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line, invisible at 0 scroll) -->
    <div class="hero-editorial-tracker" id="v-tracker" aria-hidden="true">
      <div class="tracker-segment" id="v-track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="v-fill-0"></div></div><span>Principio MDR</span></div>
      <div class="tracker-segment" id="v-track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="v-fill-1"></div></div><span>7 Bloques & RA</span></div>
      <div class="tracker-segment" id="v-track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="v-fill-2"></div></div><span>Lúa & Evidencia</span></div>
    </div>

    <!-- Sutil indicador de ratón inicial abajo (desaparece al hacer scroll) -->
    <div id="v-scroll-starter" class="hero-scroll-starter" aria-hidden="true">
      <span class="starter-text">Scroll para comenzar</span>
      <div class="hint-mouse">
        <div class="mouse-wheel"></div>
      </div>
    </div>

    <!-- PHASE 0: El Principio Clínico & El Muro MDR (Aparece únicamente al hacer scroll: 2% - 36%) -->
    <div id="v-phase-0" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <!-- Official Valeria+ App Icon with Lua Mascot -->
        <div class="valeria-app-icon-wrapper">
          <img 
            src={`${baseUrl}/assets/valeria_lua.png`} 
            alt="Logo Oficial de Valeria+ con la Mascota Lúa" 
            class="valeria-brand-icon" 
            width="110"
            height="110"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <h1 class="hero-headline">
          Terapia auditivo‑verbal y del lenguaje, <span class="gradient-text-purple">en tu bolsillo y 100% offline</span>
        </h1>

        <p class="hero-narrative-lead">
          Diseñada para niñas y niños con hipoacusia, implante coclear, dislalias, TEA, dislexia o dificultades del lenguaje. 
          Bajo el principio clínico <strong>MDR</strong>: el adulto es el motor de voz y el juez clínico definitivo de cada respuesta.
        </p>

        <div class="hero-badge-pill-row">
          <span class="badge-pill pill-purple">🔒 100% Offline & ASR Local</span>
          <span class="badge-pill pill-cyan">⚡ Expo SDK 54 / RN 0.81</span>
          <span class="badge-pill pill-emerald">🩺 Sello ITEMAS 2024</span>
          <span class="badge-pill pill-amber">🎓 Incubación USC-INTEGRA</span>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Los 7 Bloques Clínicos & Realidad Aumentada 3D (38% - 70% Scroll) -->
    <div id="v-phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Arquitectura Terapéutica Multidominio</span>
        </div>
        <h2 class="hero-headline text-gradient-cyan">
          7 Bloques de intervención médica con rigor fonoaudiológico.
        </h2>

        <div class="valeria-showcase-grid">
          <!-- Left: Clinical Cards -->
          <div class="showcase-cards-col">
            <div class="valeria-feature-card">
              <div class="feature-icon-badge icon-cyan">👂</div>
              <div class="feature-text">
                <strong>Test de Ling & Audición en Ruido</strong>
                <p>Comprobación previa de 6 sonidos [a, i, u, m, s, ʃ] y entrenamiento progresivo en ruido babble.</p>
              </div>
            </div>

            <div class="valeria-feature-card">
              <div class="feature-icon-badge icon-purple">🗣️</div>
              <div class="feature-text">
                <strong>Pares Mínimos D7 (Vecino O2)</strong>
                <p>Evaluación fonológica con 35/35 contrastes detectados y doble confirmación adulto-niño.</p>
              </div>
            </div>

            <div class="valeria-feature-card">
              <div class="feature-icon-badge icon-emerald">👓</div>
              <div class="feature-text">
                <strong>Realidad Aumentada 3D & LSE</strong>
                <p>Cinemática orofacial en Filament sin micrófono (Zero-PHI) y 27 dactilemas LSE en Academy.</p>
              </div>
            </div>
          </div>

          <!-- Right: Real Phone App Mockup -->
          <div class="showcase-phone-col">
            <div class="phone-frame-mockup">
              <div class="phone-status-bar">
                <span class="phone-notch"></span>
                <span class="phone-tag">Valeria+ v12 Live</span>
              </div>
              <img 
                src={`${baseUrl}/assets/valeria-app-1.png`} 
                alt="Captura real de la app Valeria+ v12 mostrando los niveles de progreso y la mascota Lúa" 
                class="phone-capture-img"
                width="320"
                height="650"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: Mascota Lúa, 5 Variedades & Criterio (72% - 100% Scroll) -->
    <div id="v-phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Gamificación Pediátrica & Evidencia Científica</span>
        </div>
        <h2 class="hero-headline">
          <span class="quote-tagline-purple">“Motivación intrínseca. Cero frustración.”</span>
        </h2>
        <p class="hero-narrative-lead">
          La mascota oficial <strong>Lúa</strong> en pixel art acompaña el desarrollo en 12 niveles de progreso y 18 insignias en 5 metales. Con 5 variedades lingüísticas nativas (Castellano, Galego Nós, Dominicano es-DO, Euskara HiTZ, US English) y PoC publicada en Zenodo.
        </p>

        <div class="hero-cta-group">
          <a href="#terapias" class="btn-valeria-primary">
            <span>Explorar los 7 Bloques</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href={`${baseUrl}/lua`} class="btn-valeria-secondary">
            <span>Mascota & Hardware Lúa</span>
          </a>
          <a href={`${baseUrl}/cv`} class="btn-valeria-secondary">
            <span>Currículum (CV)</span>
          </a>
          <a href="https://github.com/FrankBetances/Valeria" target="_blank" rel="noopener noreferrer" class="btn-valeria-ghost" aria-label="Ver repositorio en GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initValeriaHero() {
    const heroSection = document.getElementById('valeria-hero-scrub');
    const scrollStarter = document.getElementById('v-scroll-starter');
    const tracker = document.getElementById('v-tracker');
    const phase0 = document.getElementById('v-phase-0');
    const phase1 = document.getElementById('v-phase-1');
    const phase2 = document.getElementById('v-phase-2');

    const fill0 = document.getElementById('v-fill-0');
    const fill1 = document.getElementById('v-fill-1');
    const fill2 = document.getElementById('v-fill-2');
    const bgStage = document.getElementById('v-hero-bg-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    function calcOpacity(progress: number, enterStart: number, enterEnd: number, exitStart: number, exitEnd: number): number {
      if (progress < enterStart || progress > exitEnd) return 0;
      if (progress < enterEnd) return (progress - enterStart) / (enterEnd - enterStart);
      if (progress > exitStart) return Math.max(0, 1 - (progress - exitStart) / (exitEnd - exitStart));
      return 1.0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      } else {
        targetProgress = 0;
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      currentProgress += (targetProgress - currentProgress) * 0.18;

      // Starter hint fades out immediately when scroll starts (> 0.01)
      const opStarter = calcOpacity(targetProgress, 0.0, 0.005, 0.015, 0.04);
      if (scrollStarter) {
        scrollStarter.style.opacity = opStarter.toFixed(3);
        scrollStarter.style.pointerEvents = opStarter > 0.4 ? 'auto' : 'none';
      }

      // Phase 0: Enters when scroll begins (0.02 -> peaks at 0.10-0.28 -> exits at 0.36)
      const op0 = calcOpacity(targetProgress, 0.02, 0.10, 0.28, 0.36);
      // Phase 1: 7 Bloques & RA (0.37 -> peaks at 0.46-0.64 -> exits at 0.72)
      const op1 = calcOpacity(targetProgress, 0.37, 0.46, 0.64, 0.72);
      // Phase 2: Lúa & CTAs (0.72 -> peaks at 0.80-1.00)
      const op2 = calcOpacity(targetProgress, 0.72, 0.80, 0.98, 1.00);

      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${(0.15 - targetProgress) * 40}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.52 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.86 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      // Lifestyle Background Dynamic Parallax
      if (bgStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const bgOpacity = Math.max(0.40, 0.72 - currentProgress * 0.25);
        bgStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        bgStage.style.opacity = bgOpacity.toFixed(3);
      }

      // Tracker visibility (fades in once scroll starts)
      if (tracker) {
        tracker.style.opacity = targetProgress > 0.02 ? '1' : '0';
      }

      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.02) / 0.34) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.36) / 0.36) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.72) / 0.28) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initValeriaHero);
  } else {
    initValeriaHero();
  }
  document.addEventListener('astro:page-load', initValeriaHero);
</script>

<style>
  /* 320vh Hero Container */
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    width: 100%;
    background-color: var(--bg-dark);
  }

  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Ambient Backdrop Canvas */
  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  /* Lifestyle Artwork Background Parallax Stage */
  .hero-lifestyle-bg-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100vh;
    max-width: 1920px;
    max-height: 1080px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    will-change: transform, opacity;
    opacity: 0.72;
    pointer-events: none;
  }

  .lifestyle-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 92%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 92%);
    filter: brightness(0.85) contrast(1.12);
  }

  .lifestyle-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.25) 0%, rgba(7, 9, 14, 0.72) 80%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(95px);
    opacity: 0.28;
    pointer-events: none;
  }

  .orb-purple {
    top: 20%;
    left: 18%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, var(--accent-purple) 0%, rgba(138, 43, 226, 0) 70%);
  }

  .orb-cyan {
    bottom: 20%;
    right: 15%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--accent-cyan) 0%, rgba(0, 242, 254, 0) 70%);
  }

  .orb-emerald {
    top: 60%;
    left: 45%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, var(--accent-emerald) 0%, rgba(16, 185, 129, 0) 70%);
    opacity: 0.18;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
  }

  /* Official App Brand Icon */
  .valeria-app-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.25rem auto;
  }

  .valeria-brand-icon {
    width: clamp(84px, 12vw, 105px);
    height: auto;
    border-radius: 26px;
    filter: drop-shadow(0 0 35px rgba(168, 85, 247, 0.5)) drop-shadow(0 10px 25px rgba(0, 0, 0, 0.6));
    border: 2px solid rgba(168, 85, 247, 0.45);
    background: #0f172a;
    transition: transform 0.3s ease;
    animation: subtleFloat 4s ease-in-out infinite alternate;
  }

  @keyframes subtleFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  /* Sutil indicador de inicio abajo (desaparece con el scroll) */
  .hero-scroll-starter {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 8;
    will-change: opacity;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .starter-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* Editorial Tracker */
  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-purple);
    transition: width 0.1s linear;
  }

  /* Phase Panels */
  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 960px;
    margin: 0 auto;
  }

  .max-w-showcase {
    max-width: 1100px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .eyebrow-purple {
    color: #D8B4FE;
  }

  .eyebrow-cyan {
    color: var(--accent-cyan);
  }

  .eyebrow-emerald {
    color: var(--accent-emerald);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-purple);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-purple);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(168, 85, 247, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
  }

  .hero-headline {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.5rem;
  }

  .gradient-text-purple {
    background: linear-gradient(135deg, #FFFFFF 20%, #C084FC 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-cyan {
    background: linear-gradient(135deg, #FFFFFF 20%, var(--accent-cyan) 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .quote-tagline-purple {
    background: linear-gradient(135deg, #D8B4FE 0%, #A855F7 50%, #00F2FE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-narrative-lead {
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 auto 2.25rem auto;
    font-weight: 400;
  }

  .hero-narrative-lead strong {
    color: var(--text-main);
  }

  /* Badge Pill Row */
  .hero-badge-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge-pill {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #D8B4FE;
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  .pill-amber {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #FCD34D;
  }

  /* Phase 1 Showcase Grid */
  .valeria-showcase-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 1.5rem;
    text-align: left;
  }

  .showcase-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .valeria-feature-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s ease;
  }

  .valeria-feature-card:hover {
    transform: translateX(4px);
    border-color: rgba(168, 85, 247, 0.4);
  }

  .feature-icon-badge {
    font-size: 1.75rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
