---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- Centered High-Impact Hero for Valeria+ (Minimalist, Clean, Perfectly Centered) -->
<section id="valeria-hero" class="hero-native-section">
  <!-- Subtle Ambient Backdrop Glows (No Distracting Wallpaper) -->
  <div class="hero-backdrop-layer" aria-hidden="true">
    <div class="ambient-glow glow-purple"></div>
    <div class="ambient-glow glow-cyan"></div>
    <div class="ambient-glow glow-emerald"></div>
    <div class="hero-grid-overlay"></div>
  </div>

  <div class="container hero-container">
    <!-- Centered Institutional Badges Strip -->
    <div class="hero-badges-row" aria-label="Acreditaciones y sellos de calidad">
      <span class="hero-badge badge-starttic">
        <span class="badge-icon">🚀</span>
        <span><strong>startTIC</strong> · Alta Tecnología</span>
      </span>
      <span class="hero-badge badge-itemas">
        <span class="badge-icon">🩺</span>
        <span><strong>ITEMAS-ISCIII 2024</strong></span>
      </span>
      <span class="hero-badge badge-offline">
        <span class="badge-icon">🔒</span>
        <span><strong>100% Offline</strong> · Zero-PHI</span>
      </span>
      <span class="hero-badge badge-mdr">
        <span class="badge-icon">⚖️</span>
        <span><strong>Marco MDR</strong> · Control Adulto</span>
      </span>
    </div>

    <!-- Centered Main Editorial Content (Text and Mockup) -->
    <div class="hero-main-content">
      <!-- Big Title -->
      <h1 class="hero-title">
        Rehabilitación del lenguaje en casa: <span class="gradient-text-purple">la familia acompaña, Lúa refuerza</span>
      </h1>

      <!-- Visual Showcase: Clean Phone Device Mockup placed directly below the title -->
      <div class="hero-showcase-center">
        <div class="device-mockup">
          <div class="device-notch"></div>
          <div class="device-screen">
            <img 
              src={`${baseUrl}/assets/valeria-screen-bienvenida.png`} 
              alt="Pantalla de Bienvenida de Valeria+ v14 con la mascota Lúa" 
              class="device-screen-img"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <p class="hero-lead">
        Ejercicios de estimulación estructurada para dificultades del habla, hipoacusia, TEA y dislexia. Formación previa para los padres (Academy) y rehabilitación centrada en prácticas lúdicas en <strong>10 bloques</strong> 100% offline y siempre bajo control del adulto.
      </p>

      <!-- Centered Actions -->
      <div class="hero-actions-row">
        <a 
          href="https://play.google.com/store/apps/details?id=eu.futureforkids.valeria" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-playstore"
          aria-label="Descargar Valeria+ en Google Play Store"
        >
          <svg class="play-svg-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186A2.02 2.02 0 0 1 3.39 21.8C3.14 21.28 3 20.67 3 19.98V4.02c0-.69.14-1.3.39-1.82.065-.137.14-.268.219-.386z" fill="#00D2FF"/>
            <path d="M17.472 8.448L5.037.824 13.792 12l3.68-3.552z" fill="#00E676"/>
            <path d="M17.472 15.552L13.792 12 5.037 23.176l12.435-7.624z" fill="#FF5252"/>
            <path d="M20.803 10.428l-3.331-2.043-3.68 3.615 3.68 3.552 3.331-2.043c.96-.588.96-2.493 0-3.081z" fill="#FFD600"/>
          </svg>
          <span class="btn-play-content">
            <span class="btn-play-sub">DISPONIBLE EN</span>
            <span class="btn-play-main">Google Play</span>
          </span>
        </a>

        <a href="#bloques-clinicos" class="btn-primary">
          <span>Explorar 10 Bloques</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </a>

        <a href="#metodo" class="btn-secondary">
          <span>El Método</span>
        </a>

        <a href={`${baseUrl}/lua`} class="btn-pill-link">
          <span>🐱 Lúa</span>
        </a>
      </div>

      <!-- Centered KPI Metrics Strip -->
      <div class="hero-kpi-strip" aria-label="Cifras clave del proyecto">
        <div class="kpi-item">
          <span class="kpi-num">10</span>
          <span class="kpi-label">Bloques Clínicos</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">4.711</span>
          <span class="kpi-label">Locuciones Offline</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">6</span>
          <span class="kpi-label">Variedades de Voz</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">Zero-PHI</span>
          <span class="kpi-label">Privacidad Total</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-native-section {
    position: relative;
    padding-top: 110px;
    padding-bottom: 70px;
    overflow: hidden;
    background-color: var(--bg-dark);
  }

  .hero-backdrop-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.3;
  }

  .glow-purple {
    top: 5%;
    left: 25%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, transparent 70%);
  }

  .glow-cyan {
    top: 12%;
    right: 20%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.18) 0%, transparent 70%);
  }

  .glow-emerald {
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.12) 0%, transparent 70%);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at 50% 40%, black 25%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, black 25%, transparent 80%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.25rem;
  }

  /* Centered Badges Strip */
  .hero-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(8px);
  }

  .hero-badge strong {
    color: var(--text-main);
  }

  .badge-starttic {
    border-color: rgba(0, 242, 254, 0.3);
    background: rgba(0, 242, 254, 0.06);
  }

  .badge-itemas {
    border-color: rgba(168, 85, 247, 0.3);
    background: rgba(168, 85, 247, 0.06);
  }

  .badge-offline {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.06);
  }

  .badge-mdr {
    border-color: rgba(245, 158, 11, 0.3);
    background: rgba(245, 158, 11, 0.06);
  }

  /* Centered Main Content */
  .hero-main-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }

  /* Headings */
  .hero-title {
    font-size: clamp(2.1rem, 4.6vw, 3.35rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.03em;
    color: var(--text-main);
    text-align: center;
    margin: 0 auto 1rem auto;
    max-width: 920px;
  }

  .gradient-text-purple {
    background: linear-gradient(135deg, #C084FC 0%, #00F2FE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    color: var(--text-muted);
    text-align: center;
    max-width: 740px;
    margin: 0 auto 1.75rem auto;
  }

  .hero-lead strong {
    color: var(--text-main);
  }

  /* Centered Actions Row */
  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0 auto 2rem auto;
  }

  /* Play Store Hero Button */
  .btn-playstore {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 1.25rem;
    border-radius: 14px;
    background: #090D16;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45), 0 0 16px rgba(0, 242, 254, 0.15);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-playstore:hover {
    border-color: rgba(0, 242, 254, 0.65);
    background: #0D1322;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55), 0 0 28px rgba(0, 242, 254, 0.3);
  }

  .play-svg-icon {
    flex-shrink: 0;
  }

  .btn-play-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    line-height: 1.15;
  }

  .btn-play-sub {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .btn-play-main {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .btn-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.4rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fdba74;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-pill-link:hover {
    background: rgba(249, 115, 22, 0.22);
    border-color: rgba(249, 115, 22, 0.6);
    color: #fff;
    transform: translateY(-2px);
  }

  /* Centered KPI Strip */
  .hero-kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 1.25rem 1.75rem;
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(12px);
  }

  .kpi-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.2rem;
  }

  .kpi-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-cyan);
    letter-spacing: -0.02em;
  }

  .kpi-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
  }

  /* Centered Showcase Mockup placed directly below title */
  .hero-showcase-center {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 0.5rem auto 1.5rem auto;
  }

  .device-mockup {
    position: relative;
    width: 170px;
    padding: 6px;
    border-radius: 24px;
    background: #0D131F;
    border: 2px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 12px 32px -6px rgba(0, 0, 0, 0.7), 0 0 28px rgba(168, 85, 247, 0.16);
    margin: 0 auto;
  }

  .device-notch {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 8px;
    border-radius: var(--radius-full);
    background: #05080E;
    z-index: 2;
  }

  .device-screen {
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: #07090E;
  }

  .device-screen-img {
    width: 100%;
    height: auto;
    aspect-ratio: 460 / 1024;
    object-fit: cover;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .hero-native-section {
      padding-top: 105px;
      padding-bottom: 50px;
    }

    .hero-container {
      gap: 1.75rem;
    }

    .hero-title {
      font-size: clamp(1.85rem, 5.5vw, 2.5rem);
    }
  }

  @media (max-width: 640px) {
    .hero-native-section {
      padding-top: 96px;
      padding-bottom: 45px;
    }

    .hero-badges-strip {
      gap: 0.4rem;
    }

    .hero-badge {
      font-size: 0.72rem;
      padding: 0.28rem 0.65rem;
    }

    .hero-title {
      font-size: clamp(1.65rem, 7vw, 2.1rem);
      line-height: 1.2;
    }

    .hero-lead {
      font-size: 0.925rem;
      line-height: 1.55;
      margin-bottom: 1.5rem;
      padding: 0 0.25rem;
    }

    .hero-actions-row {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.7rem;
      margin-bottom: 1.75rem;
    }

    .hero-actions-row .btn-playstore,
    .hero-actions-row .btn-primary,
    .hero-actions-row .btn-secondary,
    .hero-actions-row .btn-pill-link {
      width: 100%;
      justify-content: center;
      min-height: 48px;
    }

    .hero-kpi-strip {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding: 0.9rem 0.75rem;
      border-radius: var(--radius-md);
    }

    .kpi-num {
      font-size: 1.45rem;
    }

    .kpi-label {
      font-size: 0.7rem;
    }

    .hero-showcase-center {
      margin: 0.35rem auto 1.25rem auto;
    }

    .device-mockup {
      width: min(150px, 52vw);
      padding: 5px;
      border-radius: 20px;
    }

    .device-notch {
      width: 34px;
      height: 7px;
      top: 7px;
    }

    .device-screen {
      border-radius: 15px;
    }
  }

  @media (max-width: 380px) {
    .hero-badges-strip {
      gap: 0.3rem;
    }

    .hero-badge {
      font-size: 0.68rem;
      padding: 0.25rem 0.5rem;
    }

    .device-mockup {
      width: min(135px, 56vw);
    }
  }
</style>
