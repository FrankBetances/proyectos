---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- Native Flow High-Performance Hero for Valeria+ (Zero Scroll Hijacking, LCP < 0.8s, CLS = 0) -->
<section id="valeria-hero" class="hero-native-section">
  <!-- Ambient Backdrop with Visual Metaphor & Glows -->
  <div class="hero-backdrop-layer" aria-hidden="true">
    <div class="ambient-glow glow-purple"></div>
    <div class="ambient-glow glow-cyan"></div>
    <div class="ambient-glow glow-emerald"></div>

    <div class="backdrop-artwork-wrapper">
      <img 
        src={`${baseUrl}/assets/valeria-lua-hero-bg.jpg`} 
        alt="Entorno de estimulación de Valeria+ con dispositivo de Lúa y apoyo familiar en el hogar" 
        class="backdrop-artwork-img"
        width="1376"
        height="768"
        loading="eager"
        fetchpriority="high"
      />
      <div class="backdrop-gradient-mask"></div>
    </div>

    <div class="hero-grid-overlay"></div>
  </div>

  <div class="container hero-container">
    <!-- Institutional Badges Strip -->
    <div class="hero-badges-row" aria-label="Acreditaciones y sellos de calidad">
      <span class="hero-badge badge-starttic">
        <span class="badge-icon">🚀</span>
        <span><strong>startTIC</strong> · Alta Tecnología</span>
      </span>
      <span class="hero-badge badge-itemas">
        <span class="badge-icon">🩺</span>
        <span><strong>Sello ITEMAS-ISCIII 2024</strong></span>
      </span>
      <span class="hero-badge badge-offline">
        <span class="badge-icon">🔒</span>
        <span><strong>100% Offline</strong> · Zero-PHI</span>
      </span>
      <span class="hero-badge badge-mdr">
        <span class="badge-icon">⚖️</span>
        <span><strong>Marco MDR</strong> · Control Adulto</span>
      </span>
    </div>

    <!-- Main Editorial Content -->
    <div class="hero-main-content">
      <div class="hero-brand-header">
        <div class="brand-avatar-box">
          <img 
            src={`${baseUrl}/assets/valeria_lua.png`} 
            alt="Logotipo de Valeria+ con la gata Lúa en píxel art" 
            class="brand-lua-avatar"
            width="88"
            height="88"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="brand-eyebrow">
          <span class="eyebrow-pill">PLATAFORMA PEDIÁTRICA V14.2</span>
          <span class="eyebrow-sub">Dr. Frank Betances · ORL Pediátrico</span>
        </div>
      </div>

      <h1 class="hero-title">
        Rehabilitación del lenguaje en casa: <span class="gradient-text-purple">la familia acompaña, Lúa refuerza</span>
      </h1>

      <p class="hero-lead">
        Apoyo clínico estructurado para niñas y niños con dificultades del habla, hipoacusia, implante coclear, dislalia, TEA o dislexia. Formación parental en <strong>2 minutos (Academy)</strong> y práctica lúdica en <strong>10 bloques clínicos</strong> bajo control del adulto (MDR Clase I).
      </p>

      <!-- KPI Metrics Strip -->
      <div class="hero-kpi-strip" aria-label="Cifras clave del proyecto">
        <div class="kpi-item">
          <span class="kpi-num">10</span>
          <span class="kpi-label">Bloques Clínicos</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">4.711</span>
          <span class="kpi-label">Locuciones Offline</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">6</span>
          <span class="kpi-label">Variedades de Voz</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-num">100%</span>
          <span class="kpi-label">Cero Nube / Zero-PHI</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions-row">
        <a href="#bloques-clinicos" class="btn-primary">
          <span>Explorar los 10 Bloques</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <a href="#academy" class="btn-secondary">
          <span>Formación Academy</span>
        </a>
        <a href="#lua-mascota" class="btn-pill-link">
          <span>🐱 Mascota Lúa</span>
        </a>
      </div>
    </div>

    <!-- Visual Showcase: App Preview & 3 Strategic Cards -->
    <div class="hero-showcase-grid">
      <!-- Left: 3 Quick Focus Cards -->
      <div class="showcase-cards">
        <div class="focus-card">
          <div class="focus-icon icon-cyan">🎧</div>
          <div class="focus-content">
            <h4>Integración Sensorial SOR</h4>
            <p>11 sonidos cotidianos para desensibilización acústica progresiva. Pausar siempre suma puntos.</p>
          </div>
        </div>

        <div class="focus-card">
          <div class="focus-icon icon-purple">🐱</div>
          <div class="focus-content">
            <h4>Gamificación Respetuosa</h4>
            <p>Lúa en píxel art (12 niveles, 18 insignias), descanso visual 20-20-20 y cero castigos.</p>
          </div>
        </div>

        <div class="focus-card">
          <div class="focus-icon icon-emerald">🎯</div>
          <div class="focus-content">
            <h4>Realidad Aumentada 3D</h4>
            <p>Cámara frontal como sensor motor con micrófono apagado (ARCore + MediaPipe + Filament).</p>
          </div>
        </div>
      </div>

      <!-- Right: Phone Device Mockup -->
      <div class="showcase-device-col">
        <div class="device-mockup">
          <div class="device-notch"></div>
          <div class="device-screen">
            <img 
              id="hero-phone-img"
              src={`${baseUrl}/assets/valeria-screen-bienvenida.png`} 
              alt="Pantalla de Bienvenida de Valeria+ v14 con la mascota Lúa" 
              class="device-screen-img"
              width="460"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="device-caption">
            <span id="hero-phone-caption" class="caption-chip">Pantalla de Inicio · Valeria+ v14</span>
          </div>
          <div class="device-tabs" role="tablist" aria-label="Capturas de pantalla de Valeria+">
            <button 
              type="button" 
              role="tab" 
              aria-selected="true" 
              class="device-tab-btn active" 
              data-src={`${baseUrl}/assets/valeria-screen-bienvenida.png`}
              data-alt="Pantalla de Bienvenida de Valeria+ v14 con la mascota Lúa"
              data-caption="Pantalla de Inicio · Valeria+ v14"
            >
              Inicio
            </button>
            <button 
              type="button" 
              role="tab" 
              aria-selected="false" 
              class="device-tab-btn" 
              data-src={`${baseUrl}/assets/valeria-screen-academy.png`}
              data-alt="Pestaña de Formación Academy en Valeria+ v14"
              data-caption="1.º Formación · Academy en 2 min"
            >
              Academy
            </button>
            <button 
              type="button" 
              role="tab" 
              aria-selected="false" 
              class="device-tab-btn" 
              data-src={`${baseUrl}/assets/valeria-screen-conoce-lua.png`}
              data-alt="Pantalla Conoce a Lúa y Pacientes en Valeria+ v14"
              data-caption="Mascota Lúa & Dispositivo Físico"
            >
              Lúa
            </button>
            <button 
              type="button" 
              role="tab" 
              aria-selected="false" 
              class="device-tab-btn" 
              data-src={`${baseUrl}/assets/valeria-screen-creditos.png`}
              data-alt="Créditos y Avales Clínicos en Valeria+ v14 (ITEMAS, ACOPROS)"
              data-caption="Avales Clínicos · ITEMAS & ACOPROS"
            >
              Avales
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-native-section {
    position: relative;
    padding-top: 110px;
    padding-bottom: 70px;
    overflow: hidden;
    background-color: var(--bg-dark);
  }

  .hero-backdrop-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .backdrop-artwork-wrapper {
    position: absolute;
    top: 0;
    right: 0;
    width: 65%;
    height: 90%;
    opacity: 0.28;
    mask-image: radial-gradient(circle at 60% 30%, black 15%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 60% 30%, black 15%, transparent 75%);
  }

  .backdrop-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .backdrop-gradient-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 9, 14, 0.2) 0%, rgba(7, 9, 14, 0.95) 100%);
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }

  .glow-purple {
    top: 5%;
    left: 10%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.25) 0%, transparent 70%);
  }

  .glow-cyan {
    top: 20%;
    right: 5%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.2) 0%, transparent 70%);
  }

  .glow-emerald {
    bottom: 0;
    left: 35%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 85%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Badges Strip */
  .hero-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(8px);
  }

  .hero-badge strong {
    color: var(--text-main);
  }

  .badge-starttic {
    border-color: rgba(0, 242, 254, 0.3);
    background: rgba(0, 242, 254, 0.06);
  }

  .badge-itemas {
    border-color: rgba(168, 85, 247, 0.3);
    background: rgba(168, 85, 247, 0.06);
  }

  .badge-offline {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.06);
  }

  .badge-mdr {
    border-color: rgba(245, 158, 11, 0.3);
    background: rgba(245, 158, 11, 0.06);
  }

  /* Brand Header */
  .hero-brand-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .brand-avatar-box {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.25) 0%, rgba(15, 23, 42, 0.8) 100%);
    border: 1.5px solid rgba(168, 85, 247, 0.5);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .brand-lua-avatar {
    width: 58px;
    height: 58px;
    image-rendering: pixelated;
    object-fit: contain;
  }

  .brand-eyebrow {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .eyebrow-pill {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .eyebrow-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Headings */
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-main);
    max-width: 960px;
    margin-bottom: 1.25rem;
  }

  .gradient-text-purple {
    background: linear-gradient(135deg, #C084FC 0%, #00F2FE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 820px;
    margin-bottom: 1.75rem;
  }

  .hero-lead strong {
    color: var(--text-main);
  }

  /* KPI Strip */
  .hero-kpi-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    max-width: 760px;
    margin-bottom: 2rem;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(12px);
  }

  .kpi-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .kpi-num {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent-cyan);
    letter-spacing: -0.02em;
  }

  .kpi-label {
    font-size: 0.78rem;
    color: var(--text-dim);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Actions Row */
  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.4rem;
    border-radius: var(--radius-full);
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fdba74;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-pill-link:hover {
    background: rgba(249, 115, 22, 0.22);
    border-color: rgba(249, 115, 22, 0.6);
    color: #fff;
    transform: translateY(-2px);
  }

  /* Showcase Grid */
  .hero-showcase-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }

  .showcase-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .focus-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
  }

  .focus-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(15, 23, 42, 0.8);
  }

  .focus-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .focus-icon.icon-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .focus-icon.icon-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
  }

  .focus-icon.icon-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .focus-content h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .focus-content p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Phone Mockup */
  .showcase-device-col {
    display: flex;
    justify-content: center;
  }

  .device-mockup {
    position: relative;
    width: 280px;
    padding: 10px;
    border-radius: 36px;
    background: #0D131F;
    border: 3px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 20px 60px -10px rgba(0, 0, 0, 0.7), 0 0 40px rgba(168, 85, 247, 0.15);
  }

  .device-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 14px;
    border-radius: var(--radius-full);
    background: #05080E;
    z-index: 2;
  }

  .device-screen {
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    background: #07090E;
  }

  .device-screen-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .device-caption {
    margin-top: 0.75rem;
    text-align: center;
  }

  .caption-chip {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .device-tabs {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.8rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .device-tab-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .device-tab-btn:hover {
    background: rgba(0, 242, 254, 0.12);
    border-color: rgba(0, 242, 254, 0.3);
    color: var(--text-main);
  }

  .device-tab-btn.active {
    background: rgba(0, 242, 254, 0.2);
    border-color: var(--accent-cyan);
    color: #fff;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.3);
  }

  .device-tab-btn:focus-visible {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 2px;
  }

  @media (max-width: 960px) {
    .hero-showcase-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .backdrop-artwork-wrapper {
      width: 100%;
      opacity: 0.18;
    }
  }

  @media (max-width: 640px) {
    .hero-native-section {
      padding-top: 90px;
    }

    .hero-kpi-strip {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .device-mockup {
      width: 240px;
    }
  }
</style>

<script>
  function setupHeroPhoneSwitcher() {
    const phoneImg = document.getElementById('hero-phone-img') as HTMLImageElement | null;
    const captionSpan = document.getElementById('hero-phone-caption');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.device-tab-btn');

    if (!phoneImg || !captionSpan || tabs.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const newSrc = tab.getAttribute('data-src');
        const newAlt = tab.getAttribute('data-alt');
        const newCaption = tab.getAttribute('data-caption');

        if (newSrc) phoneImg.src = newSrc;
        if (newAlt) phoneImg.alt = newAlt;
        if (newCaption) captionSpan.textContent = newCaption;
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroPhoneSwitcher);
  } else {
    setupHeroPhoneSwitcher();
  }
</script>
