---
import EarlifyValidation from './earlify/EarlifyValidation.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section for Valeria+ inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="valeria-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Lifestyle Backdrop Graphic with Parallax -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div id="v-hero-bg-stage" class="hero-lifestyle-bg-stage">
        <img 
          src={`${baseUrl}/assets/valeria-lua-hero-bg.jpg?v=1`} 
          alt="Dispositivo interactivo de Lúa con pantalla circular mostrando a la gata Lúa en pixel art sobre mesa de madera, con adulto y niño celebrando con choque de manos" 
          class="lifestyle-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="lifestyle-overlay-gradient"></div>
      </div>
      <div class="glow-orb orb-purple"></div>
      <div class="glow-orb orb-cyan"></div>
      <div class="glow-orb orb-emerald"></div>
      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line, invisible at 0 scroll) -->
    <div class="hero-editorial-tracker" id="v-tracker" aria-hidden="true">
      <div class="tracker-segment" id="v-track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="v-fill-0"></div></div><span>Entender & Acompañar</span></div>
      <div class="tracker-segment" id="v-track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="v-fill-1"></div></div><span>9 Bloques & RA</span></div>
      <div class="tracker-segment" id="v-track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="v-fill-2"></div></div><span>Lúa & Academy</span></div>
    </div>

    <!-- Sutil indicador de ratón inicial abajo (desaparece al hacer scroll) -->
    <div id="v-scroll-starter" class="hero-scroll-starter" aria-hidden="true">
      <span class="starter-text">Scroll para explorar</span>
      <div class="hint-mouse">
        <div class="mouse-wheel"></div>
      </div>
    </div>

    <!-- PHASE 0: El Principio Clínico & El Muro MDR (Carga inmediata a scroll 0) -->
    <div id="v-phase-0" class="hero-phase-panel phase-initial">
      <div class="phase-inner max-w-content">
        <!-- Official Valeria+ App Icon with Lua Mascot -->
        <div class="valeria-app-icon-wrapper">
          <img 
            src={`${baseUrl}/assets/valeria_lua.png`} 
            alt="Logo Oficial de Valeria+ con la Mascota Lúa" 
            class="valeria-brand-icon" 
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <h1 class="hero-headline">
          Rehabilitación del lenguaje guiada en casa: <span class="gradient-text-purple">la familia acompaña, Lúa refuerza</span>
        </h1>

        <p class="hero-narrative-lead">
          Diseñada para madres, padres y cuidadores de niñas y niños con dificultades del habla, hipoacusia, implante coclear, dislalias, TEA o dislexia. 
          <strong>Primero forma</strong> con cápsulas de 2 minutos (Academy) y <strong>después facilita la práctica en casa</strong> en 9 bloques interactivos, 100% offline y bajo control del adulto (marco MDR).
        </p>

        <div class="hero-badge-pill-row">
          <span class="badge-pill pill-purple">🎓 Formación Academy + 9 Bloques</span>
          <span class="badge-pill pill-cyan">🔒 100% Offline & Privacidad Total</span>
          <span class="badge-pill pill-emerald">🐱 Mascota Lúa & Gamificación</span>
          <span class="badge-pill pill-amber">🚀 Incubadora startTIC (Zona Franca / Gradiant)</span>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Los 9 Bloques Clínicos & Realidad Aumentada 3D (38% - 70% Scroll) -->
    <div id="v-phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Intervención Estructurada y Amable</span>
        </div>
        <h2 class="hero-headline text-gradient-cyan">
          9 Bloques de ejercicios prácticos con rigor clínico.
        </h2>

        <div class="valeria-showcase-grid">
          <!-- Left: Clinical Cards -->
          <div class="showcase-cards-col">
            <div class="valeria-feature-card">
              <div class="feature-icon-badge icon-cyan">🎧</div>
              <div class="feature-text">
                <strong>Integración Sensorial SOR (11 Sonidos)</strong>
                <p>Desensibilización para niños sensibles al ruido (aspiradora, secador, aula). Muro de control adulto.</p>
              </div>
            </div>

            <div class="valeria-feature-card">
              <div class="feature-icon-badge icon-purple">🗣️</div>
              <div class="feature-text">
                <strong>Pares Mínimos & Pizarra Mágica</strong>
                <p>Dislalias fonológicas (rana/lana) y trazado guiado numerado para evitar inversiones b/d y p/q.</p>
              </div>
            </div>

            <div class="valeria-feature-card">
              <div class="feature-icon-badge icon-emerald">🎯</div>
              <div class="feature-text">
                <strong>Realidad Aumentada 3D (ARCore + MediaPipe)</strong>
                <p>Cámara frontal como sensor de movimiento de boca y cabeza con micrófono apagado: refuerzo 3D por el gesto motor.</p>
              </div>
            </div>
          </div>

          <!-- Right: Interactive Phone Preview Mockup -->
          <div class="showcase-phone-col">
            <div class="phone-frame-mockup">
              <div class="phone-status-bar">
                <div class="phone-notch"></div>
              </div>
              <div class="phone-screen-content">
                <img 
                  src={`${baseUrl}/assets/05-hub-bloques.png`} 
                  alt="Pantalla de Hub de Bloques de Valeria+ v14" 
                  class="phone-screen-img" 
                  loading="lazy" 
                />
                <div class="phone-screen-overlay">
                  <span class="screen-pill">Hub de 9 Bloques</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: Mascota Lúa, Evidencia & Descarga (75% - 100% Scroll) -->
    <div id="v-phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Acompañamiento Afectivo & Evidencia Empírica</span>
        </div>
        <h2 class="hero-headline gradient-text-emerald">
          La Mascota Lúa, Academy LSE y Respaldo Asistencial.
        </h2>

        <div class="valeria-dual-showcase">
          <!-- Col 1: Lúa & Academy -->
          <div class="valeria-info-card glass-card">
            <div class="card-accent-tag text-purple">🐱 Mascota Lúa & Formación Academy</div>
            <h3>Jugar sin castigos y aprender a acompañar</h3>
            <p>
              Lúa acompaña en píxel art con 12 niveles, armario coleccionable y descansos visuales 20-20-20. Formación en 7 dominios con La Brújula ASHA (hitos 0-5 años) y 27 gestos en Lengua de Signos (LSE).
            </p>
            <div class="card-mini-badges">
              <span class="mini-tag">🐱 Lúa Píxel Art</span>
              <span class="mini-tag">🧭 Brújula ASHA</span>
              <span class="mini-tag">🤟 27 Gestos LSE</span>
              <span class="mini-tag">🌍 6 Variedades</span>
            </div>
          </div>

          <!-- Col 2: Evidencia & Avales -->
          <div class="valeria-info-card glass-card">
            <div class="card-accent-tag text-cyan">🩺 Validación Médica</div>
            <h3>Sellos de Calidad e Innovación</h3>
            <p>
              Premio Ennova Health 2025 y 2023, Sello de Calidad ITEMAS-ISCIII 2024, 1.er Premio SERGAS y co-desarrollo con ACOPROS y la Sociedad Gallega de Otorrinolaringología (SGORL).
            </p>
            <div class="card-action-row">
              <a href={`${baseUrl}/earlify`} class="hero-btn btn-purple">
                <span>Ecosistema Earlify</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
              <a href={`${baseUrl}/via`} class="hero-btn btn-ghost">
                <span>Conoce VIA+ (SaMD)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initValeriaHero() {
    const heroSection = document.getElementById('valeria-hero-scrub');
    const scrollStarter = document.getElementById('v-scroll-starter');
    const tracker = document.getElementById('v-tracker');
    const fill0 = document.getElementById('v-fill-0');
    const fill1 = document.getElementById('v-fill-1');
    const fill2 = document.getElementById('v-fill-2');
    const phase0 = document.getElementById('v-phase-0');
    const phase1 = document.getElementById('v-phase-1');
    const phase2 = document.getElementById('v-phase-2');
    const bgStage = document.getElementById('v-hero-bg-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    function calcOpacity(progress: number, fadeInStart: number, fadeInEnd: number, fadeOutStart: number, fadeOutEnd: number) {
      if (progress < fadeInStart) return 0;
      if (progress < fadeInEnd) {
        return fadeInStart === fadeInEnd ? 1 : (progress - fadeInStart) / (fadeInEnd - fadeInStart);
      }
      if (progress <= fadeOutStart) return 1;
      if (progress < fadeOutEnd) {
        return 1 - (progress - fadeOutStart) / (fadeOutEnd - fadeOutStart);
      }
      return 0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      } else {
        targetProgress = 0;
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      currentProgress += (targetProgress - currentProgress) * 0.18;

      const opStarter = calcOpacity(targetProgress, 0.0, 0.0, 0.03, 0.08);
      if (scrollStarter) {
        scrollStarter.style.opacity = opStarter.toFixed(3);
        scrollStarter.style.pointerEvents = opStarter > 0.4 ? 'auto' : 'none';
      }

      const op0 = calcOpacity(targetProgress, 0.0, 0.0, 0.20, 0.35);
      const op1 = calcOpacity(targetProgress, 0.30, 0.40, 0.65, 0.74);
      const op2 = calcOpacity(targetProgress, 0.70, 0.80, 1.0, 1.0);

      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${-targetProgress * 35}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.52 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.88 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      if (tracker) {
        tracker.style.opacity = '1';
      }

      if (bgStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const artOpacity = Math.max(0.35, 0.65 - currentProgress * 0.20);
        bgStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        bgStage.style.opacity = artOpacity.toFixed(3);
      }

      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, (targetProgress / 0.34) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.34) / 0.34) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.68) / 0.32) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initValeriaHero);
  } else {
    initValeriaHero();
  }
  document.addEventListener('astro:page-load', initValeriaHero);
</script>

<style>
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    background-color: var(--bg-dark);
  }

  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.28;
    pointer-events: none;
  }

  .orb-purple {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #8A2BE2 0%, rgba(138, 43, 226, 0) 70%);
    top: -100px;
    left: -150px;
  }

  .orb-cyan {
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, #00F2FE 0%, rgba(0, 242, 254, 0) 70%);
    bottom: -100px;
    right: -100px;
  }

  .orb-emerald {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, #10B981 0%, rgba(16, 185, 129, 0) 70%);
    top: 30%;
    left: 45%;
    transform: translate(-50%, -50%);
    opacity: 0.15;
  }

  .hero-lifestyle-bg-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100vh;
    z-index: 2;
    will-change: transform, opacity;
    opacity: 0.65;
  }

  .lifestyle-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    filter: brightness(0.85) contrast(1.08) saturate(1.15);
  }

  .lifestyle-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.25) 0%, rgba(7, 9, 14, 0.8) 75%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    z-index: 3;
  }

  .valeria-app-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.25rem auto;
  }

  .valeria-brand-icon {
    width: 100px;
    height: 100px;
    border-radius: 24px;
    box-shadow: 0 0 40px rgba(168, 85, 247, 0.45), 0 10px 25px rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.15);
    display: block;
    animation: floatIcon 4s ease-in-out infinite alternate;
  }

  @keyframes floatIcon {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  .hero-scroll-starter {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 8;
    will-change: opacity;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .starter-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .hint-mouse {
    width: 22px;
    height: 36px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
  }

  .mouse-wheel {
    width: 3px;
    height: 7px;
    background: var(--accent-cyan);
    border-radius: 2px;
    animation: scrollAnim 1.8s ease-in-out infinite;
  }

  @keyframes scrollAnim {
    0% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(8px); opacity: 0.4; }
    100% { transform: translateY(0); opacity: 1; }
  }

  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-purple);
    transition: width 0.1s linear;
  }

  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5.5rem 1.5rem 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .hero-phase-panel.phase-initial {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 980px;
    margin: 0 auto;
  }

  .max-w-showcase {
    max-width: 1100px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .eyebrow-cyan { color: var(--accent-cyan); }
  .eyebrow-emerald { color: var(--accent-emerald); }

  .hero-headline {
    font-size: clamp(2.1rem, 4.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .gradient-text-purple {
    background: linear-gradient(135deg, #FFFFFF 20%, #C084FC 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-cyan {
    background: linear-gradient(135deg, #FFFFFF 20%, var(--accent-cyan) 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .gradient-text-emerald {
    background: linear-gradient(135deg, #FFFFFF 20%, #34D399 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-narrative-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 auto 1.75rem auto;
    font-weight: 400;
  }

  .hero-narrative-lead strong {
    color: var(--text-main);
  }

  /* Badge Pill Row */
  .hero-badge-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge-pill {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #D8B4FE;
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  .pill-amber {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #FCD34D;
  }

  /* Phase 1 Showcase Grid */
  .valeria-showcase-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 1.5rem;
    text-align: left;
  }

  .showcase-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .valeria-feature-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .valeria-feature-card:hover {
    transform: translateX(4px);
    border-color: rgba(0, 242, 254, 0.3);
  }

  .feature-icon-badge {
    font-size: 1.6rem;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-cyan {
    background: rgba(0, 242, 254, 0.15);
    border: 1px solid rgba(0, 242, 254, 0.4);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .icon-emerald {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .feature-text strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .feature-text p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.45;
  }

