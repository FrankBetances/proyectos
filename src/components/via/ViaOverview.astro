---
const domains = [
  {
    title: "Audiología Pediátrica",
    desc: "Tamizaje auditivo, audiometría tonal liminar guiada por algoritmo Hughson-Westlake y audiometría condicionada por refuerzo lúdico («El Tren del Sonido»).",
    iconType: "audio",
    badge: "Vía Aérea 250–4000 Hz"
  },
  {
    title: "Logopedia, Voz & Lenguaje",
    desc: "Logoaudiometría verbal en campo libre, análisis acústico de voz sostenida (/a/) validado contra Praat, articulación fonética T.A.R. (SODA), prosodia y cribado normativo de hitos ASHA (0 a 5 años).",
    iconType: "voice",
    badge: "Biomarcadores & Hitos ASHA"
  },
  {
    title: "Neurodesarrollo & Conducta",
    desc: "Cribado de autismo M-CHAT-R/F (16–30 meses), detección de trastornos respiratorios del sueño SAHS (PSQ de Chervin) y 5 mini-juegos para funciones ejecutivas.",
    iconType: "neuro",
    badge: "Evaluación Gamificada"
  },
  {
    title: "Deglución & Disfagia",
    desc: "Método de Exploración Clínica Volumen-Viscosidad (MECV-V) con pulsioxímetro BLE para monitorización continua y detección inmediata de desaturación de SpO₂ ≥ 3%.",
    iconType: "swallow",
    badge: "Seguridad Deglutoria"
  }
];

const turnkeyFeatures = [
  {
    title: "Estación Clínica Lista para Usar",
    badge: "Llave en Mano",
    desc: "Enciendes y evalúas de inmediato. Sin instalaciones engorrosas ni riesgos de desconfiguración en consulta, con carcasa médica lavable y arranque directo."
  },
  {
    title: "Calibración Acústica de Fábrica",
    badge: "Precisión Objetiva",
    desc: "Ajuste acústico sellado de fábrica para que cada medición auditiva y vocal sea reproducible, objetiva y clínicamente fiable sin depender del criterio subjetivo."
  },
  {
    title: "Informes Clínicos en 30 Segundos",
    badge: "Cero Alucinaciones",
    desc: "Genera automáticamente un borrador completo con las escalas oficiales (BIAP/OMS y ASHA) y cálculo de pérdida, listo para revisar y firmar con tu firma colegiada."
  }
];

const restrictions = [
  { text: "Emitir diagnósticos automatizados sin validación médica", reason: "Requeriría clasificación SaMD Clase III; VIA+ actúa como CDSS de apoyo" },
  { text: "Sustituir el juicio clínico del profesional sanitario", reason: "Herramienta de ayuda a la decisión clínica, nunca de reemplazo facultativo" },
  { text: "Interpretar resultados como patológicos de forma autónoma", reason: "La correlación clínica foniátrica es competencia exclusiva del evaluador" },
  { text: "Recomendar prescripciones terapéuticas o farmacológicas", reason: "Acto médico reservado al profesional sanitario colegiado" },
  { text: "Operar en entornos no supervisados o domésticos", reason: "Diseñado y validado estrictamente para uso profesional en consulta clínica" }
];
---

<section id="que-es-via" class="via-overview section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Definición & Entrega Llave en Mano</span>
      <h2>Estación clínica homologada: <span class="gradient-text">Cuatro áreas de diagnóstico en un solo equipo</span></h2>
      <p>Software como Dispositivo Médico (SaMD Clase IIa) de apoyo a la decisión clínica (CDSS): pruebas objetivas, rigor metodológico y generación automática de informes sin pérdida de tiempo administrativo.</p>
    </div>

    <div class="domains-grid">
      {domains.map((d) => (
        <div class="glass-card domain-card">
          <div class="domain-top">
            <span class="domain-icon">
              {d.iconType === 'audio' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
              )}
              {d.iconType === 'voice' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
              )}
              {d.iconType === 'neuro' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
              )}
              {d.iconType === 'swallow' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
              )}
            </span>
            <span class="badge badge-cyan">{d.badge}</span>
          </div>
          <h3>{d.title}</h3>
          <p>{d.desc}</p>
        </div>
      ))}
    </div>

    <!-- Turnkey COTS & Deterministic NLG Showcase -->
    <div class="glass-card turnkey-box">
      <div class="turnkey-header">
        <span class="badge badge-purple">Arquitectura Clínica Homologada</span>
        <h3>SaMD sobre Hardware Homologado (Llave en Mano) + Motor NLG</h3>
        <p>Resuelve la variabilidad acústica y la seguridad hospitalaria entregando software y estación clínica precalibrada como una unidad indivisible:</p>
      </div>
      <div class="turnkey-grid">
        {turnkeyFeatures.map((tf) => (
          <div class="turnkey-item">
            <span class="badge badge-cyan">{tf.badge}</span>
            <h4>{tf.title}</h4>
            <p>{tf.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Restrictions Section -->
    <div class="glass-card restriction-card">
      <div class="restriction-header">
        <span class="restriction-icon">⛔</span>
        <div>
          <h3>¿Qué NO hace VIA+? (Límites y Principios de Seguridad)</h3>
          <p>Para cumplir con la directiva MDR 2017/745 y garantizar la máxima seguridad del paciente pediátrico:</p>
        </div>
      </div>

      <div class="restrictions-list">
        {restrictions.map((r) => (
          <div class="restriction-item">
            <span class="cross-icon">❌</span>
            <div class="restriction-body">
              <strong>{r.text}</strong>
              <span class="reason-tag">Fundamento: {r.reason}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .via-overview {
    padding: 90px 0;
    position: relative;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .domain-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .domain-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .domain-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .domain-icon {
    font-size: 2rem;
    width: 52px;
    height: 52px;
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .domain-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .domain-card p {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Turnkey Box */
  .turnkey-box {
    padding: 2.5rem;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(8, 47, 73, 0.3) 100%);
    border: 1px solid rgba(0, 242, 254, 0.3);
    border-radius: var(--radius-lg);
    margin-bottom: 3rem;
  }

  .turnkey-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .turnkey-header h3 {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0.75rem 0 0.5rem 0;
  }

  .turnkey-header p {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 780px;
    margin: 0 auto;
  }

  .turnkey-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .turnkey-item {
    background: rgba(2, 6, 23, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .turnkey-item h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
  }

  .turnkey-item p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Restrictions Box */
  .restriction-card {
    padding: 2.5rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-lg);
  }

  .restriction-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .restriction-icon {
    font-size: 2.2rem;
  }

  .restriction-header h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.25rem 0;
    color: var(--text-main);
  }

  .restriction-header p {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin: 0;
  }

  .restrictions-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .restriction-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(2, 6, 23, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .cross-icon {
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .restriction-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .restriction-body strong {
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .reason-tag {
    font-size: 0.84rem;
    color: #f87171;
  }

  @media (max-width: 768px) {
    .via-overview {
      padding: 60px 0;
    }
  }
</style>
