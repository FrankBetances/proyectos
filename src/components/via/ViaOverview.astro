---
const domains = [
  {
    title: "Audiología Pediátrica",
    desc: "Tamizaje auditivo, audiometría tonal liminar guiada por Hughson-Westlake y audiometría condicionada gamificada (El Tren del Sonido).",
    icon: "👂"
  },
  {
    title: "Logopedia y Lenguaje",
    desc: "Logoaudiometría verbal en campo libre, discriminación de fonemas, repetición de palabras y evaluación del criterio SODA (T.A.R.).",
    icon: "🗣️"
  },
  {
    title: "Neurodesarrollo",
    desc: "Cribado de Autismo (M-CHAT-R), SAHS infantil (PSQ de Chervin), test de disfagia MECV-V y exploración de 5 funciones ejecutivas.",
    icon: "🧠"
  }
];

const restrictions = [
  { text: "Emitir diagnósticos automatizados sin validación médica", reason: "Requeriría clasificación SaMD Clase III" },
  { text: "Sustituir el juicio del profesional sanitario", reason: "Diseñado como herramienta de apoyo (CDSS), no de reemplazo" },
  { text: "Interpretar resultados de forma patológica de forma autónoma", reason: "Fuera del alcance validado sin escrutinio clínico" },
  { text: "Recomendar tratamientos farmacológicos o quirúrgicos", reason: "Competencia exclusiva del facultativo graduado" },
  { text: "Funcionar en entornos no supervisados o domésticos", reason: "Diseñado y validado únicamente para uso profesional en clínica" }
];
---

<section id="que-es-via" class="via-overview">
  <div class="container">
    <div class="section-header">
      <span class="tag">Definición & Alcance Clínico</span>
      <h2>¿Qué es <span class="gradient-text">VIA+</span>?</h2>
      <p>Herramienta de apoyo a la decisión clínica (CDSS) que opera sobre tablets iOS/Android bajo la supervisión directa del facultativo.</p>
    </div>

    <div class="domains-grid">
      {domains.map((d) => (
        <div class="glass-card domain-card">
          <span class="domain-icon">{d.icon}</span>
          <h3>{d.title}</h3>
          <p>{d.desc}</p>
        </div>
      ))}
    </div>

    <!-- Restrictions Section -->
    <div class="glass-card restriction-card">
      <div class="restriction-header">
        <span class="restriction-icon">⛔</span>
        <div>
          <h3>¿Qué NO hace VIA+? (Límites Regulatorios)</h3>
          <p>Para cumplir con la directiva MDR 2017/745 y garantizar la máxima seguridad del paciente pediátrico:</p>
        </div>
      </div>

      <div class="restrictions-list">
        {restrictions.map((r) => (
          <div class="restriction-item">
            <span class="cross-icon">❌</span>
            <div class="restriction-body">
              <strong>{r.text}</strong>
              <span class="reason-tag">Fundamento: {r.reason}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .via-overview {
    padding: 90px 0;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .domain-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .domain-icon {
    font-size: 2.2rem;
    width: 56px;
    height: 56px;
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .domain-card h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .domain-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .restriction-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 10, 20, 0.4) 100%);
    border: 1px solid rgba(244, 63, 94, 0.3);
    padding: 2.5rem;
  }

  .restriction-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .restriction-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .restriction-header h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-rose);
    margin-bottom: 0.25rem;
  }

  .restriction-header p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .restrictions-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .restriction-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }

  .cross-icon {
    font-size: 1.1rem;
  }

  .restriction-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .restriction-body strong {
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .reason-tag {
    font-size: 0.825rem;
    color: var(--text-dim);
  }

  @media (max-width: 768px) {
    .restriction-card {
      padding: 1.5rem;
    }
  }
</style>
