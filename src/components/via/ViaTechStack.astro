---
const techItems = [
  { category: "Estación Clínica Homologada", stack: "Tableta médica de 11\" (IP68) llave en mano · Modo Kiosco MDM bloqueado · Carcasa de silicona médica lavable" },
  { category: "Calibración Electroacústica", stack: "Curva de transferencia en cámara anecoica vs sonómetro Clase 1 · Conversión dB SPL ↔ dB HL sellada · Micrófono en modo crudo" },
  { category: "Audio DSP & Sonómetro", stack: "Captura PCM a 48 kHz · Síntesis tonal de baja latencia · Sonómetro en dB(A) con ponderación A (IEC 61672), LAeq y percentiles" },
  { category: "Validación Acústica Praat", stack: "Análisis LPC de orden 20 · Jitter y Shimmer ciclo a ciclo · F0, HNR y formantes F1–F3 contrastados frente a Praat" },
  { category: "Motor NLG Determinista", stack: "Síntesis clínica combinatoria trazable sin IA generativa · Borrador editable supervisado · Firma digital colegiada en PDF" },
  { category: "Voz Neuronal & 7 Lenguas", stack: "421 locuciones pre-sintetizadas (Proxecto Nós, HiTZ, AINA, Quisqueya Habla) · Interfaz reactiva en 7 variedades" },
  { category: "Cifrado & Persistencia Local", stack: "Base de datos relacional local 100% offline · Cifrado en reposo respaldado por hardware · Consentimiento bloqueante" },
  { category: "Sensores BLE & Telemetría", stack: "Pulsioximetría inalámbrica (SpO₂ en MECV-V) · Silencio clínico en periférico Lúa · Telemetría QR Zero-PHI (IEC 62366-1)" }
];
---

<section id="stack-tecnico" class="via-tech section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Arquitectura Embebida de Software Médico</span>
      <h2>Stack Tecnológico & <span class="gradient-text">Herramientas de Build-Time</span></h2>
      <p>Construido con librerías nativas de alto rendimiento optimizadas para procesamiento acústico y sensorial en tiempo real en tablets.</p>
    </div>

    <div class="tech-grid">
      {techItems.map((t) => (
        <div class="glass-card tech-card">
          <span class="tech-cat">{t.category}</span>
          <p class="tech-stack">{t.stack}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .via-tech {
    padding: 90px 0;
    background: rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .tech-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .tech-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.3);
  }

  .tech-cat {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-stack {
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 768px) {
    .via-tech {
      padding: 60px 0;
    }
  }
</style>
