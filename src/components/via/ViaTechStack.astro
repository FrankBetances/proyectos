---
const techItems = [
  { category: "Estación Clínica Lista para Usar", stack: "Tableta médica de 11 pulgadas preconfigurada con inicio directo en la aplicación y carcasa lavable para consulta." },
  { category: "Calibración Acústica de Precisión", stack: "Curva de sonido ajustada de fábrica para asegurar que la audiometría y la grabación vocal sean objetivas." },
  { category: "Procesamiento de Audio en Directo", stack: "Captura de alta fidelidad y control del ruido ambiental para garantizar el silencio antes de evaluar al menor." },
  { category: "Validación frente a Estándares", stack: "Algoritmos acústicos contrastados frente a herramientas de referencia en fonética clínica para máxima fiabilidad." },
  { category: "Motor de Informes Clínicos", stack: "Generación estructurada del documento clínico en segundos, editable en pantalla y listo para firma colegiada." },
  { category: "7 Variedades Lingüísticas", stack: "Audios y estímulos adaptados por especialistas en castellano, galego, euskara, català, dominicano, latam e inglés." },
  { category: "Almacenamiento Local Seguro", stack: "Base de datos cifrada en el propio dispositivo: funciona 100% offline y protege al máximo los datos de salud." },
  { category: "Sensores Médicos Inalámbricos", stack: "Conexión con pulsioxímetro para deglución segura y enlace silencioso con la mascota Lúa sin cables." }
];
---

<section id="stack-tecnico" class="via-tech section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Ingeniería al Servicio de la Clínica</span>
      <h2>Fiabilidad Técnica: <span class="gradient-text">Máximo rendimiento en consulta</span></h2>
      <p>Diseñada para ofrecer velocidad, precisión acústica y estabilidad absoluta sin depender de conexión a internet.</p>
    </div>

    <div class="tech-grid">
      {techItems.map((t) => (
        <div class="glass-card tech-card">
          <span class="tech-cat">{t.category}</span>
          <p class="tech-stack">{t.stack}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .via-tech {
    padding: 90px 0;
    background: rgba(0, 0, 0, 0.2);
    position: relative;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .tech-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .tech-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.3);
  }

  .tech-cat {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-stack {
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 768px) {
    .via-tech {
      padding: 60px 0;
    }
  }
</style>
