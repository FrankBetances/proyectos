---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="via-hero">
  <div class="container">
    <div class="hero-top-badges">
      <span class="badge badge-cyan">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        SaMD Clase IIa · MDR 2017/745 (Regla 11)
      </span>
      <span class="badge badge-purple">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 12 2 2 4-4"/></svg>
        IEC 62304 Clase B · ISO 14971
      </span>
      <span class="badge badge-emerald">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Telemetría Zero-PHI (IEC 62366-1)
      </span>
      <span class="badge badge-amber">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        4 Lenguas (es · gl · eu · es-DO)
      </span>
    </div>

    <!-- Official VIA+ App Icon Logo -->
    <div class="via-app-icon-wrapper">
      <img 
        src={`${baseUrl}/assets/via-logo.png`} 
        alt="Logo Oficial de VIA+ (SaMD IIa)" 
        class="via-app-icon-img" 
        width="96"
        height="96"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <h1 class="hero-title">
      VIA<span class="gradient-text">+</span> · Valoración Interactiva de Audición y Lenguaje
    </h1>

    <p class="hero-subtitle">
      Software como Dispositivo Médico (SaMD) de Clase IIa que actúa como herramienta de <strong>apoyo a la decisión clínica (CDSS)</strong> en consulta médica: 12 módulos de evaluación gamificada, DSP acústico validado contra Praat, operación 100% offline y estricto respeto a la privacidad del menor.
    </p>

    <!-- Clinical Safety Warning Box -->
    <div class="safety-warning-box">
      <div class="warning-header">
        <span class="warning-icon">⚠️</span>
        <strong>AVISO DE SEGURIDAD CLÍNICA OBLIGATORIO</strong>
      </div>
      <p>
        VIA+ es una herramienta de apoyo a la decisión clínica. Bajo ninguna circunstancia emite diagnósticos automatizados ni sustituye el juicio del profesional sanitario. Su uso está estrictamente restringido a entornos clínicos bajo supervisión profesional directa. La interpretación de todos los resultados es responsabilidad exclusiva del facultativo.
      </p>
    </div>

    <div class="hero-actions">
      <a href="#modulos" class="btn-primary">
        <span>12 Módulos Clínicos</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#flujo-clinico" class="btn-secondary">
        <span>Flujo Clínico CAP</span>
      </a>
      <a href="#idiomas-voz" class="btn-secondary">
        <span>4 Lenguas & Voz</span>
      </a>
      <a href="https://github.com/FrankBetances/via" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    <!-- Quick Metrics Strip -->
    <div class="hero-stats-grid">
      <div class="stat-card glass-card">
        <span class="stat-number">12</span>
        <span class="stat-label">Módulos Clínicos Integrados</span>
      </div>
      <div class="stat-card glass-card">
        <span class="stat-number">4</span>
        <span class="stat-label">Lenguas de Sesión con Voz Propia</span>
      </div>
      <div class="stat-card glass-card">
        <span class="stat-number">0 IA</span>
        <span class="stat-label">En Dispositivo (ADR Ratificado)</span>
      </div>
      <div class="stat-card glass-card">
        <span class="stat-number">100%</span>
        <span class="stat-label">Offline-First · Datos Locales</span>
      </div>
    </div>

    <!-- Clean VIA+ Medical Showcase -->
    <div class="via-gallery-grid">
      <div class="phone-card glass-card">
        <div class="card-caption">
          <span class="badge badge-cyan">Módulos de Selección Pediátrica</span>
          <h4>Análisis Vocal & Audiometría Pediátrica (Play Audiometry)</h4>
        </div>
        <img 
          src={`${baseUrl}/assets/via-app-clean.png`} 
          alt="Captura real del módulo clínico de VIA+ SaMD con Análisis Acústico de Voz, Audiometría Infantil y Verbal" 
          class="via-img" 
          width="461"
          height="491"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .via-hero {
    padding-top: 120px;
    padding-bottom: 60px;
    text-align: center;
    background: radial-gradient(circle at 50% 15%, rgba(0, 242, 254, 0.08) 0%, rgba(7, 9, 14, 0) 70%);
  }

  .hero-top-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
  }

  .badge-cyan {
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .badge-purple {
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: var(--accent-purple);
  }

  .badge-emerald {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  .badge-amber {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--accent-amber);
  }

  .via-app-icon-wrapper {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .via-app-icon-img {
    border-radius: 22px;
    box-shadow: 0 10px 30px rgba(0, 242, 254, 0.25);
    border: 2px solid rgba(0, 242, 254, 0.4);
    background: #0f172a;
    transition: transform 0.3s ease;
  }

  .via-app-icon-img:hover {
    transform: scale(1.05);
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900;
    max-width: 950px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.15;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    color: var(--text-muted);
    max-width: 820px;
    margin: 0 auto 2.5rem auto;
    line-height: 1.65;
  }

  .hero-subtitle strong {
    color: var(--text-main);
    font-weight: 600;
  }

  .safety-warning-box {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-left: 4px solid var(--accent-amber);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    max-width: 820px;
    margin: 0 auto 2.5rem auto;
    text-align: left;
  }

  .warning-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-amber);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .safety-warning-box p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-blue) 100%);
    color: #07090e;
    box-shadow: 0 4px 20px rgba(0, 242, 254, 0.35);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 242, 254, 0.5);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-main);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Stats Grid */
  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    max-width: 950px;
    margin: 0 auto 3.5rem auto;
  }

  .stat-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 242, 254, 0.3);
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 900;
    font-family: var(--font-heading);
    color: var(--accent-cyan);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* Gallery */
  .via-gallery-grid {
    display: flex;
    justify-content: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .phone-card {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }

  .card-caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .card-caption h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .via-img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .via-hero {
      padding-top: 100px;
    }
    .hero-stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero-stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
