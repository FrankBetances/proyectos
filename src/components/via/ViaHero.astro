---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section for VIA+ inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="via-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Clinical Backdrop Graphic with Parallax -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div id="via-hero-bg-stage" class="hero-clinical-bg-stage">
        <img 
          src={`${baseUrl}/assets/via-hero-bg.jpg?v=1`} 
          alt="Consulta pediátrica con tablet médica mostrando análisis acústico y audiometría junto a especialista y paciente" 
          class="clinical-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="clinical-overlay-gradient"></div>
      </div>
      <div class="glow-orb orb-cyan"></div>
      <div class="glow-orb orb-blue"></div>
      <div class="glow-orb orb-emerald"></div>
      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line, invisible at 0 scroll) -->
    <div class="hero-editorial-tracker" id="via-tracker" aria-hidden="true">
      <div class="tracker-segment" id="via-track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="via-fill-0"></div></div><span>SaMD Clase IIa</span></div>
      <div class="tracker-segment" id="via-track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="via-fill-1"></div></div><span>13 Módulos & DSP</span></div>
      <div class="tracker-segment" id="via-track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="via-fill-2"></div></div><span>7 Lenguas & Privacidad</span></div>
    </div>

    <!-- Sutil indicador de ratón inicial abajo (desaparece al hacer scroll) -->
    <div id="via-scroll-starter" class="hero-scroll-starter" aria-hidden="true">
      <span class="starter-text">Scroll para explorar la plataforma médica</span>
      <div class="hint-mouse">
        <div class="mouse-wheel"></div>
      </div>
    </div>

    <!-- PHASE 0: El Marco Clínico SaMD Clase IIa (Carga inmediata a scroll 0) -->
    <div id="via-phase-0" class="hero-phase-panel phase-initial">
      <div class="phase-inner max-w-content">
        <!-- Official VIA+ App Icon -->
        <div class="via-app-icon-wrapper">
          <img 
            src={`${baseUrl}/assets/via-logo.png`} 
            alt="Logo Oficial de VIA+ (SaMD Clase IIa)" 
            class="via-brand-icon" 
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <h1 class="hero-headline">
          Valoración interactiva de audición, voz y lenguaje: <span class="gradient-text-cyan">apoyo clínico en tablet y 100% offline</span>
        </h1>

        <p class="hero-narrative-lead">
          Dispositivo médico de software (SaMD Clase IIa) para consultas de otorrinolaringología, audiología pediátrica y logopedia. 
          13 módulos de evaluación gamificados que capturan biomarcadores vocales y conductuales con procesamiento acústico determinista y supervisión profesional directa.
        </p>

        <div class="hero-badge-pill-row">
          <span class="badge-pill pill-cyan">⚕️ SaMD Clase IIa · MDR 2017/745</span>
          <span class="badge-pill pill-purple">🛡️ IEC 62304 Clase B</span>
          <span class="badge-pill pill-emerald">🔒 Telemetría Zero-PHI (IEC 62366-1)</span>
          <span class="badge-pill pill-amber">⚡ Cero IA en Runtime</span>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Los 13 Módulos & DSP Acústico Validado (38% - 70% Scroll) -->
    <div id="via-phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Arquitectura de Diagnóstico Clínico</span>
        </div>
        <h2 class="hero-headline text-gradient-cyan">
          13 Módulos de evaluación con procesamiento determinista y calibración acústica.
        </h2>

        <div class="via-showcase-grid">
          <!-- Left: Clinical Cards -->
          <div class="showcase-cards-col">
            <div class="via-feature-card">
              <div class="feature-icon-badge icon-cyan">🎙️</div>
              <div class="feature-text">
                <strong>Sonómetro Ambiental & Audiometría</strong>
                <p>Sonómetro en dB(A) calibrado (IEC 61672) y Audiometría tonal liminar / condicionada («El Tren del Sonido»).</p>
              </div>
            </div>

            <div class="via-feature-card">
              <div class="feature-icon-badge icon-purple">🔬</div>
              <div class="feature-text">
                <strong>Análisis de Voz (Praat) & Hitos ASHA</strong>
                <p>Jitter y shimmer ciclo a ciclo con LPC orden 20 contrastados con Praat, y cribado normativo de 21 hitos ASHA (0 a 5 años).</p>
              </div>
            </div>

            <div class="via-feature-card">
              <div class="feature-icon-badge icon-emerald">🩺</div>
              <div class="feature-text">
                <strong>Disfagia MECV-V, T.A.R. & Logoaudiometría</strong>
                <p>Pulsioximetría BLE para desaturación SpO₂, articulación SODA con reconocedor local y logoaudiometría verbal.</p>
              </div>
            </div>
          </div>

          <!-- Right: Real App Screenshot Card -->
          <div class="showcase-tablet-col">
            <div class="tablet-frame-mockup">
              <div class="tablet-status-bar">
                <span class="tablet-notch"></span>
                <span class="tablet-tag">VIA+ SaMD v2.4 Live</span>
              </div>
              <img 
                src={`${baseUrl}/assets/via-app-clean.png`} 
                alt="Captura real del módulo clínico de VIA+ SaMD con Análisis Acústico de Voz y Audiometría" 
                class="tablet-capture-img"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: 7 Lenguas, Privacidad Zero-PHI & Acciones (72% - 100% Scroll) -->
    <div id="via-phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Soberanía Lingüística & Seguridad Médica</span>
        </div>
        <h2 class="hero-headline">
          <span class="quote-tagline-cyan">“Criterio clínico. Cero cajas negras.”</span>
        </h2>
        <p class="hero-narrative-lead">
          Batería clínica con 7 lenguas de sesión: Castellano (Sharvard), Galego (Celtia / Proxecto Nós), Euskara (HiTZ / Aholab), Dominicano (Quisqueya Habla), Català (projecte AINA), Español LatAm y English US. Datos clínicos 100% en SQLite local y telemetría de usabilidad en código QR anónimo (Zero-PHI).
        </p>

        <div class="hero-cta-group">
          <a href="#modulos" class="btn-via-primary">
            <span>Explorar los 13 Módulos</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#flujo-clinico" class="btn-via-secondary">
            <span>Flujo Clínico CAP</span>
          </a>
          <a href="#idiomas-voz" class="btn-via-secondary">
            <span>7 Lenguas & Voz</span>
          </a>
          <a href="https://github.com/FrankBetances/via" target="_blank" rel="noopener noreferrer" class="btn-via-ghost" aria-label="Ver repositorio en GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initViaHero() {
    const heroSection = document.getElementById('via-hero-scrub');
    const scrollStarter = document.getElementById('via-scroll-starter');
    const tracker = document.getElementById('via-tracker');
    const phase0 = document.getElementById('via-phase-0');
    const phase1 = document.getElementById('via-phase-1');
    const phase2 = document.getElementById('via-phase-2');

    const fill0 = document.getElementById('via-fill-0');
    const fill1 = document.getElementById('via-fill-1');
    const fill2 = document.getElementById('via-fill-2');
    const bgStage = document.getElementById('via-hero-bg-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    function calcOpacity(progress: number, enterStart: number, enterEnd: number, exitStart: number, exitEnd: number): number {
      if (progress < enterStart || progress > exitEnd) return 0;
      if (progress < enterEnd) {
        if (enterEnd === enterStart) return 1.0;
        return (progress - enterStart) / (enterEnd - enterStart);
      }
      if (progress > exitStart) {
        if (exitEnd === exitStart) return 0.0;
        return Math.max(0, 1 - (progress - exitStart) / (exitEnd - exitStart));
      }
      return 1.0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      } else {
        targetProgress = 0;
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      currentProgress += (targetProgress - currentProgress) * 0.18;

      // Starter hint is visible on start and fades out as user scrolls
      const opStarter = calcOpacity(targetProgress, 0.0, 0.0, 0.03, 0.08);
      if (scrollStarter) {
        scrollStarter.style.opacity = opStarter.toFixed(3);
        scrollStarter.style.pointerEvents = opStarter > 0.4 ? 'auto' : 'none';
      }

      // Phase 0: Fully visible at 0 scroll (1.0) -> exits between 0.18 and 0.35
      const op0 = calcOpacity(targetProgress, 0.0, 0.0, 0.18, 0.35);
      // Phase 1: 13 Módulos & DSP (enters 0.30 -> peaks at 0.40-0.62 -> exits at 0.72)
      const op1 = calcOpacity(targetProgress, 0.30, 0.40, 0.62, 0.72);
      // Phase 2: 7 Lenguas & CTAs (enters 0.68 -> peaks at 0.78-1.00)
      const op2 = calcOpacity(targetProgress, 0.68, 0.78, 1.0, 1.0);

      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${-targetProgress * 40}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.50 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.85 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      // Clinical Background Dynamic Parallax
      if (bgStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const bgOpacity = Math.max(0.35, 0.65 - currentProgress * 0.25);
        bgStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        bgStage.style.opacity = bgOpacity.toFixed(3);
      }

      // Tracker visibility
      if (tracker) {
        tracker.style.opacity = '1';
      }

      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, (targetProgress / 0.34) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.34) / 0.34) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.68) / 0.32) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initViaHero);
  } else {
    initViaHero();
  }
  document.addEventListener('astro:page-load', initViaHero);
</script>

<style>
  /* 320vh Hero Container */
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    width: 100%;
    background-color: var(--bg-dark);
  }

  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Ambient Backdrop Canvas */
  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  /* Clinical Artwork Background Parallax Stage */
  .hero-clinical-bg-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100vh;
    max-width: 1920px;
    max-height: 1080px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    will-change: transform, opacity;
    opacity: 0.72;
    pointer-events: none;
  }

  .clinical-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    mask-image: radial-gradient(ellipse at 50% 50%, black 45%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 45%, transparent 90%);
    filter: brightness(0.65) contrast(1.15);
  }

  .clinical-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.45) 0%, rgba(7, 9, 14, 0.85) 75%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(95px);
    opacity: 0.28;
    pointer-events: none;
  }

  .orb-cyan {
    top: 20%;
    left: 18%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, var(--accent-cyan) 0%, rgba(0, 242, 254, 0) 70%);
  }

  .orb-blue {
    bottom: 20%;
    right: 15%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--accent-blue) 0%, rgba(79, 172, 254, 0) 70%);
  }

  .orb-emerald {
    top: 60%;
    left: 45%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, var(--accent-emerald) 0%, rgba(16, 185, 129, 0) 70%);
    opacity: 0.18;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
  }

  /* Official Brand Icon */
  .via-app-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.25rem auto;
  }

  .via-brand-icon {
    width: clamp(84px, 12vw, 105px);
    height: auto;
    border-radius: 26px;
    filter: drop-shadow(0 0 35px rgba(0, 242, 254, 0.45)) drop-shadow(0 10px 25px rgba(0, 0, 0, 0.6));
    border: 2px solid rgba(0, 242, 254, 0.4);
    background: #0f172a;
    transition: transform 0.3s ease;
    animation: subtleFloat 4s ease-in-out infinite alternate;
  }

  @keyframes subtleFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  /* Sutil indicador de inicio abajo (desaparece con el scroll) */
  .hero-scroll-starter {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 8;
    will-change: opacity;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .starter-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* Editorial Tracker */
  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-cyan);
    transition: width 0.1s linear;
  }

  /* Phase Panels */
  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .hero-phase-panel.phase-initial {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 960px;
    margin: 0 auto;
  }

  .max-w-showcase {
    max-width: 1100px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .eyebrow-cyan {
    color: var(--accent-cyan);
  }

  .eyebrow-emerald {
    color: var(--accent-emerald);
  }

  .hero-headline {
    font-size: clamp(2.1rem, 4.2vw, 3.6rem);
    font-weight: 900;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
  }

  .gradient-text-cyan {
    color: #38BDF8;
    font-weight: 900;
    text-shadow: 0 0 25px rgba(56, 189, 248, 0.6);
  }

  .text-gradient-cyan {
    color: #38BDF8;
    font-weight: 900;
    text-shadow: 0 0 25px rgba(56, 189, 248, 0.6);
  }

  .quote-tagline-cyan {
    color: #38BDF8;
    font-weight: 900;
    text-shadow: 0 0 25px rgba(56, 189, 248, 0.6);
    display: inline-block;
  }

  .hero-narrative-lead {
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 auto 2.25rem auto;
    font-weight: 400;
  }

  .hero-narrative-lead strong {
    color: var(--text-main);
  }

  /* Badge Pill Row */
  .hero-badge-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge-pill {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #D8B4FE;
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  .pill-amber {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #FCD34D;
  }

  /* Showcase Grid */
  .via-showcase-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 1.5rem;
    text-align: left;
  }

  .showcase-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .via-feature-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s ease;
  }

  .via-feature-card:hover {
    transform: translateX(4px);
    border-color: rgba(0, 242, 254, 0.4);
  }

  .feature-icon-badge {
    font-size: 1.75rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .icon-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .icon-emerald {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

