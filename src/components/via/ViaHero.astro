---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="via-hero">
  <div class="container">
    <div class="hero-top-badges">
      <span class="badge badge-cyan">SaMD Clase IIa · MDR 2017/745</span>
      <span class="badge badge-purple">IEC 62304 Clase B</span>
      <span class="badge badge-emerald">ISO 14971 Risk Management</span>
      <span class="badge badge-amber">Telemetría Zero-PHI QR</span>
    </div>

    <h1 class="hero-title">
      VIA<span class="gradient-text">+</span> · Valoración Interactiva de Audición y Lenguaje
    </h1>

    <p class="hero-subtitle">
      Software como Dispositivo Médico (SaMD) de Clase IIa que actúa como herramienta de <strong>apoyo a la decisión clínica (CDSS)</strong> para audiometría, logoaudiometría, fonética y neurodesarrollo pediátrico.
    </p>

    <!-- Clinical Safety Warning Box -->
    <div class="safety-warning-box">
      <div class="warning-header">
        <span class="warning-icon">⚠️</span>
        <strong>AVISO DE SEGURIDAD CLÍNICA OBLIGATORIO</strong>
      </div>
      <p>
        VIA+ es una herramienta de apoyo a la decisión clínica. Bajo ninguna circunstancia emite diagnósticos automatizados ni sustituye el juicio del profesional sanitario. Su uso está estrictamente restringido a entornos clínicos bajo supervisión profesional directa.
      </p>
    </div>

    <div class="hero-actions">
      <a href="#modulos" class="btn-primary">
        <span>Explorar 11 Módulos Clínicos</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#flujo-clinico" class="btn-secondary">
        <span>Ver Flujo Clínico CAP</span>
      </a>
      <a href="https://github.com/FrankBetances/via" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>GitHub Repositorio</span>
      </a>
    </div>

    <!-- VIA+ Screenshots Gallery Showcase -->
    <div class="via-gallery-grid">
      <div class="phone-card glass-card">
        <div class="card-caption">
          <span class="badge badge-amber">Proyecto Quisqueya Habla</span>
          <h4>Dirección Clínica & Dirección</h4>
        </div>
        <img src={`${baseUrl}/assets/via-app-1.png`} alt="Captura real de VIA+ mostrando Proyecto Quisqueya Habla y Dirección Clínica por Dr. Frank Betances" class="via-img" />
      </div>

      <div class="phone-card glass-card">
        <div class="card-caption">
          <span class="badge badge-cyan">Selección de Pruebas</span>
          <h4>Análisis de Voz, Audiometría & Idiomas</h4>
        </div>
        <img src={`${baseUrl}/assets/via-app-2.png`} alt="Captura real de VIA+ mostrando selección de pruebas, Certificado de Aptitud de sala y variedades de idioma" class="via-img" />
      </div>
    </div>
  </div>
</section>

<style>
  .via-hero {
    padding-top: 140px;
    padding-bottom: 70px;
    text-align: center;
  }

  .hero-top-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-size: 3.4rem;
    font-weight: 800;
    max-width: 950px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 820px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .safety-warning-box {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.75rem;
    max-width: 850px;
    margin: 0 auto 2.5rem auto;
    text-align: left;
    backdrop-filter: blur(10px);
  }

  .warning-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-amber);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
  }

  .safety-warning-box p {
    color: var(--text-main);
    font-size: 0.925rem;
    line-height: 1.5;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .via-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 2rem;
    max-width: 850px;
    margin: 0 auto;
  }

  .phone-card {
    padding: 1rem;
    border-radius: 24px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .card-caption h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-top: 0.4rem;
  }

  .via-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.2rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
