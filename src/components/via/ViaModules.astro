---
const modules = [
  {
    num: "1",
    title: "Revisión Previa y Estado del Oído",
    hw: "Cribado Previo",
    desc: "Comprueba el estado del oído y la viabilidad de la sesión antes de comenzar las pruebas auditivas.",
    entity: "Viabilidad Clínica",
    metric: "Apto para la prueba",
    badgeColor: "cyan"
  },
  {
    num: "2",
    title: "Cribado de Autismo (M-CHAT-R/F)",
    hw: "Cuestionario Clínico",
    desc: "Cuestionario oficial validado para detección precoz en niños de 16 a 30 meses en solo unos minutos.",
    entity: "Neurodesarrollo",
    metric: "Escala validada de riesgo",
    badgeColor: "purple"
  },
  {
    num: "3",
    title: "Sonómetro de Sala",
    hw: "Control Acústico",
    desc: "Verifica que el ruido ambiental de la consulta no interfiera en la fiabilidad de las pruebas auditivas.",
    entity: "Control de Entorno",
    metric: "Validación de silencio",
    badgeColor: "amber"
  },
  {
    num: "4",
    title: "Audiometría Infantil",
    hw: "Medición Tonal",
    desc: "Evalúa el umbral de audición en las frecuencias clave de la voz con cálculo automático de pérdida.",
    entity: "Audición Tonal",
    metric: "Cálculo según OMS",
    badgeColor: "emerald"
  },
  {
    num: "5",
    title: "Audiometría por Juego («El Tren»)",
    hw: "Juego Interactivo",
    desc: "El niño toca el silbato de un tren cada vez que escucha un sonido: respuestas fiables y sin miedo.",
    entity: "Audiología Lúdica",
    metric: "Respuesta condicionada",
    badgeColor: "cyan"
  },
  {
    num: "6",
    title: "Análisis Rápido de Voz",
    hw: "Captura de Voz",
    desc: "Evalúa la salud de las cuerdas vocales, la estabilidad del tono y posibles signos de ronquera o fatiga.",
    entity: "Salud Vocal",
    metric: "Biomarcadores acústicos",
    badgeColor: "purple"
  },
  {
    num: "7",
    title: "Test de Deglución (MECV-V)",
    hw: "Seguridad al Tragar",
    desc: "Monitoriza la oxigenación y la seguridad al tragar diferentes texturas para prevenir atragantamientos.",
    entity: "Deglución y Disfagia",
    metric: "Control continuo de oxígeno",
    badgeColor: "rose"
  },
  {
    num: "8",
    title: "Cribado de Sueño y Respiración",
    hw: "Cuestionario Pediátrico",
    desc: "Detecta sospechas de pausas respiratorias nocturnas, ronquidos o problemas del sueño en la infancia.",
    entity: "Trastornos del Sueño",
    metric: "Índice de sospecha clínica",
    badgeColor: "amber"
  },
  {
    num: "9",
    title: "Articulación y Pronunciación (T.A.R.)",
    hw: "Registro de Habla",
    desc: "Comprueba cómo pronuncia cada sonido del idioma con tarjetas ilustradas amenas y adaptadas por edad.",
    entity: "Fonética y Habla",
    metric: "Registro claro de fonemas",
    badgeColor: "emerald"
  },
  {
    num: "10",
    title: "Audiometría Verbal",
    hw: "Comprensión Oral",
    desc: "Evalúa cómo reconoce y entiende las palabras habladas en la sala según su etapa de desarrollo.",
    entity: "Comprensión Auditiva",
    metric: "Umbral de recepción verbal",
    badgeColor: "cyan"
  },
  {
    num: "11",
    title: "Atención y Memoria",
    hw: "5 Minijuegos",
    desc: "Cinco juegos sencillos para valorar la concentración, la memoria de trabajo y la agilidad mental del menor.",
    entity: "Desarrollo Cognitivo",
    metric: "Perfil de atención",
    badgeColor: "purple"
  },
  {
    num: "12",
    title: "Ritmo y Entonación",
    hw: "Habla Conectada",
    desc: "Analiza la musicalidad, la fluidez y las pausas cuando el niño cuenta una pequeña historia o describe una lámina.",
    entity: "Fluidez Verbal",
    metric: "Patrón de entonación",
    badgeColor: "rose"
  },
  {
    num: "13",
    title: "Hitos del Lenguaje (ASHA)",
    hw: "Observación Guiada",
    desc: "Verifica si el habla y la comprensión corresponden a su edad (de 0 a 5 años) con alertas de detección precoz.",
    entity: "Hitos Evolutivos",
    metric: "Escala oficial ASHA",
    badgeColor: "cyan"
  }
];
---

<section id="modulos" class="via-modules section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Batería Integral de Apoyo Clínico</span>
      <h2>13 Módulos de Evaluación & <span class="gradient-text">Neurodesarrollo</span></h2>
      <p>Cada módulo combina rigor metodológico basado en la evidencia foniátrica con interfaces lúdicas adaptadas a la infancia.</p>
    </div>

    <div class="modules-grid">
      {modules.map((m) => (
        <div class="glass-card module-card">
          <div class="module-top">
            <span class="mod-num">Módulo {m.num}</span>
            <span class={`badge badge-${m.badgeColor}`}>{m.hw}</span>
          </div>

          <h3>{m.title}</h3>
          <p class="mod-desc">{m.desc}</p>

          <div class="mod-meta-box">
            <div class="meta-row">
              <span class="meta-k">Criterio:</span>
              <strong class="meta-v">{m.metric}</strong>
            </div>
            <div class="meta-row">
              <span class="meta-k">Ámbito Clínico:</span>
              <code class="meta-code">{m.entity}</code>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .via-modules {
    padding: 90px 0;
    background: rgba(0, 0, 0, 0.25);
    position: relative;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.75rem;
  }

  .module-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .module-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .module-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .mod-num {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .mod-icon {
    font-size: 1.75rem;
  }

  .module-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--text-main);
    line-height: 1.3;
  }

  .mod-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .mod-meta-box {
    background: rgba(2, 6, 23, 0.45);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    gap: 0.5rem;
  }

  .meta-k {
    color: var(--text-dim);
  }

  .meta-v {
    color: var(--text-main);
    font-weight: 600;
  }

  .meta-code {
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .via-modules {
      padding: 60px 0;
    }
  }
</style>
