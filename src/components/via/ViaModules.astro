---
const modules = [
  {
    num: "1",
    icon: "📋",
    title: "Evaluación Clínica Previa (CAP)",
    hw: "🟢 Cribado Previo",
    desc: "Certificado de Aptitud para la Prueba: registra otoscopia por oído y capacidades visual, verbal (por grupo de edad) y motora fina para determinar qué módulos son viables.",
    entity: "Otoscopia y Viabilidad",
    metric: "Veredicto Completo / Parcial / Bloqueado",
    badgeColor: "cyan"
  },
  {
    num: "2",
    icon: "🧩",
    title: "Cribado de Autismo M-CHAT-R/F",
    hw: "🟢 Cuestionario Clínico",
    desc: "Cribado de TEA validado para 16–30 meses con 20 reactivos, estratificación en riesgo bajo, medio y alto, y entrevista de seguimiento integrada.",
    entity: "Neurodesarrollo Temprano",
    metric: "Escala validada 0–20 puntos",
    badgeColor: "purple"
  },
  {
    num: "3",
    icon: "🎛️",
    title: "Sonómetro Ambiental de Sala",
    hw: "🎙️ Micrófono Calibrado",
    desc: "Control acústico previo a la exploración auditiva: medición en dB(A) con ponderación A (IEC 61672), nivel continuo equivalente (LAeq) y percentiles de fondo (L90) y picos (L10).",
    entity: "Control de Sala",
    metric: "Umbral clínico ≤ 45 dB(A)",
    badgeColor: "amber"
  },
  {
    num: "4",
    icon: "🎧",
    title: "Audiometría Infantil Tonal",
    hw: "🔊 Audio Calibrado",
    desc: "Audiometría liminar (250–4000 Hz) guiada por protocolo Hughson-Westlake con curva de compensación electroacústica sellada en cámara anecoica y cálculo automático de PTA.",
    entity: "Audiología Tonal",
    metric: "Clasificación descriptiva BIAP / OMS",
    badgeColor: "emerald"
  },
  {
    num: "5",
    icon: "🚂",
    title: "Audiometría Condicionada (El Tren)",
    hw: "🔊 Refuerzo Lúdico CRA",
    desc: "Audiometría condicionada por juego: un tren interactivo avanza a 60 fps por estaciones de frecuencia cada vez que el paciente confirma el estímulo sonoro tocando el silbato.",
    entity: "Audiología Pediátrica",
    metric: "Condicionamiento lúdico por frecuencias",
    badgeColor: "cyan"
  },
  {
    num: "6",
    icon: "🎤",
    title: "Análisis Acústico de Voz",
    hw: "🎙️ Captura 48 kHz + LPC 20",
    desc: "Extracción de biomarcadores vocales sobre vocal sostenida (/a/): F0, perturbación ciclo a ciclo (jitter y shimmer), relación armónico-ruido (HNR) y formantes F1–F3 validados frente a Praat.",
    entity: "Foniatría y Voz",
    metric: "Validación matemática frente a Praat",
    badgeColor: "purple"
  },
  {
    num: "7",
    icon: "💧",
    title: "Test de Disfagia MECV-V",
    hw: "📶 Pulsioxímetro BLE",
    desc: "Método de Exploración Clínica Volumen-Viscosidad en 9 bolos con monitorización inalámbrica continua de SpO₂ para detectar desaturaciones ≥ 3% y orientar la dieta segura.",
    entity: "Seguridad Deglutoria",
    metric: "Bifurcación viscosidad × volumen",
    badgeColor: "rose"
  },
  {
    num: "8",
    icon: "😴",
    title: "Cribado SAHS Infantil",
    hw: "🟢 Exploración + PSQ",
    desc: "Cuestionario pediátrico de sueño de Chervin (SRBD-22) combinado con exploración orofaríngea (escala amigdalina de Brodsky), IMC y factores de riesgo respiratorio.",
    entity: "Trastornos del Sueño",
    metric: "Índice Chervin ≥ 0.33 (Derivación)",
    badgeColor: "amber"
  },
  {
    num: "9",
    icon: "🗣️",
    title: "Articulación · T.A.R.",
    hw: "🎙️ Voz Neuronal + SODA",
    desc: "Test de Articulación a la Repetición sobre rejilla fonema × posición con 86 ítems propios por variedad lingüística, apoyo de reconocimiento en dispositivo y registro SODA.",
    entity: "Fonología y Habla",
    metric: "Matriz SODA por posición silábica",
    badgeColor: "emerald"
  },
  {
    num: "10",
    icon: "🔊",
    title: "Audiometría Verbal (Logoaudiometría)",
    hw: "🗣️ Estímulos por Edad",
    desc: "Reconocimiento verbal en campo libre por selección de láminas ilustradas graduadas por edad (bandas A–D), en modos de discriminación y búsqueda de umbral de recepción verbal.",
    entity: "Logoaudiometría",
    metric: "Discriminación y umbral verbal (SRT)",
    badgeColor: "cyan"
  },
  {
    num: "11",
    icon: "🧠",
    title: "Funciones Ejecutivas Pediátricas",
    hw: "🗣️ 5 Mini-Juegos",
    desc: "Exploración lúdica graduada por edad en 5 dominios cognitivos: atención sostenida, inhibición (Go/No-Go), flexibilidad cognitiva, memoria de trabajo y planificación.",
    entity: "Procesamiento Cognitivo",
    metric: "Perfil descriptivo 0–100 por dominio",
    badgeColor: "purple"
  },
  {
    num: "12",
    icon: "〰️",
    title: "Análisis Prosódico (Habla Conectada)",
    hw: "🎙️ Narración Guiada",
    desc: "Cuantifica la dinámica del habla conectada (30–60 s de habla válida sobre lámina o cuento): rango y variabilidad tonal en semitonos, pausas, fracción sonora y tasa de articulación.",
    entity: "Prosodia y Fluidez",
    metric: "Registro acústico descriptivo",
    badgeColor: "rose"
  },
  {
    num: "13",
    icon: "🧭",
    title: "Cribado de Hitos del Lenguaje ASHA",
    hw: "🟢 Observación Clínica",
    desc: "Evaluación sobre umbrales de percentil 75 de la ASHA (0 a 5 años) con 21 hitos en 7 bandas de edad, 3 dominios comunicativos y 8 banderas rojas de derivación temprana.",
    entity: "Desarrollo Comunicativo",
    metric: "Percentil 75 ASHA + Banderas Rojas",
    badgeColor: "cyan"
  }
];
---

<section id="modulos" class="via-modules section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Batería Integral de Apoyo Clínico</span>
      <h2>13 Módulos de Evaluación & <span class="gradient-text">Neurodesarrollo</span></h2>
      <p>Cada módulo combina rigor metodológico basado en la evidencia foniátrica con interfaces lúdicas adaptadas a la infancia.</p>
    </div>

    <div class="modules-grid">
      {modules.map((m) => (
        <div class="glass-card module-card">
          <div class="module-top">
            <span class="mod-num">M{m.num}</span>
            <span class="mod-icon">{m.icon}</span>
            <span class={`badge badge-${m.badgeColor}`}>{m.hw}</span>
          </div>

          <h3>{m.title}</h3>
          <p class="mod-desc">{m.desc}</p>

          <div class="mod-meta-box">
            <div class="meta-row">
              <span class="meta-k">Criterio:</span>
              <strong class="meta-v">{m.metric}</strong>
            </div>
            <div class="meta-row">
              <span class="meta-k">Ámbito Clínico:</span>
              <code class="meta-code">{m.entity}</code>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .via-modules {
    padding: 90px 0;
    background: rgba(0, 0, 0, 0.25);
    position: relative;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.75rem;
  }

  .module-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .module-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .module-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .mod-num {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .mod-icon {
    font-size: 1.75rem;
  }

  .module-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--text-main);
    line-height: 1.3;
  }

  .mod-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .mod-meta-box {
    background: rgba(2, 6, 23, 0.45);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    gap: 0.5rem;
  }

  .meta-k {
    color: var(--text-dim);
  }

  .meta-v {
    color: var(--text-main);
    font-weight: 600;
  }

  .meta-code {
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .via-modules {
      padding: 60px 0;
    }
  }
</style>
