---
const steps = [
  {
    num: "1",
    title: "Acceso Profesional",
    icon: "🔑",
    desc: "Autenticación del facultativo sanitario mediante Firebase Auth. Cada evaluación queda firmada con su número de colegiado y perfil profesional.",
    badge: "Firma Acreditada",
    badgeColor: "cyan"
  },
  {
    num: "2",
    title: "Identificación del Paciente",
    icon: "👤",
    desc: "Búsqueda en el historial o alta sociodemográfica (NHC, edad calculada, sexo). Se genera la sesión clínica localmente en SQLite.",
    badge: "Datos Locales",
    badgeColor: "purple"
  },
  {
    num: "3",
    title: "Consentimiento Informado",
    icon: "✍️",
    desc: "Paso bloqueante legal: texto normativo y firma manuscrita digital del tutor sobre el lienzo táctil. Sin firma válida, la evaluación queda bloqueada.",
    badge: "Bloqueante Obligatorio",
    badgeColor: "rose"
  },
  {
    num: "4",
    title: "Pre-screening Clínico (CAP)",
    icon: "📋",
    desc: "Certificado de Aptitud para la Prueba en 4 dominios (Otoscopia por oído, Visual, Verbal por edad y Motora fina). Emite veredicto graduado (Completo, Parcial o Bloqueado).",
    badge: "Otoscopia & Aptitud",
    badgeColor: "rose"
  },
  {
    num: "5",
    title: "Sonómetro de Sala & Hub",
    icon: "🎛️",
    desc: "Comprobación del nivel de ruido en dB(A) (LAeq ≤ 45 dB), diagnóstico de cadena de audio en 4 escuchas y selección entre 7 lenguas de sesión.",
    badge: "Gate de Ruido & Idioma",
    badgeColor: "amber"
  },
  {
    num: "6",
    title: "Batería de 13 Módulos",
    icon: "🎮",
    desc: "Evaluación gamificada interactiva. El Modo Niño ofrece una interfaz lúdica sin elementos clínicos visibles; el facultativo supervisa con mediciones deterministas.",
    badge: "13 Módulos",
    badgeColor: "emerald"
  },
  {
    num: "7",
    title: "Síntesis NLG & Informe Firmado",
    icon: "🧾",
    desc: "El motor NLG determinista redacta el pre-informe clínico (PTA, voz, ASHA, otoscopia). El facultativo revisa y edita el borrador, lo firma en pantalla y genera el PDF.",
    badge: "NLG + Firma Colegiada",
    badgeColor: "cyan"
  },
  {
    num: "8",
    title: "Archivo Local & Telemetría QR",
    icon: "🗂️",
    desc: "Persistencia cifrada en el dispositivo para seguimiento evolutivo longitudinal y exportación opcional de telemetría de usabilidad en QR anónimo (Zero-PHI).",
    badge: "Historial & QR Zero-PHI",
    badgeColor: "purple"
  }
];

const capItems = [
  { label: "1. Otoscopia por Oído", detail: "Registra Normal, Cerumen, OMA, OME, Perforación o DTT. El tapón de cerumen, OMA o perforación bloquean selectivamente la audiometría de ese oído." },
  { label: "2. Capacidad Visual", detail: "Verifica fijación de la mirada, distinción de dos imágenes en pantalla, señalamiento y ausencia de nistagmo marcado." },
  { label: "3. Comprensión Verbal por Edad", detail: "Ítems escalonados en 3 franjas (18m–2a11m, 3–4a11m y ≥5 años), desde responder a su nombre hasta comprender la tarea tras demostración." },
  { label: "4. Motricidad Fina", detail: "Comprueba pulsación en objetivo ≥ 4 cm, distinción entre dos zonas táctiles, arrastre ≥ 3 cm y ausencia de movimientos involuntarios severos." }
];
---

<section id="flujo-clinico" class="via-workflow section-padding">
  <div class="container">
    <div class="section-header">
      <span class="tag">Recorrido Secuencial Obligatorio</span>
      <h2>Flujo Clínico en Consulta <span class="gradient-text">& Puertas Bloqueantes</span></h2>
      <p>Cada fase constituye un prerrequisito ineludible para garantizar la validez metodológica y la seguridad del paciente pediátrico.</p>
    </div>

    <div class="timeline-grid">
      {steps.map((s) => (
        <div class="glass-card timeline-card">
          <div class="timeline-top">
            <span class="step-num">{s.num}</span>
            <span class="step-icon">{s.icon}</span>
            <span class={`badge badge-${s.badgeColor}`}>{s.badge}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- CAP Checklist Box -->
    <div class="glass-card cap-box">
      <div class="cap-header">
        <span class="cap-icon">🛡️</span>
        <div>
          <h3>Pre-Screening — Certificado de Aptitud para la Prueba (CAP)</h3>
          <p class="cap-sub">El facultativo debe verificar las 4 capacidades antes de habilitar la batería (paso bloqueante):</p>
        </div>
      </div>

      <div class="cap-grid">
        {capItems.map((item) => (
          <div class="cap-item">
            <span class="check-mark">✓</span>
            <div>
              <strong>{item.label}</strong>
              <span class="cap-detail">{item.detail}</span>
            </div>
          </div>
        ))}
      </div>
      
      <div class="cap-footnote">
        <em>*Veredicto graduado:</em> Un hallazgo parcial en el CAP no cancela toda la sesión, sino que deshabilita únicamente las pruebas que ese hallazgo invalida (por ejemplo, audiometría ipsilateral ante tapón de cerumen u otitis media aguda).
      </div>
    </div>
  </div>
</section>

<style>
  .via-workflow {
    padding: 90px 0;
    position: relative;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    height: 100%;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .timeline-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .timeline-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 0.5rem;
  }

  .step-num {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--accent-cyan);
    background: rgba(0, 242, 254, 0.1);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .step-icon {
    font-size: 1.4rem;
  }

  .timeline-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
    color: var(--text-main);
  }

  .timeline-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* CAP Box */
  .cap-box {
    padding: 2.5rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: var(--radius-lg);
  }

  .cap-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .cap-icon {
    font-size: 2rem;
  }

  .cap-header h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.25rem 0;
    color: var(--text-main);
  }

  .cap-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .cap-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(2, 6, 23, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem;
    border-radius: var(--radius-md);
  }

  .check-mark {
    color: #34d399;
    font-weight: 900;
    font-size: 1.1rem;
    background: rgba(16, 185, 129, 0.15);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cap-item strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .cap-detail {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
    display: block;
  }

  .cap-footnote {
    font-size: 0.85rem;
    color: var(--text-dim);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }

  @media (max-width: 768px) {
    .via-workflow {
      padding: 60px 0;
    }
  }
</style>
