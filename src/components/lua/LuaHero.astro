---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<section class="lua-hero">
  <div class="container">
    <div class="hero-top-badges">
      <span class="badge badge-orange">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
        ESP32-C3 · 240×240 IPS Circular
      </span>
      <span class="badge badge-cyan">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>
        Bluetooth LE 5.0 (Zero-PHI)
      </span>
      <span class="badge badge-emerald">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        C++17 Puro · 45.722 Tests
      </span>
    </div>

    <h1 class="hero-title">
      Lúa: La Mascota Inteligente <br/>
      <span class="gradient-text-orange">en la Terapia y en la Consulta</span>
    </h1>

    <p class="hero-subtitle">
      Dispositivo físico complementario para el neurodesarrollo y la audiología pediátrica. 
      En casa, <strong>espeja el estímulo visual y el refuerzo de Valeria+</strong> capturando la mirada del niño; en clínica, <strong>asiste en estricto Silencio Clínico en VIA+</strong> sin interferir en el acto médico.
    </p>

    <!-- Interactive Hardware circular simulator container -->
    <div class="hardware-showcase">
      <div class="hardware-bezel">
        <div class="ttl-ring"></div>
        <div class="gc9a01-screen">
          <div class="pixel-cat">
            <div class="cat-ears">
              <div class="ear left"></div>
              <div class="ear right"></div>
            </div>
            <div class="cat-face-head">
              <div class="cat-eyes">
                <div class="eye left"></div>
                <div class="eye right"></div>
              </div>
              <div class="cat-snout">
                <div class="nose"></div>
                <div class="mouth"></div>
              </div>
              <div class="cat-cheeks">
                <div class="blush left"></div>
                <div class="blush right"></div>
              </div>
            </div>
          </div>
          <div class="screen-glare"></div>
          <div class="screen-hud">
            <span class="hud-status">ACTIVA · 240×240</span>
          </div>
        </div>
      </div>
      <div class="hardware-halo"></div>
    </div>

    <!-- Quick stats strip -->
    <div class="hero-stats-grid">
      <div class="stat-card glass-card">
        <span class="stat-number">240×240</span>
        <span class="stat-label">Pantalla IPS Circular (GC9A01)</span>
      </div>
      <div class="stat-card glass-card">
        <span class="stat-number">22</span>
        <span class="stat-label">Expresiones + 8 Emociones AFFECT</span>
      </div>
      <div class="stat-card glass-card">
        <span class="stat-number">66 / 45</span>
        <span class="stat-label">Pictogramas e Insignias en 24×24</span>
      </div>
      <div class="stat-card glass-card">
        <span class="stat-number">0 dB</span>
        <span class="stat-label">Sin Micrófono · Cero Ruido Clínico</span>
      </div>
    </div>
    
  </div>
</section>

<style>
  .lua-hero {
    padding-top: 120px;
    padding-bottom: 70px;
    text-align: center;
    background: radial-gradient(circle at 50% 20%, rgba(249, 115, 22, 0.08) 0%, rgba(7, 9, 14, 0) 70%);
    position: relative;
    overflow: hidden;
  }

  .hero-top-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
  }

  .badge-orange {
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fb923c;
  }

  .badge-cyan {
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    color: var(--accent-cyan);
  }

  .badge-emerald {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
  }

  .hero-title {
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 900;
    max-width: 950px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.15;
    color: var(--text-main);
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
    line-height: 1.65;
  }

  .hero-subtitle strong {
    color: var(--text-main);
    font-weight: 600;
  }

  /* Hardware Showcase */
  .hardware-showcase {
    position: relative;
    width: 270px;
    height: 270px;
    margin: 0 auto 4rem auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hardware-bezel {
    position: relative;
    width: 240px;
    height: 240px;
    background: linear-gradient(145deg, #1e293b, #090d16);
    border-radius: 50%;
    border: 9px solid #334155;
    box-shadow: 
      0 0 0 2px rgba(255, 255, 255, 0.1),
      inset 0 0 25px rgba(0, 0, 0, 0.9),
      0 20px 50px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(249, 115, 22, 0.2);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  /* Ring showing TTL / Concession */
  .ttl-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 3px solid transparent;
    border-top-color: #00f2fe;
    border-right-color: #00f2fe;
    border-bottom-color: rgba(0, 242, 254, 0.3);
    animation: rotateRing 8s linear infinite;
    pointer-events: none;
  }

  @keyframes rotateRing {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .gc9a01-screen {
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: #020617;
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.95);
  }

  .screen-glare {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0) 50%);
    pointer-events: none;
    z-index: 5;
  }

  .screen-hud {
    position: absolute;
    bottom: 12px;
    z-index: 4;
  }

  .hud-status {
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(15, 23, 42, 0.7);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(56, 189, 248, 0.3);
    letter-spacing: 0.05em;
  }

  /* Pixel Art Cat */
  .pixel-cat {
    position: relative;
    width: 100px;
    height: 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: catIdleBreathing 3.6s ease-in-out infinite;
    z-index: 3;
  }

  @keyframes catIdleBreathing {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-3px) scale(1.02); }
  }

  .cat-ears {
    position: absolute;
    top: -12px;
    width: 80px;
    display: flex;
    justify-content: space-between;
  }

  .ear {
    width: 22px;
    height: 22px;
    background: #0f172a;
    border: 3px solid #1e293b;
    position: relative;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .ear::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 4px;
    width: 10px;
    height: 10px;
    background: #f43f5e;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .cat-face-head {
    width: 84px;
    height: 68px;
    background: #0f172a;
    border: 3px solid #1e293b;
    border-radius: 20px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .cat-eyes {
    display: flex;
    justify-content: space-between;
    width: 50px;
    margin-top: -4px;
  }

  .eye {
    width: 12px;
    height: 18px;
    background: #38bdf8;
    border-radius: 4px;
    position: relative;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.8);
    animation: catBlink 4.5s infinite;
  }

  .eye::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 2px;
    width: 4px;
    height: 5px;
    background: white;
    border-radius: 2px;
  }

  @keyframes catBlink {
    0%, 94%, 98%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }

  .cat-snout {
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nose {
    width: 6px;
    height: 4px;
    background: #f43f5e;
    border-radius: 2px 2px 3px 3px;
  }

  .mouth {
    width: 12px;
    height: 4px;
    border-bottom: 2px solid #cbd5e1;
    border-radius: 0 0 6px 6px;
    margin-top: 1px;
  }

  .cat-cheeks {
    position: absolute;
    width: 64px;
    display: flex;
    justify-content: space-between;
    top: 36px;
  }

  .blush {
    width: 8px;
    height: 4px;
    background: rgba(244, 63, 94, 0.4);
    border-radius: 50%;
  }

  .hardware-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 290px;
    height: 290px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.2) 0%, rgba(249, 115, 22, 0) 70%);
    border-radius: 50%;
    z-index: 1;
    animation: haloPulse 4s infinite ease-in-out;
  }

  @keyframes haloPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
    50% { transform: translate(-50%, -50%) scale(1.12); opacity: 0.9; }
  }

  /* Stats Grid */
  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    max-width: 1060px;
    margin: 0 auto;
  }

  .stat-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(249, 115, 22, 0.3);
  }

  .stat-number {
    font-size: 1.8rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: #fb923c;
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .lua-hero {
      padding-top: 100px;
    }
    .hero-stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero-stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
