---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section for Lúa Mascot inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="lua-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Lifestyle Backdrop Graphic with Parallax -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div id="lua-hero-bg-stage" class="hero-lua-bg-stage">
        <img 
          src={`${baseUrl}/assets/valeria-lua-hero-bg.jpg?v=1`} 
          alt="Dispositivo circular de Lúa con pixel art sobre mesa de madera junto a interacción familiar y tablet clínica" 
          class="lua-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="lua-overlay-gradient"></div>
      </div>
      <div class="glow-orb orb-orange"></div>
      <div class="glow-orb orb-cyan"></div>
      <div class="glow-orb orb-purple"></div>
      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line, invisible at 0 scroll) -->
    <div class="hero-editorial-tracker" id="lua-tracker" aria-hidden="true">
      <div class="tracker-segment" id="lua-track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="lua-fill-0"></div></div><span>Compañera Física</span></div>
      <div class="tracker-segment" id="lua-track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="lua-fill-1"></div></div><span>Visor Circular &amp; Sets STEAM</span></div>
      <div class="tracker-segment" id="lua-track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="lua-fill-2"></div></div><span>Cero Castigo &amp; Contacto</span></div>
    </div>

    <!-- Sutil indicador de ratón inicial abajo (desaparece al hacer scroll) -->
    <div id="lua-scroll-starter" class="hero-scroll-starter" aria-hidden="true">
      <span class="starter-text">Scroll para conocer a Lúa</span>
      <div class="hint-mouse">
        <div class="mouse-wheel"></div>
      </div>
    </div>

    <!-- PHASE 0: Presentación de la Mascota Física + STEAM & AR (Carga inmediata a scroll 0) -->
    <div id="lua-phase-0" class="hero-phase-panel phase-initial">
      <div class="phase-inner max-w-content">
        <!-- Official Lúa Mascot Icon -->
        <div class="lua-mascot-icon-wrapper">
          <img 
            src={`${baseUrl}/assets/valeria_lua.png`} 
            alt="Lúa la Gata - Compañera física interactiva de Earlify Health" 
            class="lua-brand-icon" 
            width="110"
            height="110"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="editorial-eyebrow eyebrow-orange">
          <span>Compañera Física Interactiva · Juego STEAM + Realidad Aumentada</span>
        </div>

        <h1 class="hero-headline">
          Lúa: El Puente Afectivo Tangible <span class="gradient-text-orange">entre Consulta, Aula y Hogar</span>
        </h1>

        <p class="hero-narrative-lead">
          Figura física de cuerpo entero con <strong>visor circular integrado</strong>, ampliada con <strong>sets de bloques manipulativos (EN 71-1) y Realidad Aumentada</strong> para <strong>Valeria+</strong> y <strong>Descubre con Lúa</strong>. La aplicación guía, Lúa acompaña: no mide, no juzga y <strong>jamás escucha</strong>.
        </p>

        <div class="hero-badge-pill-row">
          <span class="badge-pill pill-cyan">🚀 Incubada en startTIC · Alta Tecnología</span>
          <span class="badge-pill pill-orange">🐱 Visor Circular + Bloques EN 71-1</span>
          <span class="badge-pill pill-purple">✨ Realidad Aumentada Zero-PHI</span>
          <span class="badge-pill pill-emerald">🔇 Cero Micrófonos · Silencio Clínico</span>
        </div>

        <div class="card-action-row" style="justify-content: center; margin-top: 0.5rem;">
          <button type="button" class="hero-btn btn-orange" data-open-contact style="border: none; cursor: pointer; font-family: inherit;">
            <span>Solicitar Información o Demo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </button>
          <a href="#arquitectura-sets-steam" class="hero-btn btn-ghost">
            <span>Explorar Sets STEAM + AR</span>
          </a>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Visor Circular, Espejo de App & Sets Manipulativos (38% - 70% Scroll) -->
    <div id="lua-phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Una Sola Mascota · Del Visor Circular a la Mesa de Juego</span>
        </div>
        <h2 class="hero-headline gradient-text-orange">
          Espejo Visual, Sets Manipulativos y Descanso 20-20-20.
        </h2>

        <div class="lua-showcase-grid">
          <!-- Left: Feature Cards -->
          <div class="showcase-cards-col">
            <div class="lua-feature-card">
              <div class="feature-icon-badge icon-orange">🪞</div>
              <div class="feature-text">
                <strong>Espejo de Actividad y Compañía (Valeria+)</strong>
                <p>Muestra en su visor circular los turnos de juego, <strong>120 pictogramas en arte voxel</strong>, <strong>45 insignias</strong>, el armario de coleccionables y responde a las caricias con ronroneo visual.</p>
              </div>
            </div>

            <div class="lua-feature-card">
              <div class="feature-icon-badge icon-cyan">🧱</div>
              <div class="feature-text">
                <strong>Sets de Bloques STEAM y Realidad Aumentada</strong>
                <p>Figura sin motores ni ruido mecánico con encajes modulares para los sets sensoriales y orofaciales de <strong>Valeria+</strong> y los circuitos tangibles de <strong>Descubre con Lúa</strong>.</p>
              </div>
            </div>

            <div class="lua-feature-card">
              <div class="feature-icon-badge icon-purple">🔒</div>
              <div class="feature-text">
                <strong>Ancla Visual 20-20-20 y Silencio Clínico (VIA+)</strong>
                <p>Invita a descansar la vista cada 20 minutos echándose a dormir y entra en bloqueo silencioso inmediato durante exploraciones médicas en consulta.</p>
              </div>
            </div>
          </div>

          <!-- Right: Interactive Device Simulator & Pixel Canvas -->
          <div class="showcase-device-col">
            <div class="lua-physical-device">
              <div class="device-bezel-outer">
                <div class="bezel-led-ring">
                  <div class="led-dot led-1 active"></div>
                  <div class="led-dot led-2 active"></div>
                  <div class="led-dot led-3 active"></div>
                  <div class="led-dot led-4 active"></div>
                </div>
                <div class="device-screen-circular">
                  <canvas id="lua-hero-canvas" width="240" height="240" class="pixel-display-canvas"></canvas>
                  <div class="screen-glare-overlay"></div>
                </div>
              </div>
              <div class="device-caption-row">
                <span class="device-badge">Visor Circular Integrado · 25 Expresiones + 120 Fichas Voxel</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: Cero Castigo, Silencio Clínico & CTAs (75% - 100% Scroll) -->
    <div id="lua-phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-showcase">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Ética Pediátrica &amp; Acompañamiento Clínico</span>
        </div>
        <h2 class="hero-headline gradient-text-emerald">
          Diseñada para Animar, Nunca para Juzgar.
        </h2>

        <div class="lua-dual-showcase">
          <!-- Col 1: Ética Pediátrica -->
          <div class="lua-info-card glass-card">
            <div class="card-accent-tag text-orange">🐱 Gamificación Responsable</div>
            <h3>Principio de Cero Castigo</h3>
            <p>
              Cuando un intento no sale a la primera, Lúa <strong>nunca llora, ni pone cara triste, ni emite sonidos de error</strong>: mantiene una expresión atenta y serena, protegiendo la autoestima infantil y acompañando el aprendizaje sin frustración.
            </p>
            <div class="card-mini-badges">
              <span class="mini-tag">🛡️ Cero Frustración</span>
              <span class="mini-tag">💖 Refuerzo Positivo</span>
              <span class="mini-tag">🔇 Cero Micrófonos</span>
            </div>
          </div>

          <!-- Col 2: Conexión con el Ecosistema -->
          <div class="lua-info-card glass-card">
            <div class="card-accent-tag text-cyan">🔄 Ecosistema Earlify Health</div>
            <h3>Privacidad Estructural y Continuidad</h3>
            <p>
              Sincronización inalámbrica local sin transmisión de textos ni datos personales. Une el hogar (<strong>Valeria+</strong>), el aula (<strong>Descubre con Lúa</strong>), el juego manipulativo (<strong>Lúa Construye</strong>) y la consulta (<strong>VIA+</strong>).
            </p>
            <div class="card-action-row">
              <button type="button" class="hero-btn btn-orange" data-open-contact style="border: none; cursor: pointer; font-family: inherit;">
                <span>Contactar con el Dr. Betances</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
              <a href={`${baseUrl}/construye-con-lua`} class="hero-btn btn-ghost">
                <span>Ver Lúa Construye</span>
              </a>
              <a href={`${baseUrl}/earlify`} class="hero-btn btn-ghost">
                <span>Ecosistema Earlify</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initLuaHero() {
    const heroSection = document.getElementById('lua-hero-scrub');
    const scrollStarter = document.getElementById('lua-scroll-starter');
    const tracker = document.getElementById('lua-tracker');
    const fill0 = document.getElementById('lua-fill-0');
    const fill1 = document.getElementById('lua-fill-1');
    const fill2 = document.getElementById('lua-fill-2');
    const phase0 = document.getElementById('lua-phase-0');
    const phase1 = document.getElementById('lua-phase-1');
    const phase2 = document.getElementById('lua-phase-2');
    const bgStage = document.getElementById('lua-hero-bg-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    function calcOpacity(progress: number, fadeInStart: number, fadeInEnd: number, fadeOutStart: number, fadeOutEnd: number) {
      if (progress < fadeInStart) return 0;
      if (progress < fadeInEnd) {
        return fadeInStart === fadeInEnd ? 1 : (progress - fadeInStart) / (fadeInEnd - fadeInStart);
      }
      if (progress <= fadeOutStart) return 1;
      if (progress < fadeOutEnd) {
        return 1 - (progress - fadeOutStart) / (fadeOutEnd - fadeOutStart);
      }
      return 0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      } else {
        targetProgress = 0;
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      currentProgress += (targetProgress - currentProgress) * 0.18;

      const opStarter = calcOpacity(targetProgress, 0.0, 0.0, 0.03, 0.08);
      if (scrollStarter) {
        scrollStarter.style.opacity = opStarter.toFixed(3);
        scrollStarter.style.pointerEvents = opStarter > 0.4 ? 'auto' : 'none';
      }

      const op0 = calcOpacity(targetProgress, 0.0, 0.0, 0.20, 0.35);
      const op1 = calcOpacity(targetProgress, 0.30, 0.40, 0.65, 0.74);
      const op2 = calcOpacity(targetProgress, 0.70, 0.80, 1.0, 1.0);

      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${-targetProgress * 35}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.52 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.88 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      if (tracker) {
        tracker.style.opacity = '1';
      }

      if (bgStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const artOpacity = Math.max(0.35, 0.65 - currentProgress * 0.20);
        bgStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        bgStage.style.opacity = artOpacity.toFixed(3);
      }

      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, (targetProgress / 0.34) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.34) / 0.34) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.68) / 0.32) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  // Pixel Canvas Interactive Drawing (Lúa in 24x24 pixel art inside GC9A01 screen)
  function initLuaCanvas() {
    const canvas = document.getElementById('lua-hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Standard Lúa 24x24 palette
    const P = {
      BG: '#0B0F19',
      WHITE: '#FFFFFF',
      EYE_DARK: '#0F172A',
      TURQUOISE: '#00F2FE',
      PINK: '#F472B6',
      GOLD: '#FBBF24',
      ORANGE: '#FB923C'
    };

    let frame = 0;
    function drawLuaCat() {
      frame++;
      ctx!.fillStyle = P.BG;
      ctx!.fillRect(0, 0, 240, 240);

      // Circular clip and grid rendering
      const scale = 8;
      const ox = 24;
      const oy = 24;

      // Base cat head outline & body in canonical pixel art
      ctx!.fillStyle = '#1E293B';
      // Head base
      ctx!.fillRect(ox + 5 * scale, oy + 4 * scale, 14 * scale, 14 * scale);
      // Ears
      ctx!.fillRect(ox + 4 * scale, oy + 2 * scale, 4 * scale, 4 * scale);
      ctx!.fillRect(ox + 16 * scale, oy + 2 * scale, 4 * scale, 4 * scale);

      // Inner ears (pink)
      ctx!.fillStyle = P.PINK;
      ctx!.fillRect(ox + 5 * scale, oy + 3 * scale, 2 * scale, 2 * scale);
      ctx!.fillRect(ox + 17 * scale, oy + 3 * scale, 2 * scale, 2 * scale);

      // Cute Eyes with blink cycle
      const isBlinking = (frame % 140 > 132);
      ctx!.fillStyle = P.TURQUOISE;
      if (isBlinking) {
        ctx!.fillRect(ox + 7 * scale, oy + 9 * scale, 3 * scale, 1 * scale);
        ctx!.fillRect(ox + 14 * scale, oy + 9 * scale, 3 * scale, 1 * scale);
      } else {
        // Sparkling eyes
        ctx!.fillRect(ox + 7 * scale, oy + 7 * scale, 3 * scale, 4 * scale);
        ctx!.fillRect(ox + 14 * scale, oy + 7 * scale, 3 * scale, 4 * scale);

        // Eye highlights
        ctx!.fillStyle = P.WHITE;
        ctx!.fillRect(ox + 7 * scale, oy + 7 * scale, 1 * scale, 1 * scale);
        ctx!.fillRect(ox + 14 * scale, oy + 7 * scale, 1 * scale, 1 * scale);
      }

      // Snout & Cheeks
      ctx!.fillStyle = P.PINK;
      ctx!.fillRect(ox + 5 * scale, oy + 11 * scale, 2 * scale, 1 * scale);
      ctx!.fillRect(ox + 17 * scale, oy + 11 * scale, 2 * scale, 1 * scale);

      // Nose
      ctx!.fillStyle = P.ORANGE;
      ctx!.fillRect(ox + 11 * scale, oy + 10 * scale, 2 * scale, 1 * scale);

      // Mouth
      ctx!.fillStyle = P.WHITE;
      ctx!.fillRect(ox + 11 * scale, oy + 12 * scale, 2 * scale, 1 * scale);

      // Outer Turquoise Ring with breathing glow
      const glow = Math.sin(frame * 0.05) * 4 + 8;
      ctx!.strokeStyle = 'rgba(0, 242, 254, 0.8)';
      ctx!.lineWidth = 3;
      ctx!.shadowBlur = glow;
      ctx!.shadowColor = '#00F2FE';
      ctx!.beginPath();
      ctx!.arc(120, 120, 112, 0, Math.PI * 2);
      ctx!.stroke();
      ctx!.shadowBlur = 0;

      requestAnimationFrame(drawLuaCat);
    }

    drawLuaCat();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLuaHero();
      initLuaCanvas();
    });
  } else {
    initLuaHero();
    initLuaCanvas();
  }
  document.addEventListener('astro:page-load', () => {
    initLuaHero();
    initLuaCanvas();
  });
</script>

<style>
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    background-color: var(--bg-dark);
  }

  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.28;
    pointer-events: none;
  }

  .orb-orange {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #f97316 0%, rgba(249, 115, 22, 0) 70%);
    top: -100px;
    left: -150px;
  }

  .orb-cyan {
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, #00F2FE 0%, rgba(0, 242, 254, 0) 70%);
    bottom: -100px;
    right: -100px;
  }

  .orb-purple {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, #8A2BE2 0%, rgba(138, 43, 226, 0) 70%);
    top: 30%;
    left: 45%;
    transform: translate(-50%, -50%);
    opacity: 0.15;
  }

  .hero-lua-bg-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100vh;
    z-index: 2;
    will-change: transform, opacity;
    opacity: 0.65;
  }

  .lua-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    filter: brightness(0.85) contrast(1.08) saturate(1.15);
  }

  .lua-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.25) 0%, rgba(7, 9, 14, 0.8) 75%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    z-index: 3;
  }

  .lua-mascot-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.25rem auto;
  }

  .lua-brand-icon {
    width: 100px;
    height: 100px;
    border-radius: 24px;
    box-shadow: 0 0 40px rgba(249, 115, 22, 0.45), 0 10px 25px rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.15);
    display: block;
    animation: floatIcon 4s ease-in-out infinite alternate;
  }

  @keyframes floatIcon {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  .hero-scroll-starter {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 8;
    will-change: opacity;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .starter-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .hint-mouse {
    width: 22px;
    height: 36px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
  }

  .mouse-wheel {
    width: 3px;
    height: 7px;
    background: #fb923c;
    border-radius: 2px;
    animation: scrollAnim 1.8s ease-in-out infinite;
  }

  @keyframes scrollAnim {
    0% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(8px); opacity: 0.4; }
    100% { transform: translateY(0); opacity: 1; }
  }

  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: #f97316;
    transition: width 0.1s linear;
  }

  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5.5rem 1.5rem 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .hero-phase-panel.phase-initial {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 980px;
    margin: 0 auto;
  }

  .max-w-showcase {
    max-width: 1100px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
