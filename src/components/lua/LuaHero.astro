---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<section id="lua-hero" class="lua-hero-section">
  <!-- Ambient Glow & Lifestyle Backdrop -->
  <div class="hero-background-canvas" aria-hidden="true">
    <div class="hero-lua-bg-stage">
      <img 
        src={`${baseUrl}/assets/valeria-lua-hero-bg.jpg?v=1`} 
        alt="Figura física de Lúa con visor circular junto a interacción familiar y bloques manipulativos" 
        class="lua-artwork-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="lua-overlay-gradient"></div>
    </div>
    <div class="glow-orb orb-orange"></div>
    <div class="glow-orb orb-cyan"></div>
    <div class="glow-orb orb-purple"></div>
    <div class="hero-grid-pattern"></div>
  </div>

  <div class="container hero-content-wrapper">
    <!-- Top Intro Block -->
    <div class="hero-top-intro">
      <div class="lua-mascot-icon-wrapper">
        <img 
          src={`${baseUrl}/assets/valeria_lua.png`} 
          alt="Lúa la Gata - Compañera física interactiva de Earlify Health" 
          class="lua-brand-icon" 
          width="105"
          height="105"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="editorial-eyebrow eyebrow-orange">
        <span>Compañera Física Interactiva · Juego STEAM + Realidad Aumentada</span>
      </div>

      <h1 class="hero-headline">
        Lúa: El Puente Afectivo Tangible <span class="gradient-text-orange">entre Consulta, Aula y Hogar</span>
      </h1>

      <p class="hero-narrative-lead">
        Figura física de cuerpo entero con <strong>visor circular integrado</strong>, ampliada con <strong>sets de bloques manipulativos (EN 71-1) y Realidad Aumentada</strong> para <strong>Valeria+</strong> y <strong>Descubre con Lúa</strong>. La aplicación guía, Lúa acompaña: no mide, no juzga y <strong>jamás escucha</strong>.
      </p>

      <div class="hero-badge-pill-row">
        <span class="badge-pill pill-cyan">🚀 Incubada en startTIC · Alta Tecnología</span>
        <span class="badge-pill pill-orange">🐱 Visor Circular + Bloques EN 71-1</span>
        <span class="badge-pill pill-purple">✨ Realidad Aumentada Zero-PHI</span>
        <span class="badge-pill pill-emerald">🔇 Cero Micrófonos · Silencio Clínico</span>
      </div>

      <div class="card-action-row">
        <button type="button" class="hero-btn btn-orange" data-open-contact>
          <span>Solicitar Información o Demo</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </button>
        <a href="#arquitectura-sets-steam" class="hero-btn btn-ghost">
          <span>Explorar Sets STEAM + AR</span>
        </a>
        <a href={`${baseUrl}/construye-con-lua`} class="hero-btn btn-ghost">
          <span>Ver Lúa Construye</span>
        </a>
      </div>
    </div>

    <!-- Bottom Showcase Grid: 3 Feature Cards + Interactive Circular Visor Canvas -->
    <div class="lua-showcase-grid">
      <div class="showcase-cards-col">
        <div class="lua-feature-card">
          <div class="feature-icon-badge icon-orange">🪞</div>
          <div class="feature-text">
            <strong>Espejo de Actividad y Compañía (Valeria+)</strong>
            <p>Muestra en su visor circular los turnos de juego, <strong>120 pictogramas en arte voxel</strong>, <strong>45 insignias</strong>, el armario de coleccionables y responde a las caricias con ronroneo visual.</p>
          </div>
        </div>

        <div class="lua-feature-card">
          <div class="feature-icon-badge icon-cyan">🧱</div>
          <div class="feature-text">
            <strong>Sets de Bloques STEAM y Realidad Aumentada</strong>
            <p>Figura sin motores ni ruido mecánico con encajes modulares para los sets sensoriales y orofaciales de <strong>Valeria+</strong> y los circuitos tangibles de <strong>Descubre con Lúa</strong>.</p>
          </div>
        </div>

        <div class="lua-feature-card">
          <div class="feature-icon-badge icon-purple">🔒</div>
          <div class="feature-text">
            <strong>Ancla Visual 20-20-20 y Silencio Clínico (VIA+)</strong>
            <p>Invita a descansar la vista cada 20 minutos echándose a dormir y entra en bloqueo silencioso inmediato durante exploraciones médicas en consulta.</p>
          </div>
        </div>
      </div>

      <div class="showcase-device-col">
        <div class="lua-physical-device">
          <div class="device-bezel-outer">
            <div class="bezel-led-ring">
              <div class="led-dot led-1 active"></div>
              <div class="led-dot led-2 active"></div>
              <div class="led-dot led-3 active"></div>
              <div class="led-dot led-4 active"></div>
            </div>
            <div class="device-screen-circular">
              <canvas id="lua-hero-canvas" width="240" height="240" class="pixel-display-canvas"></canvas>
              <div class="screen-glare-overlay"></div>
            </div>
          </div>
          <div class="device-caption-row">
            <span class="device-badge">Visor Circular Integrado · 25 Expresiones + 120 Fichas Voxel</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initLuaCanvas() {
    const canvas = document.getElementById('lua-hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const P = {
      BG: '#0B0F19',
      WHITE: '#FFFFFF',
      EYE_DARK: '#0F172A',
      TURQUOISE: '#00F2FE',
      PINK: '#F472B6',
      GOLD: '#FBBF24',
      ORANGE: '#FB923C'
    };

    let frame = 0;
    function drawLuaCat() {
      frame++;
      ctx!.fillStyle = P.BG;
      ctx!.fillRect(0, 0, 240, 240);

      const scale = 8;
      const ox = 24;
      const oy = 24;

      ctx!.fillStyle = '#1E293B';
      ctx!.fillRect(ox + 5 * scale, oy + 4 * scale, 14 * scale, 14 * scale);
      ctx!.fillRect(ox + 4 * scale, oy + 2 * scale, 4 * scale, 4 * scale);
      ctx!.fillRect(ox + 16 * scale, oy + 2 * scale, 4 * scale, 4 * scale);

      ctx!.fillStyle = P.PINK;
      ctx!.fillRect(ox + 5 * scale, oy + 3 * scale, 2 * scale, 2 * scale);
      ctx!.fillRect(ox + 17 * scale, oy + 3 * scale, 2 * scale, 2 * scale);

      const isBlinking = (frame % 140 > 132);
      ctx!.fillStyle = P.TURQUOISE;
      if (isBlinking) {
        ctx!.fillRect(ox + 7 * scale, oy + 9 * scale, 3 * scale, 1 * scale);
        ctx!.fillRect(ox + 14 * scale, oy + 9 * scale, 3 * scale, 1 * scale);
      } else {
        ctx!.fillRect(ox + 7 * scale, oy + 7 * scale, 3 * scale, 4 * scale);
        ctx!.fillRect(ox + 14 * scale, oy + 7 * scale, 3 * scale, 4 * scale);

        ctx!.fillStyle = P.WHITE;
        ctx!.fillRect(ox + 7 * scale, oy + 7 * scale, 1 * scale, 1 * scale);
        ctx!.fillRect(ox + 14 * scale, oy + 7 * scale, 1 * scale, 1 * scale);
      }

      ctx!.fillStyle = P.PINK;
      ctx!.fillRect(ox + 5 * scale, oy + 11 * scale, 2 * scale, 1 * scale);
      ctx!.fillRect(ox + 17 * scale, oy + 11 * scale, 2 * scale, 1 * scale);

      ctx!.fillStyle = P.ORANGE;
      ctx!.fillRect(ox + 11 * scale, oy + 10 * scale, 2 * scale, 1 * scale);

      ctx!.fillStyle = P.WHITE;
      ctx!.fillRect(ox + 11 * scale, oy + 12 * scale, 2 * scale, 1 * scale);

      const glow = Math.sin(frame * 0.05) * 4 + 8;
      ctx!.strokeStyle = 'rgba(0, 242, 254, 0.8)';
      ctx!.lineWidth = 3;
      ctx!.shadowBlur = glow;
      ctx!.shadowColor = '#00F2FE';
      ctx!.beginPath();
      ctx!.arc(120, 120, 112, 0, Math.PI * 2);
      ctx!.stroke();
      ctx!.shadowBlur = 0;

      requestAnimationFrame(drawLuaCat);
    }

    drawLuaCat();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuaCanvas);
  } else {
    initLuaCanvas();
  }
  document.addEventListener('astro:page-load', initLuaCanvas);
</script>

<style>
  .lua-hero-section {
    position: relative;
    padding: 8.5rem 0 5rem 0;
    width: 100%;
    background-color: var(--bg-dark);
    overflow: hidden;
  }

  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .hero-lua-bg-stage {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.55;
    pointer-events: none;
  }

  .lua-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    filter: brightness(0.75) contrast(1.08) saturate(1.15);
  }

  .lua-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 40%, rgba(7, 9, 14, 0.35) 0%, rgba(7, 9, 14, 0.85) 75%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.25;
    pointer-events: none;
  }

  .orb-orange {
    width: 560px;
    height: 560px;
    background: radial-gradient(circle, #f97316 0%, rgba(249, 115, 22, 0) 70%);
    top: -100px;
    left: -120px;
  }

  .orb-cyan {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, #00F2FE 0%, rgba(0, 242, 254, 0) 70%);
    bottom: -100px;
    right: -100px;
  }

  .orb-purple {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, #8A2BE2 0%, rgba(138, 43, 226, 0) 70%);
    top: 30%;
    left: 45%;
    transform: translate(-50%, -50%);
    opacity: 0.15;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 40%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, black 30%, transparent 80%);
    z-index: 3;
  }

  .hero-content-wrapper {
    position: relative;
    z-index: 5;
  }

  .hero-top-intro {
    text-align: center;
    max-width: 960px;
    margin: 0 auto 3.5rem auto;
  }

  .lua-mascot-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.25rem auto;
  }

  .lua-brand-icon {
    width: 96px;
    height: 96px;
    border-radius: 24px;
    box-shadow: 0 0 40px rgba(249, 115, 22, 0.45), 0 10px 25px rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.15);
    display: block;
    animation: floatIcon 4s ease-in-out infinite alternate;
  }

  @keyframes floatIcon {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .eyebrow-orange { color: #fb923c; }

  .hero-headline {
    font-size: clamp(2.1rem, 4.2vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .gradient-text-orange {
    background: linear-gradient(135deg, #FFFFFF 20%, #fb923c 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-narrative-lead {
    font-size: clamp(1.02rem, 1.6vw, 1.22rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 840px;
    margin: 0 auto 1.75rem auto;
  }

  .hero-narrative-lead strong {
    color: var(--text-main);
  }

  .hero-badge-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.85rem;
  }

  .badge-pill {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-orange {
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.4);
    color: #fdba74;
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #D8B4FE;
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  .card-action-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    align-items: center;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.25s ease;
  }

  .btn-orange {
    background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
    color: #FFFFFF;
    box-shadow: 0 0 25px rgba(249, 115, 22, 0.4);
  }

  .btn-orange:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(249, 115, 22, 0.6);
  }

  .btn-ghost {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .lua-showcase-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    max-width: 1120px;
    margin: 0 auto;
    text-align: left;
  }

  .showcase-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lua-feature-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .lua-feature-card:hover {
    transform: translateX(4px);
    border-color: rgba(249, 115, 22, 0.4);
  }

  .feature-icon-badge {
    font-size: 1.6rem;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-orange {
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.4);
  }

  .icon-cyan {
    background: rgba(0, 242, 254, 0.15);
    border: 1px solid rgba(0, 242, 254, 0.4);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .feature-text strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .feature-text p {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .showcase-device-col {
    display: flex;
    justify-content: center;
  }

  .lua-physical-device {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .device-bezel-outer {
    position: relative;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, #1E293B 0%, #0F172A 70%, #020617 100%);
    border: 6px solid #334155;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9), 0 0 45px rgba(249, 115, 22, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .bezel-led-ring {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    pointer-events: none;
  }

  .led-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(0, 242, 254, 0.4);
  }

  .led-1 { top: 12px; left: 50%; transform: translateX(-50%); }
  .led-2 { bottom: 12px; left: 50%; transform: translateX(-50%); }
  .led-3 { left: 12px; top: 50%; transform: translateY(-50%); }
  .led-4 { right: 12px; top: 50%; transform: translateY(-50%); }

  .led-dot.active {
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  .device-screen-circular {
    position: relative;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    overflow: hidden;
    background: #0B0F19;
    border: 2px solid rgba(0, 242, 254, 0.3);
  }

  .pixel-display-canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    display: block;
  }

  .screen-glare-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
    pointer-events: none;
    border-radius: 50%;
  }

  .device-caption-row {
    display: flex;
    justify-content: center;
  }

  .device-badge {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    text-align: center;
  }

  @media (max-width: 900px) {
    .lua-showcase-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .lua-hero-section {
      padding: 6.5rem 0 3.5rem 0;
    }
    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
