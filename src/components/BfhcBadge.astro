---
interface Props {
  variant?: 'hero' | 'card';
}

const { variant = 'hero' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;
---

<a
  href="https://bfhealthcare.gal"
  target="_blank"
  rel="noopener noreferrer"
  class={`bfhc-badge bfhc-${variant}`}
  aria-label="Business Factory Health&Care (bfhealthcare.gal)"
  title="Business Factory Health&Care"
>
  <img
    src={`${baseUrl}/assets/bfhc-white.svg`}
    alt="Business Factory Health&Care"
    class="bfhc-logo-img"
    decoding="async"
  />
</a>

<style>
  .bfhc-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.42rem 0.95rem;
    border-radius: 9999px;
    background: rgba(15, 27, 100, 0.55);
    border: 1px solid rgba(56, 189, 248, 0.42);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    max-width: 100%;
  }

  .bfhc-badge:hover {
    background: rgba(15, 27, 100, 0.8);
    border-color: rgba(56, 189, 248, 0.8);
    transform: translateY(-1px);
  }

  .bfhc-card {
    padding: 0.35rem 0.8rem;
    margin-bottom: 0.45rem;
    width: fit-content;
  }

  .bfhc-logo-img {
    height: 20px;
    width: auto;
    max-width: 100%;
    display: block;
    object-fit: contain;
  }

  .bfhc-card .bfhc-logo-img {
    height: 18px;
  }

  @media (max-width: 640px) {
    .bfhc-logo-img {
      height: 17px;
    }
  }
</style>
