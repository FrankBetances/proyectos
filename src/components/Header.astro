---
interface Props {
  activeTab?: 'home' | 'cv' | 'via' | 'earlify' | 'quisqueya' | 'lua';
}

const { activeTab = 'home' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<header class="site-header print-hide">
  <div class="container header-content">
    <a href={`${baseUrl}/`} class="logo" aria-label="Ir al inicio de la web del Dr. Frank Betances">
      <img src={`${baseUrl}/assets/dr-betances-logo.jpg`} alt="Logo Dr. Frank Betances" class="logo-img" width="44" height="44" />
      <div class="logo-text">
        <span class="logo-name">Dr. Frank <span class="plus">Betances</span></span>
        <span class="logo-tagline">ORL & Salud Digital</span>
      </div>
    </a>

    <nav class="nav-links" id="main-navigation" aria-label="Navegación principal">
      <a href={`${baseUrl}/earlify`} class={activeTab === 'earlify' ? 'active' : ''}>
        <span class="nav-pill nav-purple">Earlify Health</span>
      </a>
      <a href={`${baseUrl}/`} class={activeTab === 'home' ? 'active' : ''}>Valeria+</a>
      <a href={`${baseUrl}/via`} class={activeTab === 'via' ? 'active' : ''}>
        <span class="nav-pill nav-cyan">VIA+ (SaMD)</span>
      </a>
      <a href={`${baseUrl}/lua`} class={activeTab === 'lua' ? 'active' : ''}>
        <span class="nav-pill nav-orange">Lúa (Hardware)</span>
      </a>
      <a href={`${baseUrl}/quisqueya-habla`} class={activeTab === 'quisqueya' ? 'active' : ''}>
        <span class="nav-pill nav-amber">Quisqueya Habla</span>
      </a>
      <a href={`${baseUrl}/cv`} class={activeTab === 'cv' ? 'active' : ''}>Currículum (CV)</a>
    </nav>

    <div class="header-actions">
      <a 
        href="https://play.google.com/store/apps/details?id=eu.futureforkids.valeria" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-header-play" 
        aria-label="Descargar Valeria+ en Google Play"
      >
        <svg class="header-play-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.609 1.814L13.792 12 3.61 22.186A2.02 2.02 0 0 1 3.39 21.8C3.14 21.28 3 20.67 3 19.98V4.02c0-.69.14-1.3.39-1.82.065-.137.14-.268.219-.386z" fill="#00D2FF"/>
          <path d="M17.472 8.448L5.037.824 13.792 12l3.68-3.552z" fill="#00E676"/>
          <path d="M17.472 15.552L13.792 12 5.037 23.176l12.435-7.624z" fill="#FF5252"/>
          <path d="M20.803 10.428l-3.331-2.043-3.68 3.615 3.68 3.552 3.331-2.043c.96-.588.96-2.493 0-3.081z" fill="#FFD600"/>
        </svg>
        <span>Google Play</span>
      </a>

      <a href="https://github.com/FrankBetances" target="_blank" rel="noopener noreferrer" class="btn-github" aria-label="Ver perfil de GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>GitHub</span>
      </a>

      <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="main-navigation">
        <svg class="icon-hamburger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const nav = document.getElementById('main-navigation');

    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('mobile-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      nav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          nav.classList.remove('mobile-open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(7, 9, 14, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    height: 76px;
    display: flex;
    align-items: center;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(0, 242, 254, 0.5);
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.2);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .logo-name .plus {
    color: var(--accent-cyan);
  }

  .logo-tagline {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.925rem;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text-main);
  }

  .nav-pill {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .nav-purple {
    background: rgba(168, 85, 247, 0.15);
    color: #C084FC;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .nav-purple:hover,
  .active .nav-purple {
    background: rgba(168, 85, 247, 0.3);
    color: #F3E8FF;
    border-color: rgba(168, 85, 247, 0.6);
  }

  .nav-cyan {
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .nav-cyan:hover,
  .active .nav-cyan {
    background: rgba(0, 242, 254, 0.25);
    color: #FFFFFF;
    border-color: rgba(0, 242, 254, 0.5);
  }

  .nav-orange {
    background: rgba(249, 115, 22, 0.15);
    color: #fb923c;
    border: 1px solid rgba(249, 115, 22, 0.3);
  }

  .nav-orange:hover,
  .active .nav-orange {
    background: rgba(249, 115, 22, 0.3);
    color: #ffedd5;
    border-color: rgba(249, 115, 22, 0.6);
  }

  .nav-amber {
    background: rgba(245, 158, 11, 0.15);
    color: #FBBF24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .nav-amber:hover,
  .active .nav-amber {
    background: rgba(245, 158, 11, 0.3);
    color: #FEF3C7;
    border-color: rgba(245, 158, 11, 0.6);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn-header-play {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.85rem;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.35);
    border-radius: var(--radius-full);
    color: var(--accent-cyan);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .btn-header-play:hover {
    background: rgba(0, 242, 254, 0.2);
    border-color: rgba(0, 242, 254, 0.7);
    color: #FFFFFF;
    box-shadow: 0 0 14px rgba(0, 242, 254, 0.25);
    transform: translateY(-1px);
  }

  .header-play-icon {
    flex-shrink: 0;
  }

  .btn-github {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-main);
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-toggle .icon-close {
    display: none;
  }

  @media (max-width: 960px) {
    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-links {
      position: fixed;
      top: 76px;
      left: 0;
      right: 0;
      background: rgba(7, 9, 14, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-light);
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem;
      gap: 0.75rem;
      display: none;
      max-height: calc(100vh - 76px);
      overflow-y: auto;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
    }

    .nav-links a {
      padding: 0.65rem 0.75rem;
      font-size: 1rem;
      border-radius: var(--radius-sm);
    }

    .nav-links.mobile-open {
      display: flex;
    }

    .mobile-toggle[aria-expanded="true"] .icon-hamburger {
      display: none;
    }

    .mobile-toggle[aria-expanded="true"] .icon-close {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      height: 68px;
    }

    .nav-links {
      top: 68px;
      max-height: calc(100vh - 68px);
      padding: 1.25rem 1rem;
    }

    .logo-img {
      width: 38px;
      height: 38px;
    }

    .logo-name {
      font-size: 1.1rem;
    }

    .logo-tagline {
      font-size: 0.68rem;
    }

    .btn-header-play span,
    .btn-github span {
      display: none;
    }

    .btn-header-play,
    .btn-github {
      padding: 0.45rem;
      border-radius: 50%;
    }
  }

  @media (max-width: 380px) {
    .logo-tagline {
      display: none;
    }
  }
</style>
