---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;

const steamWorlds = [
  {
    set: "Kit Lúa",
    fenomeno: "Construcción física y afecto",
    gesto: "Montar el cuerpo de la gata con bloques",
    usoValeria: "Crea vínculo afectivo y complicidad antes de empezar a jugar",
    badge: "Núcleo Común",
    badgeColor: "orange"
  },
  {
    set: "El Camino de Lúa",
    fenomeno: "Orientación espacial y rutas",
    gesto: "Colocar baldosas y guiar a Lúa",
    usoValeria: "Aprender conceptos espaciales (delante, detrás, giro) y ordenar secuencias",
    badge: "Secuenciación",
    badgeColor: "cyan"
  },
  {
    set: "Estación de Sonido y Eco",
    fenomeno: "Vibración y ritmo acústico",
    gesto: "Tocar piezas sonoras y raspar texturas",
    usoValeria: "Afinar el oído, marcar el compás y distinguir palabras con sonidos parecidos",
    badge: "Acústica & Ritmo",
    badgeColor: "purple"
  },
  {
    set: "Rampas y Gravedad",
    fenomeno: "Movimiento, velocidad y caída",
    gesto: "Esperar la señal y soltar la esfera",
    usoValeria: "Trabajar la paciencia, la espera de turnos y el seguimiento visual",
    badge: "Atención",
    badgeColor: "teal"
  },
  {
    set: "Juego de Soplo y Viento",
    fenomeno: "Flujo de aire y causa-efecto",
    gesto: "Dosificar el soplo sobre molinillos",
    usoValeria: "Control respiratorio y redondeo labial a través del juego espontáneo",
    badge: "Causa-Efecto",
    badgeColor: "amber"
  },
  {
    set: "Puente de Equilibrio",
    fenomeno: "Peso, balanza y contrapeso",
    gesto: "Colocar piezas en ambos extremos",
    usoValeria: "Descubrir conceptos opuestos (pesado/ligero, mucho/poco) y precisión con los dedos",
    badge: "Equilibrio & Léxico",
    badgeColor: "emerald"
  },
  {
    set: "Jardín de Luces y Sombras",
    fenomeno: "Luz, prismas y siluetas",
    gesto: "Interponer prismas y proyectar formas",
    usoValeria: "Construir relatos breves, inventar cuentos y ampliar el vocabulario descriptivo",
    badge: "Relato & Creatividad",
    badgeColor: "pink"
  }
];

const evidenceTable = [
  {
    afirmacion: "Manipular bloques físicos estimula el lenguaje y la orientación espacial",
    respaldo: "Ciencias del neurodesarrollo",
    uso: "Ayuda a la familia a introducir palabras de posición y relación mientras juegan."
  },
  {
    afirmacion: "Construir siguiendo modelos visuales fortalece la atención y el razonamiento",
    respaldo: "Psicología del aprendizaje",
    uso: "Las tarjetas ilustradas guían al niño paso a paso sin necesidad de corregir con enfado."
  },
  {
    afirmacion: "El juego cooperativo mediado por adultos mejora la comunicación social",
    respaldo: "Pediatría del desarrollo",
    uso: "Fomenta la mirada compartida, la toma de turnos y la iniciativa para pedir ayuda."
  },
  {
    afirmacion: "El refuerzo positivo sin frustración consolida el hábito de hablar",
    respaldo: "Logopedia y lingüística clínica",
    uso: "Lúa premia cada intento con una sonrisa y jamás resta puntos ante un error."
  }
];
---

<section id="steam-valeria" class="steam-valeria-section">
  <div class="container">
    
    <!-- 1. Header STEAM Eje Vertebrador -->
    <div class="section-header">
      <span class="tag tag-cyan">Aprendizaje Vivencial</span>
      <h2>Aprender Tocando: <span class="gradient-text">El juego con las manos despierta el habla</span></h2>
      <p>
        Los niños no aprenden palabras de memoria mirando una pantalla; aprenden cuando tocan, apilan, hacen rodar un objeto o descubren cómo suena una pieza. Valeria+ orienta a la familia para nombrar lo que están descubriendo juntos en el momento exacto en que surge la curiosidad.
      </p>
    </div>

    <!-- Cita Rectora -->
    <div class="axiom-box glass-card">
      <p class="axiom-text">
        «La app decide el reto. Lúa celebra el logro. Los bloques los mueve el niño. La familia guía el diálogo.»
      </p>
    </div>

    <!-- 2. Tabla de los Seis Mundos de Construye con Lúa -->
    <div class="worlds-block glass-card">
      <div class="block-top-header">
        <div>
          <span class="sub-tag text-teal">Construye con Lúa en Casa</span>
          <h3 class="block-h3">Los Seis Mundos de Estimulación y Juego</h3>
        </div>
        <a href={`${baseUrl}/construye-con-lua`} class="btn-link-steam">
          <span>Ver Kits de Bloques</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="table-responsive">
        <table class="steam-valeria-table">
          <thead>
            <tr>
              <th>Mundo de Juego</th>
              <th>Experiencia Práctica</th>
              <th>Qué Hace el Niño</th>
              <th>Qué Aprende a Comunicar</th>
            </tr>
          </thead>
          <tbody>
            {steamWorlds.map((item) => (
              <tr>
                <td>
                  <strong>{item.set}</strong>
                  <span class={`badge-world badge-${item.badgeColor}`}>{item.badge}</span>
                </td>
                <td>{item.fenomeno}</td>
                <td><em>{item.gesto}</em></td>
                <td>{item.usoValeria}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3. Realidad Aumentada sin Cámaras Invasivas -->
    <div class="ar-contract-block glass-card">
      <div class="contract-header">
        <div class="contract-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <div>
          <span class="sub-tag text-purple">Privacidad Absoluta en el Hogar</span>
          <h3 class="block-h3">Reconocimiento Visual del Juego: Cero Grabaciones y Cero Nube</h3>
        </div>
      </div>

      <p class="contract-lead">
        La cámara del dispositivo solo se utiliza para identificar el circuito o figura que habéis construido en la mesa. <strong>No guarda fotos, no graba vídeo ni envía datos a servidores externos</strong>: reconoce la silueta en memoria y Lúa reacciona al instante con un gesto de aprobación en su pantalla.
      </p>

      <!-- 3 Pasos Clave -->
      <div class="chain-grid">
        <div class="chain-step">
          <span class="step-num">1</span>
          <h4>Construcción Libre</h4>
          <p>El niño experimenta con las piezas físicas: coloca baldosas, rampas o resonadores en la mesa.</p>
        </div>
        <div class="chain-arrow">→</div>
        <div class="chain-step">
          <span class="step-num">2</span>
          <h4>Reconocimiento al Instante</h4>
          <p>Enfocas un segundo con el móvil o confirmas tú mismo el acierto con un toque en pantalla.</p>
        </div>
        <div class="chain-arrow">→</div>
        <div class="chain-step">
          <span class="step-num">3</span>
          <h4>Celebración y Diálogo</h4>
          <p>Lúa sonríe y la app te sugiere la palabra o pregunta ideal para enriquecer la conversación.</p>
        </div>
      </div>
    </div>

    <!-- 4. Cuentos Pedagógicos Dialógicos -->
    <div class="stories-block glass-card">
      <div class="stories-header">
        <div class="stories-icon">📖</div>
        <div>
          <span class="sub-tag text-amber">Lectura Compartida &amp; Recast</span>
          <h3 class="block-h3">Cuentos Pedagógicos Dialógicos: La Puerta Narrativa de Cada Mundo</h3>
        </div>
      </div>
      <p class="stories-desc">
        Inspirados en los microcuentos de <em>Descubre con Lúa</em> y adaptados a la estimulación del lenguaje en casa: cada unidad cuenta con <strong>3 o 4 láminas ilustradas</strong>. La historia la narra el adulto en voz alta; Lúa solo aporta refuerzo visual en su pantalla circular.
      </p>
      <div class="stories-pills-row">
        <div class="s-pill">
          <strong>Pregunta para el niño:</strong> Consigna breve para responder señalando o vocalizando.
        </div>
        <div class="s-pill">
          <strong>Pista para el adulto:</strong> Sugerencia de reformulación positiva (<em>recast</em>) y expansión léxica.
        </div>
        <div class="s-pill">
          <strong>Cero Examen:</strong> Refuerzan comprensión, secuenciación y atención conjunta sin calificar.
        </div>
      </div>
    </div>

    <!-- 5. Honestidad Epistemológica: Qué dice la evidencia y qué no -->
    <div class="evidence-block glass-card">
      <div class="evidence-header">
        <div class="evidence-icon">📊</div>
        <div>
          <span class="sub-tag text-emerald">Honestidad Epistemológica &amp; Rigor Científico</span>
          <h3 class="block-h3">Qué Dice la Evidencia Científica y Qué No</h3>
        </div>
      </div>

      <p class="evidence-lead">
        En Earlify Health diferenciamos con total transparencia los efectos con respaldo empírico de las hipótesis en desarrollo:
      </p>

      <div class="table-responsive">
        <table class="evidence-table">
          <thead>
            <tr>
              <th>Afirmación o Premisa</th>
              <th>Respaldo Científico Disponible</th>
              <th>Criterio Canónico de Uso en Valeria+</th>
            </tr>
          </thead>
          <tbody>
            {evidenceTable.map((row) => (
              <tr>
                <td><strong>{row.afirmacion}</strong></td>
                <td><span class="respaldo-tag">{row.respaldo}</span></td>
                <td>{row.uso}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<style>
  .steam-valeria-section {
    padding: 85px 0;
    position: relative;
    border-top: 1px solid var(--border-light);
  }

  .section-header {
    text-align: center;
    max-width: 880px;
    margin: 0 auto 3rem auto;
  }

  .tag-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .axiom-box {
    text-align: center;
    padding: 1.25rem 2rem;
    margin: 0 auto 3rem auto;
    max-width: 820px;
    background: rgba(249, 115, 22, 0.08);
    border: 1px solid rgba(249, 115, 22, 0.3);
  }

  .axiom-text {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fed7aa;
    font-style: italic;
  }

  .worlds-block {
    padding: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .block-top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sub-tag {
    display: block;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .text-teal { color: #2dd4bf; }
  .text-purple { color: #d8b4fe; }
  .text-amber { color: #fbbf24; }
  .text-emerald { color: #6ee7b7; }

  .block-h3 {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
  }

  .btn-link-steam {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-main);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-link-steam:hover {
    background: rgba(0, 242, 254, 0.15);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .steam-valeria-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .steam-valeria-table th {
    text-align: left;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .steam-valeria-table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    vertical-align: middle;
    line-height: 1.5;
  }

  .steam-valeria-table td strong {
    color: var(--text-main);
    display: block;
    margin-bottom: 0.25rem;
  }

  .badge-world {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .badge-orange { background: rgba(249, 115, 22, 0.15); border: 1px solid rgba(249, 115, 22, 0.35); color: #fb923c; }
  .badge-cyan { background: rgba(0, 242, 254, 0.15); border: 1px solid rgba(0, 242, 254, 0.35); color: #00F2FE; }
  .badge-purple { background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.35); color: #d8b4fe; }
  .badge-teal { background: rgba(0, 196, 190, 0.15); border: 1px solid rgba(0, 196, 190, 0.35); color: #2dd4bf; }
  .badge-amber { background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #fbbf24; }
  .badge-emerald { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #6ee7b7; }
  .badge-pink { background: rgba(244, 114, 182, 0.15); border: 1px solid rgba(244, 114, 182, 0.35); color: #f472b6; }

  /* Contrato AR */
  .ar-contract-block {
    padding: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .contract-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .contract-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .contract-lead {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .chain-grid {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .chain-step {
    flex: 1;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(168, 85, 247, 0.2);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #d8b4fe;
    font-weight: 800;
    font-family: monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .chain-step h4 {
    margin: 0 0 0.4rem 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .chain-step p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .chain-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--text-muted);
    padding: 0 0.25rem;
  }

  /* Cuentos */
  .stories-block {
    padding: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .stories-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .stories-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .stories-desc {
    font-size: 0.96rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .stories-pills-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .s-pill {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 1.15rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .s-pill strong {
    color: #fbbf24;
    display: block;
    margin-bottom: 0.25rem;
  }

  /* Evidencia */
  .evidence-block {
    padding: 2.25rem;
  }

  .evidence-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .evidence-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .evidence-lead {
    font-size: 0.96rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .evidence-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .evidence-table th {
    text-align: left;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
    font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .evidence-table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    vertical-align: top;
    line-height: 1.5;
  }

  .evidence-table td strong {
    color: var(--text-main);
  }

  .respaldo-tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #6ee7b7;
  }

  @media (max-width: 900px) {
    .chain-grid {
      flex-direction: column;
      gap: 0.85rem;
    }
    .chain-arrow {
      transform: rotate(90deg);
      padding: 0.25rem 0;
    }
  }
</style>
