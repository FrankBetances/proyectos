---
// EarlifyInteractiveEcosystem.astro - Explorador Dinámico del Ecosistema Pediátrico & Simulador del Metrónomo Visual
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="explorador-interactivo" class="interactive-ecosystem-section" aria-labelledby="interactive-heading">
  <div class="interactive-ambient-glow" aria-hidden="true"></div>

  <div class="container">
    <!-- Header -->
    <div class="section-intro">
      <div class="section-badge badge-purple">
        <svg class="badge-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>DINAMISMO & CONTINUIDAD ASISTENCIAL</span>
      </div>

      <h2 id="interactive-heading" class="section-title">
        Explora la continuidad: <span class="gradient-text-earlify">de la consulta al aula y al hogar</span>
      </h2>

      <p class="section-lead">
        Selecciona cada entorno para observar cómo se sincroniza la tecnología de Earlify bajo un mismo criterio clínico y pedagógico, sin depender de la nube y con privacidad Zero-PHI garantizada.
      </p>
    </div>

    <!-- Interactive Navigation Tabs -->
    <div class="eco-nav-wrapper">
      <div class="eco-nav-tabs" role="tablist" aria-label="Entornos del Ecosistema Earlify">
        <button 
          type="button" 
          role="tab" 
          id="tab-btn-via" 
          aria-selected="true" 
          aria-controls="panel-via" 
          class="eco-tab-btn active"
          data-target="via"
        >
          <span class="tab-indicator indicator-cyan"></span>
          <span class="tab-step">01</span>
          <span class="tab-name">Consulta Médica (VIA+)</span>
        </button>

        <button 
          type="button" 
          role="tab" 
          id="tab-btn-descubre" 
          aria-selected="false" 
          aria-controls="panel-descubre" 
          class="eco-tab-btn"
          data-target="descubre"
        >
          <span class="tab-indicator indicator-emerald"></span>
          <span class="tab-step">02</span>
          <span class="tab-name">El Aula Escolar (Descubre)</span>
        </button>

        <button 
          type="button" 
          role="tab" 
          id="tab-btn-valeria" 
          aria-selected="false" 
          aria-controls="panel-valeria" 
          class="eco-tab-btn"
          data-target="valeria"
        >
          <span class="tab-indicator indicator-purple"></span>
          <span class="tab-step">03</span>
          <span class="tab-name">El Hogar (Valeria+)</span>
        </button>

        <button 
          type="button" 
          role="tab" 
          id="tab-btn-lua" 
          aria-selected="false" 
          aria-controls="panel-lua" 
          class="eco-tab-btn"
          data-target="lua"
        >
          <span class="tab-indicator indicator-amber"></span>
          <span class="tab-step">04</span>
          <span class="tab-name">Hardware AIoT (Lúa)</span>
        </button>
      </div>
    </div>

    <!-- Tab Panels Container -->
    <div class="eco-stage-container">
      
      <!-- Panel 1: VIA+ -->
      <div 
        id="panel-via" 
        role="tabpanel" 
        aria-labelledby="tab-btn-via" 
        class="eco-stage-panel active panel-theme-cyan"
      >
        <div class="panel-grid">
          <div class="panel-content-col">
            <div class="panel-tag tag-cyan">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              <span>EVALUACIÓN OBJETIVA EN CONSULTA</span>
            </div>
            <h3 class="panel-title">VIA+ · Precisión Diagnóstica SaMD Clase IIa</h3>
            <p class="panel-desc">
              En la consulta médica de otorrinolaringología y pediatría, VIA+ aporta rigor objetivo sin algoritmos de caja negra. 13 módulos clínicos en tablet que evalúan audición, foniatría con DSP Praat en C++ JSI y neurodesarrollo normativo ASHA.
            </p>
            <div class="panel-features-list">
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00f2fe" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                <span><strong>DSP Praat C++ JSI:</strong> Extracción acústica ciclo a ciclo (F0, Jitter, Shimmer, HNR) validada empíricamente.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00f2fe" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span><strong>Cero IA en Runtime:</strong> Conforme al AI Act UE 2024/1689. Juicio clínico 100% en manos del facultativo.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00f2fe" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span><strong>Zero-PHI &amp; QR Anónimo:</strong> Datos locales en SQLite cifrada y exportación sin transmisión a la nube.</span>
              </div>
            </div>
            <div class="panel-cta-row">
              <a href={`${baseUrl}/via`} class="btn-panel-action btn-cyan">
                <span>Ver Módulos de VIA+</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>

          <div class="panel-visual-col">
            <div class="mockup-frame frame-cyan">
              <div class="mockup-header">
                <span class="dot-btn red"></span>
                <span class="dot-btn yellow"></span>
                <span class="dot-btn green"></span>
                <span class="mockup-title">VIA+ · Audiometría &amp; Foniatría</span>
              </div>
              <div class="mockup-img-wrap">
                <img 
                  src={`${baseUrl}/assets/via-app-1.png`} 
                  alt="Pantalla de exploración de VIA+ en tablet clínica" 
                  class="mockup-img"
                  loading="lazy"
                />
              </div>
              <div class="mockup-caption">
                <span>SaMD Clase IIa · MDR 2017/745 Regla 11</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 2: Descubre con Lúa (Aula Escolar) -->
      <div 
        id="panel-descubre" 
        role="tabpanel" 
        aria-labelledby="tab-btn-descubre" 
        class="eco-stage-panel panel-theme-emerald"
      >
        <div class="panel-grid">
          <div class="panel-content-col">
            <div class="panel-tag tag-emerald">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>EDUCACIÓN INFANTIL · 0 A 3 AÑOS</span>
            </div>
            <h3 class="panel-title">Descubre con Lúa · Rutinas de Aula y Metrónomo Visual</h3>
            <p class="panel-desc">
              Desarrollada en la incubadora de alta tecnología startTIC (Consorcio Zona Franca de Vigo / GRADIANT). Diseñada para las escuelas infantiles y asambleas de 0 a 3 años bajo la premisa de <strong>cero pantallas directas para el menor</strong>: la app es un guión instrumental para la educadora o el educador.
            </p>
            <div class="panel-features-list">
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                <span><strong>10 Unidades de Aula:</strong> Una por cada mes del curso escolar con 11 cápsulas formativas para el equipo docente.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span><strong>Metrónomo Visual Silencioso:</strong> El pulso rítmico se ve y no se oye. Evita la saturación en niños con audífono o implante coclear.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                <span><strong>1.020 Locuciones Neuronales:</strong> Grabadas offline con voces de alta naturalidad (Celtia / Proxecto Nós, Sharvard y LJSpeech).</span>
              </div>
            </div>
            <div class="panel-cta-row">
              <a href={`${baseUrl}/descubre-con-lua`} class="btn-panel-action btn-emerald">
                <span>Conocer Edición Aula</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>

          <div class="panel-visual-col">
            <!-- Visual Metronome Interactive Widget -->
            <div class="metronome-interactive-card">
              <div class="metronome-badge">
                <span class="pulsing-led"></span>
                <span>SIMULADOR PEDAGÓGICO DE AULA</span>
              </div>
              <h4 class="metronome-title">Metrónomo Visual: Pulso Silencioso</h4>
              <p class="metronome-note">
                El pulso lumínico pauta el compás en la asamblea sin emitir chasquidos sonoros que enmascaren la voz de la docente o saturen prótesis auditivas.
              </p>

              <!-- Interactive Pulse Ring Container -->
              <div class="pulse-stage" aria-label="Simulación del pulso visual rítmico">
                <div id="visual-pulse-orb" class="pulse-orb bpm-80">
                  <div class="orb-core">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  </div>
                  <div class="orb-wave wave-1"></div>
                  <div class="orb-wave wave-2"></div>
                </div>
                <div class="pulse-bpm-display">
                  <span id="current-bpm-text">80</span> <small>BPM (RITMO DE ASAMBLEA)</small>
                </div>
              </div>

              <!-- BPM Selector Buttons -->
              <div class="bpm-controls-row">
                <button type="button" class="btn-bpm-select" data-bpm="60">60 BPM (Calma)</button>
                <button type="button" class="btn-bpm-select active" data-bpm="80">80 BPM (Estándar)</button>
                <button type="button" class="btn-bpm-select" data-bpm="100">100 BPM (Juego)</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Valeria+ (El Hogar) -->
      <div 
        id="panel-valeria" 
        role="tabpanel" 
        aria-labelledby="tab-btn-valeria" 
        class="eco-stage-panel panel-theme-purple"
      >
        <div class="panel-grid">
          <div class="panel-content-col">
            <div class="panel-tag tag-purple">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              <span>REHABILITACIÓN EN EL HOGAR</span>
            </div>
            <h3 class="panel-title">Valeria+ · Inmersión Familiar &amp; 10 Bloques TPR</h3>
            <p class="panel-desc">
              Terapia domiciliaria guiada donde el adulto recupera el control. Con el método TPR (Respuesta Física Total) y micro-formación en 2 minutos (Academy), la familia practica discriminación fonológica, motricidad y audición sin pantallas pasivas.
            </p>
            <div class="panel-features-list">
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                <span><strong>10 Bloques de Terapia 100% Offline:</strong> Desde pares mínimos e integración sensorial hasta la Pizarra Mágica y RA orofacial.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
                <span><strong>Academy (2 min):</strong> Capacitación basada en los hitos de la ASHA y el abecedario dactilológico en LSE con 27 figuras.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path></svg>
                <span><strong>4.711 Locuciones Neuronales:</strong> Grabadas en 6 variedades idiomáticas para preservar el acento y la identidad familiar.</span>
              </div>
            </div>
            <div class="panel-cta-row">
              <a href={`${baseUrl}/`} class="btn-panel-action btn-purple">
                <span>Explorar Valeria+</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>

          <div class="panel-visual-col">
            <div class="mockup-frame frame-purple">
              <div class="mockup-header">
                <span class="dot-btn red"></span>
                <span class="dot-btn yellow"></span>
                <span class="dot-btn green"></span>
                <span class="mockup-title">Valeria+ · Terapia Guiada en Casa</span>
              </div>
              <div class="mockup-img-wrap">
                <img 
                  src={`${baseUrl}/assets/valeria-app-1.png`} 
                  alt="Interfaz de Valeria+ en dispositivo móvil para estimulación del lenguaje" 
                  class="mockup-img"
                  loading="lazy"
                />
              </div>
              <div class="mockup-caption">
                <span>Dispositivo Médico Clase I · Muro Regulatorio Adulto</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 4: Lúa AIoT (Hardware & Acompañante) -->
      <div 
        id="panel-lua" 
        role="tabpanel" 
        aria-labelledby="tab-btn-lua" 
        class="eco-stage-panel panel-theme-amber"
      >
        <div class="panel-grid">
          <div class="panel-content-col">
            <div class="panel-tag tag-amber">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line></svg>
              <span>HARDWARE AIoT &amp; VÍNCULO AFECTIVO</span>
            </div>
            <h3 class="panel-title">Lúa · Mascota AIoT Pediátrica (ESP32-C3)</h3>
            <p class="panel-desc">
              Compañera interactiva física y gemelo digital que une ambos mundos. Reduce la ansiedad en la sala de espera, guarda estricto silencio clínico en consulta para no interferir en las pruebas acústicas y acompaña el juego en casa.
            </p>
            <div class="panel-features-list">
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><line x1="1" y1="1" x2="23" y2="23"></line><path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"></path><path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"></path></svg>
                <span><strong>Sin Micrófonos por Diseño:</strong> Hardware físicamente carente de sensores de captura sonora para blindar la intimidad del menor.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                <span><strong>Silencio Clínico (SAFE 1):</strong> Apagado automático de pantalla durante la exploración médica con VIA+.</span>
              </div>
              <div class="feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span><strong>Descanso Visual 20-20-20:</strong> Protocolo activo tras 20 minutos de interacción para evitar la fatiga ocular pediátrica.</span>
              </div>
            </div>
            <div class="panel-cta-row">
              <a href={`${baseUrl}/lua`} class="btn-panel-action btn-amber">
                <span>Descubrir a Lúa</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>

          <div class="panel-visual-col">
            <div class="lua-hardware-showcase">
              <div class="lua-avatar-card">
                <img 
                  src={`${baseUrl}/assets/lua-mascota-valeria.png`} 
                  alt="Mascota oficial Lúa en píxel art para el ecosistema Earlify Health" 
                  class="lua-pixel-render"
                  loading="lazy"
                />
                <div class="lua-halo-ring"></div>
              </div>
              <div class="lua-spec-pill">
                <span class="spec-dot"></span>
                <span>Placa Oficial V1 (ESP32-C3) · Panel IPS Redondo GC9A01</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function setupInteractiveEcosystem() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.eco-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.eco-stage-panel');
    const bpmButtons = document.querySelectorAll<HTMLButtonElement>('.btn-bpm-select');
    const pulseOrb = document.getElementById('visual-pulse-orb');
    const bpmDisplay = document.getElementById('current-bpm-text');

    // Tab switching logic
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target;
        if (!target) return;

        // Update buttons state
        tabButtons.forEach(b => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Update panels visibility
        panels.forEach(panel => {
          const isTarget = panel.id === `panel-${target}`;
          panel.classList.toggle('active', isTarget);
        });
      });
    });

    // Metronome BPM controller logic
    bpmButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const bpm = btn.dataset.bpm;
        if (!bpm || !pulseOrb || !bpmDisplay) return;

        bpmButtons.forEach(b => b.classList.toggle('active', b === btn));
        bpmDisplay.textContent = bpm;

        // Adjust animation duration based on BPM (60 / bpm = seconds per beat)
        const periodSeconds = 60 / parseInt(bpm, 10);
        pulseOrb.style.animationDuration = `${periodSeconds.toFixed(2)}s`;
        
        const waves = pulseOrb.querySelectorAll<HTMLElement>('.orb-wave');
        waves.forEach(wave => {
          wave.style.animationDuration = `${periodSeconds.toFixed(2)}s`;
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInteractiveEcosystem);
  } else {
    setupInteractiveEcosystem();
  }
  document.addEventListener('astro:page-load', setupInteractiveEcosystem);
</script>

<style>
  .interactive-ecosystem-section {
    position: relative;
    padding: clamp(60px, 10vw, 110px) 0;
    background-color: var(--bg-dark, #07090e);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .interactive-ambient-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 450px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, rgba(0, 242, 254, 0.04) 50%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .section-intro {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3rem auto;
    position: relative;
    z-index: 1;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .badge-purple {
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #c084fc;
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-main, #f8fafc);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .gradient-text-earlify {
    background: linear-gradient(135deg, #00f2fe 0%, #a855f7 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-lead {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0 auto;
  }

  /* Eco Navigation Tabs */
  .eco-nav-wrapper {
    position: relative;
    z-index: 2;
