---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="earlify-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Backdrop Graphic -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div class="glow-orb orb-cyan"></div>
      <div class="glow-orb orb-purple"></div>
      <div class="glow-orb orb-emerald"></div>
      
      <!-- Visual Metaphor: Precision Clinical Core (VIA+) flowing to Home & Interaction with Lua (Valeria+) -->
      <div class="hero-metaphor-stage" id="hero-metaphor-stage">
        <!-- Surrealist Particle Concept: Chaotic Noise Particles coalescing into a Loving Family Silhouette -->
        <img 
          src={`${baseUrl}/assets/earlify-hero-metaphor.jpg?v=15`} 
          alt="Menos ruido. Más criterio: Torbellino de partículas en desorden caótico organizándose fluidamente hasta esculpir la silueta surrealista de una familia unida" 
          class="metaphor-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="metaphor-overlay-gradient"></div>
      </div>

      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line) -->
    <div class="hero-editorial-tracker" id="tracker" aria-hidden="true">
      <div class="tracker-segment" id="track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="fill-0"></div></div><span>El Diagnóstico</span></div>
      <div class="tracker-segment" id="track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="fill-1"></div></div><span>El Ecosistema</span></div>
      <div class="tracker-segment" id="track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="fill-2"></div></div><span>El Criterio</span></div>
    </div>

    <!-- Sutil indicador de ratón inicial abajo (desaparece al hacer scroll) -->
    <div id="scroll-starter" class="hero-scroll-starter" aria-hidden="true">
      <span class="starter-text">Scroll para explorar la continuidad clínica</span>
      <div class="hint-mouse">
        <div class="mouse-wheel"></div>
      </div>
    </div>

    <!-- PHASE 0: El Abismo Clínico & La Desconexión (Carga inmediata a scroll 0) -->
    <div id="phase-0" class="hero-phase-panel phase-initial">
      <div class="phase-inner max-w-content">
        <!-- Logo Oficial de Earlify Health visible, nítido y luminoso -->
        <div class="hero-logo-wrapper">
          <img 
            src={`${baseUrl}/assets/earlify-logo.png?v=9`} 
            alt="Logo Oficial de Earlify Health" 
            class="hero-brand-logo" 
            width="260"
            height="260"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="editorial-eyebrow">
          <span>Earlify Health · Salud Digital & Neurodesarrollo</span>
        </div>
        <h1 class="hero-headline">
          Tras un diagnóstico, las familias se sienten solas al volver a casa.
        </h1>
        <p class="hero-narrative-lead">
          Conectamos la consulta médica especializada con el hogar, transformando la intervención del lenguaje en rutinas estructuradas y juegos con rigor clínico.
        </p>

        <div class="hero-badge-pill-row">
          <span class="badge-pill pill-cyan">🚀 Incubada en startTIC · Alta Tecnología</span>
          <span class="badge-pill pill-purple">🏛️ Zona Franca Vigo · Gradiant · FEDER</span>
          <span class="badge-pill pill-emerald">🩺 Sello ITEMAS-ISCIII 2024</span>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Dos Productos. Un Recorrido Continuo (32% - 66% Scroll) -->
    <div id="phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Arquitectura de Continuidad Médica</span>
        </div>
        <h2 class="hero-headline text-gradient-cyan">
          Dos productos. Un recorrido continuo de la consulta a la vida cotidiana.
        </h2>
        <div class="dual-product-capsule">
          <div class="capsule-col">
            <div class="capsule-tag tag-cyan">🩺 En Consulta</div>
            <strong class="capsule-title">VIA+ (SaMD IIa)</strong>
            <p class="capsule-desc">Herramienta clínica de apoyo a la decisión diagnóstica, medición objetiva y reducción de ruido asistencial.</p>
          </div>
          <div class="capsule-divider">
            <span class="divider-arrow">➔</span>
          </div>
          <div class="capsule-col">
            <div class="capsule-tag tag-purple">🏠 En el Hogar</div>
            <strong class="capsule-title">Valeria+</strong>
            <p class="capsule-desc">Rehabilitación auditivo-verbal gamificada, 100% offline, guiada por padres con acompañamiento médico.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: Criterio Clínico, Evidencia & Conexión (68% - 100% Scroll) -->
    <div id="phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Criterio & Evidencia Médica</span>
        </div>
        <h2 class="hero-headline text-gradient-cyan">
          Menos ruido. Más criterio. <br />
          <span class="quote-tagline">Evaluar mejor para dar continuidad antes.</span>
        </h2>
        <p class="hero-narrative-lead">
          Una visión integral que combina rigor foniátrico, tecnología médica regulada y calidez pediátrica para no dejar a ninguna familia sola tras el diagnóstico.
        </p>
        
        <div class="hero-action-buttons">
          <a href="#dos-productos" class="hero-btn btn-cyan">
            <span>Explorar Productos</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17l9.2-9.2M17 17V7H7"/>
            </svg>
          </a>
          <button id="open-contact-modal-hero" class="hero-btn btn-ghost">
            <span>Contacto Profesional</span>
          </button>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  function initEarlifyHero() {
    const heroSection = document.getElementById('earlify-hero-scrub');
    const scrollStarter = document.getElementById('scroll-starter');
    const tracker = document.getElementById('tracker');
    const fill0 = document.getElementById('fill-0');
    const fill1 = document.getElementById('fill-1');
    const fill2 = document.getElementById('fill-2');
    const phase0 = document.getElementById('phase-0');
    const phase1 = document.getElementById('phase-1');
    const phase2 = document.getElementById('phase-2');
    const metaphorStage = document.getElementById('hero-metaphor-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    // Helper: Clamps a progress value to an opacity between start and end
    function calcOpacity(progress: number, fadeInStart: number, fadeInEnd: number, fadeOutStart: number, fadeOutEnd: number) {
      if (progress < fadeInStart) return 0;
      if (progress < fadeInEnd) {
        return fadeInStart === fadeInEnd ? 1 : (progress - fadeInStart) / (fadeInEnd - fadeInStart);
      }
      if (progress <= fadeOutStart) return 1;
      if (progress < fadeOutEnd) {
        return 1 - (progress - fadeOutStart) / (fadeOutEnd - fadeOutStart);
      }
      return 0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      } else {
        targetProgress = 0;
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      // Smooth interpolation
      currentProgress += (targetProgress - currentProgress) * 0.18;

      // Scroll starter prompt is visible on initial load and fades out as user scrolls
      const opStarter = calcOpacity(targetProgress, 0.0, 0.0, 0.03, 0.08);
      if (scrollStarter) {
        scrollStarter.style.opacity = opStarter.toFixed(3);
        scrollStarter.style.pointerEvents = opStarter > 0.4 ? 'auto' : 'none';
      }

      // Phase 0: Fully visible at 0 scroll (1.0) -> exits between 0.18 and 0.35
      const op0 = calcOpacity(targetProgress, 0.0, 0.0, 0.18, 0.35);
      // Phase 1: Dos Productos & Ecosistema (enters 0.30 -> peaks at 0.40-0.62 -> exits at 0.72)
      const op1 = calcOpacity(targetProgress, 0.30, 0.40, 0.62, 0.72);
      // Phase 2: Criterio, Evidencia & CTAs (enters 0.68 -> peaks at 0.78-1.00)
      const op2 = calcOpacity(targetProgress, 0.68, 0.78, 1.0, 1.0);

      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${-targetProgress * 35}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.50 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.85 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      // Tracker visibility
      if (tracker) {
        tracker.style.opacity = '1';
      }

      // Metaphor Artwork Dynamic Parallax
      if (metaphorStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const artOpacity = Math.max(0.40, 0.70 - currentProgress * 0.25);
        metaphorStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        metaphorStage.style.opacity = artOpacity.toFixed(3);
      }

      // Editorial Tracker Bars
      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, (targetProgress / 0.34) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.34) / 0.34) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.68) / 0.32) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEarlifyHero);
  } else {
    initEarlifyHero();
  }
  document.addEventListener('astro:page-load', initEarlifyHero);
</script>

<style>
  /* 320vh Hero Container */
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    background-color: var(--bg-dark);
  }

  /* Fixed Viewport Area (Sticky) */
  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Deep Glows and Canvas */
  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.35;
    pointer-events: none;
  }

  .orb-cyan {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-cyan) 0%, rgba(0, 242, 254, 0) 70%);
    top: -120px;
    left: -120px;
  }

  .orb-purple {
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, var(--accent-purple) 0%, rgba(138, 43, 226, 0) 70%);
    bottom: -150px;
    right: -100px;
  }

  .orb-emerald {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, var(--accent-emerald) 0%, rgba(16, 185, 129, 0) 70%);
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.15;
  }

  /* Visual Metaphor Artwork with Subtle Film Grain / Vignette */
  .hero-metaphor-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 100vh;
    z-index: 2;
    will-change: transform, opacity;
    opacity: 0.70;
    transition: opacity 0.3s ease;
  }

  .metaphor-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: brightness(0.85) contrast(1.1) saturate(1.1);
  }

  .metaphor-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.2) 0%, rgba(7, 9, 14, 0.75) 80%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    z-index: 3;
  }

  /* Hero Brand Logo (Phase 0) */
  .hero-logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.5rem auto;
  }

  .hero-brand-logo {
    height: clamp(100px, 16vw, 155px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 35px rgba(0, 242, 254, 0.45)) drop-shadow(0 10px 25px rgba(0, 0, 0, 0.6));
    display: block;
    animation: subtleFloat 4s ease-in-out infinite alternate;
  }

  @keyframes subtleFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  /* Sutil indicador de inicio abajo (desaparece con el scroll) */
  .hero-scroll-starter {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    z-index: 8;
    will-change: opacity;
    pointer-events: auto;
    transition: opacity 0.2s ease;
  }

  .starter-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* Editorial Tracker */
  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-cyan);
    transition: width 0.1s linear;
  }

  /* Phase Panels */
  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5.5rem 1.5rem 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .hero-phase-panel.phase-initial {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 980px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-cyan);
    margin-bottom: 1.25rem;
  }

  .eyebrow-cyan {
    color: var(--accent-cyan);
  }

  .eyebrow-emerald {
    color: var(--accent-emerald);
  }

  .hero-headline {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.5rem;
  }

  .text-gradient-cyan {
    background: linear-gradient(135deg, #FFFFFF 20%, var(--accent-cyan) 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .quote-tagline {
    background: linear-gradient(135deg, #00F2FE 0%, #4FACFE 50%, #8A2BE2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-narrative-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 auto 1.75rem auto;
    font-weight: 400;
  }

  /* Badge Pill Row */
  .hero-badge-pill-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .badge-pill {
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-purple {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #D8B4FE;
  }

  .pill-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .pill-emerald {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--accent-emerald);
  }

  /* Dual Product Capsule (Phase 1) */
  .dual-product-capsule {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.75rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 2.25rem;
    border-radius: var(--radius-lg);
    text-align: left;
    margin: 1.5rem auto 0 auto;
    max-width: 900px;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.5);
  }

  .capsule-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .capsule-tag {
    display: inline-block;
    align-self: flex-start;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-cyan {
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.35);
  }

  .tag-purple {
    background: rgba(168, 85, 247, 0.12);
    color: #D8B4FE;
    border: 1px solid rgba(168, 85, 247, 0.35);
  }

  .capsule-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .capsule-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .capsule-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    font-size: 1.5rem;
    opacity: 0.6;
  }

  .divider-arrow {
    display: inline-block;
    animation: pulseArrow 2s infinite ease-in-out;
  }

  @keyframes pulseArrow {
    0%, 100% { transform: translateX(0); opacity: 0.5; }
    50% { transform: translateX(4px); opacity: 1; }
  }

  /* Action Buttons (Phase 2) */
  .hero-action-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn-cyan {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-blue) 100%);
    color: #07090E;
    box-shadow: 0 0 30px rgba(0, 242, 254, 0.35);
    border: none;
  }

  .btn-cyan:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 45px rgba(0, 242, 254, 0.55);
  }

  .btn-ghost {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(10px);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  /* Responsive Media Queries */
  @media (max-width: 900px) {
    .dual-product-capsule {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.5rem;
    }

    .capsule-divider {
      transform: rotate(90deg);
      margin: -0.5rem 0;
    }

    .hero-editorial-tracker {
      display: none;
    }

    .hero-phase-panel {
      padding: 4.5rem 1rem 2rem 1rem;
    }
  }

  @media (max-width: 600px) {
    .hero-headline {
      font-size: 1.85rem;
    }

    .hero-brand-logo {
      height: 90px;
    }

    .hero-action-buttons {
      flex-direction: column;
      width: 100%;
    }

    .hero-btn {
      width: 100%;
      justify-content: center;
    }

    .hero-scroll-starter {
      bottom: 20px;
    }
  }
</style>
