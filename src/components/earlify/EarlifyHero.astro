---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section class="earlify-hero">
  <div class="container">
    <div class="hero-top-badges">
      <span class="badge badge-purple">🏢 Sombrilla Tecnológica</span>
      <span class="badge badge-cyan">🩺 CEO: Dr. Frank Betances</span>
      <span class="badge badge-emerald">🏛️ Sello ITEMAS 2024</span>
      <span class="badge badge-amber">📍 USC-INTEGRA</span>
    </div>

    <!-- Official Earlify Health Logo Card -->
    <div class="earlify-logo-wrapper">
      <div class="earlify-logo-card">
        <img 
          src={`${baseUrl}/assets/earlify-logo.png`} 
          alt="Logo Oficial de Earlify Health S.L." 
          class="earlify-logo-img" 
          width="280"
          height="230"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <h1 class="hero-title">
      Earlify Health · <span class="gradient-text">Menos ruido. Más criterio.</span>
    </h1>

    <p class="hero-subtitle">
      Plataforma clínica para el neurodesarrollo, audición y lenguaje. 
      <br />
      <strong>“VIA+ estructura la evaluación clínica; Valeria+ extiende al hogar el trabajo pautado por el profesional.”</strong>
    </p>

    <!-- Canon Quote Banner -->
    <div class="canon-quote-box glass-card">
      <div class="quote-icon">💬</div>
      <div class="quote-content">
        <p class="quote-text">
          "Conocemos el problema porque lo padecemos todos los días en la trinchera hospitalaria."
        </p>
        <span class="quote-author">— Dr. Frank Alberto Betances Reinoso · Fundador y CEO de Earlify Health S.L.</span>
      </div>
    </div>

    <div class="hero-actions">
      <a href="#marcas" class="btn-primary">
        <span>Arquitectura de Marcas</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#marco-ruido" class="btn-secondary">
        <span>Marco del Ruido</span>
      </a>
      <a href={`${baseUrl}/cv`} class="btn-secondary">
        <span>Perfil del Fundador</span>
      </a>
    </div>
  </div>
</section>

<style>
  .earlify-hero {
    padding-top: 130px;
    padding-bottom: 60px;
    text-align: center;
  }

  .hero-top-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .earlify-logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.5rem auto 1.75rem auto;
  }

  .earlify-logo-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: 24px;
    padding: 1.25rem 2.25rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), 0 0 25px rgba(168, 85, 247, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .earlify-logo-card:hover {
    transform: scale(1.04) translateY(-3px);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.55), 0 0 35px rgba(168, 85, 247, 0.4);
  }

  .earlify-logo-img {
    height: 120px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .hero-title {
    font-size: 3.2rem;
    font-weight: 800;
    max-width: 900px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 800px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .canon-quote-box {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.35);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.75rem;
    max-width: 800px;
    margin: 0 auto 2.25rem auto;
    text-align: left;
    backdrop-filter: blur(16px);
  }

  .quote-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .quote-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    font-style: italic;
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }

  .quote-author {
    font-size: 0.85rem;
    color: var(--accent-purple);
    font-weight: 600;
    display: block;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.1rem;
    }
    .canon-quote-box {
      flex-direction: column;
      text-align: center;
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
