---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Modern Native Flow Hero Section for Earlify Health -->
<section id="earlify-hero" class="hero-native-section">
  <!-- Ambient Backdrop with Layered Metaphor & Glows -->
  <div class="hero-backdrop-layer" aria-hidden="true">
    <div class="ambient-glow glow-cyan"></div>
    <div class="ambient-glow glow-purple"></div>
    <div class="ambient-glow glow-emerald"></div>

    <!-- Visual Metaphor: Conceptual artwork of particles coalescing into family silhouette -->
    <div class="metaphor-artwork-wrapper">
      <img 
        src={`${baseUrl}/assets/earlify-hero-metaphor.jpg`} 
        alt="Metáfora visual de continuidad clínica y familiar en Earlify Health: orden y calidez en el neurodesarrollo" 
        class="metaphor-artwork-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="metaphor-gradient-mask"></div>
    </div>

    <div class="hero-grid-overlay"></div>
  </div>

  <div class="container hero-container">
    <!-- Brand Logo with Eager High-Priority Load & CSS-only Sizing -->
    <div class="hero-logo-container">
      <img 
        src={`${baseUrl}/assets/earlify-logo.png`} 
        alt="Logotipo Oficial de Earlify Health" 
        class="hero-brand-logo" 
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Editorial Header & Main Heading -->
    <div class="hero-header-content">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        <span>EARLIFY HEALTH · SALUD DIGITAL & NEURODESARROLLO INFANTIL</span>
      </div>

      <h1 class="hero-title">
        Uniendo la precisión médica con la calidez del hogar, <span class="text-gradient-cyan">para que ningún niño se quede atrás.</span>
      </h1>

      <p class="hero-lead">
        Tras un diagnóstico de audición o lenguaje, las familias no necesitan más incertidumbre ni listas de espera interminables. Conectamos la valoración diagnóstica en consulta con la estimulación guiada diaria en casa mediante un ecosistema riguroso, seguro y 100% offline.
      </p>

      <!-- Integrated Institutional Authority Badges -->
      <div class="hero-badges-row" aria-label="Avales institucionales y acreditaciones">
        <span class="authority-badge badge-starttic">
          <span class="badge-icon">🚀</span>
          <span class="badge-text"><strong>Incubada en startTIC</strong> · Alta Tecnología <span class="badge-sub">(Consorcio Zona Franca de Vigo · Gradiant · FEDER / INCYDE)</span></span>
        </span>
        <span class="authority-badge badge-itemas">
          <span class="badge-icon">🩺</span>
          <span class="badge-text"><strong>Sello ITEMAS-ISCIII 2024</strong></span>
        </span>
        <span class="authority-badge badge-feder">
          <span class="badge-icon">🏛️</span>
          <span class="badge-text"><strong>Fondo Europeo FEDER</strong> / Fundación INCYDE</span>
        </span>
      </div>

      <!-- Main Action CTAs -->
      <div class="hero-cta-actions">
        <a href="#ecosistema-completo" class="btn-primary-hero">
          <span>Conocer el Ecosistema Completo</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17l10-10M17 17V7H7"/>
          </svg>
        </a>
        <button 
          type="button"
          id="open-contact-modal-hero" 
          class="btn-secondary-hero"
          onclick="document.getElementById('contact-modal')?.classList.add('open'); document.getElementById('contact-modal')?.setAttribute('aria-hidden', 'false');"
        >
          <span>Contacto Profesional e Inversión</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Trilogy Summary: The 3 Core Pillars in Synchrony -->
    <div class="hero-trilogy-grid" aria-label="Los tres pilares del ecosistema Earlify">
      <!-- Pillar 1: VIA+ -->
      <a href="#ecosistema-completo" class="trilogy-card card-via">
        <div class="card-badge tag-cyan">
          <span class="tag-icon">🩺</span>
          <span>En Consulta Médica</span>
        </div>
        <h3 class="card-title">VIA+ <span class="card-subtitle">(SaMD Clase IIa)</span></h3>
        <p class="card-desc">
          Evaluación clínica objetiva en consulta con 13 módulos foniátricos sin algoritmos opacos.
        </p>
        <div class="card-footer">
          <span class="pill-mini">MDR Regla 11</span>
          <span class="pill-mini">DSP Praat C++</span>
          <span class="pill-mini">7 Lenguas</span>
        </div>
      </a>

      <!-- Pillar 2: Valeria+ -->
      <a href="#ecosistema-completo" class="trilogy-card card-valeria">
        <div class="card-badge tag-purple">
          <span class="tag-icon">🏠</span>
          <span>En el Hogar y la Familia</span>
        </div>
        <h3 class="card-title">Valeria+ <span class="card-subtitle">(DM Clase I)</span></h3>
        <p class="card-desc">
          Estimulación auditivo-verbal y micro-rutinas TPR en el hogar 100% offline y Academy para familias.
        </p>
        <div class="card-footer">
          <span class="pill-mini">9 Bloques TPR</span>
          <span class="pill-mini">4.110 Locuciones</span>
          <span class="pill-mini">Academy ASHA</span>
        </div>
      </a>

      <!-- Pillar 3: Lúa -->
      <a href="#ecosistema-completo" class="trilogy-card card-lua">
        <div class="card-badge tag-orange">
          <span class="tag-icon">🐱</span>
          <span>Puente Afectivo</span>
        </div>
        <h3 class="card-title">Lúa <span class="card-subtitle">(Hardware AIoT V1)</span></h3>
        <p class="card-desc">
          Mascota física redonda GC9A01 (ESP32-C3) con estricto silencio clínico en consulta y descanso 20-20-20.
        </p>
        <div class="card-footer">
          <span class="pill-mini">Sin Micrófonos</span>
          <span class="pill-mini">Zero-PHI</span>
          <span class="pill-mini">USC Ender-3</span>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  function initHeroModalListener() {
    const contactBtn = document.getElementById('open-contact-modal-hero');
    const modal = document.getElementById('contact-modal');
    if (contactBtn && modal) {
      contactBtn.addEventListener('click', () => {
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroModalListener);
  } else {
    initHeroModalListener();
  }
  document.addEventListener('astro:page-load', initHeroModalListener);
</script>

<style>
  /* Native Flow Modern Hero Section */
  .hero-native-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 76px);
    padding-top: clamp(100px, 14vh, 130px);
    padding-bottom: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-dark);
    color: var(--text-main);
    overflow: hidden;
  }

  /* Layered Ambient Backdrop */
  .hero-backdrop-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
  }

  .glow-cyan {
    width: clamp(350px, 45vw, 650px);
    height: clamp(350px, 45vw, 650px);
    background: radial-gradient(circle, rgba(0, 242, 254, 0.16) 0%, rgba(79, 172, 254, 0) 70%);
    top: -100px;
    left: -100px;
    filter: blur(80px);
  }

  .glow-purple {
    width: clamp(380px, 50vw, 700px);
    height: clamp(380px, 50vw, 700px);
    background: radial-gradient(circle, rgba(138, 43, 226, 0.14) 0%, rgba(138, 43, 226, 0) 70%);
    bottom: -120px;
    right: -100px;
    filter: blur(95px);
  }

  .glow-emerald {
    width: clamp(300px, 35vw, 500px);
    height: clamp(300px, 35vw, 500px);
    background: radial-gradient(circle, rgba(16, 185, 129, 0.10) 0%, rgba(16, 185, 129, 0) 70%);
    top: 35%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(85px);
  }

  /* Metaphor Background Artwork - strictly CSS dimensioned */
  .metaphor-artwork-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.28;
    mix-blend-mode: screen;
  }

  .metaphor-artwork-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    filter: brightness(0.85) contrast(1.15) saturate(1.1);
  }

  .metaphor-gradient-mask {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 35%, rgba(7, 9, 14, 0.25) 0%, rgba(7, 9, 14, 0.82) 65%, var(--bg-dark) 100%);
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 45%, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at 50% 45%, black 40%, transparent 85%);
    z-index: 2;
  }

  /* Hero Container */
  .hero-container {
    position: relative;
    z-index: 5;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Hero Logo - strictly CSS dimensioned (zero HTML width/height) */
  .hero-logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .hero-brand-logo {
    height: clamp(105px, 14vw, 150px);
    width: auto;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 0 35px rgba(0, 242, 254, 0.42)) drop-shadow(0 12px 28px rgba(0, 0, 0, 0.75));
    display: block;
    animation: gentleFloat 4.5s ease-in-out infinite alternate;
  }

  @keyframes gentleFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-5px); }
  }

  /* Content Block */
  .hero-header-content {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.28);
    border-radius: var(--radius-full);
    font-size: clamp(0.75rem, 1.1vw, 0.85rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-cyan);
    margin-bottom: 1.35rem;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: blinkDot 2s infinite ease-in-out;
  }

  @keyframes blinkDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(2.1rem, 4.4vw, 3.75rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.5rem;
  }

  .text-gradient-cyan {
    background: linear-gradient(135deg, #FFFFFF 15%, var(--accent-cyan) 65%, #4FACFE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline;
  }

  .hero-lead {
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
    color: var(--text-muted);
    line-height: 1.68;
    max-width: 860px;
    margin: 0 auto 2rem auto;
    font-weight: 400;
  }

  /* Authority Badges */
  .hero-badges-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 2.25rem;
  }

  .authority-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    line-height: 1.4;
    transition: all 0.25s ease;
  }

  .badge-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .badge-text {
    color: var(--text-main);
  }

  .badge-sub {
    opacity: 0.85;
    font-weight: 400;
  }

  .badge-starttic {
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.32);
    color: var(--text-main);
  }
  .badge-starttic strong {
    color: var(--accent-cyan);
  }

  .badge-itemas {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.32);
    color: var(--text-main);
  }
  .badge-itemas strong {
    color: var(--accent-emerald);
  }

  .badge-feder {
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.32);
    color: var(--text-main);
  }
  .badge-feder strong {
    color: #D8B4FE;
  }

  /* CTAs */
  .hero-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .btn-primary-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 2rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--accent-cyan) 0%, #00B4D8 50%, var(--accent-blue) 100%);
    color: #07090E;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.02rem;
    text-decoration: none;
    box-shadow: 0 0 35px rgba(0, 242, 254, 0.38), 0 10px 20px -5px rgba(0, 0, 0, 0.5);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    cursor: pointer;
  }

  .btn-primary-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 45px rgba(0, 242, 254, 0.55), 0 14px 28px -5px rgba(0, 0, 0, 0.6);
  }

  .btn-secondary-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.85rem;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.65);
    color: var(--text-main);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    text-decoration: none;
  }

  .btn-secondary-hero:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 242, 254, 0.4);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  /* Trilogy Summary Cards */
  .hero-trilogy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.35rem;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    text-align: left;
  }

  .trilogy-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.45rem;
    border-radius: var(--radius-lg);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.4);
  }

  .trilogy-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -10px rgba(0, 0, 0, 0.6);
  }

  .card-via:hover {
    border-color: rgba(0, 242, 254, 0.4);
    box-shadow: 0 18px 40px -10px rgba(0, 242, 254, 0.15);
  }

  .card-valeria:hover {
    border-color: rgba(168, 85, 247, 0.4);
    box-shadow: 0 18px 40px -10px rgba(168, 85, 247, 0.15);
  }

  .card-lua:hover {
    border-color: rgba(249, 115, 22, 0.4);
    box-shadow: 0 18px 40px -10px rgba(249, 115, 22, 0.15);
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.85rem;
  }

  .tag-cyan {
    background: rgba(0, 242, 254, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.32);
  }

  .tag-purple {
    background: rgba(168, 85, 247, 0.12);
    color: #D8B4FE;
    border: 1px solid rgba(168, 85, 247, 0.32);
  }

  .tag-orange {
    background: rgba(249, 115, 22, 0.12);
    color: #FDBA74;
    border: 1px solid rgba(249, 115, 22, 0.32);
  }

  .card-title {
    font-size: 1.22rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .card-subtitle {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .card-desc {
    font-size: 0.91rem;
    color: var(--text-muted);
    line-height: 1.52;
    margin-bottom: 1.15rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .pill-mini {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  /* Responsive Adjustments */
  @media (max-width: 980px) {
    .hero-trilogy-grid {
      grid-template-columns: 1fr;
      max-width: 580px;
    }

    .hero-cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary-hero,
    .btn-secondary-hero {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .hero-native-section {
      padding-top: 105px;
      padding-bottom: 3rem;
    }

    .hero-title {
      font-size: 1.95rem;
    }

    .hero-lead {
      font-size: 1.02rem;
    }

    .authority-badge {
      font-size: 0.76rem;
      padding: 0.45rem 0.85rem;
    }
  }
</style>

