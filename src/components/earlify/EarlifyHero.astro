---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<!-- 320vh Sticky Scroll Hero Section inspired by Creating-Oneshot-Hero-Landing-Pages -->
<section id="earlify-hero-scrub" class="hero-scrub-container">
  <div class="hero-sticky-viewport">
    
    <!-- Deep Ambient Glow & Backdrop Graphic -->
    <div class="hero-background-canvas" aria-hidden="true">
      <div class="glow-orb orb-cyan"></div>
      <div class="glow-orb orb-purple"></div>
      <div class="glow-orb orb-emerald"></div>
      
      <!-- Visual Metaphor: Minimalist Vector Art - Radiant Clinical Core connecting with Adult-Child Play -->
      <div class="hero-metaphor-stage" id="hero-metaphor-stage">
        <img 
          src={`${baseUrl}/assets/earlify-hero-metaphor.jpg?v=11`} 
          alt="Metáfora vectorial minimalista: nodo central de criterio clínico conectando con el juego familiar" 
          class="metaphor-artwork-img"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
        <div class="metaphor-overlay-gradient"></div>
      </div>

      <div class="hero-grid-pattern"></div>
    </div>

    <!-- Progress & Stage Indicators (Discreet Editorial Line) -->
    <div class="hero-editorial-tracker" aria-hidden="true">
      <div class="tracker-segment" id="track-0"><span>01</span><div class="track-bar"><div class="track-fill" id="fill-0"></div></div><span>El Diagnóstico</span></div>
      <div class="tracker-segment" id="track-1"><span>02</span><div class="track-bar"><div class="track-fill" id="fill-1"></div></div><span>El Ecosistema</span></div>
      <div class="tracker-segment" id="track-2"><span>03</span><div class="track-bar"><div class="track-fill" id="fill-2"></div></div><span>El Criterio</span></div>
    </div>

    <!-- PHASE 0: El Abismo Clínico & La Desconexión (0% - 28% Scroll) -->
    <div id="phase-0" class="hero-phase-panel active-phase">
      <div class="phase-inner max-w-content">
        <!-- Logo Oficial de Earlify Health visible, nítido y luminoso -->
        <div class="hero-logo-wrapper">
          <img 
            src={`${baseUrl}/assets/earlify-logo.png?v=9`} 
            alt="Logo Oficial de Earlify Health" 
            class="hero-brand-logo" 
            width="260"
            height="260"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="editorial-eyebrow">
          <span>Earlify Health · Salud Digital & Neurodesarrollo</span>
        </div>
        <h1 class="hero-headline">
          Tras un diagnóstico, las familias se sienten solas al volver a casa.
        </h1>
        <p class="hero-narrative-lead">
          Conectamos la consulta médica especializada con el hogar, transformando la intervención del lenguaje en rutinas estructuradas y juegos con rigor clínico.
        </p>
        <div class="hero-scroll-hint">
          <span class="hint-text">Desliza para explorar la continuidad asistencial</span>
          <div class="hint-mouse">
            <div class="mouse-wheel"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 1: Dos Productos. Un Recorrido Continuo (32% - 66% Scroll) -->
    <div id="phase-1" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-cyan">
          <span>Arquitectura de Continuidad Médica</span>
        </div>
        <h2 class="hero-headline text-gradient-cyan">
          Dos productos. Un recorrido continuo de la consulta a la vida cotidiana.
        </h2>
        <div class="dual-product-capsule">
          <div class="capsule-col">
            <div class="capsule-tag tag-cyan">🩺 En Consulta</div>
            <strong class="capsule-title">VIA+ (SaMD IIa)</strong>
            <p class="capsule-desc">Herramienta clínica de apoyo a la decisión diagnóstica, medición objetiva y reducción de ruido asistencial.</p>
          </div>
          <div class="capsule-divider">
            <span class="divider-arrow">➔</span>
          </div>
          <div class="capsule-col">
            <div class="capsule-tag tag-purple">🏠 En el Hogar</div>
            <strong class="capsule-title">Valeria+</strong>
            <p class="capsule-desc">Rehabilitación auditivo-verbal gamificada, 100% offline, guiada por padres con acompañamiento médico.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- PHASE 2: Criterio Clínico y Acción (70% - 100% Scroll) -->
    <div id="phase-2" class="hero-phase-panel">
      <div class="phase-inner max-w-content">
        <div class="editorial-eyebrow eyebrow-emerald">
          <span>Evidencia Empírica & Criterio Médico</span>
        </div>
        <h2 class="hero-headline">
          <span class="quote-tagline">“Menos ruido. Más criterio.”</span>
        </h2>
        <p class="hero-narrative-lead">
          Evaluamos, formamos, certificamos y rehabilitamos. Hacemos el trabajo completo para que ningún niño ni familia queden a la deriva.
        </p>
        
        <div class="hero-cta-group">
          <a href="#dos-productos" class="btn-hero-primary">
            <span>Explorar Ecosistema Clínico</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#evidencia-clinica" class="btn-hero-secondary">
            <span>Ver Evidencia & Validación</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heroSection = document.getElementById('earlify-hero-scrub');
    const phase0 = document.getElementById('phase-0');
    const phase1 = document.getElementById('phase-1');
    const phase2 = document.getElementById('phase-2');

    const fill0 = document.getElementById('fill-0');
    const fill1 = document.getElementById('fill-1');
    const fill2 = document.getElementById('fill-2');
    const metaphorStage = document.getElementById('hero-metaphor-stage');

    if (!heroSection || !phase0 || !phase1 || !phase2) return;

    let targetProgress = 0;
    let currentProgress = 0;

    // Mathematical opacity calculation without CSS lag
    function calcOpacity(progress: number, enterStart: number, enterEnd: number, exitStart: number, exitEnd: number): number {
      if (progress < enterStart || progress > exitEnd) return 0;
      if (progress < enterEnd) return (progress - enterStart) / (enterEnd - enterStart);
      if (progress > exitStart) return Math.max(0, 1 - (progress - exitStart) / (exitEnd - exitStart));
      return 1.0;
    }

    function updateScroll() {
      const rect = heroSection!.getBoundingClientRect();
      const maxScroll = rect.height - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);
    updateScroll();

    function renderLoop() {
      // Smooth interpolation
      currentProgress += (targetProgress - currentProgress) * 0.18;

      // Phase Opacities
      const op0 = calcOpacity(targetProgress, 0.0, 0.05, 0.25, 0.33);
      const op1 = calcOpacity(targetProgress, 0.33, 0.42, 0.62, 0.70);
      const op2 = calcOpacity(targetProgress, 0.70, 0.78, 0.96, 1.00);

      // Phase 0: Fade and slight move up
      phase0!.style.opacity = op0.toFixed(3);
      phase0!.style.transform = `translateY(${-targetProgress * 45}px)`;
      phase0!.style.pointerEvents = op0 > 0.4 ? 'auto' : 'none';

      // Phase 1: Enter from bottom, stay, exit up
      phase1!.style.opacity = op1.toFixed(3);
      phase1!.style.transform = `translateY(${(0.50 - targetProgress) * 40}px)`;
      phase1!.style.pointerEvents = op1 > 0.4 ? 'auto' : 'none';

      // Phase 2: Enter and settle with CTA
      phase2!.style.opacity = op2.toFixed(3);
      phase2!.style.transform = `translateY(${(0.85 - targetProgress) * 35}px)`;
      phase2!.style.pointerEvents = op2 > 0.4 ? 'auto' : 'none';

      // Metaphor Artwork Dynamic Parallax
      if (metaphorStage) {
        const scale = 1 + currentProgress * 0.08;
        const transY = currentProgress * -25;
        const artOpacity = Math.max(0.40, 0.70 - currentProgress * 0.25);
        metaphorStage.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)}) translateY(${transY.toFixed(1)}px)`;
        metaphorStage.style.opacity = artOpacity.toFixed(3);
      }

      // Editorial Tracker Bars
      if (fill0) fill0.style.width = `${Math.min(100, Math.max(0, (targetProgress / 0.33) * 100))}%`;
      if (fill1) fill1.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.33) / 0.37) * 100))}%`;
      if (fill2) fill2.style.width = `${Math.min(100, Math.max(0, ((targetProgress - 0.70) / 0.30) * 100))}%`;

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  });
</script>

<style>
  /* 320vh Hero Container */
  .hero-scrub-container {
    position: relative;
    height: 320vh;
    width: 100%;
    background-color: var(--bg-dark);
  }

  .hero-sticky-viewport {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background Ambient Graphics */
  .hero-background-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.28;
    pointer-events: none;
  }

  .orb-cyan {
    top: 20%;
    left: 15%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--accent-cyan) 0%, rgba(0, 242, 254, 0) 70%);
  }

  .orb-purple {
    bottom: 25%;
    right: 15%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, var(--accent-purple) 0%, rgba(138, 43, 226, 0) 70%);
  }

  .orb-emerald {
    top: 55%;
    left: 45%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, var(--accent-emerald) 0%, rgba(16, 185, 129, 0) 70%);
    opacity: 0.16;
  }

  /* Visual Metaphor Stage */
  .hero-metaphor-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(1380px, 94vw);
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 82vh;
    opacity: 0.70;
    pointer-events: none;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 60px rgba(0, 242, 254, 0.25));
  }

  .metaphor-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 92%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 92%);
    filter: brightness(0.92) contrast(1.12);
  }

  .metaphor-overlay-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(7, 9, 14, 0.2) 0%, rgba(7, 9, 14, 0.65) 80%, var(--bg-dark) 100%);
    pointer-events: none;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
    z-index: 3;
  }

  /* Hero Brand Logo (Phase 0) */
  .hero-logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.5rem auto;
  }

  .hero-brand-logo {
    height: clamp(100px, 16vw, 155px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 35px rgba(0, 242, 254, 0.45)) drop-shadow(0 10px 25px rgba(0, 0, 0, 0.6));
    display: block;
    animation: subtleFloat 4s ease-in-out infinite alternate;
  }

  @keyframes subtleFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  /* Editorial Tracker */
  .hero-editorial-tracker {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.75rem;
    z-index: 10;
    pointer-events: none;
  }

  .tracker-segment {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .track-bar {
    width: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .track-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-cyan);
    transition: width 0.1s linear;
  }

  /* Phase Panels */
  .hero-phase-panel {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    z-index: 5;
    will-change: opacity, transform;
    opacity: 0;
    pointer-events: none;
  }

  .phase-inner {
    text-align: center;
    width: 100%;
  }

  .max-w-content {
    max-width: 980px;
    margin: 0 auto;
  }

  .editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-cyan);
    margin-bottom: 1.25rem;
  }

  .eyebrow-cyan {
    color: var(--accent-cyan);
  }

  .eyebrow-emerald {
    color: var(--accent-emerald);
  }

  .hero-headline {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.5rem;
  }

  .text-gradient-cyan {
    background: linear-gradient(135deg, #FFFFFF 20%, var(--accent-cyan) 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .quote-tagline {
    background: linear-gradient(135deg, #00F2FE 0%, #4FACFE 50%, #8A2BE2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-narrative-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 820px;
    margin: 0 auto 2.5rem auto;
    font-weight: 400;
  }

  /* Dual Product Capsule (Phase 1) */
  .dual-product-capsule {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.75rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 2.25rem;
    border-radius: var(--radius-lg);
    text-align: left;
    margin: 1.5rem auto 0 auto;
    max-width: 900px;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.5);
  }

  .capsule-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .capsule-tag {
    display: inline-block;
    align-self: flex-start;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-cyan {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.35);
    color: var(--accent-cyan);
  }

  .tag-purple {
    background: rgba(138, 43, 226, 0.15);
    border: 1px solid rgba(138, 43, 226, 0.4);
    color: #D8B4FE;
  }

  .capsule-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .capsule-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .capsule-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    font-size: 1.5rem;
    opacity: 0.8;
  }

  /* CTAs (Phase 2) */
  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.2rem;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-blue) 100%);
    color: #040914;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    box-shadow: 0 4px 25px rgba(0, 242, 254, 0.35);
    transition: all 0.25s ease;
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 35px rgba(0, 242, 254, 0.55);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.2rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--text-main);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: all 0.25s ease;
  }

  .btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  /* Scroll Mouse Hint */
  .hero-scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hint-text {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .hint-mouse {
    width: 22px;
    height: 36px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    position: relative;
  }

  .mouse-wheel {
    width: 4px;
    height: 8px;
    background: var(--accent-cyan);
    border-radius: 2px;
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    animation: wheelScroll 1.8s infinite ease-in-out;
  }

  @keyframes wheelScroll {
    0% { transform: translate(-50%, 0); opacity: 1; }
    80% { transform: translate(-50%, 12px); opacity: 0; }
    100% { transform: translate(-50%, 0); opacity: 0; }
  }

  @media (max-width: 860px) {
    .dual-product-capsule {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.5rem;
    }
    .capsule-divider {
      transform: rotate(90deg);
      margin: -0.25rem 0;
    }
    .hero-editorial-tracker {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-headline {
      font-size: 1.85rem;
    }
    .hero-narrative-lead {
      font-size: 1rem;
    }
    .btn-hero-primary, .btn-hero-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>