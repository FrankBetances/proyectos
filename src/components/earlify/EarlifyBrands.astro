---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section id="dos-productos" class="earlify-brands section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Portafolio Asistencial</span>
      <h2 class="section-title">
        Dos productos. <span class="gradient-text">Un recorrido continuo.</span>
      </h2>
      <p class="section-description">
        Earlify desarrolla dos soluciones digitales complementarias para conectar la evaluación en consulta con la continuidad en el hogar.
      </p>
    </div>

    <div class="brands-grid">
      <!-- 1. VIA+ Card -->
      <div class="brand-card glass-card">
        <div class="card-top">
          <div class="brand-badge badge-cyan">EVALUACIÓN CLÍNICA</div>
          <span class="cert-pill">SaMD Clase IIa · Apoyo a la Decisión</span>
        </div>
        
        <h3 class="brand-name">VIA+</h3>
        <p class="brand-tagline">Herramienta de apoyo a la decisión clínica</p>
        
        <p class="brand-desc">
          VIA+ es una herramienta de apoyo a la decisión clínica para profesionales sanitarios cualificados que estructura la evaluación en neurodesarrollo.
          <br /><br />
          Ayuda a recoger y organizar información relevante, aplicar un criterio de trabajo más consistente y orientar los siguientes pasos asistenciales, siempre bajo estricta supervisión profesional.
        </p>

        <div class="card-footer">
          <a href={`${baseUrl}/via`} class="link-btn">Ver Detalles Técnicos de VIA+ &rarr;</a>
        </div>
      </div>

      <!-- 2. VALERIA+ Card -->
      <div class="brand-card glass-card">
        <div class="card-top">
          <div class="brand-badge badge-emerald">CONTINUIDAD EN CASA</div>
          <span class="cert-pill">Español e Inglés · Participación Familiar</span>
        </div>
        
        <h3 class="brand-name">Valeria+</h3>
        <p class="brand-tagline">Rehabilitación auditivo-verbal y del lenguaje</p>
        
        <p class="brand-desc">
          Valeria+ es una aplicación de rehabilitación auditivo-verbal y del lenguaje para niños, diseñados para utilizarse acompañados por padres y cuidadores en el hogar.
          <br /><br />
          Ofrece actividades estructuradas en español e inglés. No sustituye al profesional ni toma decisiones autónomas: da continuidad al trabajo definido en consulta manteniendo al adulto como responsable de la valoración final.
        </p>

        <div class="card-footer">
          <a href={`${baseUrl}/`} class="link-btn">Ver Plataforma Valeria+ &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .earlify-brands {
    background: rgba(15, 23, 42, 0.4);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 90px 0;
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .section-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: var(--accent-purple);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .section-description {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .brand-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 1px solid var(--border-light);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .brand-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 242, 254, 0.4);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .brand-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
  }

  .cert-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .brand-name {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.3rem;
  }

  .brand-tagline {
    font-size: 1rem;
    color: var(--accent-cyan);
    font-weight: 700;
    margin-bottom: 1.2rem;
  }

  .brand-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-footer {
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .link-btn {
    color: var(--accent-cyan);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-btn:hover {
    color: #fff;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }
    .brands-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
