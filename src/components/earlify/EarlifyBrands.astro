---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL.slice(0, -1) 
  : import.meta.env.BASE_URL;
---

<section id="portafolio-asistencial" class="earlify-brands section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Portafolio Asistencial</span>
      <h2 class="section-title">
        Tres soluciones. <span class="gradient-text">Un solo camino para cada familia.</span>
      </h2>
      <p class="section-description">
        Earlify desarrolla tecnología pediátrica complementaria para conectar la evaluación especializada en consulta con la continuidad diaria en casa y el apoyo emocional.
      </p>
    </div>

    <div class="brands-grid">
      <!-- 1. VIA+ Card -->
      <div class="brand-card glass-card">
        <div class="card-top">
          <div class="brand-badge badge-cyan">EVALUACIÓN CLÍNICA</div>
          <span class="cert-pill">SaMD Clase IIa · Apoyo a la Decisión</span>
        </div>
        
        <h3 class="brand-name">VIA+</h3>
        <p class="brand-tagline">Software como Dispositivo Médico en consulta</p>
        
        <p class="brand-desc">
          Herramienta en tablet para otorrinolaringólogos, audiólogos y logopedas. Integra 13 módulos de valoración (audiometría tonal y condicionada, análisis de voz validado con Praat, disfagia MECV-V y 21 hitos ASHA) sin emitir diagnósticos automáticos ni requerir internet.
        </p>

        <div class="card-footer">
          <a href={`${baseUrl}/via`} class="link-btn">Explorar Módulos de VIA+ &rarr;</a>
        </div>
      </div>

      <!-- 2. VALERIA+ Card -->
      <div class="brand-card glass-card">
        <div class="card-top">
          <div class="brand-badge badge-emerald">TERAPIA EN CASA</div>
          <span class="cert-pill">Formación Academy · 100% Offline</span>
        </div>
        
        <h3 class="brand-name">Valeria+</h3>
        <p class="brand-tagline">Formación familiar y 9 bloques de estimulación</p>
        
        <p class="brand-desc">
          Plataforma que empodera a las familias con cápsulas de 2 minutos (Academy) y ofrece 9 bloques de ejercicios (sensorial SOR, pares mínimos, Pizarra Mágica y Realidad Aumentada) con 4.110 locuciones en 6 variedades idiomáticas.
        </p>

        <div class="card-footer">
          <a href={`${baseUrl}/`} class="link-btn">Conocer Valeria+ &rarr;</a>
        </div>
      </div>

      <!-- 3. LÚA Card -->
      <div class="brand-card glass-card">
        <div class="card-top">
          <div class="brand-badge badge-orange">REFUERZO & COMPAÑÍA</div>
          <span class="cert-pill">Hardware ESP32-C3 · Silencio Clínico</span>
        </div>
        
        <h3 class="brand-name">Lúa</h3>
        <p class="brand-tagline">Mascota interactiva física y digital</p>
        
        <p class="brand-desc">
          Compañera en pixel art y dispositivo circular BLE que une ambos mundos: guarda estricto silencio en la consulta médica para no interferir en las pruebas acústicas, y en casa acompaña y premia al niño reduciendo el estrés.
        </p>

        <div class="card-footer">
          <a href={`${baseUrl}/lua`} class="link-btn">Descubrir a Lúa (Hardware) &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .earlify-brands {
    background: rgba(15, 23, 42, 0.4);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 90px 0;
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
  }

  .section-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: var(--accent-purple);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .section-description {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .brand-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 1px solid var(--border-light);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .brand-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 242, 254, 0.4);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .brand-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
  }

  .cert-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .badge-cyan {
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    color: var(--accent-cyan);
  }

  .badge-emerald {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--accent-emerald);
  }

  .badge-orange {
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: #fb923c;
  }

  .brand-name {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.3rem;
  }

  .brand-tagline {
    font-size: 0.95rem;
    color: var(--accent-cyan);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .brand-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-footer {
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .link-btn {
    color: var(--accent-cyan);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-btn:hover {
    color: #fff;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }
    .brands-grid {
      grid-template-columns: 1fr;
    }
    .brand-card {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
